import "base";
import "lexer";
import "testing";

fn kind_at(c: i64, first: i64, i: i64) -> i64 {
    return tok_kind(c, first + i);
}

fn test_keywords_identifiers_and_literals() -> i64 {
    let c = test_context();
    let first = lex_text(c, "let mut letx = 42; import _ _a");
    expect_i64(kind_at(c, first, 0), TK_LET, "let keyword");
    expect_i64(kind_at(c, first, 1), TK_MUT, "mut keyword");
    expect_i64(kind_at(c, first, 2), TK_IDENT, "keyword prefix is an identifier");
    expect_text(name_text(c, tok_value(c, first + 2)), "letx", "identifier text");
    expect_i64(kind_at(c, first, 3), TK_EQ, "assignment");
    expect_i64(kind_at(c, first, 4), TK_INT, "integer");
    expect_i64(tok_value(c, first + 4), 42, "integer value");
    expect_i64(kind_at(c, first, 5), TK_SEMI, "semicolon");
    expect_i64(kind_at(c, first, 6), TK_IMPORT, "import keyword");
    expect_i64(kind_at(c, first, 7), TK_UNDERSCORE, "lone underscore");
    expect_i64(kind_at(c, first, 8), TK_IDENT, "underscore-prefixed identifier");
    expect_i64(kind_at(c, first, 9), TK_EOF, "end of file");
    return 0;
}

fn test_primitive_types_are_keywords() -> i64 {
    let c = test_context();
    let first = lex_text(c, "u8 i8 i32 u32 i64 u64 bool void ptr Str");
    expect_i64(kind_at(c, first, 0), TK_TY_U8, "u8");
    expect_i64(kind_at(c, first, 2), TK_TY_I32, "i32");
    expect_i64(kind_at(c, first, 4), TK_TY_I64, "i64");
    expect_i64(kind_at(c, first, 6), TK_TY_BOOL, "bool");
    expect_i64(kind_at(c, first, 7), TK_TY_VOID, "void");
    expect_i64(kind_at(c, first, 8), TK_TY_PTR, "ptr");
    expect_i64(kind_at(c, first, 9), TK_IDENT, "Str is an identifier");
    return 0;
}

fn test_operators_take_longest_match() -> i64 {
    let c = test_context();
    let first = lex_text(c, "== != <= >= << >> && || -> => :: .. . : & | < > ! =");
    expect_i64(kind_at(c, first, 0), TK_EQEQ, "==");
    expect_i64(kind_at(c, first, 1), TK_NEQ, "!=");
    expect_i64(kind_at(c, first, 2), TK_LTE, "<=");
    expect_i64(kind_at(c, first, 3), TK_GTE, ">=");
    expect_i64(kind_at(c, first, 4), TK_SHL, "<<");
    expect_i64(kind_at(c, first, 5), TK_SHR, ">>");
    expect_i64(kind_at(c, first, 6), TK_AMPAMP, "&&");
    expect_i64(kind_at(c, first, 7), TK_PIPEPIPE, "||");
    expect_i64(kind_at(c, first, 8), TK_ARROW, "->");
    expect_i64(kind_at(c, first, 9), TK_FATARROW, "=>");
    expect_i64(kind_at(c, first, 10), TK_COLONCOLON, "::");
    expect_i64(kind_at(c, first, 11), TK_DOTDOT, "..");
    expect_i64(kind_at(c, first, 12), TK_DOT, ".");
    expect_i64(kind_at(c, first, 13), TK_COLON, ":");
    expect_i64(kind_at(c, first, 14), TK_AMP, "&");
    expect_i64(kind_at(c, first, 15), TK_PIPE, "|");
    expect_i64(kind_at(c, first, 16), TK_LT, "<");
    expect_i64(kind_at(c, first, 17), TK_GT, ">");
    expect_i64(kind_at(c, first, 18), TK_BANG, "!");
    expect_i64(kind_at(c, first, 19), TK_EQ, "=");
    return 0;
}

fn test_strings_comments_and_positions() -> i64 {
    let c = test_context();
    let first = lex_text(c, "// header\n  \"a\\n\\\"b\\\\\" @macro @x");
    expect_i64(kind_at(c, first, 0), TK_STR, "string after comment");
    expect_text(tok_value(c, first), "a\n\"b\\", "escapes are decoded");
    expect_i64(tok_start(c, first), 12, "string start offset");
    expect_i64(tok_end(c, first), 22, "string end offset");
    expect_i64(kind_at(c, first, 1), TK_ATMACRO, "@macro");
    expect_i64(kind_at(c, first, 2), TK_AT, "@");
    expect_i64(kind_at(c, first, 3), TK_IDENT, "macro name");
    return 0;
}

fn test_files_get_disjoint_positions() -> i64 {
    let c = test_context();
    let a = lex_text(c, "fn");
    let b = lex_text(c, "fn");
    expect_true(tok_start(c, b) > tok_end(c, a), "second file starts after the first");
    expect_i64(file_of_pos(c, tok_start(c, b)), 1, "position maps back to its file");
    return 0;
}

fn main() -> i64 {
    test_keywords_identifiers_and_literals();
    test_primitive_types_are_keywords();
    test_operators_take_longest_match();
    test_strings_comments_and_positions();
    test_files_get_disjoint_positions();
    print("ok");
    return 0;
}
