// rt/str.trk — Track runtime: strings, characters, paths.
//
// Strings are NUL-terminated byte pointers. Runtime strings are never
// freed (`str_free` is a no-op), as in the C runtime.

fn rt_is_space(ch: i64) -> bool { return ch == 32 || (ch >= 9 && ch <= 13); }
fn rt_is_digit(ch: i64) -> bool { return ch >= 48 && ch <= 57; }
fn rt_is_alpha(ch: i64) -> bool { return (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122); }

fn str_from_literal(raw: i64) -> i64 { return rt_dup(raw); }

fn str_free(s: i64) -> i64 { return 0; }

fn str_len(s: i64) -> i64 {
    if s == 0 {
        return 0;
    }
    return rt_strlen(s);
}

fn str_eq(a: i64, b: i64) -> bool {
    if a == 0 || b == 0 {
        return a == b;
    }
    let mut i: i64 = 0;
    while true {
        let x = load8(a + i);
        if x != load8(b + i) {
            return false;
        }
        if x == 0 {
            return true;
        }
        i = i + 1;
    }
    return true;
}

fn str_concat(a: i64, b: i64) -> i64 {
    let mut la: i64 = 0;
    let mut lb: i64 = 0;
    if a != 0 {
        la = rt_strlen(a);
    }
    if b != 0 {
        lb = rt_strlen(b);
    }
    let out = rt_malloc(la + lb + 1);
    if la > 0 {
        rt_copy(out, a, la);
    }
    if lb > 0 {
        rt_copy(out + la, b, lb);
    }
    store8(out + la + lb, 0);
    return out;
}

// Does `sub` occur in `s` at byte offset `at`? (`s` long enough or NUL-stopped)
fn rt_match_at(s: i64, at: i64, sub: i64) -> bool {
    let mut j: i64 = 0;
    while true {
        let y = load8(sub + j);
        if y == 0 {
            return true;
        }
        if load8(s + at + j) != y {
            return false;
        }
        j = j + 1;
    }
    return true;
}

// strstr as an index, or -1.
fn rt_find(s: i64, sub: i64) -> i64 {
    let first = load8(sub);
    if first == 0 {
        return 0;
    }
    let mut i: i64 = 0;
    while true {
        let ch = load8(s + i);
        if ch == 0 {
            return -1;
        }
        if ch == first && rt_match_at(s, i, sub) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn str_find(s: i64, sub: i64) -> i64 {
    if s == 0 || sub == 0 {
        return -1;
    }
    return rt_find(s, sub);
}

fn str_contains(s: i64, sub: i64) -> i64 {
    if s == 0 || sub == 0 {
        return 0;
    }
    if rt_find(s, sub) >= 0 {
        return 1;
    }
    return 0;
}

// atoll: leading space, optional sign, then digits.
fn str_to_int(s: i64) -> i64 {
    if s == 0 {
        return 0;
    }
    let mut p = s;
    while rt_is_space(load8(p)) {
        p = p + 1;
    }
    let mut neg = false;
    if load8(p) == 45 {
        neg = true;
        p = p + 1;
    } else if load8(p) == 43 {
        p = p + 1;
    }
    let mut n: i64 = 0;
    while rt_is_digit(load8(p)) {
        n = n * 10 - (load8(p) - 48);
        p = p + 1;
    }
    if neg {
        return n;
    }
    return 0 - n;
}

fn str_is_int(s: i64) -> i64 {
    if s == 0 || load8(s) == 0 {
        return 0;
    }
    let mut p = s;
    if load8(p) == 43 || load8(p) == 45 {
        p = p + 1;
    }
    if load8(p) == 0 {
        return 0;
    }
    while load8(p) != 0 {
        if !rt_is_digit(load8(p)) {
            return 0;
        }
        p = p + 1;
    }
    return 1;
}

fn int_to_str(val: i64) -> i64 { return rt_dup(rt_fmt_int(val)); }

fn str_starts_with(s: i64, prefix: i64) -> bool {
    if s == 0 || prefix == 0 {
        return false;
    }
    return rt_match_at(s, 0, prefix);
}

fn str_ends_with(s: i64, suffix: i64) -> bool {
    if s == 0 || suffix == 0 {
        return false;
    }
    let ls = rt_strlen(s);
    let lp = rt_strlen(suffix);
    if lp > ls {
        return false;
    }
    return rt_match_at(s, ls - lp, suffix);
}

fn str_substr(s: i64, start: i64, len: i64) -> i64 {
    if s == 0 || start < 0 || len <= 0 {
        return rt_dup_n("", 0);
    }
    let avail = rt_strnlen(s, start + len);
    if start >= avail {
        return rt_dup_n("", 0);
    }
    return rt_dup_n(s + start, avail - start);
}

fn str_trim(s: i64) -> i64 {
    if s == 0 {
        return rt_dup_n("", 0);
    }
    let mut p = s;
    while load8(p) != 0 && rt_is_space(load8(p)) {
        p = p + 1;
    }
    let mut len = rt_strlen(p);
    while len > 0 && rt_is_space(load8(p + len - 1)) {
        len = len - 1;
    }
    return rt_dup_n(p, len);
}

fn str_char_at(s: i64, idx: i64) -> i64 {
    if s == 0 || idx < 0 {
        return 0;
    }
    if rt_strnlen(s, idx + 1) <= idx {
        return 0;
    }
    return load8(s + idx);
}

// Copy a string's bytes into a collection for O(1) bounds-checked access.
fn track_str_bytes(s: i64) -> i64 {
    let mut len: i64 = 0;
    if s != 0 {
        len = rt_strlen(s);
    }
    let out = track_i64_collection_new(len + 1);
    let data = load64(out);
    let mut i: i64 = 0;
    while i < len {
        store64(data + 8 * i, load8(s + i));
        i = i + 1;
    }
    store64(out + 8, len);
    return out;
}

fn char_is_digit(ch: i64) -> bool { return rt_is_digit(ch); }
fn char_is_alpha(ch: i64) -> bool { return rt_is_alpha(ch); }
fn char_is_alphanumeric(ch: i64) -> bool { return rt_is_alpha(ch) || rt_is_digit(ch); }
fn char_is_space(ch: i64) -> bool { return rt_is_space(ch); }

fn char_to_upper(ch: i64) -> i64 {
    if ch >= 97 && ch <= 122 {
        return ch - 32;
    }
    return ch;
}

fn char_to_lower(ch: i64) -> i64 {
    if ch >= 65 && ch <= 90 {
        return ch + 32;
    }
    return ch;
}

// ------------------------------------------------------------------ paths

// Byte offset of the last `ch` in `s`, or -1.
fn rt_last_index(s: i64, ch: i64) -> i64 {
    let mut found: i64 = -1;
    let mut i: i64 = 0;
    while load8(s + i) != 0 {
        if load8(s + i) == ch {
            found = i;
        }
        i = i + 1;
    }
    return found;
}

fn path_basename(path: i64) -> i64 {
    if path == 0 {
        return rt_dup_n("", 0);
    }
    return rt_dup(path + rt_last_index(path, 47) + 1);
}

fn path_ext(path: i64) -> i64 {
    if path == 0 {
        return rt_dup_n("", 0);
    }
    let dot = rt_last_index(path, 46);
    if dot <= 0 {
        return rt_dup_n("", 0);
    }
    return rt_dup(path + dot + 1);
}

fn path_join(a: i64, b: i64) -> i64 {
    let mut pa: i64 = "";
    let mut pb: i64 = "";
    if a != 0 {
        pa = a;
    }
    if b != 0 {
        pb = b;
    }
    let la = rt_strlen(pa);
    let lb = rt_strlen(pb);
    let mut slash: i64 = 0;
    if la > 0 && load8(pa + la - 1) != 47 && (lb == 0 || load8(pb) != 47) {
        slash = 1;
    }
    let out = rt_malloc(la + slash + lb + 1);
    rt_copy(out, pa, la);
    if slash == 1 {
        store8(out + la, 47);
    }
    rt_copy(out + la + slash, pb, lb + 1);
    return out;
}
