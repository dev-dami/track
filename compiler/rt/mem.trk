// rt/mem.trk — Track runtime: process state, allocator, raw memory.
//
// The Track runtime replaces runtime/track_runtime.c with Track code that
// needs no libc: it talks to Linux through the `syscall6` builtin and
// reads and writes memory through `load64`/`store64`/`load8`/`store8`
// (docs/native.md). Every exported function keeps the name and word-ABI
// behaviour of its C counterpart, so generated code calls it unchanged.
//
// Track has no global variables, so the runtime keeps its state in one
// page mapped at the fixed address RT_BASE when the process starts.
// The rt modules have no imports: trackc loads all of them together.

const RT_BASE = 35184372088832;   // 0x200000000000, the runtime state page
const RT_STATE_SIZE = 8192;

// State fields (byte offsets from RT_BASE).
const RS_ARGC = 0;
const RS_ARGV = 8;
const RS_ENVP = 16;
const RS_HEAP = 24;               // bump pointer of the current arena
const RS_HEAP_END = 32;            // end of the populated part of the arena
const RS_USED = 40;               // bytes handed out by `alloc`
const RS_LIMIT = 48;              // `alloc` limit (sys_set_memory_limit)
const RS_RNG = 56;                // math_random state
const RS_OUTBUF = 64;             // stdout buffer
const RS_OUTLEN = 72;
const RS_ARENA_END = 80;          // end of the current arena mapping
const RS_POP_STEP = 88;           // bytes populated at the next step
const RS_NUM = 128;               // 32-byte scratch for number formatting
const RS_PIPE = 160;              // pipe(2) result: two 32-bit fds
const RS_TIME = 176;              // struct timespec
const RS_WAIT = 192;              // wait4 status
const RS_ONE = 200;               // the int 1, for setsockopt
const RS_FREE = 256;              // free-list heads, one per size class (64)
const RS_SOCK = 768;              // struct sockaddr_in
const RS_STAT = 1024;             // struct stat (144 bytes)
const RS_EXECV = 2048;            // argv for execve: 4 words
const RS_LC_N = 4096;             // freed large blocks kept for reuse
const RS_LC_BYTES = 4104;         // their total mapping length
const RS_LC_SLOTS = 4112;         // RT_LC_MAX mapping addresses, oldest first

const RT_OUT_CAP = 65536;
const RT_ARENA = 67108864;        // grow the heap 64 MiB at a time
const RT_SMALL_MAX = 65528;        // larger payloads get a mapping of their own
const RT_LARGE_TAG = 64;          // header class of such a block
const RT_LC_MAX = 16;             // large-block cache: at most this many ...
const RT_LC_CAP = 134217728;      // ... holding at most 128 MiB of mappings

const SYS_READ = 0;
const SYS_WRITE = 1;
const SYS_OPEN = 2;
const SYS_CLOSE = 3;
const SYS_STAT = 4;
const SYS_LSEEK = 8;
const SYS_MMAP = 9;
const SYS_MUNMAP = 11;
const SYS_MREMAP = 25;
const SYS_MADVISE = 28;
const MADV_POPULATE_WRITE = 23;
const MADV_HUGEPAGE = 14;
const RT_POP_MIN = 65536;
const RT_POP_MAX = 2097152;
const SYS_PIPE = 22;
const SYS_ACCESS = 21;
const SYS_GETPID = 39;
const SYS_FORK = 57;
const SYS_EXECVE = 59;
const SYS_WAIT4 = 61;
const SYS_KILL = 62;
const SYS_UNLINK = 87;
const SYS_CLOCK_GETTIME = 228;
const SYS_EXIT_GROUP = 231;

fn rs(off: i64) -> i64 { return load64(RT_BASE + off); }
fn rs_set(off: i64, v: i64) -> i64 { return store64(RT_BASE + off, v); }

fn sys0(nr: i64) -> i64 { return syscall6(nr, 0, 0, 0, 0, 0, 0); }
fn sys1(nr: i64, a: i64) -> i64 { return syscall6(nr, a, 0, 0, 0, 0, 0); }
fn sys2(nr: i64, a: i64, b: i64) -> i64 { return syscall6(nr, a, b, 0, 0, 0, 0); }
fn sys3(nr: i64, a: i64, b: i64, d: i64) -> i64 { return syscall6(nr, a, b, d, 0, 0, 0); }

fn rt_exit_now(code: i64) -> i64 {
    sys1(SYS_EXIT_GROUP, code);
    return 0;
}

// Anonymous private read/write mapping of `len` bytes; exits 137 on failure.
fn rt_mmap(len: i64) -> i64 {
    let p = syscall6(SYS_MMAP, 0, len, 3, 34, -1, 0);
    if p < 0 && p > -4096 {
        rt_oom("\nTrack Runtime Error: Out of memory allocation failure!\n");
    }
    return p;
}

fn rt_oom(msg: i64) -> i64 {
    rt_err_bytes(msg, rt_strlen(msg));
    rt_exit_now(137);
    return 0;
}

// Map the state page and record the process arguments.
fn track_runtime_init(argc: i64, argv: i64) -> i64 {
    // MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE
    let p = syscall6(SYS_MMAP, RT_BASE, RT_STATE_SIZE, 3, 1048610, -1, 0);
    if p != RT_BASE {
        rt_exit_now(137);
    }
    rs_set(RS_ARGC, argc);
    rs_set(RS_ARGV, argv);
    rs_set(RS_ENVP, argv + 8 * (argc + 1));
    rs_set(RS_LIMIT, 536870912);
    rs_set(RS_RNG, 0 - 8846114314301621463);
    rs_set(RS_OUTBUF, rt_mmap(RT_OUT_CAP));
    rs_set(RS_ONE, 1);
    return 0;
}

// ------------------------------------------------------------ allocator
//
// Every block has one header word before the payload:
// `requested_size << 8 | class`.
//
// Small blocks (up to 64 KiB with the header) are powers of two from 32
// bytes, class k = log2 of the block size. Freed ones go on a per-class
// free list (the next pointer lives in the first payload word). They are
// carved from 64 MiB arenas that are faulted in ahead of the bump pointer
// with MADV_POPULATE_WRITE (one call per step, not one fault per page);
// fresh arena memory is already zero.
//
// Large blocks get a mapping of their own, sized to the page, with class
// RT_LARGE_TAG and the mapping length in the word before the header.
// Growing one is an mremap that moves pages, not bytes. Freeing one keeps
// the mapping (already faulted in) in a small cache, the large-block
// cache, for the next large request: best fit, so a cached block may
// serve a smaller request, whose later growth then needs no syscall.
// The cache holds at most RT_LC_MAX blocks and RT_LC_CAP bytes; past
// either bound the oldest blocks go back to the kernel. Cached blocks
// are not in use: RS_USED never counts them.
//
// trackc --native inlines the arena bump path for constant sizes
// (ngen.trk ng_alloc_const): keep RS_HEAP, RS_HEAP_END, RS_FREE, RS_USED,
// RS_LIMIT, the header layout and the power-of-two classes in step with it.

fn rt_class(need: i64) -> i64 {
    let mut k: i64 = 5;
    while (1 << k) < need {
        k = k + 1;
    }
    return k;
}

fn rt_page_up(n: i64) -> i64 { return (n + 4095) & (0 - 4096); }

// Fault in [from, to) now, in one call: the pages are about to be written.
fn rt_prefault(from: i64, to: i64) -> i64 {
    if to > from {
        syscall6(SYS_MADVISE, from, to - from, MADV_POPULATE_WRITE, 0, 0, 0);
    }
    return 0;
}

// Payload of at least `size` bytes; zeroed when `zero` is true.
fn rt_block(size: i64, zero: bool) -> i64 {
    if size > RT_SMALL_MAX {
        return rt_large(size, zero);
    }
    let k = rt_class(size + 8);
    let slot = RS_FREE + 8 * k;
    let head = rs(slot);
    if head != 0 {
        rs_set(slot, load64(head));
        store64(head - 8, k);
        if zero {
            memset(head, 0, (1 << k) - 8);
        }
        return head;
    }
    let bsize = 1 << k;
    let mut cur = rs(RS_HEAP);
    if cur + bsize > rs(RS_HEAP_END) || cur == 0 {
        if cur == 0 || cur + bsize > rs(RS_ARENA_END) {
            cur = rt_mmap(RT_ARENA);
            syscall6(SYS_MADVISE, cur, RT_ARENA, MADV_HUGEPAGE, 0, 0, 0);
            rs_set(RS_ARENA_END, cur + RT_ARENA);
            rs_set(RS_HEAP_END, cur);
        }
        rt_populate(cur + bsize);
    }
    rs_set(RS_HEAP, cur + bsize);
    store64(cur, k);
    return cur + 8;
}

// Large block: [mapping length][header][payload ...]. A cached mapping
// is reused when one is big enough (zeroed up to `size` when `zero`);
// otherwise a fresh one, already zero, is mapped and faulted in.
fn rt_large(size: i64, zero: bool) -> i64 {
    let len = rt_page_up(size + 16);
    let mut big = rt_lc_take(len);
    if big != 0 {
        if zero {
            memset(big + 16, 0, size);
        }
    } else {
        big = rt_mmap(len);
        rt_prefault(big, big + len);
        store64(big, len);
    }
    store64(big + 8, (size << 8) | RT_LARGE_TAG);
    return big + 16;
}

// The smallest cached mapping of at least `len` bytes, taken out of the
// cache; 0 when none is big enough.
fn rt_lc_take(len: i64) -> i64 {
    let n = rs(RS_LC_N);
    let mut best: i64 = -1;
    let mut best_len: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        let m = load64(RT_BASE + RS_LC_SLOTS + 8 * i);
        let l = load64(m);
        if l >= len && (best < 0 || l < best_len) {
            best = i;
            best_len = l;
        }
        i = i + 1;
    }
    if best < 0 {
        return 0;
    }
    let m = load64(RT_BASE + RS_LC_SLOTS + 8 * best);
    rt_lc_remove(best);
    return m;
}

// Drop cache slot `i`, keeping the others in age order.
fn rt_lc_remove(i: i64) -> i64 {
    let n = rs(RS_LC_N);
    let at = RT_BASE + RS_LC_SLOTS;
    rs_set(RS_LC_BYTES, rs(RS_LC_BYTES) - load64(load64(at + 8 * i)));
    let mut j = i;
    while j + 1 < n {
        store64(at + 8 * j, load64(at + 8 * j + 8));
        j = j + 1;
    }
    rs_set(RS_LC_N, n - 1);
    return 0;
}

// Keep the freed mapping `m` for reuse, unmapping the oldest cached
// blocks past the cache's bounds (or `m` itself when it alone is past
// the byte bound).
fn rt_lc_put(m: i64) -> i64 {
    let len = load64(m);
    if len > RT_LC_CAP {
        syscall6(SYS_MUNMAP, m, len, 0, 0, 0, 0);
        return 0;
    }
    while rs(RS_LC_N) == RT_LC_MAX || rs(RS_LC_BYTES) + len > RT_LC_CAP {
        let old = load64(RT_BASE + RS_LC_SLOTS);
        let old_len = load64(old);
        rt_lc_remove(0);
        syscall6(SYS_MUNMAP, old, old_len, 0, 0, 0, 0);
    }
    let n = rs(RS_LC_N);
    store64(RT_BASE + RS_LC_SLOTS + 8 * n, m);
    rs_set(RS_LC_N, n + 1);
    rs_set(RS_LC_BYTES, rs(RS_LC_BYTES) + len);
    return 0;
}

// Fault in the arena ahead of the bump pointer, past at least `need`.
// Steps double from 64 KiB to 2 MiB, so small programs do not pay for
// memory they never touch. RS_HEAP_END marks the populated end: the
// inlined bump path falls back to `alloc` when it reaches it.
fn rt_populate(need: i64) -> i64 {
    let mut step = rs(RS_POP_STEP);
    if step < RT_POP_MIN {
        step = RT_POP_MIN;
    }
    let from = rs(RS_HEAP_END);
    let mut to = from + step;
    if to < need {
        to = rt_page_up(need);
    }
    if to > rs(RS_ARENA_END) {
        to = rs(RS_ARENA_END);
    }
    rt_prefault(from, to);
    rs_set(RS_HEAP_END, to);
    if step < RT_POP_MAX {
        rs_set(RS_POP_STEP, step * 2);
    }
    return 0;
}

fn rt_malloc(size: i64) -> i64 { return rt_block(size, false); }

fn rt_free(p: i64) -> i64 {
    if p == 0 {
        return 0;
    }
    let k = load64(p - 8) & 255;
    if k == RT_LARGE_TAG {
        rt_lc_put(p - 16);
        return 0;
    }
    let slot = RS_FREE + 8 * k;
    store64(p, rs(slot));
    rs_set(slot, p);
    return 0;
}

// Usable bytes of block `p`.
fn rt_capacity(p: i64) -> i64 {
    let k = load64(p - 8) & 255;
    if k == RT_LARGE_TAG {
        return load64(p - 16) - 16;
    }
    return (1 << k) - 8;
}

fn rt_realloc(p: i64, size: i64) -> i64 {
    if p == 0 {
        return rt_malloc(size);
    }
    let cap = rt_capacity(p);
    if size <= cap {
        return p;
    }
    if (load64(p - 8) & 255) == RT_LARGE_TAG {
        // A mapping of its own: the kernel moves the pages, and the grown
        // part (zero, and about to be filled) is faulted in in one call.
        let old = load64(p - 16);
        let len = rt_page_up(size + 16);
        let q = syscall6(SYS_MREMAP, p - 16, old, len, 1, 0, 0);
        if q < 0 && q > -4096 {
            rt_oom("\nTrack Runtime Error: Out of memory allocation failure!\n");
        }
        rt_prefault(q + old, q + len);
        store64(q, len);
        return q + 16;
    }
    let q = rt_malloc(size);
    rt_copy(q, p, cap);
    rt_free(p);
    return q;
}

// ------------------------------------------------------- raw memory ops

// x86-64 allows unaligned word access, so copy words whatever the
// alignment, four at a time in the bulk.
fn rt_copy(dst: i64, src: i64, n: i64) -> i64 {
    let mut i: i64 = 0;
    let quads = n & (0 - 32);
    while i < quads {
        let a = load64(src + i);
        let b = load64(src + i + 8);
        let c = load64(src + i + 16);
        let d = load64(src + i + 24);
        store64(dst + i, a);
        store64(dst + i + 8, b);
        store64(dst + i + 16, c);
        store64(dst + i + 24, d);
        i = i + 32;
    }
    let words = n & (0 - 8);
    while i < words {
        store64(dst + i, load64(src + i));
        i = i + 8;
    }
    while i < n {
        store8(dst + i, load8(src + i));
        i = i + 1;
    }
    return dst;
}

fn rt_zero(dst: i64, n: i64) -> i64 {
    if n > 0 {
        memset(dst, 0, n);
    }
    return dst;
}

// strlen, two words at a time once aligned (an aligned 16-byte pair
// holding a byte of the string never crosses into another page).
fn rt_strlen(s: i64) -> i64 {
    let mut p = s;
    while (p & 15) != 0 {
        if load8(p) == 0 {
            return p - s;
        }
        p = p + 1;
    }
    // One statement per operation with simple right operands, so the
    // native backend keeps everything in registers.
    let ones = 72340172838076673;          // 0x0101010101010101
    let highs = 0 - 9187201950435737472;   // 0x8080808080808080
    let m1: i64 = -1;
    let mut hit: i64 = 0;
    while hit == 0 {
        let v = load64(p);
        let u = load64(p + 8);
        let nv = m1 - v;
        let nu = m1 - u;
        let mut x = v - ones;
        x = x & nv;
        let mut y = u - ones;
        y = y & nu;
        x = x | y;
        hit = x & highs;
        p = p + 16;
    }
    p = p - 16;
    while load8(p) != 0 {
        p = p + 1;
    }
    return p - s;
}

// strnlen, a word at a time once aligned. An aligned word holding a byte
// of the string never crosses into another page, so reading it is safe.
fn rt_strnlen(s: i64, max: i64) -> i64 {
    if max <= 0 {
        return 0;
    }
    let end = s + max;
    let mut p = s;
    while (p & 7) != 0 {
        if p >= end {
            return max;
        }
        if load8(p) == 0 {
            return p - s;
        }
        p = p + 1;
    }
    let ones = 72340172838076673;          // 0x0101010101010101
    let highs = 0 - 9187201950435737472;   // 0x8080808080808080
    while p < end {
        let v = load64(p);
        if ((v - ones) & (0 - v - 1) & highs) != 0 {
            while load8(p) != 0 {
                p = p + 1;
            }
            if p - s < max {
                return p - s;
            }
            return max;
        }
        p = p + 8;
    }
    return max;
}

// New NUL-terminated copy of `n` bytes at `s`.
fn rt_dup_n(s: i64, n: i64) -> i64 {
    let out = rt_malloc(n + 1);
    if n > 0 {
        rt_copy(out, s, n);
    }
    store8(out + n, 0);
    return out;
}

fn rt_dup(s: i64) -> i64 {
    if s == 0 {
        return rt_dup_n("", 0);
    }
    return rt_dup_n(s, rt_strlen(s));
}

// ------------------------------------------------- counted allocation API

fn rt_limit_exceeded(requested: i64) -> i64 {
    let b = track_sb_new();
    track_sb_push(b, "\nTrack Runtime Error: Process memory boundary limit exceeded! (Allocated: ");
    track_sb_push_int(b, rs(RS_USED));
    track_sb_push(b, " bytes, Requested: ");
    track_sb_push_int(b, requested);
    track_sb_push(b, " bytes, Limit: ");
    track_sb_push_int(b, rs(RS_LIMIT));
    track_sb_push(b, " bytes)\n");
    rt_err_bytes(load64(b), track_sb_len(b));
    rt_exit_now(137);
    return 0;
}

fn sys_set_memory_limit(bytes: i64) -> i64 {
    if bytes > 0 {
        rs_set(RS_LIMIT, bytes);
    }
    return 0;
}

fn sys_get_memory_used() -> i64 { return rs(RS_USED); }

fn alloc(size: i64) -> i64 { return rt_alloc(size, true); }

// `alloc` without the zeroing: for blocks whose every payload word is
// written before any is read (cell literals and constructors, array
// copies). A reused block keeps its old bytes; fresh memory is zero anyway.
// trackc --native inlines it for constant sizes (ngen.trk ng_alloc_const).
fn track_alloc_nz(size: i64) -> i64 { return rt_alloc(size, false); }

fn rt_alloc(size: i64, zero: bool) -> i64 {
    if size <= 0 {
        return 0;
    }
    if rs(RS_USED) + size > rs(RS_LIMIT) {
        rt_limit_exceeded(size);
    }
    let p = rt_block(size, zero);
    store64(p - 8, (size << 8) | (load64(p - 8) & 255));
    rs_set(RS_USED, rs(RS_USED) + size);
    return p;
}

fn dealloc(p: i64) -> i64 {
    if p == 0 {
        return 0;
    }
    let size = load64(p - 8) >> 8;
    let used = rs(RS_USED);
    if used >= size {
        rs_set(RS_USED, used - size);
    } else {
        rs_set(RS_USED, 0);
    }
    rt_free(p);
    return 0;
}

fn mem_realloc(p: i64, new_size: i64) -> i64 {
    if p == 0 {
        return alloc(new_size);
    }
    if new_size <= 0 {
        return dealloc(p);
    }
    let old_size = load64(p - 8) >> 8;
    if rs(RS_USED) - old_size + new_size > rs(RS_LIMIT) {
        rt_limit_exceeded(new_size);
    }
    let q = rt_realloc(p, new_size);
    store64(q - 8, (new_size << 8) | (load64(q - 8) & 255));
    rs_set(RS_USED, rs(RS_USED) - old_size + new_size);
    return q;
}

// Copy `count` words to a fresh heap cell (escaping tuples).
fn track_words_copy(src: i64, count: i64) -> i64 {
    let mut bytes: i64 = 8;
    if count > 0 {
        bytes = count * 8;
    }
    if src == 0 || count <= 0 {
        return alloc(bytes);
    }
    let dst = track_alloc_nz(bytes);
    rt_copy(dst, src, count * 8);
    return dst;
}
