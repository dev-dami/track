// rt_stub/mod.trk — minimal Track runtime for testing the native backend
// until compiler/rt (card N1) lands. Same names and word ABI as
// runtime/track_runtime.c; only what the native tests need.
//
// State lives in a fixed anonymous mapping made by rt_start:
//   RT_BASE + 0   heap bump pointer
//   RT_BASE + 8   argc
//   RT_BASE + 16  argv
//   RT_HEAP...    heap (bump allocation, never freed)

import "more";

const RT_BASE = 268435456;      // 0x10000000
const RT_HEAP = 269484032;      // RT_BASE + 1 MiB
const RT_SPAN = 17179869184;    // 16 GiB, MAP_NORESERVE

fn rt_start(argc: i64, argv: i64) -> i64 {
    // mmap(RT_BASE, RT_SPAN, PROT_READ|PROT_WRITE,
    //      MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED|MAP_NORESERVE, -1, 0)
    syscall6(9, RT_BASE, RT_SPAN, 3, 16434, -1, 0);
    store64(RT_BASE, RT_HEAP);
    store64(RT_BASE + 8, argc);
    store64(RT_BASE + 16, argv);
    return 0;
}

fn sys_exit(code: i64) -> i64 {
    syscall6(60, code, 0, 0, 0, 0, 0);
    return 0;
}

fn os_args_count() -> i64 { return load64(RT_BASE + 8); }

fn os_arg(i: i64) -> i64 {
    if i < 0 || i >= os_args_count() {
        return str_concat("", "");
    }
    return str_concat(load64(load64(RT_BASE + 16) + i * 8), "");
}

// ------------------------------------------------------------- memory

fn alloc(size: i64) -> i64 {
    if size <= 0 {
        return 0;
    }
    let p: i64 = load64(RT_BASE);
    store64(RT_BASE, p + (size + 15) / 16 * 16);
    return p;
}

fn dealloc(p: i64) -> i64 { return 0; }

fn track_words_copy(src: i64, count: i64) -> i64 {
    let mut n: i64 = count;
    if n < 1 {
        n = 1;
    }
    let dst: i64 = alloc(n * 8);
    let mut i: i64 = 0;
    while i < count {
        store64(dst + i * 8, load64(src + i * 8));
        i = i + 1;
    }
    return dst;
}

// ------------------------------------------------------------- output

fn rt_write(fd: i64, s: i64) -> i64 {
    return syscall6(1, fd, s, str_len(s), 0, 0, 0);
}

fn rt_newline(fd: i64) -> i64 { return rt_write(fd, "\n"); }

// The C runtime prints a word as a string when it points at printable text.
fn rt_looks_like_text(v: i64) -> bool {
    if v < 65536 {
        return false;
    }
    // Readable? Write one byte to a pipe (EFAULT otherwise), as C does.
    let fds: i64 = alloc(16);
    syscall6(22, fds, 0, 0, 0, 0, 0);
    let rfd: i64 = load64(fds) & 4294967295;
    let wfd: i64 = (load64(fds) >> 32) & 4294967295;
    let ok: i64 = syscall6(1, wfd, v, 1, 0, 0, 0);
    syscall6(3, rfd, 0, 0, 0, 0, 0);
    syscall6(3, wfd, 0, 0, 0, 0, 0);
    if ok != 1 {
        return false;
    }
    let mut n: i64 = 0;
    while n < 4096 {
        let ch: i64 = load8(v + n);
        if ch == 0 {
            return n > 0;
        }
        if ch < 9 || (ch > 13 && ch < 32) || ch > 126 {
            return false;
        }
        n = n + 1;
    }
    return true;
}

fn print(v: i64) -> i64 {
    if rt_looks_like_text(v) {
        rt_write(1, v);
    } else {
        rt_write(1, int_to_str(v));
    }
    return rt_newline(1);
}

fn println(v: i64) -> i64 { return print(v); }

fn print_int(v: i64) -> i64 {
    rt_write(1, int_to_str(v));
    return rt_newline(1);
}

fn print_str(s: i64) -> i64 {
    rt_write(1, s);
    return rt_newline(1);
}

fn print_err(s: i64) -> i64 {
    rt_write(2, s);
    return rt_newline(2);
}

fn eprint(s: i64) -> i64 { return print_err(s); }
fn track_out(s: i64) -> i64 { return rt_write(1, s); }
fn track_err(s: i64) -> i64 { return rt_write(2, s); }

fn track_abort(msg: i64) -> i64 {
    rt_write(2, "Track abort: ");
    rt_write(2, msg);
    rt_newline(2);
    return sys_exit(134);
}

fn track_trap_div() -> i64 {
    // kill(getpid(), SIGFPE)
    syscall6(62, syscall6(39, 0, 0, 0, 0, 0, 0), 8, 0, 0, 0, 0);
    return sys_exit(136);
}

fn track_bad_field() -> i64 {
    return track_abort("field access on a value of the wrong struct type");
}

// ------------------------------------------------------------- arrays

fn rt_bounds(a: i64, i: i64) -> i64 {
    if a == 0 {
        track_abort("index into a null array");
    }
    if i < 0 || i >= load64(a) {
        track_abort("array index out of bounds");
    }
    return 0;
}

fn track_array_get(a: i64, i: i64) -> i64 {
    rt_bounds(a, i);
    return load64(a + 8 + i * 8);
}

fn track_array_set(a: i64, i: i64, v: i64) -> i64 {
    rt_bounds(a, i);
    store64(a + 8 + i * 8, v);
    return v;
}

fn track_array_slice(a: i64, from: i64, to: i64) -> i64 {
    let mut len: i64 = 0;
    if a != 0 {
        len = load64(a);
    }
    let mut end: i64 = to;
    if end < 0 {
        end = len;
    }
    if from < 0 || from > end || end > len {
        track_abort("array slice out of bounds");
    }
    let out: i64 = alloc((end - from + 1) * 8);
    store64(out, end - from);
    let mut i: i64 = 0;
    while i < end - from {
        store64(out + 8 + i * 8, load64(a + 8 + (from + i) * 8));
        i = i + 1;
    }
    return out;
}

fn array_len(a: i64) -> i64 {
    if a == 0 {
        return 0;
    }
    return load64(a);
}

// ------------------------------------------------------------- strings

fn str_len(s: i64) -> i64 {
    if s == 0 {
        return 0;
    }
    let mut n: i64 = 0;
    while load8(s + n) != 0 {
        n = n + 1;
    }
    return n;
}

fn str_eq(a: i64, b: i64) -> i64 {
    if a == 0 || b == 0 {
        if a == b {
            return 1;
        }
        return 0;
    }
    let mut i: i64 = 0;
    while true {
        let x: i64 = load8(a + i);
        if x != load8(b + i) {
            return 0;
        }
        if x == 0 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn rt_copy_bytes(dst: i64, src: i64, n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        store8(dst + i, load8(src + i));
        i = i + 1;
    }
    return 0;
}

fn str_concat(a: i64, b: i64) -> i64 {
    let la: i64 = str_len(a);
    let lb: i64 = str_len(b);
    let out: i64 = alloc(la + lb + 1);
    rt_copy_bytes(out, a, la);
    rt_copy_bytes(out + la, b, lb);
    store8(out + la + lb, 0);
    return out;
}

fn int_to_str(v: i64) -> i64 {
    let buf: i64 = alloc(24);
    let mut p: i64 = 23;
    store8(buf + p, 0);
    let mut x: i64 = v;
    if x == 0 {
        p = p - 1;
        store8(buf + p, 48);
    }
    while x != 0 {
        let mut d: i64 = x % 10;
        if d < 0 {
            d = 0 - d;
        }
        p = p - 1;
        store8(buf + p, 48 + d);
        x = x / 10;
    }
    if v < 0 {
        p = p - 1;
        store8(buf + p, 45);
    }
    return buf + p;
}

fn str_find(s: i64, sub: i64) -> i64 {
    let ls: i64 = str_len(s);
    let lt: i64 = str_len(sub);
    let mut i: i64 = 0;
    while i + lt <= ls {
        let mut j: i64 = 0;
        while j < lt && load8(s + i + j) == load8(sub + j) {
            j = j + 1;
        }
        if j == lt {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn str_to_int(s: i64) -> i64 {
    let mut i: i64 = 0;
    let mut neg: i64 = 0;
    while load8(s + i) == 32 {
        i = i + 1;
    }
    if load8(s + i) == 45 {
        neg = 1;
        i = i + 1;
    } else if load8(s + i) == 43 {
        i = i + 1;
    }
    let mut v: i64 = 0;
    while load8(s + i) >= 48 && load8(s + i) <= 57 {
        v = v * 10 + load8(s + i) - 48;
        i = i + 1;
    }
    if neg == 1 {
        return 0 - v;
    }
    return v;
}

// ------------------------------------------------------------- misc

fn add(a: i64, b: i64) -> i64 { return a + b; }
fn sum(a: i64, b: i64) -> i64 { return a + b; }

fn math_clamp(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo {
        return lo;
    }
    if v > hi {
        return hi;
    }
    return v;
}

// Vec handles: cells [len, cap, data].
fn vec_init(cap: i64) -> i64 {
    let mut n: i64 = cap;
    if n < 4 {
        n = 4;
    }
    let h: i64 = alloc(24);
    store64(h, 0);
    store64(h + 8, n);
    store64(h + 16, alloc(n * 8));
    return h;
}

fn vec_push(h: i64, v: i64) -> i64 {
    let len: i64 = load64(h);
    if len == load64(h + 8) {
        let bigger: i64 = alloc(len * 16);
        rt_copy_bytes(bigger, load64(h + 16), len * 8);
        store64(h + 16, bigger);
        store64(h + 8, len * 2);
    }
    store64(load64(h + 16) + len * 8, v);
    store64(h, len + 1);
    return 0;
}

fn vec_get(h: i64, i: i64) -> i64 {
    if i < 0 || i >= load64(h) {
        return 0;
    }
    return load64(load64(h + 16) + i * 8);
}

fn vec_len(h: i64) -> i64 { return load64(h); }

// ------------------------------------------------------------- files

fn file_exists(path: i64) -> i64 {
    if syscall6(21, path, 0, 0, 0, 0, 0) == 0 {
        return 1;
    }
    return 0;
}

// stat(2) into a scratch buffer; returns the buffer or 0.
fn rt_stat(path: i64) -> i64 {
    let st: i64 = alloc(256);
    if syscall6(4, path, st, 0, 0, 0, 0) != 0 {
        return 0;
    }
    return st;
}

fn file_size(path: i64) -> i64 {
    let st: i64 = rt_stat(path);
    if st == 0 {
        return -1;
    }
    return load64(st + 48);
}

fn dir_exists(path: i64) -> i64 {
    let st: i64 = rt_stat(path);
    if st == 0 {
        return 0;
    }
    if (load64(st + 24) & 61440) == 16384 {
        return 1;
    }
    return 0;
}

// xorshift64 with the C runtime's seed; state at RT_BASE + 24.
fn math_random() -> i64 {
    let mut x: i64 = load64(RT_BASE + 24);
    if x == 0 {
        x = -8846114314301621463;
    }
    x = rt_xor(x, x << 13);
    x = rt_xor(x, x >> 7);
    x = rt_xor(x, x << 17);
    store64(RT_BASE + 24, x);
    return x;
}

fn rt_xor(a: i64, b: i64) -> i64 { return (a | b) - (a & b); }
