// symbols.trk — program-wide declarations shared by the checker and the
// C emitter: functions, enum/union layouts, type aliases, and integer
// constants (evaluated in item order, as the bootstrap compiler does).

import "base";
import "ast";

// Compile-time integer evaluation. Returns (ok, value). A reference to a
// constant declared later evaluates it on demand (dependency order).
// NI_CONSTOK: 0 unevaluated, 1 integer ready, 2 being evaluated,
// 3 string constant (the C emitter inlines its literal).
fn const_eval(c: i64, n: i64) -> (i64, i64) {
    let k = nk(c, n);
    if k == K_INT {
        return (1, na(c, n));
    }
    if k == K_BOOL {
        return (1, na(c, n));
    }
    if k == K_VAR {
        let name = na(c, n);
        if ni(c, name, NI_CONSTOK) != 1 && ni(c, name, NI_CONST) >= 0 {
            eval_const_item(c, ni(c, name, NI_CONST));
        }
        if ni(c, name, NI_CONSTOK) == 1 {
            return (1, ni(c, name, NI_CONSTVAL));
        }
        let disc = variant_disc(c, name);
        if disc >= 0 && !is_payload_variant(c, name) {
            return (1, disc);
        }
        return (0, 0);
    }
    if k == K_UN {
        let (ok, v) = const_eval(c, nb(c, n));
        if na(c, n) == OP_NEG {
            return (ok, 0 - v);
        }
        if na(c, n) == OP_NOT {
            if v == 0 {
                return (ok, 1);
            }
            return (ok, 0);
        }
        return (0, 0);
    }
    if k == K_BIN {
        let op = na(c, n);
        let (lok, l) = const_eval(c, nb(c, n));
        let (rok, r) = const_eval(c, nc(c, n));
        if lok == 0 || rok == 0 {
            return (0, 0);
        }
        if (op == OP_DIV || op == OP_MOD) && r == 0 {
            fail_at(c, npos(c, n), "E0200", "division by zero in a constant expression");
        }
        if op == OP_ADD { return (1, l + r); }
        if op == OP_SUB { return (1, l - r); }
        if op == OP_MUL { return (1, l * r); }
        if op == OP_DIV { return (1, l / r); }
        if op == OP_MOD { return (1, l % r); }
        if op == OP_BAND { return (1, l & r); }
        if op == OP_BOR { return (1, l | r); }
        if op == OP_SHL { return (1, l << (r & 63)); }
        if op == OP_SHR { return (1, l >> (r & 63)); }
        if op == OP_EQ { return (1, bool_word(l == r)); }
        if op == OP_NEQ { return (1, bool_word(l != r)); }
        if op == OP_LT { return (1, bool_word(l < r)); }
        if op == OP_GT { return (1, bool_word(l > r)); }
        if op == OP_LTE { return (1, bool_word(l <= r)); }
        if op == OP_GTE { return (1, bool_word(l >= r)); }
        if op == OP_AND { return (1, bool_word(l != 0 && r != 0)); }
        if op == OP_OR { return (1, bool_word(l != 0 || r != 0)); }
        return (0, 0);
    }
    return (0, 0);
}

fn bool_word(b: bool) -> i64 {
    if b {
        return 1;
    }
    return 0;
}

// Evaluate the K_CONST item `n`. A string literal is kept as a string
// constant; anything else must fold to an integer or it is an error.
fn eval_const_item(c: i64, n: i64) -> i64 {
    let name = na(c, n);
    let state = ni(c, name, NI_CONSTOK);
    if state == 2 {
        return fail_at(c, npos(c, n), "E0200", text_cat3("constant '", name_text(c, name), "' depends on itself"));
    }
    if state != 0 {
        return 0;
    }
    ni_set(c, name, NI_CONSTOK, 2);
    let value = nb(c, n);
    if nk(c, value) == K_STR {
        ni_set(c, name, NI_CONSTOK, 3);
        return 0;
    }
    let (ok, v) = const_eval(c, value);
    if ok == 0 {
        return fail_at(c, npos(c, value), "E0200", text_cat3("constant '", name_text(c, name), "' is not a compile-time integer or string expression"));
    }
    ni_set(c, name, NI_CONSTOK, 1);
    ni_set(c, name, NI_CONSTVAL, v);
    return 0;
}

fn variant_name(c: i64, owner: i64, variant: i64) -> i64 {
    return intern(c, text_cat3(name_text(c, owner), "::", name_text(c, variant)));
}

// Record enum/union/alias/struct/function/constant declarations of every
// item. Later definitions of the same type name replace earlier ones.
fn collect_symbols(c: i64) -> i64 {
    return collect_symbols_from(c, 0);
}

// collect_symbols for the items loaded at index `from` onwards.
fn collect_symbols_from(c: i64, from: i64) -> i64 {
    let items = cx(c, CX_ITEMS);
    let mut i: i64 = from;
    while i < vlen(items) {
        let n = vget(items, i);
        let k = nk(c, n);
        if k == K_CONST {
            ni_set(c, na(c, n), NI_CONST, n);
        } else if k == K_ENUM {
            let name = na(c, n);
            ni_set(c, name, NI_TYPEKIND, 1);
            ni_set(c, name, NI_TYPENODE, n);
            let variants = nc(c, n);
            let mut next: i64 = 0;
            let mut j: i64 = 0;
            while j < list_len(c, variants) {
                let vname = variant_name(c, name, list_at(c, variants, j));
                let value = list_at(c, variants, j + 1);
                let mut disc = next;
                if value >= 0 {
                    let (ok, v) = const_eval(c, value);
                    if ok == 1 {
                        disc = v;
                    }
                }
                ni_set(c, vname, NI_VARIANT, disc);
                ni_set(c, vname, NI_OWNER, name);
                next = disc + 1;
                j = j + 2;
            }
        } else if k == K_UNION {
            let name = na(c, n);
            ni_set(c, name, NI_TYPEKIND, 2);
            ni_set(c, name, NI_TYPENODE, n);
            ni_set(c, name, NI_PAYLOAD, 0);
            let variants = nb(c, n);
            let mut j: i64 = 0;
            while j < list_len(c, variants) {
                let vname = variant_name(c, name, list_at(c, variants, j));
                ni_set(c, vname, NI_VARIANT, j / 2);
                ni_set(c, vname, NI_OWNER, name);
                if list_at(c, variants, j + 1) >= 0 {
                    ni_set(c, name, NI_PAYLOAD, 1);
                }
                j = j + 2;
            }
        } else if k == K_TYPEDEF {
            ni_set(c, na(c, n), NI_TYPEKIND, 4);
            ni_set(c, na(c, n), NI_TYPENODE, nb(c, n));
        } else if k == K_STRUCT {
            if ni(c, na(c, n), NI_TYPEKIND) != 3 {
                vpush(cx(c, CX_STRUCTS), na(c, n));
            }
            ni_set(c, na(c, n), NI_TYPEKIND, 3);
            ni_set(c, na(c, n), NI_TYPENODE, n);
        } else if k == K_FN || k == K_MACRODEF {
            let name = na(c, n);
            if ni(c, name, NI_FN) >= 0 {
                fail_at(c, npos(c, n), "E0201", text_cat3("duplicate definition of function '", name_text(c, name), "'"));
            }
            ni_set(c, name, NI_FN, n);
        }
        i = i + 1;
    }
    // Constants are evaluated after every declaration is known, so a
    // constant may refer to one declared later.
    let mut j: i64 = 0;
    while j < vlen(items) {
        let n = vget(items, j);
        if nk(c, n) == K_CONST && ni(c, na(c, n), NI_CONST) == n {
            eval_const_item(c, n);
        }
        j = j + 1;
    }
    return 0;
}

// Runtime isolation (card K3a). The Track runtime (compiler/rt/) is loaded
// after the user program, as items `from` on and nodes `node_from` on.
// A runtime function or constant whose name the program already defines
// is renamed to a fresh `__rt_<name>`, together with every call (or, for
// a constant, every use) inside the runtime: the program's calls keep
// reaching its own definition and the runtime's keep reaching the
// runtime's. Names the code generators call directly (`alloc`, `str_eq`,
// `track_*`...) cannot be split this way and stay E0201.
fn isolate_runtime(c: i64, from: i64, node_from: i64) -> i64 {
    let items = cx(c, CX_ITEMS);
    let olds = vnew();
    let news = vnew();
    let kinds = vnew();
    let mut i: i64 = from;
    while i < vlen(items) {
        let n = vget(items, i);
        let k = nk(c, n);
        let name = na(c, n);
        let mut taken = false;
        if k == K_FN || k == K_MACRODEF {
            taken = ni(c, name, NI_FN) >= 0;
        } else if k == K_CONST {
            taken = ni(c, name, NI_CONST) >= 0;
        }
        if taken && k == K_CONST && emitter_entry(name_text(c, name)) {
            // A reserved runtime constant (ngen reads it by name) cannot be
            // split; constants are not otherwise checked for duplicates.
            let user = ni(c, name, NI_CONST);
            fail_at(c, npos(c, user), "E0201", text_cat3("duplicate definition of constant '", name_text(c, name), "' (reserved by the runtime)"));
        }
        if taken && !emitter_entry(name_text(c, name)) {
            let fresh = fresh_runtime_name(c, name);
            vpush(olds, name);
            vpush(news, fresh);
            vpush(kinds, k);
            node_set_a(c, n, fresh);
        }
        i = i + 1;
    }
    if vlen(olds) == 0 {
        return 0;
    }
    let mut m: i64 = node_from;
    while m < node_count(c) {
        let k = nk(c, m);
        if k == K_CALL || k == K_VAR || k == K_MACROCALL {
            let j = index_of(olds, na(c, m));
            // A constant is read as a variable; a function is called.
            if j >= 0 && (vget(kinds, j) == K_CONST) == (k == K_VAR) {
                node_set_a(c, m, vget(news, j));
            }
        }
        m = m + 1;
    }
    return 0;
}

fn node_set_a(c: i64, n: i64, v: i64) -> i64 {
    return vset(cx(c, CX_NODES), n * N_WIDTH + 1, v);
}

fn index_of(v: i64, x: i64) -> i64 {
    let mut i: i64 = 0;
    while i < vlen(v) {
        if vget(v, i) == x {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// `__rt_<name>`, lengthened with `_` until nothing uses it.
fn fresh_runtime_name(c: i64, name: i64) -> i64 {
    let mut text = text_cat("__rt_", name_text(c, name));
    let mut id = intern(c, text);
    while ni(c, id, NI_FN) >= 0 || ni(c, id, NI_CONST) >= 0 {
        text = text_cat(text, "_");
        id = intern(c, text);
    }
    return id;
}

// Runtime names cgen/ngen call by name (allocation, string compare, array
// access, the entry point); a program defining one would capture those
// calls, so it stays a duplicate definition.
fn emitter_entry(n: i64) -> bool {
    return text_eq(n, "alloc") || text_eq(n, "dealloc") || text_eq(n, "str_eq")
        || text_eq(n, "str_len") || text_eq(n, "str_char_at") || text_eq(n, "array_len")
        || text_eq(n, "sys_exit") || text_eq(n, "rt_start") || text_eq(n, "memset")
        || text_eq(n, "main") || text_starts(n, "track_") || ng_layout_const(n);
}

// Runtime-state layout constants that ngen's inline alloc/free read by name
// (`ng_rt_const`); a user const of the same name must stay an E0201 clash.
fn ng_layout_const(n: i64) -> bool {
    return text_eq(n, "RT_BASE") || text_eq(n, "RS_USED") || text_eq(n, "RS_HEAP")
        || text_eq(n, "RS_LIMIT") || text_eq(n, "RS_HEAP_END") || text_eq(n, "RS_FREE");
}

// Discriminant of `Type::Variant`, or -1 when it is not a known variant.
fn variant_disc(c: i64, name: i64) -> i64 {
    if ni(c, name, NI_OWNER) < 0 {
        return -1;
    }
    return ni(c, name, NI_VARIANT);
}

fn is_payload_union(c: i64, name: i64) -> bool {
    return ni(c, name, NI_TYPEKIND) == 2 && ni(c, name, NI_PAYLOAD) == 1;
}

// True when `Type::Variant` belongs to a union with payload variants
// (its values are heap cells `[tag, payload...]`).
fn is_payload_variant(c: i64, name: i64) -> bool {
    let owner = ni(c, name, NI_OWNER);
    if owner < 0 {
        return false;
    }
    return is_payload_union(c, owner);
}

// Number of words of a tuple type (resolving aliases), or -1.
fn tuple_arity(c: i64, ty: i64) -> i64 {
    let mut t = ty;
    let mut depth: i64 = 0;
    while depth < 16 {
        if t < 0 {
            return -1;
        }
        if nk(c, t) == T_TUPLE {
            return list_len(c, na(c, t));
        }
        if nk(c, t) != T_CUSTOM {
            return -1;
        }
        if ni(c, na(c, t), NI_TYPEKIND) != 4 {
            return -1;
        }
        t = ni(c, na(c, t), NI_TYPENODE);
        depth = depth + 1;
    }
    return -1;
}

// Last `::` segment of a qualified name (the name itself if unqualified).
fn last_segment(c: i64, name: i64) -> i64 {
    let text = name_text(c, name);
    let bytes = text_bytes(text);
    let mut i: i64 = vlen(bytes) - 1;
    while i > 0 {
        if vget(bytes, i) == 58 && vget(bytes, i - 1) == 58 {
            return intern(c, str_substr(text, i + 1, vlen(bytes) - i - 1));
        }
        i = i - 1;
    }
    return name;
}

// Runtime tag in word 0 of a struct value (same hash as the Rust compiler).
fn struct_tag(c: i64, name: i64) -> i64 {
    return text_hash(name_text(c, name));
}

// The K_STRUCT node declaring `name`, or -1.
fn struct_def(c: i64, name: i64) -> i64 {
    if ni(c, name, NI_TYPEKIND) != 3 {
        return -1;
    }
    return ni(c, name, NI_TYPENODE);
}

// Index of `field` among the fields of struct node `s`, or -1.
fn struct_field_index(c: i64, s: i64, field: i64) -> i64 {
    let fields = nb(c, s);
    let mut i: i64 = 0;
    while i < list_len(c, fields) {
        if list_at(c, fields, i) == field {
            return i / 2;
        }
        i = i + 2;
    }
    return -1;
}

// Flattened (tag, index) pairs of every struct declaring `field`.
fn field_candidates(c: i64, field: i64) -> i64 {
    let out = vnew();
    let structs = cx(c, CX_STRUCTS);
    let mut i: i64 = 0;
    while i < vlen(structs) {
        let name = vget(structs, i);
        let idx = struct_field_index(c, struct_def(c, name), field);
        if idx >= 0 {
            vpush(out, struct_tag(c, name));
            vpush(out, idx);
        }
        i = i + 1;
    }
    return out;
}

fn is_qualified(c: i64, name: i64) -> bool {
    return vget(cx(c, CX_QUAL), name) == 1;
}
