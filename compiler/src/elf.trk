// elf.trk — static ELF64 executable writer for the native backend.
//
// The image is one PT_LOAD segment (read/write/execute) mapped at
// ELF_BASE: the 64-byte ELF header, two 56-byte program headers (the
// PT_LOAD and a PT_GNU_STACK asking for a non-executable stack), then the
// code and data bytes. No sections, no dynamic linker, no libc. Files are
// written with `open64`/`write`/`fchmod`/`close` and `memset` so the bytes
// may hold NULs. These libc names link from libc on the C path and under
// the Rust bootstrap compiler (which knows no machine builtins); the
// native backend lowers each straight to a Linux system call or
// `rep stosb`.

import "base";
import "x64";

const ELF_BASE = 4194304;   // 0x400000
const ELF_HEADERS = 176;    // ELF header + two program headers

fn elf_u16(b: i64, v: i64) -> i64 {
    x_byte(b, v);
    return x_byte(b, v >> 8);
}

// The ELF and program headers (ELF_HEADERS bytes) of the executable whose
// code+data `body` (byte vector) has the entry point at body offset
// `entry`. The body follows the headers in the file (elf_write_file).
fn elf_headers(body: i64, entry: i64) -> i64 {
    let b = vnew_cap(ELF_HEADERS);
    // e_ident
    x_byte(b, 127);
    x_byte(b, 69);
    x_byte(b, 76);
    x_byte(b, 70);
    x_byte(b, 2);   // ELFCLASS64
    x_byte(b, 1);   // little endian
    x_byte(b, 1);   // EV_CURRENT
    x_byte(b, 0);   // System V ABI
    x_u64(b, 0);
    elf_u16(b, 2);  // ET_EXEC
    elf_u16(b, 62); // EM_X86_64
    x_u32(b, 1);
    x_u64(b, ELF_BASE + ELF_HEADERS + entry);
    x_u64(b, 64);   // e_phoff
    x_u64(b, 0);    // e_shoff
    x_u32(b, 0);    // e_flags
    elf_u16(b, 64); // e_ehsize
    elf_u16(b, 56); // e_phentsize
    elf_u16(b, 2);  // e_phnum
    elf_u16(b, 0);
    elf_u16(b, 0);
    elf_u16(b, 0);
    // program header: PT_LOAD, RWX, whole file
    let size = ELF_HEADERS + vlen(body);
    x_u32(b, 1);
    x_u32(b, 7);
    x_u64(b, 0);
    x_u64(b, ELF_BASE);
    x_u64(b, ELF_BASE);
    x_u64(b, size);
    x_u64(b, size);
    x_u64(b, 4096);
    // program header: PT_GNU_STACK, RW (the stack is not executable)
    x_u32(b, 1685382481);
    x_u32(b, 6);
    let mut z: i64 = 0;
    while z < 5 {
        x_u64(b, 0);
        z = z + 1;
    }
    x_u64(b, 16);
    return b;
}

// Write the executable with code+data `body` (byte vector, entry at
// offset 0) to `path` with mode 0755. Returns 0 on success.
fn elf_write_file(path: i64, body: i64) -> i64 {
    let head = elf_headers(body, 0);
    let h = vlen(head);
    let n = h + vlen(body);
    let buf: i64 = alloc(n + 8);
    let mut i: i64 = 0;
    while i < h {
        memset(buf + i, vget(head, i), 1);
        i = i + 1;
    }
    while i < n {
        memset(buf + i, vget(body, i - h), 1);
        i = i + 1;
    }
    // open(path, O_WRONLY|O_CREAT|O_TRUNC, 0755)
    let fd: i64 = open64(path, 577, 493);
    if fd < 0 {
        return 1;
    }
    fchmod(fd, 493);
    let mut done: i64 = 0;
    while done < n {
        let w: i64 = write(fd, buf + done, n - done);
        if w <= 0 {
            close(fd);
            return 1;
        }
        done = done + w;
    }
    close(fd);
    return 0;
}
