// life.trk — value lifecycles: origin sets and per-function summaries.
//
// Runs after `check_program` on accepted programs (docs/lifecycles.md §1).
// One forward walk per function keeps an origin set per variable slot
// (checker field V_ORIGIN) and records, per parameter, how the function
// uses it (none < read < mutate) and how its life ends ({die, ret, esc}),
// plus the origin of the result.
//
// An origin set is one word: bits 0..59 are parameters ("derived from
// parameter k"), then FRESH, STATIC and UNKNOWN. Joins are `|`. Copy
// values (integers, bools) have the empty origin.
//
// Calls use the callee's summary (card L4, docs/lifecycles.md §1.3-1.4).
// `life_program` builds the call graph, orders it into strongly connected
// components (Tarjan, callees first) and iterates each recursive component
// from bottom until no member's summary changes. Runtime functions get
// their summary from a fixed table (`rt_summaries`); a callee that is
// neither a program function nor in the table stays conservative: it may
// mutate every `&` argument, every by-value argument escapes, and a
// non-copy result is UNKNOWN plus whatever its arguments carry.
//
// Generics: a template is analysed once, with its type parameters treated
// as opaque linear values (tracked). That over-approximates the join over
// its instantiations (docs/lifecycles.md §1.4 step 6): an instantiation
// with a Copy argument passes the empty origin at the call site, so the
// extra facts cost nothing there. trackc emits one function per template,
// so one summary per template is what the backends need.

import "base";
import "ast";
import "symbols";
import "checker";

const O_FRESH = 1152921504606846976;   // 1 << 60
const O_STATIC = 2305843009213693952;  // 1 << 61
const O_UNKNOWN = 4611686018427387904; // 1 << 62
const O_PARAMS = 1152921504606846975;  // bits 0..59
const O_MAXPARAMS = 60;
// Path flag on a reference slot whose target's block has ended (E0213).
// Stripped when the slot is read, so it never reaches a summary.
const O_DANGLE = 0 - 9223372036854775807 - 1; // 1 << 63

const U_NONE = 0;
const U_READ = 1;
const U_MUT = 2;

const E_DIE = 1;
const E_RET = 2;
const E_ESC = 4;

const LF_EFFECT = 1; // the function calls something (L4 refines to effects)

// Per-function walk state.
const LS_BASE = 0;   // first slot of the function (its first parameter)
const LS_NP = 1;     // parameter count
const LS_USE = 2;    // vector: use level per parameter
const LS_END = 3;    // vector: end set per parameter
const LS_OWNED = 4;  // bits of by-value, non-copy parameters
const LS_REFS = 5;   // bits of `&T` parameters
const LS_LIVE = 6;   // owned parameter bits still owned on the current path
const LS_RES = 7;    // result origin
const LS_FLAGS = 8;
const LS_RTRACK = 9; // 1 when the result type carries an origin
const LS_WIDTH = 10;

// Summary table (checker slot CK_LIFE): [records, record offset by name,
// runtime records, runtime record offset by name, callee cache by name].
// A record is [fn node (-1 for a runtime function), param count, result,
// flags, recursive component size (0 when not recursive), fixpoint passes,
// (use, end) per param].
const LR_FN = 0;
const LR_NP = 1;
const LR_RES = 2;
const LR_FLAGS = 3;
const LR_SCC = 4;
const LR_PASSES = 5;
const LR_PARAMS = 6;

const LT_RECS = 0;
const LT_BYNAME = 1;
const LT_RTRECS = 2;
const LT_RTBYNAME = 3;
const LT_CALLEE = 4;
const LT_READ = 5;  // by record offset: 1 when a call read it since its last change
const LT_STALE = 6; // 1 when a pass changed a summary some call had already read
// Hard errors (card L5, see "hard errors" below).
const LT_ERR = 7;     // first hard error found: [pos, code, message], or 0
const LT_TWICE = 8;   // by record offset: latent E0214 of a `&` param, or 0
const LT_CUR = 9;     // record offset of the function being walked
const LT_POINTS = 10; // (ref slot, target slot) pairs from `r = &x`
const LT_DANGLE = 11; // (ref slot, target name, block end pos) of dangling refs
const LT_BSTART = 12; // first slot of the innermost block being walked
const LT_HOLDS = 13;  // (slot, local slot) of non-ref locals bound to a literal holding `&local`

// Callee cache values: >= 0 is a program record offset, <= C_RT0 a runtime
// record (offset C_RT0 - value), C_UNKNOWN a conservative callee.
const C_UNSET = -1;
const C_UNKNOWN = -2;
const C_RT0 = -3;

fn lsg(s: i64, i: i64) -> i64 { return vget(s, i); }
fn lsg_set(s: i64, i: i64, x: i64) -> i64 { return vset(s, i, x); }

fn bit_clear(x: i64, m: i64) -> i64 { return x - (x & m); }

// True when values of type `ty` carry an origin: non-copy values and
// references. Unknown types are tracked, so nothing is lost.
fn life_tracked(c: i64, ty: i64) -> bool {
    if ty < 0 || ty == ck(c, CK_TY_UNK) {
        return true;
    }
    if ty_is_ref(c, ty) {
        return true;
    }
    return !ty_is_copy(c, ty);
}

fn param_bit(k: i64) -> i64 {
    if k >= O_MAXPARAMS {
        return O_UNKNOWN;
    }
    return 1 << k;
}

// Raise the use level of every parameter in `o` to at least `level`.
fn touch(s: i64, o: i64, level: i64) -> i64 {
    if (o & O_PARAMS) == 0 {
        return 0;
    }
    let uses = lsg(s, LS_USE);
    let mut k: i64 = 0;
    while k < lsg(s, LS_NP) && k < O_MAXPARAMS {
        if ((o >> k) & 1) == 1 && vget(uses, k) < level {
            vset(uses, k, level);
        }
        k = k + 1;
    }
    return 0;
}

fn end_add(s: i64, o: i64, e: i64) -> i64 {
    if (o & O_PARAMS) == 0 {
        return 0;
    }
    let ends = lsg(s, LS_END);
    let mut k: i64 = 0;
    while k < lsg(s, LS_NP) && k < O_MAXPARAMS {
        if ((o >> k) & 1) == 1 {
            vset(ends, k, vget(ends, k) | e);
        }
        k = k + 1;
    }
    return 0;
}

// `o` leaves the frame for good (stored in caller-owned memory, or moved
// into a callee that may keep it).
fn sink_esc(s: i64, o: i64) -> i64 {
    end_add(s, o, E_ESC);
    lsg_set(s, LS_LIVE, bit_clear(lsg(s, LS_LIVE), o));
    return 0;
}

// The function exits returning `o`: those origins end by `ret`, every
// other owned parameter still live dies here.
fn exit_with(s: i64, value: i64) -> i64 {
    let mut o = value;
    if lsg(s, LS_RTRACK) == 0 {
        o = 0;
    }
    lsg_set(s, LS_RES, lsg(s, LS_RES) | o);
    end_add(s, o, E_RET);
    end_add(s, bit_clear(lsg(s, LS_LIVE), o), E_DIE);
    return 0;
}

// ------------------------------------------------------------ path state

fn slot_origin(c: i64, slot: i64) -> i64 { return vf(c, slot, V_ORIGIN); }
fn slot_origin_set(c: i64, slot: i64, o: i64) -> i64 { return vf_set(c, slot, V_ORIGIN, o); }

// [live bits, origin of each function slot]
fn life_save(c: i64, s: i64) -> i64 {
    let base = lsg(s, LS_BASE);
    let n = var_count(c);
    let st = vnew_cap(n - base + 1);
    vpush(st, lsg(s, LS_LIVE));
    let mut slot = base;
    while slot < n {
        vpush(st, slot_origin(c, slot));
        slot = slot + 1;
    }
    return st;
}

fn life_restore(c: i64, s: i64, st: i64) -> i64 {
    let base = lsg(s, LS_BASE);
    lsg_set(s, LS_LIVE, vget(st, 0));
    let mut i: i64 = 1;
    while i < vlen(st) {
        slot_origin_set(c, base + i - 1, vget(st, i));
        i = i + 1;
    }
    return 0;
}

fn life_join(c: i64, s: i64, st: i64) -> i64 {
    let base = lsg(s, LS_BASE);
    lsg_set(s, LS_LIVE, lsg(s, LS_LIVE) | vget(st, 0));
    let mut i: i64 = 1;
    while i < vlen(st) {
        let slot = base + i - 1;
        slot_origin_set(c, slot, slot_origin(c, slot) | vget(st, i));
        i = i + 1;
    }
    return 0;
}

// ------------------------------------------------------------- the walk

fn var_origin(c: i64, s: i64, name: i64) -> i64 {
    let slot = lookup(c, name);
    if slot < 0 {
        return 0;
    }
    if slot < lsg(s, LS_BASE) {
        // A global: constants and variants live forever.
        if life_tracked(c, vf(c, slot, V_TYPE)) {
            return O_STATIC;
        }
        return 0;
    }
    return slot_origin(c, slot);
}

// A value in a move position (returned, bound, stored, passed by value).
// A bare variable there is moved, not used (docs/lifecycles.md §1.1:
// `read` is a field load or a `&` pass), so it raises no use level.
fn ev_move(c: i64, s: i64, n: i64) -> i64 {
    if n >= 0 && nk(c, n) == K_VAR {
        return live_var_origin(c, s, n);
    }
    return ev(c, s, n);
}

// Origin of a value whose type is `ty`, given the origin of what holds it.
fn through(c: i64, n: i64, o: i64) -> i64 {
    if life_tracked(c, infer_type(c, n)) {
        return o;
    }
    return 0;
}

// Origin of the walked block's last value. Block-local slots are dropped.
fn walk_block(c: i64, s: i64, body: i64) -> i64 {
    let count = var_count(c);
    let table = ck(c, CK_LIFE);
    let outer = vget(table, LT_BSTART);
    vset(table, LT_BSTART, count);
    let mut v: i64 = 0;
    let mut i: i64 = 0;
    while i < list_len(c, body) {
        let n = list_at(c, body, i);
        v = ev_move(c, s, n);
        if nk(c, n) == K_RETURN {
            i = list_len(c, body);
        }
        i = i + 1;
    }
    if vlen(vget(table, LT_POINTS)) > 0 && list_len(c, body) > 0 {
        refs_outlive_block(c, count, npos(c, list_at(c, body, list_len(c, body) - 1)));
    }
    if vlen(vget(table, LT_HOLDS)) > 0 {
        holds_close(c, count);
    }
    vset(table, LT_BSTART, outer);
    truncate_vars(c, count);
    return v;
}

// Bind a pattern's names as `bind_pattern` does, all sharing origin `o`.
fn bind_origin(c: i64, p: i64, ty: i64, mutable: i64, o: i64) -> i64 {
    let first = var_count(c);
    bind_pattern(c, p, ty, mutable);
    let mut slot = first;
    while slot < var_count(c) {
        if life_tracked(c, vf(c, slot, V_TYPE)) {
            slot_origin_set(c, slot, o);
        }
        slot = slot + 1;
    }
    return 0;
}

fn ev_list(c: i64, s: i64, l: i64, from: i64, step: i64) -> i64 {
    let mut o: i64 = 0;
    let mut i = from;
    while i < list_len(c, l) {
        o = o | ev_move(c, s, list_at(c, l, i));
        i = i + step;
    }
    return o;
}

// The K_FN node a call's name resolves to, or -1.
fn callee_fn(c: i64, name: i64) -> i64 {
    let mut f = ni(c, name, NI_FN);
    if f < 0 {
        f = ni(c, last_segment(c, name), NI_FN);
    }
    if f >= 0 && nk(c, f) == K_FN {
        return f;
    }
    return -1;
}

// Resolve a call's name to its summary: a program function's record, a
// runtime table record, or C_UNKNOWN. Cached per name id.
fn life_callee(c: i64, name: i64) -> i64 {
    let table = ck(c, CK_LIFE);
    let cache = vget(table, LT_CALLEE);
    if name < 0 || name >= vlen(cache) {
        return C_UNKNOWN;
    }
    let hit = vget(cache, name);
    if hit != C_UNSET {
        return hit;
    }
    let mut v = C_UNKNOWN;
    let f = callee_fn(c, name);
    if f >= 0 {
        let at = life_summary(c, na(c, f));
        if at >= 0 {
            v = at;
        }
    } else {
        let rt = vget(table, LT_RTBYNAME);
        let mut at = vget(rt, name);
        if at < 0 {
            let key = last_segment(c, name);
            if key < vlen(rt) {
                at = vget(rt, key);
            }
        }
        if at >= 0 {
            v = C_RT0 - at;
        }
    }
    vset(cache, name, v);
    return v;
}

fn ev_call(c: i64, s: i64, n: i64) -> i64 {
    let name = na(c, n);
    let args = nb(c, n);
    let callee = life_callee(c, name);
    // The callee's summary, if any: record vector, offset, parameter
    // count, result origin; and its parameter list for program functions.
    let mut recs: i64 = -1;
    let mut at: i64 = 0;
    let mut params: i64 = -1;
    if callee >= 0 {
        let table = ck(c, CK_LIFE);
        recs = vget(table, LT_RECS);
        at = callee;
        params = nc(c, vget(recs, at + LR_FN));
        // Seen by the fixpoint: a later change makes this pass stale.
        vset(vget(table, LT_READ), at, 1);
    } else if callee <= C_RT0 {
        recs = vget(ck(c, CK_LIFE), LT_RTRECS);
        at = C_RT0 - callee;
    }
    let mut np: i64 = 0;
    let mut r: i64 = O_UNKNOWN;
    if recs >= 0 {
        np = vget(recs, at + LR_NP);
        r = vget(recs, at + LR_RES);
    }
    lsg_set(s, LS_FLAGS, lsg(s, LS_FLAGS) | LF_EFFECT);
    let mut res = r & (O_FRESH | O_STATIC | O_UNKNOWN);
    let mut i: i64 = 0;
    while i < list_len(c, args) {
        let a = list_at(c, args, i);
        let mut pty: i64 = -1;
        if params >= 0 && i * 2 + 1 < list_len(c, params) {
            pty = list_at(c, params, i * 2 + 1);
        } else {
            pty = infer_type(c, a);
        }
        let is_ref = ty_is_ref(c, pty);
        let mut o: i64 = 0;
        if is_ref {
            o = ev(c, s, a);
        } else {
            o = ev_move(c, s, a);
        }
        if i < np {
            // The callee's summary of parameter i (docs/lifecycles.md §1.3).
            let pu = vget(recs, at + LR_PARAMS + i * 2);
            let pe = vget(recs, at + LR_PARAMS + i * 2 + 1);
            if params >= 0 {
                check_twice_at_call(c, at, i, a);
                check_tuple_twice(c, s, a, pty);
            }
            if is_ref {
                // Lending is a read; the callee may raise it to mutate.
                touch(s, o, U_READ);
                touch(s, o, pu);
                if (pe & E_ESC) != 0 {
                    sink_esc(s, o);
                }
            } else if life_tracked(c, pty) {
                if (pe & (E_DIE | E_ESC)) != 0 && params >= 0 {
                    check_lent_consumed(c, s, name, vget(recs, at + LR_FN), i, a);
                }
                // The callee uses the same value, so its use is ours. A
                // borrowed value stays the lender's and is read.
                touch(s, o & lsg(s, LS_REFS), U_READ);
                touch(s, o, pu);
                if (pe & E_ESC) != 0 {
                    sink_esc(s, o);
                } else if pe == 0 {
                    // The callee never ends it: it diverges, or its
                    // summary is still bottom in a recursive component.
                    lsg_set(s, LS_LIVE, bit_clear(lsg(s, LS_LIVE), o));
                } else if (pe & E_DIE) != 0 {
                    // die: the caller ends it after the call (caller-ends
                    // convention), so an owned value stays live here. A
                    // borrowed one would be ended by a frame that only
                    // borrowed it (E0211's root cause): record the die.
                    end_add(s, o & lsg(s, LS_REFS), E_DIE);
                }
                // ret: the result carries it, below.
            }
            if i < O_MAXPARAMS && ((r >> i) & 1) == 1 {
                res = res | o;
            }
        } else if is_ref {
            touch(s, o, U_MUT);
            res = res | o | O_UNKNOWN;
        } else if life_tracked(c, pty) {
            // A moved owned value is the callee's now, but a borrowed one
            // stays the lender's: the callee may read through it.
            touch(s, o & lsg(s, LS_REFS), U_READ);
            sink_esc(s, o);
            res = res | o | O_UNKNOWN;
        }
        i = i + 1;
    }
    if !life_tracked(c, call_type(c, name, args)) {
        return 0;
    }
    return res;
}

// Variable at the base of a place (`a.b.0[i]`, `*r`), or -1.
fn place_var(c: i64, n: i64) -> i64 {
    let k = nk(c, n);
    if k == K_VAR {
        return na(c, n);
    }
    if k == K_FIELD || k == K_TINDEX || k == K_INDEX {
        return place_var(c, na(c, n));
    }
    if k == K_UN && na(c, n) == OP_DEREF {
        return place_var(c, nb(c, n));
    }
    return -1;
}

// Index expressions inside a place are plain reads.
fn ev_place_indices(c: i64, s: i64, n: i64) -> i64 {
    let k = nk(c, n);
    if k == K_INDEX {
        ev(c, s, nb(c, n));
    }
    if k == K_FIELD || k == K_TINDEX || k == K_INDEX {
        return ev_place_indices(c, s, na(c, n));
    }
    if k == K_UN {
        return ev_place_indices(c, s, nb(c, n));
    }
    return 0;
}

fn ev_assign(c: i64, s: i64, n: i64) -> i64 {
    let target = na(c, n);
    let o = ev_move(c, s, nb(c, n));
    let name = place_var(c, target);
    if name < 0 {
        sink_esc(s, o);
        return 0;
    }
    let slot = lookup(c, name);
    if slot < lsg(s, LS_BASE) {
        sink_esc(s, o);
        return 0;
    }
    let mut ro = slot_origin(c, slot);
    if nk(c, target) == K_VAR && vf(c, slot, V_LENS) == 0 {
        // Rebinding: the old value dies (it stays in LIVE until the exit).
        if life_tracked(c, vf(c, slot, V_TYPE)) {
            slot_origin_set(c, slot, o);
        }
        if ty_is_ref(c, vf(c, slot, V_TYPE)) {
            ref_rebound(c, slot, nb(c, n));
        } else {
            holds_bind(c, s, slot, nb(c, n));
        }
        return 0;
    }
    if ro < 0 {
        // A store through a reference whose target is gone.
        dangling_use(c, slot, target);
        ro = bit_clear(ro, O_DANGLE);
    }
    // A store through the place (or a whole write through a lens).
    ev_place_indices(c, s, target);
    touch(s, ro, U_MUT);
    if (ro & (lsg(s, LS_REFS) | O_STATIC | O_UNKNOWN)) != 0 {
        sink_esc(s, o);
    } else {
        slot_origin_set(c, slot, ro | o);
    }
    return 0;
}

fn ev_if(c: i64, s: i64, n: i64) -> i64 {
    ev(c, s, na(c, n));
    let pre = life_save(c, s);
    let vt = walk_block(c, s, nb(c, n));
    let then_div = body_diverges(c, nb(c, n));
    let post_then = life_save(c, s);
    life_restore(c, s, pre);
    let ve = walk_block(c, s, nc(c, n));
    let else_div = body_diverges(c, nc(c, n));
    if else_div && !then_div {
        life_restore(c, s, post_then);
        return vt;
    }
    if then_div && !else_div {
        return ve;
    }
    life_join(c, s, post_then);
    return vt | ve;
}

fn ev_match(c: i64, s: i64, n: i64) -> i64 {
    let target = na(c, n);
    let ot = ev(c, s, target);
    let mut tt = infer_type(c, target);
    if tt < 0 {
        tt = ck(c, CK_TY_UNK);
    }
    let arms = nb(c, n);
    let pre = life_save(c, s);
    let mut joined: i64 = -1;
    let mut v: i64 = 0;
    let mut i: i64 = 0;
    while i < list_len(c, arms) {
        life_restore(c, s, pre);
        let count = var_count(c);
        bind_origin(c, list_at(c, arms, i), tt, 0, ot);
        let guard = list_at(c, arms, i + 1);
        if guard >= 0 {
            ev(c, s, guard);
        }
        let body = list_at(c, arms, i + 2);
        let vb = ev(c, s, body);
        truncate_vars(c, count);
        if !node_diverges(c, body) {
            v = v | vb;
            if joined < 0 {
                joined = life_save(c, s);
            } else {
                life_join(c, s, joined);
                joined = life_save(c, s);
            }
        }
        i = i + 3;
    }
    if joined >= 0 {
        life_restore(c, s, joined);
    } else {
        life_restore(c, s, pre);
    }
    return v;
}

// True when the current path state equals the saved `st`.
fn life_same(c: i64, s: i64, st: i64) -> bool {
    if lsg(s, LS_LIVE) != vget(st, 0) {
        return false;
    }
    let base = lsg(s, LS_BASE);
    let mut i: i64 = 1;
    while i < vlen(st) {
        if slot_origin(c, base + i - 1) != vget(st, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Loops: each pass walks the body from the join of the state before the
// loop (zero iterations) and every earlier pass, until a pass changes
// nothing. A value can need one pass per hop to reach a slot (an n-way
// rotation needs n - 1), so no fixed pass count is enough. Joins only add
// bits, so the passes are bounded by slots x bits; once the state repeats,
// another pass would record the same use and end facts again.
fn ev_while(c: i64, s: i64, n: i64) -> i64 {
    let mut done = false;
    while !done {
        let pre = life_save(c, s);
        ev(c, s, na(c, n));
        walk_block(c, s, nb(c, n));
        life_join(c, s, pre);
        done = life_same(c, s, pre);
    }
    return 0;
}

fn ev_for(c: i64, s: i64, n: i64) -> i64 {
    let iter = nb(c, n);
    let oi = ev(c, s, iter);
    let elem = for_elem_type(c, infer_type(c, iter));
    let mut done = false;
    while !done {
        let pre = life_save(c, s);
        let count = var_count(c);
        let slot = declare(c, na(c, n), elem, 0);
        if life_tracked(c, elem) {
            slot_origin_set(c, slot, oi);
        }
        walk_block(c, s, nc(c, n));
        truncate_vars(c, count);
        life_join(c, s, pre);
        done = life_same(c, s, pre);
    }
    return 0;
}

fn ev_lens(c: i64, s: i64, n: i64) -> i64 {
    let target = lookup(c, na(c, n));
    let mut o: i64 = 0;
    let mut ty: i64 = -1;
    if target >= 0 {
        o = var_origin(c, s, na(c, n));
        ty = vf(c, target, V_TYPE);
    }
    let count = var_count(c);
    let lens = declare(c, nb(c, n), ty, 0);
    vf_set(c, lens, V_LENS, 1);
    slot_origin_set(c, lens, o);
    let v = walk_block(c, s, nc(c, n));
    let grown = slot_origin(c, lens);
    truncate_vars(c, count);
    if target >= lsg(s, LS_BASE) {
        slot_origin_set(c, target, slot_origin(c, target) | grown);
    }
    return v;
}

fn ev(c: i64, s: i64, n: i64) -> i64 {
    if n < 0 {
        return 0;
    }
    let k = nk(c, n);
    if k == K_INT || k == K_BOOL {
        return 0;
    }
    if k == K_STR {
        return O_STATIC;
    }
    if k == K_VAR {
        let o = live_var_origin(c, s, n);
        touch(s, o, U_READ);
        return o;
    }
    if k == K_BIN {
        ev(c, s, nb(c, n));
        ev(c, s, nc(c, n));
        if is_comparison_op(na(c, n)) || na(c, n) == OP_AND || na(c, n) == OP_OR {
            return 0;
        }
        if life_tracked(c, infer_type(c, n)) {
            return O_UNKNOWN;
        }
        return 0;
    }
    if k == K_UN {
        let o = ev(c, s, nb(c, n));
        if na(c, n) == OP_DEREF {
            return through(c, n, o);
        }
        return 0;
    }
    if k == K_ARRAY || k == K_TUPLE {
        return O_FRESH | ev_list(c, s, na(c, n), 0, 1);
    }
    if k == K_SINIT {
        check_owned_twice(c, s, n);
        return O_FRESH | ev_list(c, s, nb(c, n), 1, 2);
    }
    if k == K_FIELD || k == K_TINDEX {
        return through(c, n, ev(c, s, na(c, n)));
    }
    if k == K_INDEX {
        let o = ev(c, s, na(c, n));
        ev(c, s, nb(c, n));
        return through(c, n, o);
    }
    if k == K_SLICE {
        ev(c, s, na(c, n));
        ev(c, s, nb(c, n));
        ev(c, s, nc(c, n));
        return O_FRESH;
    }
    if k == K_RANGE {
        ev(c, s, na(c, n));
        ev(c, s, nb(c, n));
        return 0;
    }
    if k == K_ADDR {
        return ev(c, s, na(c, n));
    }
    if k == K_CALL {
        return ev_call(c, s, n);
    }
    if k == K_MACROCALL {
        lsg_set(s, LS_FLAGS, lsg(s, LS_FLAGS) | LF_EFFECT);
        let args = nb(c, n);
        let mut o: i64 = 0;
        let mut i: i64 = 0;
        while i < list_len(c, args) {
            o = o | ev(c, s, list_at(c, args, i));
            i = i + 1;
        }
        sink_esc(s, o);
        if nc(c, n) >= 0 {
            walk_block(c, s, nc(c, n));
        }
        if life_tracked(c, infer_type(c, n)) {
            return o | O_UNKNOWN;
        }
        return 0;
    }
    if k == K_LENS {
        return ev_lens(c, s, n);
    }
    if k == K_IF {
        return ev_if(c, s, n);
    }
    if k == K_MATCH {
        return ev_match(c, s, n);
    }
    if k == K_WHILE {
        return ev_while(c, s, n);
    }
    if k == K_FOR {
        return ev_for(c, s, n);
    }
    if k == K_RETURN {
        check_return_escape(c, s, na(c, n));
        let f = vget(life_records(c), vget(ck(c, CK_LIFE), LT_CUR) + LR_FN);
        check_tuple_twice(c, s, na(c, n), nd(c, f));
        let o = ev_move(c, s, na(c, n));
        exit_with(s, o);
        return 0;
    }
    if k == K_ASSIGN {
        return ev_assign(c, s, n);
    }
    if k == K_LET {
        check_tuple_twice(c, s, nd(c, n), nc(c, n));
        let o = ev_move(c, s, nd(c, n));
        let mut ty = nc(c, n);
        if ty < 0 {
            ty = infer_type(c, nd(c, n));
        }
        let slot = declare(c, na(c, n), ty, nb(c, n));
        if life_tracked(c, ty) {
            slot_origin_set(c, slot, o);
        }
        let rhs = nd(c, n);
        // `let x = x;` shadows: the right side named the older slot.
        let shadow = rhs >= 0 && nk(c, rhs) == K_VAR && na(c, rhs) == na(c, n);
        if ty_is_ref(c, ty) {
            if !shadow {
                ref_points(c, slot, rhs);
            }
        } else if !shadow {
            holds_bind(c, s, slot, rhs);
        }
        return 0;
    }
    if k == K_LETD {
        let o = ev_move(c, s, nc(c, n));
        let mut ty = infer_type(c, nc(c, n));
        if ty < 0 {
            ty = ck(c, CK_TY_UNK);
        }
        bind_origin(c, na(c, n), ty, nb(c, n), o);
        return 0;
    }
    return 0;
}

// ------------------------------------------------------------ functions

fn fn_returns_value(c: i64, f: i64) -> bool {
    let ret = nd(c, f);
    return ret >= 0 && !is_prim(c, ret, PRIM_VOID);
}

// Analyze one function and join the result into its record at `at`. True
// when the record changed.
fn life_function(c: i64, f: i64, at: i64) -> bool {
    let params = nc(c, f);
    let np = list_len(c, params) / 2;
    let s = vfill(vnew_cap(LS_WIDTH), LS_WIDTH, 0);
    let base = var_count(c);
    life_errors_enter(c, at);
    lsg_set(s, LS_BASE, base);
    lsg_set(s, LS_NP, np);
    lsg_set(s, LS_USE, vfill(vnew_cap(np + 1), np, U_NONE));
    lsg_set(s, LS_END, vfill(vnew_cap(np + 1), np, 0));
    let mut owned: i64 = 0;
    let mut refs: i64 = 0;
    let mut k: i64 = 0;
    while k < np {
        let ty = list_at(c, params, k * 2 + 1);
        let slot = declare(c, list_at(c, params, k * 2), ty, 0);
        if ty_is_ref(c, ty) {
            refs = refs | param_bit(k);
            slot_origin_set(c, slot, param_bit(k));
        } else if life_tracked(c, ty) {
            owned = owned | param_bit(k);
            slot_origin_set(c, slot, param_bit(k));
        }
        k = k + 1;
    }
    owned = owned & O_PARAMS;
    refs = refs & O_PARAMS;
    lsg_set(s, LS_OWNED, owned);
    lsg_set(s, LS_REFS, refs);
    lsg_set(s, LS_LIVE, owned);
    if fn_returns_value(c, f) && life_tracked(c, nd(c, f)) {
        lsg_set(s, LS_RTRACK, 1);
    }
    let body = ne(c, f);
    let v = walk_block(c, s, body);
    if !body_diverges(c, body) {
        exit_with(s, v);
    }
    truncate_vars(c, base);
    // Join into the record: summaries only grow, so a recursive component
    // reaches its fixpoint even where a caller's facts are not monotone in
    // a callee's (more `ret` can mean less `die`).
    let recs = life_records(c);
    let mut changed = false;
    let res = vget(recs, at + LR_RES) | lsg(s, LS_RES);
    if res != vget(recs, at + LR_RES) {
        vset(recs, at + LR_RES, res);
        changed = true;
    }
    // Callers never read the flags, so a flag change makes nothing stale.
    vset(recs, at + LR_FLAGS, vget(recs, at + LR_FLAGS) | lsg(s, LS_FLAGS));
    let uses = lsg(s, LS_USE);
    let ends = lsg(s, LS_END);
    let mut j: i64 = 0;
    while j < np {
        let ua = at + LR_PARAMS + j * 2;
        if vget(uses, j) > vget(recs, ua) {
            vset(recs, ua, vget(uses, j));
            changed = true;
        }
        let mut e = vget(recs, ua + 1) | vget(ends, j);
        if (e & E_ESC) != 0 {
            e = E_ESC; // esc absorbs
        }
        if e != vget(recs, ua + 1) {
            vset(recs, ua + 1, e);
            changed = true;
        }
        j = j + 1;
    }
    if changed {
        // A call that read the old summary saw a stale one.
        let table = ck(c, CK_LIFE);
        let read = vget(table, LT_READ);
        if vget(read, at) == 1 {
            vset(table, LT_STALE, 1);
        }
        vset(read, at, 0);
    }
    return changed;
}

// ------------------------------------------------------------ call graph

// Append the record of `f` at bottom (no use, no end, empty result) and
// return its offset.
fn rec_alloc(c: i64, recs: i64, f: i64, np: i64) -> i64 {
    let at = vlen(recs);
    vpush(recs, f);
    vpush(recs, np);
    vpush(recs, 0);
    vpush(recs, 0);
    vpush(recs, 0);
    vpush(recs, 0);
    let mut k: i64 = 0;
    while k < np * 2 {
        vpush(recs, 0);
        k = k + 1;
    }
    return at;
}

// Push the record offset of every program function `n` calls.
fn scan_calls(c: i64, n: i64, out: i64) -> i64 {
    if n < 0 {
        return 0;
    }
    let k = nk(c, n);
    if k == K_INT || k == K_BOOL || k == K_STR || k == K_VAR {
        return 0;
    }
    if k == K_CALL {
        let at = life_callee(c, na(c, n));
        if at >= 0 {
            vpush(out, at);
        }
        return scan_list(c, nb(c, n), 0, 1, out);
    }
    if k == K_BIN {
        scan_calls(c, nb(c, n), out);
        return scan_calls(c, nc(c, n), out);
    }
    if k == K_UN {
        return scan_calls(c, nb(c, n), out);
    }
    if k == K_ARRAY || k == K_TUPLE {
        return scan_list(c, na(c, n), 0, 1, out);
    }
    if k == K_SINIT {
        return scan_list(c, nb(c, n), 1, 2, out);
    }
    if k == K_FIELD || k == K_TINDEX || k == K_ADDR || k == K_RETURN {
        return scan_calls(c, na(c, n), out);
    }
    if k == K_INDEX || k == K_RANGE || k == K_ASSIGN {
        scan_calls(c, na(c, n), out);
        return scan_calls(c, nb(c, n), out);
    }
    if k == K_SLICE {
        scan_calls(c, na(c, n), out);
        scan_calls(c, nb(c, n), out);
        return scan_calls(c, nc(c, n), out);
    }
    if k == K_LENS {
        return scan_list(c, nc(c, n), 0, 1, out);
    }
    if k == K_IF {
        scan_calls(c, na(c, n), out);
        scan_list(c, nb(c, n), 0, 1, out);
        return scan_list(c, nc(c, n), 0, 1, out);
    }
    if k == K_WHILE {
        scan_calls(c, na(c, n), out);
        return scan_list(c, nb(c, n), 0, 1, out);
    }
    if k == K_FOR {
        scan_calls(c, nb(c, n), out);
        return scan_list(c, nc(c, n), 0, 1, out);
    }
    if k == K_MACROCALL {
        scan_list(c, nb(c, n), 0, 1, out);
        return scan_list(c, nc(c, n), 0, 1, out);
    }
    if k == K_MATCH {
        scan_calls(c, na(c, n), out);
        let arms = nb(c, n);
        let mut i: i64 = 0;
        while i < list_len(c, arms) {
            scan_calls(c, list_at(c, arms, i + 1), out);
            scan_calls(c, list_at(c, arms, i + 2), out);
            i = i + 3;
        }
        return 0;
    }
    if k == K_LET {
        return scan_calls(c, nd(c, n), out);
    }
    if k == K_LETD {
        return scan_calls(c, nc(c, n), out);
    }
    return 0;
}

fn scan_list(c: i64, l: i64, from: i64, step: i64, out: i64) -> i64 {
    let mut i = from;
    while i < list_len(c, l) {
        scan_calls(c, list_at(c, l, i), out);
        i = i + step;
    }
    return 0;
}

// Tarjan's strongly connected components over record offsets. `g` is
// [callees by record offset, index, lowlink, on-stack, stack, counter,
// components]; a component is pushed as its members then -1, callees'
// components before their callers'.
const TG_ADJ = 0;
const TG_INDEX = 1;
const TG_LOW = 2;
const TG_ON = 3;
const TG_STACK = 4;
const TG_NEXT = 5;
const TG_OUT = 6;

fn tarjan(g: i64, v: i64) -> i64 {
    let index = vget(g, TG_INDEX);
    let low = vget(g, TG_LOW);
    let on = vget(g, TG_ON);
    let stack = vget(g, TG_STACK);
    vset(index, v, vget(g, TG_NEXT));
    vset(low, v, vget(g, TG_NEXT));
    vset(g, TG_NEXT, vget(g, TG_NEXT) + 1);
    vpush(stack, v);
    vset(on, v, 1);
    let edges = vget(vget(g, TG_ADJ), v);
    let mut i: i64 = 0;
    while i < vlen(edges) {
        let w = vget(edges, i);
        if vget(index, w) < 0 {
            tarjan(g, w);
            if vget(low, w) < vget(low, v) {
                vset(low, v, vget(low, w));
            }
        } else if vget(on, w) == 1 && vget(index, w) < vget(low, v) {
            vset(low, v, vget(index, w));
        }
        i = i + 1;
    }
    if vget(low, v) == vget(index, v) {
        let out = vget(g, TG_OUT);
        let mut w: i64 = -1;
        while w != v {
            w = vpop(stack);
            vset(on, w, 0);
            vpush(out, w);
        }
        vpush(out, -1);
    }
    return 0;
}

// Analyse one component (members out[from..to)): once when it is not
// recursive, else from bottom until a pass changes no member's summary.
fn life_component(c: i64, g: i64, from: i64, to: i64) -> i64 {
    let out = vget(g, TG_OUT);
    let recs = life_records(c);
    let size = to - from;
    let mut recursive = size > 1;
    if !recursive {
        let v = vget(out, from);
        let edges = vget(vget(g, TG_ADJ), v);
        let mut i: i64 = 0;
        while i < vlen(edges) {
            if vget(edges, i) == v {
                recursive = true;
            }
            i = i + 1;
        }
    }
    // Members in load order (record offsets ascend with it).
    let mut a = from + 1;
    while a < to {
        let x = vget(out, a);
        let mut b = a;
        while b > from && vget(out, b - 1) > x {
            vset(out, b, vget(out, b - 1));
            b = b - 1;
        }
        vset(out, b, x);
        a = a + 1;
    }
    // A pass is the fixpoint when every summary a call read during it was
    // already final: re-walking would read the same summaries and compute
    // the same records. Most components of word-typed code never change a
    // summary after its first read, so they finish in one pass.
    let table = ck(c, CK_LIFE);
    let mut passes: i64 = 0;
    let mut again = true;
    while again {
        vset(table, LT_STALE, 0);
        passes = passes + 1;
        let mut m = from;
        while m < to {
            let at = vget(out, m);
            life_function(c, vget(recs, at + LR_FN), at);
            m = m + 1;
        }
        again = recursive && vget(table, LT_STALE) == 1;
    }
    if recursive {
        let mut m = from;
        while m < to {
            let at = vget(out, m);
            vset(recs, at + LR_SCC, size);
            vset(recs, at + LR_PASSES, passes);
            m = m + 1;
        }
    }
    return 0;
}

// Summaries for every function of the checked program: records in load
// order, analysed callees first.
fn life_program(c: i64) -> i64 {
    let nn = name_count(c);
    let table = vnew_cap(7);
    let recs = vnew_cap(4096);
    vpush(table, recs);
    vpush(table, vfill(vnew_cap(nn + 1), nn, -1));
    vpush(table, vnew_cap(1024));
    vpush(table, vfill(vnew_cap(nn + 1), nn, -1));
    vpush(table, vfill(vnew_cap(nn + 1), nn, C_UNSET));
    vpush(table, 0); // LT_READ, sized once the records exist
    vpush(table, 0);
    life_errors_init(table);
    ck_set(c, CK_LIFE, table);
    rt_summaries(c);
    let byname = vget(table, LT_BYNAME);
    let items = cx(c, CX_ITEMS);
    let fns = vnew_cap(1024);
    let mut i: i64 = 0;
    while i < vlen(items) {
        let n = vget(items, i);
        if nk(c, n) == K_FN {
            let at = rec_alloc(c, recs, n, list_len(c, nc(c, n)) / 2);
            vpush(fns, at);
            if na(c, n) < vlen(byname) {
                vset(byname, na(c, n), at);
            }
        }
        i = i + 1;
    }
    // The call graph, indexed by record offset.
    let nr = vlen(recs);
    vset(table, LT_READ, vfill(vnew_cap(nr + 1), nr, 0));
    vset(table, LT_TWICE, vfill(vnew_cap(nr + 1), nr, 0));
    let adj = vfill(vnew_cap(nr + 1), nr, 0);
    i = 0;
    while i < vlen(fns) {
        let at = vget(fns, i);
        let edges = vnew_cap(8);
        scan_list(c, ne(c, vget(recs, at + LR_FN)), 0, 1, edges);
        vset(adj, at, edges);
        i = i + 1;
    }
    let g = vnew_cap(7);
    vpush(g, adj);
    vpush(g, vfill(vnew_cap(nr + 1), nr, -1));
    vpush(g, vfill(vnew_cap(nr + 1), nr, 0));
    vpush(g, vfill(vnew_cap(nr + 1), nr, 0));
    vpush(g, vnew_cap(64));
    vpush(g, 0);
    vpush(g, vnew_cap(vlen(fns) * 2 + 1));
    i = 0;
    while i < vlen(fns) {
        let at = vget(fns, i);
        if vget(vget(g, TG_INDEX), at) < 0 {
            tarjan(g, at);
        }
        i = i + 1;
    }
    let out = vget(g, TG_OUT);
    let mut from: i64 = 0;
    i = 0;
    while i < vlen(out) {
        if vget(out, i) < 0 {
            life_component(c, g, from, i);
            from = i + 1;
        }
        i = i + 1;
    }
    return 0;
}


// ------------------------------------------------------------ hard errors
//
// Card L5, docs/lifecycles.md §2: definite lifecycle bugs found during the
// walk. Facts only grow across fixpoint passes, so an error seen in any
// pass is real. The first one found is kept and `life_fail_pending`
// reports it once the summaries are complete (`trackc life` skips that,
// so the dump still works on rejected programs).
//   E0211  a `&` value passed where the callee ends its parameter
//   E0212  `&local` inside a returned tuple, array or struct literal
//   E0213  a reference read after the block of its target closed
//   E0214  one borrowed value stored into two owned fields

const O_KEEP = 9223372036854775807; // every bit but O_DANGLE

fn life_errors_init(table: i64) -> i64 {
    vpush(table, 0);      // LT_ERR
    vpush(table, 0);      // LT_TWICE, sized once the records exist
    vpush(table, -1);     // LT_CUR
    vpush(table, vnew()); // LT_POINTS
    vpush(table, vnew()); // LT_DANGLE
    vpush(table, 0);      // LT_BSTART
    vpush(table, vnew()); // LT_HOLDS
    return 0;
}

fn life_errors_enter(c: i64, at: i64) -> i64 {
    let table = ck(c, CK_LIFE);
    vset(table, LT_CUR, at);
    vtrunc(vget(table, LT_POINTS), 0);
    vtrunc(vget(table, LT_DANGLE), 0);
    vtrunc(vget(table, LT_HOLDS), 0);
    return 0;
}

fn life_error(c: i64, pos: i64, code: i64, message: i64) -> i64 {
    let table = ck(c, CK_LIFE);
    if vget(table, LT_ERR) == 0 {
        let e = vnew_cap(3);
        vpush(e, pos);
        vpush(e, code);
        vpush(e, message);
        vset(table, LT_ERR, e);
    }
    return 0;
}

// Report the first hard error, if any (exits). A latent E0214 that no call
// site named is reported at its literal.
fn life_fail_pending(c: i64) -> i64 {
    let table = ck(c, CK_LIFE);
    let e = vget(table, LT_ERR);
    if e != 0 {
        return fail_at(c, vget(e, 0), vget(e, 1), vget(e, 2));
    }
    let tw = vget(table, LT_TWICE);
    let mut at: i64 = 0;
    while at < vlen(tw) {
        let t = vget(tw, at);
        if t != 0 && vget(t, 3) == 0 {
            return fail_at(c, vget(t, 0), "E0214", text_cat3(quoted(c, vget(t, 4)), " would be ended twice: ", vget(t, 2)));
        }
        at = at + 1;
    }
    return 0;
}

fn life_line(c: i64, pos: i64) -> i64 {
    let f = file_of_pos(c, pos);
    let bytes = text_bytes(vget(cx(c, CX_SRCS), f));
    let end = pos - vget(cx(c, CX_BASES), f);
    let mut line: i64 = 1;
    let mut i: i64 = 0;
    while i < end && i < vlen(bytes) {
        if vget(bytes, i) == 10 {
            line = line + 1;
        }
        i = i + 1;
    }
    return line;
}

fn cur_fn_name(c: i64) -> i64 {
    let at = vget(ck(c, CK_LIFE), LT_CUR);
    return na(c, vget(life_records(c), at + LR_FN));
}

fn ty_text(c: i64, t: i64) -> i64 {
    if t >= 0 && nk(c, t) == T_CUSTOM {
        return name_text(c, na(c, t));
    }
    if t >= 0 && nk(c, t) == T_REF {
        return text_cat("&", ty_text(c, na(c, t)));
    }
    if t >= 0 && nk(c, t) == T_SLICE {
        return text_cat("[]", ty_text(c, na(c, t)));
    }
    return "T";
}

fn is_generic_param(c: i64, f: i64, t: i64) -> bool {
    if t < 0 || nk(c, t) != T_CUSTOM || nb(c, f) < 0 {
        return false;
    }
    let g = nb(c, f);
    let mut j: i64 = 0;
    while j < list_len(c, g) {
        if list_at(c, g, j) == na(c, t) {
            return true;
        }
        j = j + 1;
    }
    return false;
}

// E0211: argument `a` (index i) of a call to `f` is borrowed, but f ends
// its by-value parameter (die or esc): the frame that only borrowed the
// value would end it. Borrowed means a `&` variable, or an owned place
// read through one (`r.p`, `*r`, `r.0`, `r[i]`): that moves the value out
// of a borrow. A generic parameter binds to the argument's own type, so a
// `&` variable passed there is lent, not consumed.
fn check_lent_consumed(c: i64, s: i64, name: i64, f: i64, i: i64, a: i64) -> i64 {
    let root = place_var(c, a);
    if root < 0 {
        return 0;
    }
    let slot = lookup(c, root);
    if slot < lsg(s, LS_BASE) || !ty_is_ref(c, vf(c, slot, V_TYPE)) {
        return 0;
    }
    let params = nc(c, f);
    let pty = list_at(c, params, i * 2 + 1);
    if ty_is_ref(c, pty) {
        return 0;
    }
    if nk(c, a) == K_VAR {
        if is_generic_param(c, f, pty) {
            return 0;
        }
    } else {
        let at = infer_type(c, a);
        if at < 0 || at == ck(c, CK_TY_UNK) || ty_is_ref(c, at) || ty_is_copy(c, at) {
            return 0;
        }
    }
    let callee = quoted(c, na(c, f));
    let p = quoted(c, list_at(c, params, i * 2));
    let me = quoted(c, cur_fn_name(c));
    // Name the `&` parameter the value was lent through, not a local alias.
    let mut lent = root;
    let refs = slot_origin(c, slot) & lsg(s, LS_REFS);
    if refs != 0 {
        let mut k: i64 = 0;
        while (refs & param_bit(k)) == 0 {
            k = k + 1;
        }
        lent = vf(c, lsg(s, LS_BASE) + k, V_NAME);
    }
    let b = sb_new();
    sb_add(b, callee);
    sb_add(b, " consumes its parameter ");
    sb_add(b, p);
    sb_add(b, ", but ");
    sb_add(b, "'");
    sb_add(b, lent_text(c, a, name_text(c, lent)));
    sb_add(b, "' is only lent to ");
    sb_add(b, me);
    sb_add(b, ". Pass '&' and make '");
    sb_add(b, name_text(c, list_at(c, params, i * 2)));
    sb_add(b, ": &");
    sb_add(b, ty_text(c, pty));
    sb_add(b, "', or take ownership in ");
    sb_add(b, me);
    sb_add(b, ".");
    return life_error(c, npos(c, a), "E0211", sb_text(b));
}

// Source text of place `n` with its base variable spelled `root`.
fn lent_text(c: i64, n: i64, root: i64) -> i64 {
    let k = nk(c, n);
    if k == K_FIELD {
        return text_cat3(lent_text(c, na(c, n), root), ".", name_text(c, nb(c, n)));
    }
    if k == K_TINDEX {
        return text_cat3(lent_text(c, na(c, n), root), ".", text_of_int(nb(c, n)));
    }
    if k == K_INDEX {
        return text_cat(lent_text(c, na(c, n), root), "[..]");
    }
    if k == K_UN {
        return text_cat("*", lent_text(c, nb(c, n), root));
    }
    return root;
}

// True when `slot` is an owned local of this frame (not a parameter, not
// a reference): it dies when the function returns.
fn frame_local(c: i64, s: i64, slot: i64) -> bool {
    return slot >= lsg(s, LS_BASE) + lsg(s, LS_NP) && !ty_is_ref(c, vf(c, slot, V_TYPE));
}

// True when `v` builds a value from parts: a tuple, array, struct or
// union payload literal.
fn is_literal(c: i64, v: i64) -> bool {
    let k = nk(c, v);
    if k == K_TUPLE || k == K_ARRAY || k == K_SINIT {
        return true;
    }
    return k == K_CALL && ni(c, na(c, v), NI_OWNER) >= 0;
}

// The frame local whose address the value `e` carries, or -1: `&x`, a
// `&` variable that points at `x` (LT_POINTS), a variable bound to a
// literal holding `&x` (LT_HOLDS), or a literal with such an element.
fn local_addr_in(c: i64, s: i64, e: i64) -> i64 {
    if e < 0 {
        return -1;
    }
    let k = nk(c, e);
    if k == K_ADDR {
        let root = place_var(c, na(c, e));
        if root < 0 {
            return -1;
        }
        let slot = lookup(c, root);
        if slot >= 0 && frame_local(c, s, slot) {
            return slot;
        }
        return -1;
    }
    if k == K_VAR {
        let slot = lookup(c, na(c, e));
        if slot < lsg(s, LS_BASE) {
            return -1;
        }
        let table = ck(c, CK_LIFE);
        let mut list = vget(table, LT_HOLDS);
        if ty_is_ref(c, vf(c, slot, V_TYPE)) {
            list = vget(table, LT_POINTS);
        }
        let mut j: i64 = 0;
        while j < vlen(list) {
            if vget(list, j) == slot && frame_local(c, s, vget(list, j + 1)) {
                return vget(list, j + 1);
            }
            j = j + 2;
        }
        return -1;
    }
    if !is_literal(c, e) {
        return -1;
    }
    let mut l = na(c, e);
    let mut from: i64 = 0;
    let mut step: i64 = 1;
    if k == K_SINIT {
        l = nb(c, e);
        from = 1;
        step = 2;
    } else if k == K_CALL {
        l = nb(c, e);
    }
    let mut i = from;
    while i < list_len(c, l) {
        let t = local_addr_in(c, s, list_at(c, l, i));
        if t >= 0 {
            return t;
        }
        i = i + step;
    }
    return -1;
}

// E0212 bookkeeping: `slot` (not a reference) is now bound to `rhs`; it
// holds a local's address when `rhs` is a literal or variable that does.
fn holds_bind(c: i64, s: i64, slot: i64, rhs: i64) -> i64 {
    let mut t: i64 = -1;
    if rhs >= 0 && (nk(c, rhs) == K_VAR || is_literal(c, rhs)) {
        t = local_addr_in(c, s, rhs);
    }
    let h = vget(ck(c, CK_LIFE), LT_HOLDS);
    let mut j: i64 = 0;
    while j < vlen(h) {
        if vget(h, j) == slot {
            vset(h, j + 1, -1);
        }
        j = j + 2;
    }
    if t >= 0 {
        vpush(h, slot);
        vpush(h, t);
    }
    return 0;
}

// The block whose slots start at `count` closes: forget holders and
// targets declared inside it.
fn holds_close(c: i64, count: i64) -> i64 {
    let h = vget(ck(c, CK_LIFE), LT_HOLDS);
    let keep = vnew_cap(vlen(h));
    let mut j: i64 = 0;
    while j < vlen(h) {
        if vget(h, j) < count && vget(h, j + 1) >= 0 && vget(h, j + 1) < count {
            vpush(keep, vget(h, j));
            vpush(keep, vget(h, j + 1));
        }
        j = j + 2;
    }
    vtrunc(h, 0);
    j = 0;
    while j < vlen(keep) {
        vpush(h, vget(keep, j));
        j = j + 1;
    }
    return 0;
}

fn escape_error(c: i64, at: i64, slot: i64, place: i64, via: i64) -> i64 {
    let fname = quoted(c, cur_fn_name(c));
    let b = sb_new();
    sb_add(b, "local ");
    sb_add(b, quoted(c, vf(c, slot, V_NAME)));
    sb_add(b, " escapes ");
    sb_add(b, fname);
    sb_add(b, place);
    if via >= 0 {
        if text_len(place) > 0 {
            sb_add(b, ",");
        }
        sb_add(b, " through ");
        sb_add(b, quoted(c, via));
    }
    sb_add(b, "; it dies when ");
    sb_add(b, fname);
    sb_add(b, " returns.");
    return life_error(c, npos(c, at), "E0212", sb_text(b));
}

// E0212: a returned literal holds `&x` for a local `x` of this frame,
// directly, through a `&` alias of `x`, or through a variable bound to a
// literal that holds it; or the returned variable is such a holder.
fn check_return_escape(c: i64, s: i64, v: i64) -> i64 {
    if v < 0 {
        return 0;
    }
    let k = nk(c, v);
    if k == K_VAR {
        let slot = lookup(c, na(c, v));
        if slot >= lsg(s, LS_BASE) && !ty_is_ref(c, vf(c, slot, V_TYPE)) {
            let t = local_addr_in(c, s, v);
            if t >= 0 {
                escape_error(c, v, t, "", na(c, v));
            }
        }
        return 0;
    }
    if !is_literal(c, v) {
        return 0;
    }
    let mut l = na(c, v);
    let mut from: i64 = 0;
    let mut step: i64 = 1;
    if k == K_SINIT {
        l = nb(c, v);
        from = 1;
        step = 2;
    } else if k == K_CALL {
        l = nb(c, v);
    }
    let mut i = from;
    while i < list_len(c, l) {
        let e = list_at(c, l, i);
        let ek = nk(c, e);
        if ek == K_ADDR || ek == K_VAR {
            let t = local_addr_in(c, s, e);
            if t >= 0 {
                let mut place: i64 = 0;
                if k == K_SINIT {
                    place = text_cat3(" through field '", name_text(c, na(c, v)), ".");
                    place = text_cat3(place, name_text(c, list_at(c, l, i - 1)), "'");
                } else if k == K_TUPLE {
                    place = text_cat3(" inside the returned tuple (element ", text_of_int(i), ")");
                } else if k == K_ARRAY {
                    place = text_cat3(" inside the returned array (element ", text_of_int(i), ")");
                } else {
                    place = text_cat3(" inside the returned payload of '", name_text(c, na(c, v)), "'");
                }
                let mut via: i64 = -1;
                if ek == K_VAR {
                    via = na(c, e);
                }
                escape_error(c, e, t, place, via);
            }
        } else {
            check_return_escape(c, s, e);
        }
        i = i + step;
    }
    return 0;
}

// E0214: a struct literal stores the same borrowed variable into two owned
// fields. For a `&` parameter the error names the caller's value, so it is
// latent here and reported at the call sites (`check_twice_at_call`).
fn check_owned_twice(c: i64, s: i64, n: i64) -> i64 {
    let pairs = nb(c, n);
    let mut i: i64 = 1;
    while i < list_len(c, pairs) {
        let e = list_at(c, pairs, i);
        if owned_from_borrow(c, s, n, list_at(c, pairs, i - 1), e) {
            let mut j: i64 = 1;
            while j < i {
                let d = list_at(c, pairs, j);
                if nk(c, d) == K_VAR && na(c, d) == na(c, e) && owned_from_borrow(c, s, n, list_at(c, pairs, j - 1), d) {
                    twice_found(c, s, n, list_at(c, pairs, j - 1), list_at(c, pairs, i - 1), e);
                    return 0;
                }
                j = j + 2;
            }
        }
        if nk(c, e) == K_TUPLE {
            let sd = struct_def(c, na(c, n));
            if sd >= 0 {
                let idx = struct_field_index(c, sd, list_at(c, pairs, i - 1));
                if idx >= 0 {
                    check_tuple_twice(c, s, e, list_at(c, nb(c, sd), idx * 2 + 1));
                }
            }
        }
        i = i + 2;
    }
    return 0;
}

// True when field `field` of literal `n` is owned and `e` is a borrowed
// variable (a `&` typed local or parameter).
fn owned_from_borrow(c: i64, s: i64, n: i64, field: i64, e: i64) -> bool {
    if nk(c, e) != K_VAR {
        return false;
    }
    let slot = lookup(c, na(c, e));
    if slot < lsg(s, LS_BASE) || !ty_is_ref(c, vf(c, slot, V_TYPE)) {
        return false;
    }
    let sd = struct_def(c, na(c, n));
    if sd < 0 {
        return false;
    }
    let idx = struct_field_index(c, sd, field);
    if idx < 0 {
        return false;
    }
    let ft = list_at(c, nb(c, sd), idx * 2 + 1);
    return ft >= 0 && !ty_is_ref(c, ft) && life_tracked(c, ft);
}

fn twice_found(c: i64, s: i64, n: i64, f1: i64, f2: i64, e: i64) -> i64 {
    let sname = name_text(c, na(c, n));
    let b = sb_new();
    sb_add(b, "fields '");
    sb_add(b, sname);
    sb_add(b, ".");
    sb_add(b, name_text(c, f1));
    sb_add(b, "' and '");
    sb_add(b, sname);
    sb_add(b, ".");
    sb_add(b, name_text(c, f2));
    sb_add(b, "'");
    return twice_report(c, s, e, sb_text(b));
}

// E0214 in a tuple literal whose expected type `ety` (a declared return,
// `let`, parameter or field type) makes two elements owned: the same
// borrowed variable fills both. A tuple's own inferred type keeps `&`
// elements as references, so only an expected type can make them owned.
fn check_tuple_twice(c: i64, s: i64, lit: i64, ety: i64) -> i64 {
    if lit < 0 || ety < 0 || nk(c, lit) != K_TUPLE || nk(c, ety) != T_TUPLE {
        return 0;
    }
    let el = na(c, lit);
    let tl = na(c, ety);
    let mut i: i64 = 0;
    while i < list_len(c, el) && i < list_len(c, tl) {
        let e = list_at(c, el, i);
        if borrowed_var(c, s, e) && owned_type(c, list_at(c, tl, i)) {
            let mut j: i64 = 0;
            while j < i {
                let d = list_at(c, el, j);
                if nk(c, d) == K_VAR && na(c, d) == na(c, e) && owned_type(c, list_at(c, tl, j)) {
                    let b = sb_new();
                    sb_add(b, "elements ");
                    sb_add(b, text_of_int(j));
                    sb_add(b, " and ");
                    sb_add(b, text_of_int(i));
                    sb_add(b, " of the tuple");
                    return twice_report(c, s, e, sb_text(b));
                }
                j = j + 1;
            }
        }
        check_tuple_twice(c, s, e, list_at(c, tl, i));
        i = i + 1;
    }
    return 0;
}

// True when `e` is a borrowed variable (a `&` typed local or parameter).
fn borrowed_var(c: i64, s: i64, e: i64) -> bool {
    if e < 0 || nk(c, e) != K_VAR {
        return false;
    }
    let slot = lookup(c, na(c, e));
    return slot >= lsg(s, LS_BASE) && ty_is_ref(c, vf(c, slot, V_TYPE));
}

fn owned_type(c: i64, t: i64) -> bool {
    return t >= 0 && !ty_is_ref(c, t) && life_tracked(c, t);
}

// Report (or, for a `&` parameter, record as latent) that `places` both
// take ownership of the borrowed variable `e`.
fn twice_report(c: i64, s: i64, e: i64, places: i64) -> i64 {
    let text = text_cat3(places, " both take ownership of the borrowed ", text_cat(quoted(c, na(c, e)), "."));
    let slot = lookup(c, na(c, e));
    let base = lsg(s, LS_BASE);
    let table = ck(c, CK_LIFE);
    if slot < base + lsg(s, LS_NP) {
        let tw = vget(table, LT_TWICE);
        let at = vget(table, LT_CUR);
        if vget(tw, at) == 0 {
            let t = vnew_cap(5);
            vpush(t, npos(c, e));
            vpush(t, slot - base);
            vpush(t, text);
            vpush(t, 0);
            vpush(t, na(c, e));
            vset(tw, at, t);
        }
        return 0;
    }
    // A local reference: name its target when known.
    let mut owner = na(c, e);
    let pts = vget(table, LT_POINTS);
    let mut k: i64 = 0;
    while k < vlen(pts) {
        if vget(pts, k) == slot {
            owner = vf(c, vget(pts, k + 1), V_NAME);
        }
        k = k + 2;
    }
    return life_error(c, npos(c, e), "E0214", text_cat3(quoted(c, owner), " would be ended twice: ", text));
}

// E0214 at a call site: argument i feeds a parameter the callee stores
// twice, so the caller's value would be ended twice.
fn check_twice_at_call(c: i64, at: i64, i: i64, a: i64) -> i64 {
    let t = vget(vget(ck(c, CK_LIFE), LT_TWICE), at);
    if t == 0 || vget(t, 1) != i {
        return 0;
    }
    let mut name: i64 = -1;
    if nk(c, a) == K_ADDR {
        name = place_var(c, na(c, a));
    } else if nk(c, a) == K_VAR {
        name = na(c, a);
    }
    if name < 0 {
        return 0;
    }
    vset(t, 3, 1);
    return life_error(c, npos(c, a), "E0214", text_cat3(quoted(c, name), " would be ended twice: ", vget(t, 2)));
}

// Slots the reference value `rhs` points at, pushed onto `out`: the root
// of `&place`, the targets of a `&` variable it copies, or those of the
// one `&` argument a call's result always derives from (its summary's
// result is exactly that parameter). Anything else adds nothing.
fn ref_targets(c: i64, rhs: i64, out: i64) -> i64 {
    if rhs < 0 {
        return 0;
    }
    let k = nk(c, rhs);
    if k == K_ADDR {
        let root = place_var(c, na(c, rhs));
        if root >= 0 {
            let t = lookup(c, root);
            if t >= 0 {
                vpush(out, t);
            }
        }
        return 0;
    }
    if k == K_VAR {
        let slot = lookup(c, na(c, rhs));
        if slot < 0 || !ty_is_ref(c, vf(c, slot, V_TYPE)) {
            return 0;
        }
        let pts = vget(ck(c, CK_LIFE), LT_POINTS);
        let mut j: i64 = 0;
        while j < vlen(pts) {
            if vget(pts, j) == slot {
                vpush(out, vget(pts, j + 1));
            }
            j = j + 2;
        }
        return 0;
    }
    if k == K_CALL {
        let at = life_callee(c, na(c, rhs));
        if at < 0 {
            return 0;
        }
        let recs = vget(ck(c, CK_LIFE), LT_RECS);
        let r = vget(recs, at + LR_RES);
        let bits = r & O_PARAMS;
        if bits == 0 || (r & (O_FRESH | O_STATIC | O_UNKNOWN)) != 0 || (bits & (bits - 1)) != 0 {
            return 0;
        }
        let mut i: i64 = 0;
        while (bits & param_bit(i)) == 0 {
            i = i + 1;
        }
        let params = nc(c, vget(recs, at + LR_FN));
        let args = nb(c, rhs);
        if i < list_len(c, args) && i * 2 + 1 < list_len(c, params) && ty_is_ref(c, list_at(c, params, i * 2 + 1)) {
            ref_targets(c, list_at(c, args, i), out);
        }
    }
    return 0;
}

// E0213 bookkeeping: `slot` (a reference) now points at what `rhs` does.
fn ref_points(c: i64, slot: i64, rhs: i64) -> i64 {
    let ts = vnew();
    ref_targets(c, rhs, ts);
    let pts = vget(ck(c, CK_LIFE), LT_POINTS);
    let mut k: i64 = 0;
    while k < vlen(pts) {
        if vget(pts, k) == slot {
            vset(pts, k, vget(pts, vlen(pts) - 2));
            vset(pts, k + 1, vget(pts, vlen(pts) - 1));
            vtrunc(pts, vlen(pts) - 2);
        } else {
            k = k + 2;
        }
    }
    let mut j: i64 = 0;
    while j < vlen(ts) {
        vpush(pts, slot);
        vpush(pts, vget(ts, j));
        j = j + 1;
    }
    return 0;
}

// A reference rebound in the block that declares it no longer carries an
// older dangling target.
fn ref_rebound(c: i64, slot: i64, rhs: i64) -> i64 {
    ref_points(c, slot, rhs);
    let table = ck(c, CK_LIFE);
    if slot >= vget(table, LT_BSTART) {
        let d = vget(table, LT_DANGLE);
        let k = dangle_find(c, slot);
        if k >= 0 {
            vset(d, k, -1);
        }
    }
    return 0;
}

fn dangle_find(c: i64, slot: i64) -> i64 {
    let d = vget(ck(c, CK_LIFE), LT_DANGLE);
    let mut k: i64 = 0;
    while k < vlen(d) {
        if vget(d, k) == slot {
            return k;
        }
        k = k + 3;
    }
    return -1;
}

// The block whose slots start at `count` closes (its last statement is at
// `endpos`): references declared outside it that point inside dangle.
fn refs_outlive_block(c: i64, count: i64, endpos: i64) -> i64 {
    let table = ck(c, CK_LIFE);
    let pts = vget(table, LT_POINTS);
    let keep = vnew_cap(vlen(pts));
    let mut k: i64 = 0;
    while k < vlen(pts) {
        let r = vget(pts, k);
        let t = vget(pts, k + 1);
        if r < count && t >= count {
            slot_origin_set(c, r, slot_origin(c, r) | O_DANGLE);
            if dangle_find(c, r) < 0 {
                let d = vget(table, LT_DANGLE);
                vpush(d, r);
                vpush(d, vf(c, t, V_NAME));
                vpush(d, endpos);
            }
        } else if r < count {
            vpush(keep, r);
            vpush(keep, t);
        }
        k = k + 2;
    }
    vtrunc(pts, 0);
    k = 0;
    while k < vlen(keep) {
        vpush(pts, vget(keep, k));
        k = k + 1;
    }
    return 0;
}

// Origin of the variable at node `n`; reading a dangling reference is E0213.
fn live_var_origin(c: i64, s: i64, n: i64) -> i64 {
    let o = var_origin(c, s, na(c, n));
    if o >= 0 {
        return o;
    }
    dangling_use(c, lookup(c, na(c, n)), n);
    return o & O_KEEP;
}

fn dangling_use(c: i64, slot: i64, n: i64) -> i64 {
    let r = quoted(c, vf(c, slot, V_NAME));
    let use_line = text_of_int(life_line(c, npos(c, n)));
    let k = dangle_find(c, slot);
    let b = sb_new();
    sb_add(b, r);
    if k >= 0 {
        let d = vget(ck(c, CK_LIFE), LT_DANGLE);
        sb_add(b, " refers to ");
        sb_add(b, quoted(c, vget(d, k + 1)));
        sb_add(b, ", which ends at the close of this block (line ");
        sb_add(b, text_of_int(life_line(c, vget(d, k + 2))));
        sb_add(b, "); ");
    } else {
        sb_add(b, " refers to a value whose block has ended; ");
    }
    sb_add(b, r);
    sb_add(b, " is used after it at line ");
    sb_add(b, use_line);
    sb_add(b, ".");
    return life_error(c, npos(c, n), "E0213", sb_text(b));
}
// ------------------------------------------------------ runtime summaries

// One runtime function: `params` has one letter per parameter, `result`
// one letter (docs/lifecycles.md §1.4 step 5).
//   params: n none/die, r read/die, m mutate/die, s read/esc (stored or
//           freed: ownership leaves the caller), k none/ret (handed back)
//   result: - none, f fresh, t static, u unknown, 0-9 derived(param)
fn rt(c: i64, name: i64, params: i64, result: i64) -> i64 {
    let table = ck(c, CK_LIFE);
    let recs = vget(table, LT_RTRECS);
    let byname = vget(table, LT_RTBYNAME);
    let id = name_find(c, name);
    if id < 0 || id >= vlen(byname) {
        return 0; // the program never names it
    }
    let p = text_bytes(params);
    let np = vlen(p);
    let at = rec_alloc(c, recs, -1, np);
    let r = vget(text_bytes(result), 0);
    let mut o: i64 = 0;
    if r == 102 { o = O_FRESH; }
    if r == 116 { o = O_STATIC; }
    if r == 117 { o = O_UNKNOWN; }
    if r >= 48 && r <= 57 { o = 1 << (r - 48); }
    vset(recs, at + LR_RES, o);
    let mut k: i64 = 0;
    while k < np {
        let ch = vget(p, k);
        let mut u = U_NONE;
        let mut e = E_DIE;
        if ch == 114 { u = U_READ; }
        if ch == 109 { u = U_MUT; }
        if ch == 115 { u = U_READ; e = E_ESC; }
        if ch == 107 { e = E_RET; }
        vset(recs, at + LR_PARAMS + k * 2, u);
        vset(recs, at + LR_PARAMS + k * 2 + 1, e);
        k = k + 1;
    }
    vset(byname, id, at);
    return 0;
}

// The id of an interned name, or -1. Unlike `intern`, never adds one, so
// the runtime table leaves the name ids of later passes unchanged.
fn name_find(c: i64, s: i64) -> i64 {
    let names = cx(c, CX_NAMES);
    let table = cx(c, CX_HASH);
    let mask = vlen(table) - 1;
    let mut slot = text_hash(s) & mask;
    while vget(table, slot) != 0 {
        let id = vget(table, slot) - 1;
        if text_eq(vget(names, id), s) {
            return id;
        }
        slot = (slot + 1) & mask;
    }
    return -1;
}

// Summaries of the runtime functions (checker builtins, runtime/
// track_runtime.c, compiler/rt). Raw machine builtins (syscall6, load64,
// store64, load8, store8) are deliberately absent: an argument to them
// escapes (docs/lifecycles.md §1.1).
fn rt_summaries(c: i64) -> i64 {
    // output
    rt(c, "print", "r", "-");
    rt(c, "println", "r", "-");
    rt(c, "print_int", "r", "-");
    rt(c, "print_hex", "r", "-");
    rt(c, "print_str", "r", "-");
    rt(c, "print_err", "r", "-");
    rt(c, "eprint", "r", "-");
    rt(c, "track_out", "r", "-");
    rt(c, "track_err", "r", "-");
    // memory
    rt(c, "alloc", "n", "f");
    rt(c, "dealloc", "s", "-");
    rt(c, "mem_realloc", "kn", "0");
    rt(c, "memset", "mnn", "-");
    rt(c, "memcpy", "msn", "-"); // src words land in dst: treat as stored
    rt(c, "memcmp", "rrn", "-");
    rt(c, "track_words_copy", "rn", "0"); // copied words may alias src cells
    rt(c, "array_len", "r", "-");
    // strings
    rt(c, "str_len", "r", "-");
    rt(c, "str_eq", "rr", "-");
    rt(c, "str_from_literal", "r", "f");
    rt(c, "str_concat", "rr", "f");
    rt(c, "str_free", "s", "-");
    rt(c, "track_str_free", "s", "-");
    rt(c, "str_find", "rr", "-");
    rt(c, "str_contains", "rr", "-");
    rt(c, "str_to_int", "r", "-");
    rt(c, "str_is_int", "r", "-");
    rt(c, "int_to_str", "n", "f");
    rt(c, "str_starts_with", "rr", "-");
    rt(c, "str_ends_with", "rr", "-");
    rt(c, "str_substr", "rnn", "f");
    rt(c, "str_trim", "r", "f");
    rt(c, "str_char_at", "rn", "-");
    rt(c, "track_str_bytes", "r", "f"); // a new collection of the bytes
    rt(c, "path_basename", "r", "f");
    rt(c, "path_ext", "r", "f");
    rt(c, "path_join", "rr", "f");
    // collections
    rt(c, "vec_init", "n", "f");
    rt(c, "vec_push", "ms", "-");
    rt(c, "vec_get", "rn", "0");
    rt(c, "vec_set", "mns", "-");
    rt(c, "vec_pop", "m", "0");
    rt(c, "vec_len", "r", "-");
    rt(c, "vec_clear", "m", "-");
    rt(c, "vec_reserve", "mn", "-");
    rt(c, "vec_free", "s", "-");
    rt(c, "ring_init", "n", "f");
    rt(c, "ring_push", "ms", "-");
    rt(c, "ring_pop", "m", "0");
    rt(c, "ring_peek", "r", "0");
    rt(c, "ring_full", "r", "-");
    rt(c, "ring_empty", "r", "-");
    rt(c, "ring_count", "r", "-");
    rt(c, "track_i64_collection_new", "n", "f");
    rt(c, "track_i64_collection_len", "r", "-");
    rt(c, "track_i64_collection_push", "ms", "-");
    rt(c, "track_i64_collection_get", "rn", "0");
    rt(c, "track_i64_collection_set", "mns", "-");
    rt(c, "track_i64_collection_pop", "m", "0");
    rt(c, "track_i64_collection_truncate", "mn", "-");
    rt(c, "track_i64_collection_free", "s", "-");
    rt(c, "track_sb_new", "", "f");
    rt(c, "track_sb_push", "mr", "-");
    rt(c, "track_sb_push_byte", "mn", "-");
    rt(c, "track_sb_push_int", "mn", "-");
    rt(c, "track_sb_len", "r", "-");
    rt(c, "track_sb_str", "r", "f");
    rt(c, "track_sb_clear", "m", "-");
    rt(c, "track_sb_free", "s", "-");
    // files and io
    rt(c, "read", "", "-");
    rt(c, "read_line", "", "f");
    rt(c, "file_open", "rr", "f");
    rt(c, "file_close", "s", "-");
    rt(c, "file_read_all", "r", "f");
    rt(c, "file_write", "mr", "-");
    rt(c, "file_exists", "r", "-");
    rt(c, "file_remove", "r", "-");
    rt(c, "file_size", "r", "-");
    rt(c, "file_copy", "rr", "-");
    rt(c, "dir_exists", "r", "-");
    rt(c, "track_file_read", "r", "f");
    rt(c, "track_file_write_all", "rr", "-");
    // system
    rt(c, "abort", "r", "-");
    rt(c, "exit", "n", "-");
    rt(c, "sys_exit", "n", "-");
    rt(c, "sys_exec", "r", "-");
    rt(c, "process_spawn", "r", "-");
    rt(c, "clock_ms", "", "-");
    rt(c, "env_get", "r", "f");
    rt(c, "env_exists", "r", "-");
    rt(c, "os_args_count", "", "-");
    rt(c, "os_arg", "n", "f");
    rt(c, "sys_set_memory_limit", "n", "-");
    rt(c, "sys_get_memory_used", "", "-");
    rt(c, "net_socket_tcp_listen", "n", "-");
    rt(c, "net_socket_accept", "n", "-");
    rt(c, "net_socket_connect", "rn", "-");
    rt(c, "net_socket_send", "nrn", "-");
    rt(c, "net_socket_recv", "nmn", "-");
    rt(c, "net_socket_close", "n", "-");
    // pure scalars
    rt(c, "math_abs", "n", "-");
    rt(c, "math_min", "nn", "-");
    rt(c, "math_max", "nn", "-");
    rt(c, "math_clamp", "nnn", "-");
    rt(c, "math_pow", "nn", "-");
    rt(c, "math_sqrt", "n", "-");
    rt(c, "math_floor", "n", "-");
    rt(c, "math_ceil", "n", "-");
    rt(c, "math_round", "n", "-");
    rt(c, "math_random", "", "-");
    rt(c, "char_is_digit", "n", "-");
    rt(c, "char_is_alpha", "n", "-");
    rt(c, "char_is_alphanumeric", "n", "-");
    rt(c, "char_is_space", "n", "-");
    rt(c, "char_to_upper", "n", "-");
    rt(c, "char_to_lower", "n", "-");
    return 0;
}

// Record offset of the summary of function `name`, or -1.
fn life_summary(c: i64, name: i64) -> i64 {
    let byname = vget(ck(c, CK_LIFE), 1);
    if name < 0 || name >= vlen(byname) {
        return -1;
    }
    return vget(byname, name);
}

fn life_records(c: i64) -> i64 { return vget(ck(c, CK_LIFE), 0); }

// ----------------------------------------------------------------- dump

fn use_text(u: i64) -> i64 {
    if u == U_MUT { return "mutate"; }
    if u == U_READ { return "read"; }
    return "none";
}

fn end_text(e: i64) -> i64 {
    if e == 0 {
        return "-";
    }
    let b = sb_new();
    let mut sep = false;
    if (e & E_DIE) != 0 {
        sb_add(b, "die");
        sep = true;
    }
    if (e & E_RET) != 0 {
        if sep { sb_add(b, ","); }
        sb_add(b, "ret");
        sep = true;
    }
    if (e & E_ESC) != 0 {
        if sep { sb_add(b, ","); }
        sb_add(b, "esc");
    }
    return sb_text(b);
}

fn origin_text(c: i64, f: i64, o: i64) -> i64 {
    if o == 0 {
        return "none";
    }
    let params = nc(c, f);
    let b = sb_new();
    let mut sep = false;
    let mut k: i64 = 0;
    while k < list_len(c, params) / 2 && k < O_MAXPARAMS {
        if ((o >> k) & 1) == 1 {
            if sep { sb_add(b, " "); }
            sb_add(b, "derived(");
            sb_add(b, name_text(c, list_at(c, params, k * 2)));
            sb_add(b, ")");
            sep = true;
        }
        k = k + 1;
    }
    if (o & O_FRESH) != 0 {
        if sep { sb_add(b, " "); }
        sb_add(b, "fresh");
        sep = true;
    }
    if (o & O_STATIC) != 0 {
        if sep { sb_add(b, " "); }
        sb_add(b, "static");
        sep = true;
    }
    if (o & O_UNKNOWN) != 0 {
        if sep { sb_add(b, " "); }
        sb_add(b, "unknown");
    }
    return sb_text(b);
}

// One block per function, in load order:
//   fn <name>
//     param <name> owned|ref|copy [use=<use> end=<ends>]
//     result void|copy|<origin set>
//     effects none|calls
//     scc size=<members> passes=<n>      (recursive functions only)
fn life_dump(c: i64) -> i64 {
    let recs = life_records(c);
    let b = sb_new();
    let mut at: i64 = 0;
    while at < vlen(recs) {
        let f = vget(recs, at + LR_FN);
        let np = vget(recs, at + LR_NP);
        let params = nc(c, f);
        sb_add(b, "fn ");
        sb_add(b, name_text(c, na(c, f)));
        sb_byte(b, 10);
        let mut k: i64 = 0;
        while k < np {
            let ty = list_at(c, params, k * 2 + 1);
            sb_add(b, "  param ");
            sb_add(b, name_text(c, list_at(c, params, k * 2)));
            if ty_is_ref(c, ty) {
                sb_add(b, " ref");
            } else if life_tracked(c, ty) {
                sb_add(b, " owned");
            } else {
                sb_add(b, " copy");
            }
            if life_tracked(c, ty) {
                sb_add(b, " use=");
                sb_add(b, use_text(vget(recs, at + LR_PARAMS + k * 2)));
                sb_add(b, " end=");
                sb_add(b, end_text(vget(recs, at + LR_PARAMS + k * 2 + 1)));
            }
            sb_byte(b, 10);
            k = k + 1;
        }
        sb_add(b, "  result ");
        if !fn_returns_value(c, f) {
            sb_add(b, "void");
        } else if !life_tracked(c, nd(c, f)) {
            sb_add(b, "copy");
        } else {
            sb_add(b, origin_text(c, f, vget(recs, at + LR_RES)));
        }
        sb_byte(b, 10);
        if (vget(recs, at + LR_FLAGS) & LF_EFFECT) != 0 {
            sb_add(b, "  effects calls\n");
        } else {
            sb_add(b, "  effects none\n");
        }
        if vget(recs, at + LR_SCC) > 0 {
            sb_add(b, "  scc size=");
            sb_int(b, vget(recs, at + LR_SCC));
            sb_add(b, " passes=");
            sb_int(b, vget(recs, at + LR_PASSES));
            sb_byte(b, 10);
        }
        at = at + LR_PARAMS + np * 2;
    }
    return sb_text(b);
}

// ------------------------------------------------------- warnings (L6)
//
// Lifecycle warnings W0301-W0305 (docs/lifecycles.md §2). They run after
// the summaries are final, in one more walk per function that mirrors the
// checker's scopes (declare / bind_pattern / truncate_vars) so names
// resolve exactly as they did while checking. Per slot it records the
// binding `let`, whether the value was read, and a pending write (a field
// store, or a call that mutates it through `&`) that no read has followed
// yet. A slot's warnings are decided when its scope closes. A read
// anywhere in a loop body keeps a write in the same body alive, since the
// next iteration may read it.
//   W0301 a `let` binding is never read
//   W0302 a field or element store into a local is never read
//   W0303 a call mutates a local through `&`, and it is never read again
//   W0304 a call's result is discarded and the call has no other effect
//   W0305 a by-value parameter is only read
// `_`-prefixed names silence them.

const WS_BASE = 0;  // first slot of the function
const WS_ROWS = 1;  // per-slot rows, WR words each, from WS_BASE
const WS_SEQ = 2;   // event counter (reads and pending writes)
const WS_PURE = 3;  // purity memo by record offset: 0 unknown, 2 pure, 3 impure, 10+depth visiting
const WS_LOW = 4;   // shallowest visiting depth a purity search leaned on
const WS_WIDTH = 5;

const WR_DECL = 0;  // the K_LET node, or -1 (parameters, patterns, lenses)
const WR_READ = 1;  // 1 once the value is read
const WR_LAST = 2;  // event number of the last read
const WR_PEND = 3;  // node of a write no read has followed, or -1
const WR_PCALL = 4; // 1 when the pending write is a mutating call
const WR_PSEQ = 5;  // event number of the pending write
const WR_LOCAL = 6; // 1 for an owned, non-reference local (its writes can be dead)
const WR = 7;

fn wsg(w: i64, i: i64) -> i64 { return vget(w, i); }

fn wtick(w: i64) -> i64 {
    vset(w, WS_SEQ, vget(w, WS_SEQ) + 1);
    return vget(w, WS_SEQ);
}

fn wrow(w: i64, slot: i64) -> i64 { return (slot - wsg(w, WS_BASE)) * WR; }
fn wget(w: i64, slot: i64, f: i64) -> i64 { return vget(wsg(w, WS_ROWS), wrow(w, slot) + f); }
fn wset(w: i64, slot: i64, f: i64, x: i64) -> i64 { return vset(wsg(w, WS_ROWS), wrow(w, slot) + f, x); }

// Give every slot declared since the last sync a blank row.
fn wsync(c: i64, w: i64) -> i64 {
    let rows = wsg(w, WS_ROWS);
    let want = (var_count(c) - wsg(w, WS_BASE)) * WR;
    while vlen(rows) < want {
        vpush(rows, -1); // WR_DECL
        vpush(rows, 0);
        vpush(rows, 0);
        vpush(rows, -1); // WR_PEND
        vpush(rows, 0);
        vpush(rows, 0);
        vpush(rows, 0);
    }
    return 0;
}

// The function slot `name` resolves to, or -1 for globals and unknowns.
fn wslot(c: i64, w: i64, name: i64) -> i64 {
    let slot = lookup(c, name);
    if slot < wsg(w, WS_BASE) {
        return -1;
    }
    return slot;
}

fn wread(c: i64, w: i64, name: i64) -> i64 {
    let slot = wslot(c, w, name);
    if slot < 0 {
        return 0;
    }
    wset(w, slot, WR_READ, 1);
    wset(w, slot, WR_LAST, wtick(w));
    wset(w, slot, WR_PEND, -1);
    return 0;
}

// Record a write to `slot` that only a later read can justify. The first
// unread write is the one reported.
fn wpend(w: i64, slot: i64, node: i64, is_call: i64) -> i64 {
    if wget(w, slot, WR_PEND) < 0 {
        wset(w, slot, WR_PEND, node);
        wset(w, slot, WR_PCALL, is_call);
        wset(w, slot, WR_PSEQ, wtick(w));
    }
    return 0;
}

fn silenced(c: i64, name: i64) -> bool {
    return str_char_at(name_text(c, name), 0) == 95;
}

// Line of the `}` closing the block that holds the statement at `pos`.
fn scope_end_line(c: i64, pos: i64) -> i64 {
    let f = file_of_pos(c, pos);
    let src = vget(cx(c, CX_SRCS), f);
    let n = text_len(src);
    let mut i = pos - vget(cx(c, CX_BASES), f);
    let mut depth: i64 = 0;
    let mut done = false;
    while !done && i < n {
        let ch = str_char_at(src, i);
        if ch == 34 {
            i = i + 1;
            while i < n && str_char_at(src, i) != 34 {
                if str_char_at(src, i) == 92 {
                    i = i + 1;
                }
                i = i + 1;
            }
        } else if ch == 47 && i + 1 < n && str_char_at(src, i + 1) == 47 {
            while i < n && str_char_at(src, i) != 10 {
                i = i + 1;
            }
        } else if ch == 123 {
            depth = depth + 1;
        } else if ch == 125 {
            if depth == 0 {
                done = true;
            }
            depth = depth - 1;
        }
        if !done {
            i = i + 1;
        }
    }
    let mut line: i64 = 1;
    let mut j: i64 = 0;
    while j < i && j < n {
        if str_char_at(src, j) == 10 {
            line = line + 1;
        }
        j = j + 1;
    }
    return line;
}

// The variable node at the base of a store target (no derefs: see wassign).
fn store_root_node(c: i64, n: i64) -> i64 {
    let k = nk(c, n);
    if k == K_FIELD || k == K_TINDEX || k == K_INDEX {
        return store_root_node(c, na(c, n));
    }
    return n;
}

// Source-like text of a store target: `p.y`, `p.0`, `p[..]`.
fn place_text(c: i64, n: i64) -> i64 {
    let k = nk(c, n);
    if k == K_VAR {
        return name_text(c, na(c, n));
    }
    if k == K_FIELD {
        return text_cat3(place_text(c, na(c, n)), ".", name_text(c, nb(c, n)));
    }
    if k == K_TINDEX {
        return text_cat3(place_text(c, na(c, n)), ".", text_of_int(nb(c, n)));
    }
    if k == K_INDEX {
        return text_cat(place_text(c, na(c, n)), "[..]");
    }
    return "_";
}

// Decide the warnings of the slots from `count` up, then drop them.
fn wscope_end(c: i64, w: i64, count: i64) -> i64 {
    let mut slot = count;
    while slot < var_count(c) {
        let decl = wget(w, slot, WR_DECL);
        let name = vf(c, slot, V_NAME);
        if decl >= 0 && !silenced(c, name) {
            let q = quoted(c, name);
            let pend = wget(w, slot, WR_PEND);
            if wget(w, slot, WR_READ) == 0 {
                warn_at(c, npos(c, decl), "W0301", text_cat3(q, " is created and never read; remove it or name it '_",
                    text_cat(name_text(c, name), "'.")));
            } else if pend >= 0 && wget(w, slot, WR_PCALL) == 1 {
                warn_at(c, npos(c, pend), "W0303", text_cat3(text_cat3("'", name_text(c, na(c, pend)), "' mutates "),
                    q, text_cat3(", but ", q, " is never read afterwards.")));
            } else if pend >= 0 {
                let line = text_of_int(scope_end_line(c, npos(c, decl)));
                warn_at(c, npos(c, store_root_node(c, pend)), "W0302", text_cat3(text_cat3("write to '", place_text(c, pend), "' is never read; "),
                    q, text_cat3(" ends at line ", line, ".")));
            }
        }
        slot = slot + 1;
    }
    truncate_vars(c, count);
    vtrunc(wsg(w, WS_ROWS), (count - wsg(w, WS_BASE)) * WR);
    return 0;
}

// A loop body read keeps the body's own writes alive: the next iteration
// may read them. Slots below `count` existed before the loop.
fn wloop_end(c: i64, w: i64, start: i64, count: i64) -> i64 {
    let mut slot = wsg(w, WS_BASE);
    while slot < count {
        if wget(w, slot, WR_PEND) >= 0 && wget(w, slot, WR_PSEQ) > start && wget(w, slot, WR_LAST) > start {
            wset(w, slot, WR_PEND, -1);
        }
        slot = slot + 1;
    }
    return 0;
}

// A block's statements; the last one's value is used when `used`.
fn wblock(c: i64, w: i64, body: i64, used: bool) -> i64 {
    let count = var_count(c);
    let len = list_len(c, body);
    let mut i: i64 = 0;
    while i < len {
        let n = list_at(c, body, i);
        wk(c, w, n, used && i == len - 1);
        if nk(c, n) == K_RETURN {
            i = len;
        }
        i = i + 1;
    }
    wscope_end(c, w, count);
    return 0;
}

fn wlist(c: i64, w: i64, l: i64, from: i64, step: i64) -> i64 {
    let mut i = from;
    while i < list_len(c, l) {
        wk(c, w, list_at(c, l, i), true);
        i = i + step;
    }
    return 0;
}

fn place_has_deref(c: i64, n: i64) -> bool {
    let k = nk(c, n);
    if k == K_UN {
        return true;
    }
    if k == K_FIELD || k == K_TINDEX || k == K_INDEX {
        return place_has_deref(c, na(c, n));
    }
    return false;
}

fn wassign(c: i64, w: i64, n: i64) -> i64 {
    let target = na(c, n);
    wk(c, w, nb(c, n), true);
    if nk(c, target) == K_VAR {
        return 0; // rebinding writes the variable, it reads nothing
    }
    let mut p = target;
    while nk(c, p) == K_FIELD || nk(c, p) == K_TINDEX || nk(c, p) == K_INDEX || nk(c, p) == K_UN {
        if nk(c, p) == K_INDEX {
            wk(c, w, nb(c, p), true);
        }
        if nk(c, p) == K_UN {
            p = nb(c, p);
        } else {
            p = na(c, p);
        }
    }
    let name = place_var(c, target);
    if name < 0 {
        return 0;
    }
    let slot = wslot(c, w, name);
    if slot >= 0 && wget(w, slot, WR_LOCAL) == 1 && !place_has_deref(c, target) {
        return wpend(w, slot, target, 0);
    }
    // A store through a reference, a lens or a parameter: whoever lent
    // the value sees it.
    return wread(c, w, name);
}

fn wcall(c: i64, w: i64, n: i64, used: bool) -> i64 {
    let args = nb(c, n);
    wlist(c, w, args, 0, 1);
    let at = life_callee(c, na(c, n));
    if at < 0 {
        return 0;
    }
    let recs = life_records(c);
    let np = vget(recs, at + LR_NP);
    let mut i: i64 = 0;
    while i < list_len(c, args) && i < np {
        let a = list_at(c, args, i);
        if nk(c, a) == K_ADDR && nk(c, na(c, a)) == K_VAR && vget(recs, at + LR_PARAMS + i * 2) == U_MUT {
            let slot = wslot(c, w, na(c, na(c, a)));
            if slot >= 0 && wget(w, slot, WR_LOCAL) == 1 {
                wpend(w, slot, n, 1);
            }
        }
        i = i + 1;
    }
    if !used {
        wdiscard(c, w, n, at);
    }
    return 0;
}

// W0304: the call's result is dropped, and the callee only reads its
// parameters, ends none of them by `esc`, returns a fresh (or copy) value
// and reaches no call with an effect.
fn wdiscard(c: i64, w: i64, n: i64, at: i64) -> i64 {
    let recs = life_records(c);
    let f = vget(recs, at + LR_FN);
    if !fn_returns_value(c, f) {
        return 0;
    }
    if (vget(recs, at + LR_RES) & (O_PARAMS | O_STATIC | O_UNKNOWN)) != 0 {
        return 0;
    }
    vset(w, WS_LOW, 1000000);
    if !pure_fn(c, w, at, 0) {
        return 0;
    }
    let mut what = "returns a value";
    if life_tracked(c, nd(c, f)) {
        what = "returns a fresh value";
    }
    let q = text_cat3("'", name_text(c, na(c, n)), "'");
    return warn_at(c, npos(c, n), "W0304", text_cat3(text_cat3("result of ", q, " is discarded, and "),
        q, text_cat3(" has no other effect (it only reads its parameters and ", what, ").")));
}

// True when the program function at record `at` has no effect: no
// parameter mutated or escaping, and every call it makes (transitively)
// is to such a function or to a side-effect-free runtime function.
// Results are memoized, except a "pure" that leaned on a function still
// being searched further up: that one may yet turn out impure.
fn pure_fn(c: i64, w: i64, at: i64, depth: i64) -> bool {
    let memo = wsg(w, WS_PURE);
    let m = vget(memo, at);
    if m == 2 {
        return true;
    }
    if m == 3 {
        return false;
    }
    if m >= 10 {
        if m - 10 < wsg(w, WS_LOW) {
            vset(w, WS_LOW, m - 10);
        }
        return true;
    }
    let recs = life_records(c);
    let mut ok = true;
    let np = vget(recs, at + LR_NP);
    let mut k: i64 = 0;
    while k < np {
        if vget(recs, at + LR_PARAMS + k * 2) == U_MUT || (vget(recs, at + LR_PARAMS + k * 2 + 1) & E_ESC) != 0 {
            ok = false;
        }
        k = k + 1;
    }
    let low_before = wsg(w, WS_LOW);
    vset(w, WS_LOW, 1000000);
    if ok {
        vset(memo, at, 10 + depth);
        ok = pure_list(c, w, ne(c, vget(recs, at + LR_FN)), 0, 1, depth + 1);
    }
    let low = wsg(w, WS_LOW);
    if !ok {
        vset(memo, at, 3);
    } else if low >= depth {
        vset(memo, at, 2);
    } else {
        vset(memo, at, 0);
    }
    if low < low_before {
        vset(w, WS_LOW, low);
    } else {
        vset(w, WS_LOW, low_before);
    }
    return ok;
}

// Runtime functions that only compute a value (allocation included).
fn rt_pure_name(s: i64) -> bool {
    if text_starts(s, "str_") || text_starts(s, "path_") || text_starts(s, "char_") {
        return true;
    }
    if text_starts(s, "math_") {
        return !text_eq(s, "math_random");
    }
    return text_eq(s, "int_to_str") || text_eq(s, "memcmp") || text_eq(s, "array_len") || text_eq(s, "alloc")
        || text_eq(s, "vec_init") || text_eq(s, "vec_get") || text_eq(s, "vec_len")
        || text_eq(s, "ring_init") || text_eq(s, "ring_peek") || text_eq(s, "ring_full")
        || text_eq(s, "ring_empty") || text_eq(s, "ring_count")
        || text_eq(s, "track_i64_collection_new") || text_eq(s, "track_i64_collection_len")
        || text_eq(s, "track_i64_collection_get") || text_eq(s, "track_sb_new") || text_eq(s, "track_sb_len")
        || text_eq(s, "track_sb_str") || text_eq(s, "track_str_bytes") || text_eq(s, "track_words_copy");
}

fn pure_call(c: i64, w: i64, n: i64, depth: i64) -> bool {
    let callee = life_callee(c, na(c, n));
    if callee >= 0 {
        if !pure_fn(c, w, callee, depth) {
            return false;
        }
    } else if callee <= C_RT0 {
        let recs = vget(ck(c, CK_LIFE), LT_RTRECS);
        let at = C_RT0 - callee;
        let mut k: i64 = 0;
        while k < vget(recs, at + LR_NP) {
            if vget(recs, at + LR_PARAMS + k * 2) == U_MUT || (vget(recs, at + LR_PARAMS + k * 2 + 1) & E_ESC) != 0 {
                return false;
            }
            k = k + 1;
        }
        if !rt_pure_name(name_text(c, last_segment(c, na(c, n)))) {
            return false;
        }
    } else {
        return false;
    }
    return pure_list(c, w, nb(c, n), 0, 1, depth);
}

fn pure_node(c: i64, w: i64, n: i64, depth: i64) -> bool {
    if n < 0 {
        return true;
    }
    let k = nk(c, n);
    if k == K_INT || k == K_BOOL || k == K_STR || k == K_VAR {
        return true;
    }
    if k == K_CALL {
        return pure_call(c, w, n, depth);
    }
    if k == K_MACROCALL {
        return false;
    }
    if k == K_BIN {
        return pure_node(c, w, nb(c, n), depth) && pure_node(c, w, nc(c, n), depth);
    }
    if k == K_UN {
        return pure_node(c, w, nb(c, n), depth);
    }
    if k == K_ARRAY || k == K_TUPLE {
        return pure_list(c, w, na(c, n), 0, 1, depth);
    }
    if k == K_SINIT {
        return pure_list(c, w, nb(c, n), 1, 2, depth);
    }
    if k == K_FIELD || k == K_TINDEX || k == K_ADDR || k == K_RETURN {
        return pure_node(c, w, na(c, n), depth);
    }
    if k == K_INDEX || k == K_RANGE || k == K_ASSIGN {
        return pure_node(c, w, na(c, n), depth) && pure_node(c, w, nb(c, n), depth);
    }
    if k == K_SLICE {
        return pure_node(c, w, na(c, n), depth) && pure_node(c, w, nb(c, n), depth) && pure_node(c, w, nc(c, n), depth);
    }
    if k == K_LENS {
        return pure_list(c, w, nc(c, n), 0, 1, depth);
    }
    if k == K_IF {
        return pure_node(c, w, na(c, n), depth) && pure_list(c, w, nb(c, n), 0, 1, depth)
            && pure_list(c, w, nc(c, n), 0, 1, depth);
    }
    if k == K_WHILE {
        return pure_node(c, w, na(c, n), depth) && pure_list(c, w, nb(c, n), 0, 1, depth);
    }
    if k == K_FOR {
        return pure_node(c, w, nb(c, n), depth) && pure_list(c, w, nc(c, n), 0, 1, depth);
    }
    if k == K_MATCH {
        if !pure_node(c, w, na(c, n), depth) {
            return false;
        }
        let arms = nb(c, n);
        let mut i: i64 = 0;
        while i < list_len(c, arms) {
            if !pure_node(c, w, list_at(c, arms, i + 1), depth) || !pure_node(c, w, list_at(c, arms, i + 2), depth) {
                return false;
            }
            i = i + 3;
        }
        return true;
    }
    if k == K_LET {
        return pure_node(c, w, nd(c, n), depth);
    }
    if k == K_LETD {
        return pure_node(c, w, nc(c, n), depth);
    }
    return true;
}

fn pure_list(c: i64, w: i64, l: i64, from: i64, step: i64, depth: i64) -> bool {
    let mut i = from;
    while i < list_len(c, l) {
        if !pure_node(c, w, list_at(c, l, i), depth) {
            return false;
        }
        i = i + step;
    }
    return true;
}

// The warnings walk: `used` is false for a value nobody takes.
fn wk(c: i64, w: i64, n: i64, used: bool) -> i64 {
    if n < 0 {
        return 0;
    }
    let k = nk(c, n);
    if k == K_INT || k == K_BOOL || k == K_STR {
        return 0;
    }
    if k == K_VAR {
        return wread(c, w, na(c, n));
    }
    if k == K_BIN {
        wk(c, w, nb(c, n), true);
        return wk(c, w, nc(c, n), true);
    }
    if k == K_UN {
        return wk(c, w, nb(c, n), true);
    }
    if k == K_ARRAY || k == K_TUPLE {
        return wlist(c, w, na(c, n), 0, 1);
    }
    if k == K_SINIT {
        return wlist(c, w, nb(c, n), 1, 2);
    }
    if k == K_FIELD || k == K_TINDEX || k == K_ADDR || k == K_RETURN {
        return wk(c, w, na(c, n), true);
    }
    if k == K_INDEX || k == K_RANGE {
        wk(c, w, na(c, n), true);
        return wk(c, w, nb(c, n), true);
    }
    if k == K_SLICE {
        wk(c, w, na(c, n), true);
        wk(c, w, nb(c, n), true);
        return wk(c, w, nc(c, n), true);
    }
    if k == K_CALL {
        return wcall(c, w, n, used);
    }
    if k == K_MACROCALL {
        wlist(c, w, nb(c, n), 0, 1);
        if nc(c, n) >= 0 {
            wblock(c, w, nc(c, n), false);
        }
        return 0;
    }
    if k == K_LENS {
        wread(c, w, na(c, n));
        let target = lookup(c, na(c, n));
        let mut ty: i64 = -1;
        if target >= 0 {
            ty = vf(c, target, V_TYPE);
        }
        let count = var_count(c);
        let lens = declare(c, nb(c, n), ty, 0);
        vf_set(c, lens, V_LENS, 1);
        wsync(c, w);
        wblock(c, w, nc(c, n), used);
        return wscope_end(c, w, count);
    }
    if k == K_IF {
        wk(c, w, na(c, n), true);
        wblock(c, w, nb(c, n), used);
        return wblock(c, w, nc(c, n), used);
    }
    if k == K_MATCH {
        let target = na(c, n);
        wk(c, w, target, true);
        let mut tt = infer_type(c, target);
        if tt < 0 {
            tt = ck(c, CK_TY_UNK);
        }
        let arms = nb(c, n);
        let mut i: i64 = 0;
        while i < list_len(c, arms) {
            let count = var_count(c);
            bind_pattern(c, list_at(c, arms, i), tt, 0);
            wsync(c, w);
            wk(c, w, list_at(c, arms, i + 1), true);
            wk(c, w, list_at(c, arms, i + 2), used);
            wscope_end(c, w, count);
            i = i + 3;
        }
        return 0;
    }
    if k == K_WHILE {
        let start = wsg(w, WS_SEQ);
        let count = var_count(c);
        wk(c, w, na(c, n), true);
        wblock(c, w, nb(c, n), false);
        return wloop_end(c, w, start, count);
    }
    if k == K_FOR {
        let iter = nb(c, n);
        wk(c, w, iter, true);
        let start = wsg(w, WS_SEQ);
        let count = var_count(c);
        declare(c, na(c, n), for_elem_type(c, infer_type(c, iter)), 0);
        wsync(c, w);
        wblock(c, w, nc(c, n), false);
        wscope_end(c, w, count);
        return wloop_end(c, w, start, count);
    }
    if k == K_ASSIGN {
        return wassign(c, w, n);
    }
    if k == K_LET {
        wk(c, w, nd(c, n), true);
        let mut ty = nc(c, n);
        if ty < 0 {
            ty = infer_type(c, nd(c, n));
        }
        let slot = declare(c, na(c, n), ty, nb(c, n));
        wsync(c, w);
        wset(w, slot, WR_DECL, n);
        if !ty_is_ref(c, ty) && life_tracked(c, ty) {
            wset(w, slot, WR_LOCAL, 1);
        }
        return 0;
    }
    if k == K_LETD {
        wk(c, w, nc(c, n), true);
        let mut ty = infer_type(c, nc(c, n));
        if ty < 0 {
            ty = ck(c, CK_TY_UNK);
        }
        bind_pattern(c, na(c, n), ty, nb(c, n));
        return wsync(c, w);
    }
    return 0;
}

fn type_text(c: i64, t: i64) -> i64 {
    let k = nk(c, t);
    if k == T_CUSTOM {
        return name_text(c, na(c, t));
    }
    if k == T_REF {
        return text_cat("&", type_text(c, na(c, t)));
    }
    if k == T_SLICE {
        return text_cat("[]", type_text(c, na(c, t)));
    }
    if k == T_ARRAY {
        return text_cat3(text_cat("[", type_text(c, na(c, t))), "; ", text_cat(text_of_int(nb(c, t)), "]"));
    }
    if k == T_PTR {
        return text_cat3("ptr<", type_text(c, na(c, t)), ">");
    }
    if k == T_PRIM {
        let p = na(c, t);
        if p == PRIM_U8 { return "u8"; }
        if p == PRIM_I8 { return "i8"; }
        if p == PRIM_I32 { return "i32"; }
        if p == PRIM_U32 { return "u32"; }
        if p == PRIM_U64 { return "u64"; }
        if p == PRIM_BOOL { return "bool"; }
        return "i64";
    }
    return "_";
}

// W0305: a by-value, non-copy parameter the function only reads and lets
// die. Generic templates are skipped: taking a `T` by value is the point.
fn warn_consume_only_reads(c: i64, at: i64) -> i64 {
    let recs = life_records(c);
    let f = vget(recs, at + LR_FN);
    if list_len(c, nb(c, f)) > 0 {
        return 0;
    }
    let params = nc(c, f);
    let np = vget(recs, at + LR_NP);
    let mut k: i64 = 0;
    while k < np {
        let ty = list_at(c, params, k * 2 + 1);
        let pname = list_at(c, params, k * 2);
        if !ty_is_ref(c, ty) && life_tracked(c, ty) && !silenced(c, pname)
            && vget(recs, at + LR_PARAMS + k * 2) == U_READ && vget(recs, at + LR_PARAMS + k * 2 + 1) == E_DIE {
            let fq = text_cat3("'", name_text(c, na(c, f)), "'");
            warn_at(c, npos(c, f), "W0305", text_cat3(text_cat3(fq, " takes ", quoted(c, pname)),
                " by value but only reads it; take '&", text_cat(type_text(c, ty), "' so callers keep it.")));
        }
        k = k + 1;
    }
    return 0;
}

fn warn_function(c: i64, w: i64, f: i64) -> i64 {
    let params = nc(c, f);
    let np = list_len(c, params) / 2;
    let base = var_count(c);
    vset(w, WS_BASE, base);
    vtrunc(wsg(w, WS_ROWS), 0);
    let mut k: i64 = 0;
    while k < np {
        declare(c, list_at(c, params, k * 2), list_at(c, params, k * 2 + 1), 0);
        k = k + 1;
    }
    wsync(c, w);
    wblock(c, w, ne(c, f), fn_returns_value(c, f));
    return wscope_end(c, w, base);
}

// Lifecycle warnings for every program function (after `life_program`).
fn life_warnings(c: i64) -> i64 {
    let recs = life_records(c);
    let w = vfill(vnew_cap(WS_WIDTH), WS_WIDTH, 0);
    vset(w, WS_ROWS, vnew_cap(256));
    vset(w, WS_PURE, vfill(vnew_cap(vlen(recs) + 1), vlen(recs), 0));
    let mut at: i64 = 0;
    while at < vlen(recs) {
        warn_function(c, w, vget(recs, at + LR_FN));
        warn_consume_only_reads(c, at);
        at = at + LR_PARAMS + vget(recs, at + LR_NP) * 2;
    }
    return 0;
}

// ------------------------------------------------------ placement (L7)
//
// The placement plan (docs/lifecycles.md §1.5, §3.1): for every
// allocation site (tuple, struct, array or payload-union literal, and a
// call whose result is exactly `fresh`) a PLACE and an ENDS point. Both
// backends read it; neither re-derives it. cgen reads the stack decisions
// (L8); the other places change no code yet.
//   stack          life ends in this frame. Literals only, in a `let x =
//                  lit` block statement with a statement after it. Tuples
//                  by K2's rule: `x` is afterwards only indexed,
//                  destructured, matched without binding the whole value,
//                  or reassigned; and `x = (..)` reassigning such an `x`.
//                  Struct, array and payload-union literals by the
//                  heap-autofree rule below plus element reads and writes
//                  (`x[i]`, `x[i] = v`), when the cell fits the stack cap
//                  (PL_CELL_MAX words, PL_FRAME_MAX words per function),
//                  and `x` is never reassigned a fresh cell (L9: such an
//                  `x` is heap-autofree, so every cell it held is freed),
//                  or is only reassigned cells cgen writes in place (L10,
//                  mode 4: a flat struct literal or a ret-slot call; the
//                  site is dumped `stack` with `x`'s ENDS). A `let x =
//                  f(..)` of a ret-slot function `f` is stack by the same
//                  rule: the caller passes a slot. Field writes go through
//                  the slot. A return, a store, a copy, `&x` kept anywhere,
//                  or a call whose parameter escapes or returns it keeps
//                  `x` off the stack.
//   ret-slot       the literal (or ret-slot call) is returned directly from
//                  a ret-slot function (`life_ret_slot_fn`): result origin
//                  exactly `fresh`, a flat struct or tuple type, and every
//                  `return` such a site. cgen (L10) writes it into the
//                  caller's cell, passed as a hidden last argument.
//                  `x = f(..)` of a heap-autofree `x` is dumped
//                  `heap-autofree`: the result is written into `x`'s cell.
//   heap-autofree  `let x = site` (a struct, tuple, array or union cell) where
//                  `x` may also be read through its fields or lent to
//                  calls whose parameter neither escapes nor flows into the
//                  result, and every `x = v` builds a fresh cell. cgen
//                  (L9) frees the old cell at each `x = v` and the last one
//                  when the block is left (end, or `return`). `deep` (dump)
//                  marks sites whose free also runs drop glue.
//   temp-autofree  a fresh Str or handle call that is an argument of a
//                  call which only lends it, or a discarded statement
//                  (L13b, `pl_call_args`); freed right after that call.
//                  A fresh cell argument likewise (L13c, `pl_temp_cell`),
//                  `deep` when its free runs drop glue; a flat one that
//                  fits the frame is a stack cell instead.
//                  ENDS is the consuming call's line.
//   heap           everything else, including anything uncertain.
// ENDS is the position of the last mention of `x` (stack and autofree),
// the `return` (ret-slot), or -1 (heap: no end is planned).
// Names resolve as cgen's scopes do (`bind`/`scope_end`), so the
// reassignment rule matches the local cgen binds.

const PL_NONE = 0;
const PL_STACK = 1;
const PL_RET = 2;
const PL_HEAP = 3;
const PL_AUTO = 4;
const PL_TEMP = 5;

const LT_PLACE = 13; // by node: PL_*, 0 when not a site
const LT_SITES = 14; // [fn node, site node, PL_*, ends pos]*, in walk order
const LT_DEEP = 15;  // by node: 1 when a heap-autofree site's free may run drop glue
const LT_CURTY = 16; // type of the site whose uses `pl_use_ok` mode 3 is checking
const LT_RSFN = 17;  // by fn node: 1 when it has a ret-slot entry (card L10)
const LT_HKIND = 18; // by name id: HK_* of a runtime function whose result is fresh
const LT_HFN = 19;   // by fn node: HK_* when every `return` is a fresh call of that kind
const LT_HLENT = 20; // by fn node: bits of the parameters the function only lends (L13)
const LT_HSITE = 21; // by node: HK_* of a heap-autofree Str or handle site, else 0
const LT_CURHK = 22; // HK_* of the site whose uses `pl_use_ok` mode 5 is checking
const LT_TEMP = 23;  // by node: consumer of a temp-autofree call (L13b), else -1
const LT_GFN = 24;   // by fn node: 1 when every `return` builds a glue-fresh cell (L13d)

const PS_FLAG = 0;  // by name: `pl_let`'s flag for the local it binds (below), else 0
const PS_BOUND = 1; // scope stack: (name, previous flag) pairs
const PS_FN = 2;    // function being walked (-1 for top-level statements)
const PS_RET = 3;   // 1 when its literal returns can use the caller's slot
const PS_WORDS = 4; // words of struct/array/union stack cells planned in this function
const PS_INRET = 5; // 1 while walking a `return` value (no stack temporaries there)
const PS_WIDTH = 6;

// Stack cap (§3.1): at most 32 words per cell and 4 KiB of cells per frame.
const PL_CELL_MAX = 32;
const PL_FRAME_MAX = 512;

// The flag a local is bound with: ENDS + 1 (> 0) for a K2 stack tuple,
// whose tuple reassignments get their own slot; `pl_inplace_flag(ENDS)`
// for a struct, array, union or call stack cell, whose reassignments to
// a flat struct literal or a ret-slot call rewrite the cell in place;
// `pl_inplace_flag(ENDS) - PL_AUTOFLAG` for a heap-autofree local, whose
// ret-slot call reassignments rewrite its heap cell in place.
const PL_AUTOFLAG = 1099511627776; // 1 << 40

fn pl_inplace_flag(ends: i64) -> i64 { return 0 - ends - 2; }
fn pl_flag_auto(flag: i64) -> bool { return flag <= 0 - 2 - PL_AUTOFLAG; }
fn pl_flag_inplace(flag: i64) -> bool { return flag <= 0 - 2 && !pl_flag_auto(flag); }

fn pl_flag_ends(flag: i64) -> i64 {
    if pl_flag_auto(flag) {
        return 0 - flag - 2 - PL_AUTOFLAG;
    }
    return 0 - flag - 2;
}

fn life_place_of(c: i64, n: i64) -> i64 {
    let table = ck(c, CK_LIFE);
    if vlen(table) <= LT_PLACE || n < 0 {
        return PL_NONE;
    }
    let place = vget(table, LT_PLACE);
    if n >= vlen(place) {
        return PL_NONE;
    }
    return vget(place, n);
}

// True when heap-autofree site `n` may free its owned child cells too
// (drop glue): every child cell is fresh at birth and on every
// reassignment, and no use can move a child out or swap one in.
fn life_auto_deep(c: i64, n: i64) -> bool {
    let table = ck(c, CK_LIFE);
    if vlen(table) <= LT_DEEP || n < 0 || n >= vlen(vget(table, LT_DEEP)) {
        return false;
    }
    return vget(vget(table, LT_DEEP), n) == 1;
}

// How drop glue treats a value of type `t` (card L9): 1 struct cell, 2
// tuple cell (both free their child cells of kind != 0, then the shell),
// 3 array cell (shell only: elements may be shared with a slice's
// source), 0 never freed (copy values, Str, references, unions, whose
// payload-less values are plain words, and generic parameters).
fn pl_drop_kind(c: i64, t: i64) -> i64 {
    if t < 0 {
        return 0;
    }
    let k = nk(c, t);
    if k == T_TUPLE {
        return 2;
    }
    if k == T_ARRAY {
        return 3;
    }
    if k == T_CUSTOM && generic_binding(c, na(c, t)) < 0 && struct_def(c, na(c, t)) >= 0 {
        return 1;
    }
    return 0;
}

// The type of allocation site `v`.
fn pl_site_type(c: i64, v: i64) -> i64 {
    if pl_site_kind(c, v) == 5 {
        return call_type(c, na(c, v), nb(c, v));
    }
    return infer_type(c, v);
}

// True when `v` builds a fresh cell drop glue may free: a tuple, struct or
// array literal, or a call whose result is exactly `fresh`.
fn pl_fresh_site(c: i64, v: i64) -> bool {
    let kind = pl_site_kind(c, v);
    return kind != 0 && kind != 4 && pl_drop_kind(c, pl_site_type(c, v)) != 0;
}

// True when every cell drop glue would free in `v`'s value is fresh: a
// fresh call result (origins are deep, so `fresh` covers its children),
// an array literal (its elements are never freed), or a tuple or struct
// literal whose child cells are all deep-fresh sites.
fn pl_deep_fresh(c: i64, v: i64) -> bool {
    if !pl_fresh_site(c, v) {
        return false;
    }
    let k = nk(c, v);
    let mut l: i64 = -1;
    let mut from: i64 = 0;
    let mut step: i64 = 1;
    if k == K_TUPLE {
        l = na(c, v);
    } else if k == K_SINIT {
        l = nb(c, v);
        from = 1;
        step = 2;
    } else {
        return true;
    }
    let mut decl: i64 = -1;
    if k == K_SINIT {
        decl = struct_def(c, na(c, v));
        if decl < 0 {
            return false;
        }
    }
    let mut i = from;
    while i < list_len(c, l) {
        let e = list_at(c, l, i);
        if pl_site_kind(c, e) != 0 {
            if !pl_deep_fresh(c, e) {
                return false;
            }
        } else if decl >= 0 {
            // Drop glue follows the declared field types.
            let f = struct_field_index(c, decl, list_at(c, l, i - 1));
            if f < 0 || pl_drop_kind(c, list_at(c, nb(c, decl), f * 2 + 1)) != 0 {
                return false;
            }
        } else {
            let k2 = nk(c, e);
            if k2 != K_INT && k2 != K_BOOL && k2 != K_STR {
                return false;
            }
        }
        i = i + step;
    }
    return true;
}

// True when `n` is a chain of field and tuple-element reads rooted at
// variable `name` (`name.a.0.b`).
fn pl_chain_of(c: i64, n: i64, name: i64) -> bool {
    let k = nk(c, n);
    if k == K_FIELD || k == K_TINDEX {
        return pl_chain_of(c, na(c, n), name);
    }
    return pl_is_name(c, n, name);
}

// The type of read chain `n` from the site being checked (type in
// LT_CURTY), or -2 when it cannot be followed.
fn pl_member_type(c: i64, n: i64) -> i64 {
    let k = nk(c, n);
    if k != K_FIELD && k != K_TINDEX {
        return vget(ck(c, CK_LIFE), LT_CURTY);
    }
    let t = pl_member_type(c, na(c, n));
    let kind = pl_drop_kind(c, t);
    if k == K_FIELD && kind == 1 {
        let decl = struct_def(c, na(c, t));
        let f = struct_field_index(c, decl, nb(c, n));
        if f < 0 {
            return -2;
        }
        return list_at(c, nb(c, decl), f * 2 + 1);
    }
    if k == K_TINDEX && kind == 2 {
        let elems = na(c, t);
        if nb(c, n) < 0 || nb(c, n) >= list_len(c, elems) {
            return -2;
        }
        return list_at(c, elems, nb(c, n));
    }
    return -2;
}

// True when read chain `n` from the site being checked yields a value
// drop glue never frees, so the read cannot move a freed child out.
// Chains that cannot be followed are never kept.
fn pl_member_kept(c: i64, n: i64) -> bool {
    let t = pl_member_type(c, n);
    return t != -2 && pl_drop_kind(c, t) == 0;
}

fn pl_record(c: i64, p: i64, n: i64, place: i64, ends: i64) -> i64 {
    let table = ck(c, CK_LIFE);
    vset(vget(table, LT_PLACE), n, place);
    let sites = vget(table, LT_SITES);
    vpush(sites, vget(p, PS_FN));
    vpush(sites, n);
    vpush(sites, place);
    vpush(sites, ends);
    return 0;
}

fn pl_bind(c: i64, p: i64, name: i64, flag: i64) -> i64 {
    let flags = vget(p, PS_FLAG);
    if name < 0 || name >= vlen(flags) {
        return 0;
    }
    let bound = vget(p, PS_BOUND);
    vpush(bound, name);
    vpush(bound, vget(flags, name));
    vset(flags, name, flag);
    return 0;
}

fn pl_flag(c: i64, p: i64, name: i64) -> i64 {
    let flags = vget(p, PS_FLAG);
    if name < 0 || name >= vlen(flags) {
        return 0;
    }
    return vget(flags, name);
}

fn pl_scope_end(p: i64, mark: i64) -> i64 {
    let bound = vget(p, PS_BOUND);
    let flags = vget(p, PS_FLAG);
    while vlen(bound) > mark {
        let prev = vpop(bound);
        let name = vpop(bound);
        vset(flags, name, prev);
    }
    return 0;
}

// The kind of allocation site `n` is, or 0: 1 tuple, 2 struct, 3 array,
// 4 payload-union literal, 5 call with a fresh result.
fn pl_site_kind(c: i64, n: i64) -> i64 {
    if n < 0 {
        return 0;
    }
    let k = nk(c, n);
    if k == K_TUPLE { return 1; }
    if k == K_SINIT { return 2; }
    if k == K_ARRAY { return 3; }
    if k != K_CALL {
        return 0;
    }
    let name = na(c, n);
    if is_qualified(c, name) && variant_disc(c, name) >= 0 {
        if is_payload_variant(c, name) {
            return 4;
        }
        return 0;
    }
    let callee = life_callee(c, name);
    let mut r: i64 = 0;
    if callee >= 0 {
        r = vget(vget(ck(c, CK_LIFE), LT_RECS), callee + LR_RES);
    } else if callee <= C_RT0 {
        r = vget(vget(ck(c, CK_LIFE), LT_RTRECS), C_RT0 - callee + LR_RES);
    }
    if (r == O_FRESH || pl_glue_fn(c, callee_fn(c, name))) && life_tracked(c, call_type(c, name, nb(c, n))) {
        return 5;
    }
    return 0;
}

// True when program function `f` returns a cell whose shell, and every
// child cell drop glue frees, is fresh (LT_GFN, card L13d), even though
// a Str field may be static or a parameter's (drop glue never frees Str).
fn pl_glue_fn(c: i64, f: i64) -> bool {
    let table = ck(c, CK_LIFE);
    if f < 0 || vlen(table) <= LT_GFN {
        return false;
    }
    let gfn = vget(table, LT_GFN);
    if gfn == 0 || f >= vlen(gfn) {
        return false;
    }
    return vget(gfn, f) == 1;
}

// True when every `return` in statement `n` gives a deep-fresh value
// (`pl_deep_fresh`: a literal whose child cells are fresh, or a fresh
// call, which LT_GFN may already admit).
fn pl_glue_rets_ok(c: i64, n: i64) -> bool {
    if n < 0 {
        return true;
    }
    let k = nk(c, n);
    if k == K_RETURN {
        return na(c, n) >= 0 && pl_deep_fresh(c, na(c, n));
    }
    if k == K_IF { return pl_glue_rets_ok(c, na(c, n)) && pl_glue_rets_list(c, nb(c, n), 0, 1) && pl_glue_rets_list(c, nc(c, n), 0, 1); }
    if k == K_WHILE { return pl_glue_rets_list(c, nb(c, n), 0, 1); }
    if k == K_FOR || k == K_LENS { return pl_glue_rets_list(c, nc(c, n), 0, 1); }
    if k == K_LET { return pl_glue_rets_ok(c, nd(c, n)); }
    if k == K_LETD { return pl_glue_rets_ok(c, nc(c, n)); }
    if k == K_ASSIGN { return pl_glue_rets_ok(c, nb(c, n)); }
    if k == K_MATCH { return pl_glue_rets_list(c, nb(c, n), 2, 3); }
    return true;
}

fn pl_glue_rets_list(c: i64, l: i64, from: i64, step: i64) -> bool {
    let mut i = from;
    while i < list_len(c, l) {
        if !pl_glue_rets_ok(c, list_at(c, l, i)) {
            return false;
        }
        i = i + step;
    }
    return true;
}

// LT_GFN: the least set of non-generic functions whose summary result is
// fresh with no unknown part, no cell parameter in it (a Str field may
// still be static or a parameter's), and whose every `return` is
// deep-fresh. Marks are only ever set, so a member stays valid.
fn pl_glue_fns(c: i64) -> i64 {
    let table = ck(c, CK_LIFE);
    let gfn = vfill(vnew_cap(node_count(c) + 1), node_count(c), 0);
    vset(table, LT_GFN, gfn);
    let items = cx(c, CX_ITEMS);
    let cand = vnew();
    let mut i: i64 = 0;
    while i < vlen(items) {
        let f = vget(items, i);
        if nk(c, f) == K_FN && list_len(c, nb(c, f)) <= 0 && pl_drop_kind(c, nd(c, f)) != 0 && pl_ends_in_return(c, ne(c, f)) {
            let at = life_summary(c, na(c, f));
            if at >= 0 {
                let res = vget(life_records(c), at + LR_RES);
                let mut ok = (res & O_FRESH) != 0 && (res & O_UNKNOWN) == 0 && res != O_FRESH;
                let params = nc(c, f);
                let mut q: i64 = 0;
                while ok && q < O_MAXPARAMS && q * 2 < list_len(c, params) {
                    if ((res >> q) & 1) == 1 && pl_drop_kind(c, list_at(c, params, q * 2 + 1)) != 0 {
                        ok = false;
                    }
                    q = q + 1;
                }
                if ok {
                    vpush(cand, f);
                }
            }
        }
        i = i + 1;
    }
    let mut changed = true;
    while changed {
        changed = false;
        let mut j: i64 = 0;
        while j < vlen(cand) {
            let f = vget(cand, j);
            if vget(gfn, f) == 0 && pl_glue_rets_list(c, ne(c, f), 0, 1) {
                vset(gfn, f, 1);
                changed = true;
            }
            j = j + 1;
        }
    }
    return 0;
}

fn pl_kind_text(kind: i64) -> i64 {
    if kind == 1 { return "tuple"; }
    if kind == 2 { return "struct"; }
    if kind == 3 { return "array"; }
    if kind == 4 { return "union"; }
    return "call";
}

fn pl_place_text(place: i64) -> i64 {
    if place == PL_STACK { return "stack"; }
    if place == PL_RET { return "ret-slot"; }
    if place == PL_AUTO { return "heap-autofree"; }
    if place == PL_TEMP { return "temp-autofree"; }
    return "heap";
}

// True when argument `i` of call `n` may be the plain local (or `&local`)
// without the value outliving this frame: the callee's summary of that
// parameter neither escapes nor returns it, and a by-value parameter ends
// it (`die`, so the caller ends it). Unknown callees never qualify.
fn pl_arg_ok(c: i64, n: i64, i: i64, is_addr: bool, read_only: bool) -> bool {
    let name = na(c, n);
    if is_qualified(c, name) && variant_disc(c, name) >= 0 {
        return false;
    }
    let callee = life_callee(c, name);
    let mut recs: i64 = -1;
    let mut at: i64 = 0;
    if callee >= 0 {
        recs = vget(ck(c, CK_LIFE), LT_RECS);
        at = callee;
    } else if callee <= C_RT0 {
        recs = vget(ck(c, CK_LIFE), LT_RTRECS);
        at = C_RT0 - callee;
    }
    if recs < 0 || i >= vget(recs, at + LR_NP) || i >= O_MAXPARAMS {
        return false;
    }
    let pe = vget(recs, at + LR_PARAMS + i * 2 + 1);
    if (pe & (E_ESC | E_RET)) != 0 {
        return false;
    }
    if ((vget(recs, at + LR_RES) >> i) & 1) == 1 {
        return false;
    }
    if read_only && vget(recs, at + LR_PARAMS + i * 2) > U_READ {
        return false;
    }
    return is_addr || pe != 0;
}

// True when `v` is a call whose arguments include `name` or `&name`.
fn pl_call_takes(c: i64, v: i64, name: i64) -> bool {
    if v < 0 || nk(c, v) != K_CALL {
        return false;
    }
    let args = nb(c, v);
    let mut i: i64 = 0;
    while i < list_len(c, args) {
        let a = list_at(c, args, i);
        if pl_is_name(c, a, name) || (nk(c, a) == K_ADDR && pl_is_name(c, na(c, a), name)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Words of the cell a ret-slot entry writes for result type `t`, or -1
// when `t` is not a flat struct or tuple: one whose cell owns no child
// cell drop glue would free, so a caller's slot never hides one.
fn pl_flat_words(c: i64, t: i64) -> i64 {
    let kind = pl_drop_kind(c, t);
    let mut types: i64 = -1;
    let mut from: i64 = 0;
    let mut step: i64 = 1;
    if kind == 1 {
        types = nb(c, struct_def(c, na(c, t)));
        from = 1;
        step = 2;
    } else if kind == 2 {
        types = na(c, t);
    } else {
        return -1;
    }
    let mut i = from;
    while i < list_len(c, types) {
        if pl_drop_kind(c, list_at(c, types, i)) != 0 {
            return -1;
        }
        i = i + step;
    }
    let count = list_len(c, types) / step;
    if kind == 1 {
        return 1 + count;
    }
    return pl_max(count, 1);
}

// True when the ret-slot entry for result type `t` writes every word of
// its cell before anything reads it (card L14): a struct literal stores
// the tag and every field, a tuple literal every element, and `return
// g(..)` hands the cell to an entry of the same type. Only an empty tuple
// leaves its one word unwritten. The allocating wrapper then skips zeroing.
fn pl_rs_full(c: i64, t: i64) -> bool {
    if pl_flat_words(c, t) <= 0 {
        return false;
    }
    return pl_drop_kind(c, t) != 2 || list_len(c, na(c, t)) > 0;
}

// True when function node `f` has a ret-slot entry (card L10): its
// result is exactly `fresh`, of a flat struct or tuple type, and every
// `return` builds a literal or calls a ret-slot function.
fn life_ret_slot_fn(c: i64, f: i64) -> bool {
    let table = ck(c, CK_LIFE);
    if f < 0 || vlen(table) <= LT_RSFN || vget(table, LT_RSFN) == 0 || f >= vlen(vget(table, LT_RSFN)) {
        return false;
    }
    return vget(vget(table, LT_RSFN), f) == 1;
}

// True when `v` calls a function with a ret-slot entry.
fn pl_rs_call(c: i64, v: i64) -> bool {
    if v < 0 || nk(c, v) != K_CALL {
        return false;
    }
    return life_ret_slot_fn(c, callee_fn(c, na(c, v)));
}

// True when cgen can write `v` into the cell a local already has: a flat
// struct literal (every cell of the type has its size) or a ret-slot call.
fn pl_in_place(c: i64, v: i64) -> bool {
    if pl_rs_call(c, v) {
        return true;
    }
    return nk(c, v) == K_SINIT && pl_flat_words(c, infer_type(c, v)) > 0;
}

fn pl_ends_in_return(c: i64, body: i64) -> bool {
    let len = list_len(c, body);
    if len == 0 {
        return false;
    }
    let last = list_at(c, body, len - 1);
    if nk(c, last) == K_RETURN {
        return na(c, last) >= 0;
    }
    if nk(c, last) == K_IF {
        return pl_ends_in_return(c, nb(c, last)) && pl_ends_in_return(c, nc(c, last));
    }
    return false;
}

fn pl_rets_list(c: i64, l: i64, from: i64, step: i64, rsfn: i64) -> bool {
    let mut i = from;
    while i < list_len(c, l) {
        if !pl_rets_ok(c, list_at(c, l, i), rsfn) {
            return false;
        }
        i = i + step;
    }
    return true;
}

// True when every `return` in statement `n` builds a struct or tuple
// literal or calls a function `rsfn` marks.
fn pl_rets_ok(c: i64, n: i64, rsfn: i64) -> bool {
    if n < 0 {
        return true;
    }
    let k = nk(c, n);
    if k == K_RETURN {
        let v = na(c, n);
        if v < 0 {
            return false;
        }
        let kv = nk(c, v);
        if kv == K_SINIT || kv == K_TUPLE {
            return true;
        }
        if kv == K_CALL {
            let f = callee_fn(c, na(c, v));
            return f >= 0 && vget(rsfn, f) == 1;
        }
        return false;
    }
    if k == K_IF { return pl_rets_ok(c, na(c, n), rsfn) && pl_rets_list(c, nb(c, n), 0, 1, rsfn) && pl_rets_list(c, nc(c, n), 0, 1, rsfn); }
    if k == K_WHILE { return pl_rets_list(c, nb(c, n), 0, 1, rsfn); }
    if k == K_FOR || k == K_LENS { return pl_rets_list(c, nc(c, n), 0, 1, rsfn); }
    if k == K_LET { return pl_rets_ok(c, nd(c, n), rsfn); }
    if k == K_LETD { return pl_rets_ok(c, nc(c, n), rsfn); }
    if k == K_ASSIGN { return pl_rets_ok(c, nb(c, n), rsfn); }
    if k == K_MATCH { return pl_rets_list(c, nb(c, n), 2, 3, rsfn); }
    return true;
}

// Mark the functions with a ret-slot entry (LT_RSFN): the greatest set
// where each candidate's returns only build literals or call members, so
// self and mutual recursion through `return f(..)` qualify.
fn pl_ret_fns(c: i64) -> i64 {
    let rsfn = vfill(vnew_cap(node_count(c) + 1), node_count(c), 0);
    vset(ck(c, CK_LIFE), LT_RSFN, rsfn);
    let items = cx(c, CX_ITEMS);
    let mut i: i64 = 0;
    while i < vlen(items) {
        let f = vget(items, i);
        if nk(c, f) == K_FN {
            let at = life_summary(c, na(c, f));
            let words = pl_flat_words(c, nd(c, f));
            if at >= 0 && vget(life_records(c), at + LR_RES) == O_FRESH && words > 0 && words <= PL_CELL_MAX && pl_ends_in_return(c, ne(c, f)) {
                vset(rsfn, f, 1);
            }
        }
        i = i + 1;
    }
    let mut changed = true;
    while changed {
        changed = false;
        let mut j: i64 = 0;
        while j < vlen(items) {
            let f = vget(items, j);
            if vget(rsfn, f) == 1 && !pl_rets_list(c, ne(c, f), 0, 1, rsfn) {
                vset(rsfn, f, 0);
                changed = true;
            }
            j = j + 1;
        }
    }
    return 0;
}

// ------------------------------------------- fresh Str and handles (L13)
//
// docs/lifecycles.md §3.5. A `let x = f(..)` whose call returns a fresh
// runtime object the caller owns (a Str, a Vec, an i64 collection or a
// string builder) is heap-autofree when every later mention of `x` lends
// it to a call that neither keeps nor frees it (mode 5 of `pl_use_ok`),
// and every `x = v` makes a fresh object of the same kind. The backends
// free it with the kind's runtime free function where cells are freed
// (block end, `return`, reassignment). The proof is the origin alone:
// there is no runtime check, so anything uncertain is never freed.

const HK_STR = 1;  // track_str_free
const HK_VEC = 2;  // vec_free
const HK_COLL = 3; // track_i64_collection_free
const HK_SB = 4;   // track_sb_free

fn hd_free_name(kind: i64) -> i64 {
    if kind == HK_STR { return "track_str_free"; }
    if kind == HK_VEC { return "vec_free"; }
    if kind == HK_COLL { return "track_i64_collection_free"; }
    return "track_sb_free";
}

fn hd_kind_text(kind: i64) -> i64 {
    if kind == HK_STR { return "str"; }
    if kind == HK_VEC { return "vec"; }
    if kind == HK_COLL { return "collection"; }
    return "builder";
}

fn hd_kind(c: i64, kinds: i64, name: i64, kind: i64) -> i64 {
    let id = name_find(c, name);
    if id >= 0 && id < vlen(kinds) {
        vset(kinds, id, kind);
    }
    return 0;
}

// The runtime functions whose result is a new object the caller owns,
// checked against runtime/track_runtime.c and compiler/rt: every Str one
// returns a malloc'd (C) or rt_malloc'd (Track runtime) copy, never a
// literal, and every handle a new record with its own storage.
fn hd_kinds(c: i64) -> i64 {
    let kinds = vfill(vnew_cap(name_count(c) + 1), name_count(c), 0);
    hd_kind(c, kinds, "str_from_literal", HK_STR);
    hd_kind(c, kinds, "str_concat", HK_STR);
    hd_kind(c, kinds, "int_to_str", HK_STR);
    hd_kind(c, kinds, "str_substr", HK_STR);
    hd_kind(c, kinds, "str_trim", HK_STR);
    hd_kind(c, kinds, "path_basename", HK_STR);
    hd_kind(c, kinds, "path_ext", HK_STR);
    hd_kind(c, kinds, "path_join", HK_STR);
    hd_kind(c, kinds, "track_sb_str", HK_STR);
    hd_kind(c, kinds, "read_line", HK_STR);
    hd_kind(c, kinds, "file_read_all", HK_STR);
    hd_kind(c, kinds, "track_file_read", HK_STR);
    hd_kind(c, kinds, "env_get", HK_STR);
    hd_kind(c, kinds, "os_arg", HK_STR);
    hd_kind(c, kinds, "vec_init", HK_VEC);
    hd_kind(c, kinds, "track_i64_collection_new", HK_COLL);
    hd_kind(c, kinds, "track_str_bytes", HK_COLL);
    hd_kind(c, kinds, "track_sb_new", HK_SB);
    return kinds;
}

// HK_* of the fresh object call `v` returns, or 0: a runtime function the
// table marks fresh, or a program function whose every `return` is such a
// call (LT_HFN).
fn hd_call_kind(c: i64, v: i64) -> i64 {
    if v < 0 || nk(c, v) != K_CALL {
        return 0;
    }
    let name = na(c, v);
    if is_qualified(c, name) && variant_disc(c, name) >= 0 {
        return 0;
    }
    let table = ck(c, CK_LIFE);
    let callee = life_callee(c, name);
    if callee <= C_RT0 {
        if vget(vget(table, LT_RTRECS), C_RT0 - callee + LR_RES) != O_FRESH {
            return 0;
        }
        let kinds = vget(table, LT_HKIND);
        let mut id = name;
        if id >= vlen(kinds) || vget(kinds, id) == 0 {
            id = last_segment(c, name);
        }
        if id < 0 || id >= vlen(kinds) {
            return 0;
        }
        return vget(kinds, id);
    }
    let f = callee_fn(c, name);
    let hfn = vget(table, LT_HFN);
    if f < 0 || f >= vlen(hfn) {
        return 0;
    }
    return vget(hfn, f);
}

// True when argument `i` of call `n` may be the Str or handle local being
// checked (`&local` when `is_addr`): the callee neither keeps it nor frees
// it. Runtime functions follow the table (an element a call returns is a
// word the free never touches, so a derived result is fine); program
// functions need the parameter lent (LT_HLENT) or, for tracked types, a
// summary `pl_arg_ok` accepts.
fn hd_arg_ok(c: i64, n: i64, i: i64, is_addr: bool) -> bool {
    let name = na(c, n);
    if is_qualified(c, name) && variant_disc(c, name) >= 0 {
        return false;
    }
    let callee = life_callee(c, name);
    if callee <= C_RT0 {
        let recs = vget(ck(c, CK_LIFE), LT_RTRECS);
        let at = C_RT0 - callee;
        if i >= vget(recs, at + LR_NP) {
            return false;
        }
        let pe = vget(recs, at + LR_PARAMS + i * 2 + 1);
        return pe != 0 && (pe & (E_ESC | E_RET)) == 0;
    }
    let f = callee_fn(c, name);
    let lent = vget(ck(c, CK_LIFE), LT_HLENT);
    if !is_addr && f >= 0 && f < vlen(lent) && i < O_MAXPARAMS && ((vget(lent, f) >> i) & 1) == 1 {
        return true;
    }
    return callee >= 0 && pl_arg_ok(c, n, i, is_addr, false);
}

// HK_* when every `return` in statement list `l` (from `from`, every
// `step`) is a call of one fresh kind; `cur` is the kind seen so far (0
// none yet), -1 when one does not qualify.
fn hd_rets_list(c: i64, l: i64, from: i64, step: i64, cur: i64) -> i64 {
    let mut k = cur;
    let mut i = from;
    while i < list_len(c, l) && k >= 0 {
        k = hd_rets(c, list_at(c, l, i), k);
        i = i + step;
    }
    return k;
}

fn hd_rets(c: i64, n: i64, cur: i64) -> i64 {
    if n < 0 || cur < 0 {
        return cur;
    }
    let k = nk(c, n);
    if k == K_RETURN {
        let kind = hd_call_kind(c, na(c, n));
        if kind == 0 || (cur != 0 && cur != kind) {
            return -1;
        }
        return kind;
    }
    if k == K_IF { return hd_rets_list(c, nc(c, n), 0, 1, hd_rets_list(c, nb(c, n), 0, 1, cur)); }
    if k == K_WHILE { return hd_rets_list(c, nb(c, n), 0, 1, cur); }
    if k == K_FOR || k == K_LENS { return hd_rets_list(c, nc(c, n), 0, 1, cur); }
    if k == K_MATCH { return hd_rets_list(c, nb(c, n), 2, 3, cur); }
    return cur;
}

// LT_HKIND, LT_HFN and LT_HLENT for the program. LT_HFN is the least
// fixpoint (kinds are only ever set, so a member's kind stays valid);
// LT_HLENT the greatest: every parameter starts lent and loses it when a
// mention is not a lent argument (mode 6), until nothing changes, so a
// parameter passed on to itself or a lending partner stays lent.
fn hd_program(c: i64) -> i64 {
    let table = ck(c, CK_LIFE);
    vset(table, LT_HKIND, hd_kinds(c));
    let nn = node_count(c);
    let hfn = vfill(vnew_cap(nn + 1), nn, 0);
    let lent = vfill(vnew_cap(nn + 1), nn, 0);
    vset(table, LT_HFN, hfn);
    vset(table, LT_HLENT, lent);
    let items = cx(c, CX_ITEMS);
    let mut i: i64 = 0;
    while i < vlen(items) {
        let f = vget(items, i);
        if nk(c, f) == K_FN {
            let np = list_len(c, nc(c, f)) / 2;
            if np > 0 && np < O_MAXPARAMS {
                vset(lent, f, (1 << np) - 1);
            }
        }
        i = i + 1;
    }
    // A function's checks read only the LT_HFN / LT_HLENT entries of the
    // functions it calls (hd_call_kind, hd_arg_ok), so a sweep skips a
    // function none of whose callees changed since its last check: the
    // check would repeat its last answer. `stamp` is when each function's
    // entries last changed, `seen` when each item was last checked.
    let deps = vnew_cap(vlen(items) + 1);
    let seen = vfill(vnew_cap(vlen(items) + 1), vlen(items), -1);
    let stamp = vfill(vnew_cap(nn + 1), nn, 0);
    let mut tick: i64 = 0;
    let mut d: i64 = 0;
    while d < vlen(items) {
        let f = vget(items, d);
        let fs = vnew();
        if nk(c, f) == K_FN {
            hd_scan_list(c, ne(c, f), 0, 1, fs);
        }
        vpush(deps, fs);
        d = d + 1;
    }
    let mut changed = true;
    while changed {
        changed = false;
        let mut j: i64 = 0;
        while j < vlen(items) {
            let f = vget(items, j);
            if nk(c, f) == K_FN && hd_stale(vget(deps, j), stamp, vget(seen, j)) {
                vset(seen, j, tick);
                let was_h = vget(hfn, f);
                let was_l = vget(lent, f);
                if vget(hfn, f) == 0 && pl_ends_in_return(c, ne(c, f)) {
                    let kind = hd_rets_list(c, ne(c, f), 0, 1, 0);
                    if kind > 0 {
                        vset(hfn, f, kind);
                        changed = true;
                    }
                }
                let params = nc(c, f);
                let mut bits = vget(lent, f);
                let mut q: i64 = 0;
                while q * 2 < list_len(c, params) && bits != 0 {
                    if ((bits >> q) & 1) == 1 && !pl_rest_ok(c, ne(c, f), 0, list_at(c, params, q * 2), 6) {
                        bits = bit_clear(bits, 1 << q);
                        changed = true;
                    }
                    q = q + 1;
                }
                vset(lent, f, bits);
                if vget(hfn, f) != was_h || bits != was_l {
                    tick = tick + 1;
                    vset(stamp, f, tick);
                }
            }
            j = j + 1;
        }
    }
    return 0;
}

// True when item deps `fs` hold a function changed after `seen` (-1: the
// item was never checked).
fn hd_stale(fs: i64, stamp: i64, seen: i64) -> bool {
    if seen < 0 {
        return true;
    }
    let mut i: i64 = 0;
    while i < vlen(fs) {
        if vget(stamp, vget(fs, i)) > seen {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Push every program function a call in `n` names (callee_fn), walking
// the nodes scan_calls walks.
fn hd_scan_fns(c: i64, n: i64, out: i64) -> i64 {
    if n < 0 {
        return 0;
    }
    let k = nk(c, n);
    if k == K_INT || k == K_BOOL || k == K_STR || k == K_VAR {
        return 0;
    }
    if k == K_CALL {
        let f = hd_callee_peek(c, na(c, n));
        if f >= 0 {
            vpush(out, f);
        }
        return hd_scan_list(c, nb(c, n), 0, 1, out);
    }
    if k == K_BIN || k == K_FOR {
        hd_scan_fns(c, nb(c, n), out);
        if k == K_FOR {
            return hd_scan_list(c, nc(c, n), 0, 1, out);
        }
        return hd_scan_fns(c, nc(c, n), out);
    }
    if k == K_UN {
        return hd_scan_fns(c, nb(c, n), out);
    }
    if k == K_ARRAY || k == K_TUPLE {
        return hd_scan_list(c, na(c, n), 0, 1, out);
    }
    if k == K_SINIT {
        return hd_scan_list(c, nb(c, n), 1, 2, out);
    }
    if k == K_FIELD || k == K_TINDEX || k == K_ADDR || k == K_RETURN {
        return hd_scan_fns(c, na(c, n), out);
    }
    if k == K_INDEX || k == K_RANGE || k == K_ASSIGN || k == K_SLICE {
        hd_scan_fns(c, na(c, n), out);
        hd_scan_fns(c, nb(c, n), out);
        if k == K_SLICE {
            return hd_scan_fns(c, nc(c, n), out);
        }
        return 0;
    }
    if k == K_LENS {
        return hd_scan_list(c, nc(c, n), 0, 1, out);
    }
    if k == K_IF || k == K_WHILE {
        hd_scan_fns(c, na(c, n), out);
        hd_scan_list(c, nb(c, n), 0, 1, out);
        if k == K_IF {
            return hd_scan_list(c, nc(c, n), 0, 1, out);
        }
        return 0;
    }
    if k == K_MACROCALL {
        hd_scan_list(c, nb(c, n), 0, 1, out);
        return hd_scan_list(c, nc(c, n), 0, 1, out);
    }
    if k == K_MATCH {
        hd_scan_fns(c, na(c, n), out);
        hd_scan_list(c, nb(c, n), 1, 3, out);
        return hd_scan_list(c, nb(c, n), 2, 3, out);
    }
    if k == K_LET {
        return hd_scan_fns(c, nd(c, n), out);
    }
    if k == K_LETD {
        return hd_scan_fns(c, nc(c, n), out);
    }
    return 0;
}

// callee_fn without interning: a last segment no name has yet names no
// function, and interning it here would renumber later names.
fn hd_callee_peek(c: i64, name: i64) -> i64 {
    let mut f = ni(c, name, NI_FN);
    if f < 0 {
        let bytes = text_bytes(name_text(c, name));
        let mut i: i64 = vlen(bytes) - 1;
        while i > 0 {
            if vget(bytes, i) == 58 && vget(bytes, i - 1) == 58 {
                let id = intern_find_span(c, bytes, i + 1, vlen(bytes));
                if id >= 0 {
                    f = ni(c, id, NI_FN);
                }
                i = 0;
            }
            i = i - 1;
        }
    }
    if f >= 0 && nk(c, f) == K_FN {
        return f;
    }
    return -1;
}

fn hd_scan_list(c: i64, l: i64, from: i64, step: i64, out: i64) -> i64 {
    let mut i = from;
    while i < list_len(c, l) {
        hd_scan_fns(c, list_at(c, l, i), out);
        i = i + step;
    }
    return 0;
}

// The HK_* of heap-autofree site `n`, or 0 for cells and other sites.
fn life_auto_handle(c: i64, n: i64) -> i64 {
    let table = ck(c, CK_LIFE);
    if vlen(table) <= LT_HSITE || n < 0 {
        return 0;
    }
    let sites = vget(table, LT_HSITE);
    if sites == 0 || n >= vlen(sites) {
        return 0;
    }
    return vget(sites, n);
}

// ------------------------------------------- fresh temporaries (L13b)
//
// docs/lifecycles.md §3.5. A fresh Str or handle call (`hd_call_kind`)
// that is an argument of call `n` (`f(g())` or `f(&g())`) dies when `f`
// returns when f's summary for that parameter is die-only: it neither
// keeps nor frees nor returns it, and f's result is not derived from it
// (`pl_temp_arg_ok`). The site is temp-autofree with `n` as its consumer
// (LT_TEMP); the backends free it right after `n` returns. A fresh call
// that is a statement before the last of a block is its own consumer: its
// result is discarded, so it is freed right after it returns. A `return
// g()` or `let x = g()` is never a temporary; anything uncertain is not
// freed.

fn pl_temp(c: i64, p: i64, n: i64, consumer: i64, hk: i64) -> i64 {
    let table = ck(c, CK_LIFE);
    vset(vget(table, LT_TEMP), n, consumer);
    vset(vget(table, LT_HSITE), n, hk);
    return pl_record(c, p, n, PL_TEMP, npos(c, consumer));
}

// True when argument `i` of call `n` may be a temporary freed after `n`:
// `hd_arg_ok` (neither kept nor freed) and the result of `n` neither
// derives from parameter `i` nor has an unknown origin.
fn pl_temp_arg_ok(c: i64, n: i64, i: i64, is_addr: bool) -> bool {
    if i >= O_MAXPARAMS || !hd_arg_ok(c, n, i, is_addr) {
        return false;
    }
    let callee = life_callee(c, na(c, n));
    let mut res: i64 = O_UNKNOWN;
    if callee >= 0 {
        res = vget(vget(ck(c, CK_LIFE), LT_RECS), callee + LR_RES);
    } else if callee <= C_RT0 {
        res = vget(vget(ck(c, CK_LIFE), LT_RTRECS), C_RT0 - callee + LR_RES);
    }
    return (res & O_UNKNOWN) == 0 && ((res >> i) & 1) == 0;
}

// Fresh cell temporary `v`, argument `i` of call `n` (card L13c). A flat
// struct or tuple literal, an array literal or a ret-slot call that fits
// the frame budget lives in a stack cell of this frame: it dies when `n`
// returns, so the slot is free again before the site runs again. Not in a
// `return` value, whose call may be a tail call that drops the frame.
// Anything else is temp-autofree with consumer `n`: freed right after `n`
// returns, with drop glue (deep) when every child cell is fresh and `n`
// only reads the argument, else the shell alone.
fn pl_temp_cell(c: i64, p: i64, v: i64, n: i64, i: i64, is_addr: bool) -> i64 {
    let kind = pl_site_kind(c, v);
    let lit = kind == 3 || ((kind == 1 || kind == 2) && pl_flat_words(c, pl_site_type(c, v)) > 0);
    if vget(p, PS_INRET) == 0 && (lit || pl_rs_call(c, v)) && pl_cell_fits(c, p, v) {
        vset(p, PS_WORDS, vget(p, PS_WORDS) + pl_cell_words(c, v));
        return pl_record(c, p, v, PL_STACK, npos(c, n));
    }
    let table = ck(c, CK_LIFE);
    vset(vget(table, LT_TEMP), v, n);
    if pl_deep_fresh(c, v) && pl_arg_ok(c, n, i, is_addr, true) {
        vset(vget(table, LT_DEEP), v, 1);
    }
    return pl_record(c, p, v, PL_TEMP, npos(c, n));
}

// The arguments of call `n`, in cgen's order: fresh temporaries are
// planned temp-autofree, the rest walked.
fn pl_call_args(c: i64, p: i64, n: i64) -> i64 {
    let args = nb(c, n);
    let mut i: i64 = 0;
    while i < list_len(c, args) {
        let a = list_at(c, args, i);
        let mut inner = a;
        let is_addr = nk(c, a) == K_ADDR;
        if is_addr {
            inner = na(c, a);
        }
        let hk = hd_call_kind(c, inner);
        if hk > 0 {
            if pl_temp_arg_ok(c, n, i, is_addr) {
                pl_temp(c, p, inner, n, hk);
                pl_parts(c, p, inner);
            } else {
                pl_walk(c, p, a);
            }
        } else {
            // `pl_walk(c, p, a)` unrolled, so the site kind is found once.
            let kind = pl_site_kind(c, inner);
            if kind != 0 && kind != 4 && pl_drop_kind(c, pl_site_type(c, inner)) != 0 && pl_temp_arg_ok(c, n, i, is_addr) {
                pl_temp_cell(c, p, inner, n, i, is_addr);
            } else if kind != 0 {
                pl_record(c, p, inner, PL_HEAP, -1);
            }
            pl_parts(c, p, inner);
        }
        i = i + 1;
    }
    return 0;
}

// The consumer of temp-autofree call `n` (the call it is an argument of,
// or `n` itself for a discarded statement), or -1.
fn life_temp_of(c: i64, n: i64) -> i64 {
    let table = ck(c, CK_LIFE);
    if vlen(table) <= LT_TEMP || n < 0 {
        return -1;
    }
    let t = vget(table, LT_TEMP);
    if t == 0 || n >= vlen(t) {
        return -1;
    }
    return vget(t, n);
}

fn pl_uses_ok(c: i64, l: i64, name: i64, mode: i64) -> bool {
    let mut i: i64 = 0;
    while i < list_len(c, l) {
        if !pl_use_ok(c, list_at(c, l, i), name, mode) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn pl_use_opt(c: i64, n: i64, name: i64, mode: i64) -> bool {
    if n < 0 {
        return true;
    }
    return pl_use_ok(c, n, name, mode);
}

fn pl_is_name(c: i64, n: i64, name: i64) -> bool {
    if n < 0 {
        return false;
    }
    return nk(c, n) == K_VAR && na(c, n) == name;
}

// K2's escape rule (`mode` 0) for the statements after `let name`:
// `name` stays local when it is only read by tuple indexing (`name.0`),
// destructured (`let (a, b) = name`), matched against patterns that never
// bind the whole value, or reassigned. Any other mention (returned,
// passed, stored, copied, borrowed, lens target, block value) escapes. A
// shadowing `let name` only makes it stricter. `mode` 1 (stack) also
// accepts field reads and lending to calls `pl_arg_ok` allows; mode 2
// (heap-autofree) also requires every `name = v` to build a fresh cell;
// mode 3 (drop glue) also rejects any use that may move a child cell out
// or swap one in: reading a field or element drop glue would free,
// destructuring, matching, and lending to a parameter that mutates. Mode
// 4 (stack, rewritten in place, card L10) is mode 1 except that every
// `name = v` must build a flat struct literal or call a ret-slot function,
// which cgen writes into the cell `name` already has. In every mode but 0
// and 6, `return f(.., name)` and `return f(.., &name)` escape, as ngen
// refuses them (card L11). Mode 5 (a fresh Str or handle, card L13) only
// lends `name` to calls `hd_arg_ok` allows, and every `name = v` makes a
// fresh object of the site's kind (LT_CURHK); mode 6 (a lent parameter)
// is mode 5 with no assignment at all and `return f(.., name)` allowed,
// since nothing is freed in that frame.
fn pl_use_ok(c: i64, n: i64, name: i64, mode: i64) -> bool {
    let k = nk(c, n);
    if k == K_INT || k == K_STR || k == K_BOOL { return true; }
    if k == K_VAR { return na(c, n) != name; }
    if k == K_BIN { return pl_use_ok(c, nb(c, n), name, mode) && pl_use_ok(c, nc(c, n), name, mode); }
    if k == K_UN { return pl_use_ok(c, nb(c, n), name, mode); }
    if k == K_ADDR { return pl_use_ok(c, na(c, n), name, mode); }
    if k == K_ARRAY || k == K_TUPLE { return pl_uses_ok(c, na(c, n), name, mode); }
    if mode == 3 && (k == K_FIELD || k == K_TINDEX) && pl_chain_of(c, n, name) {
        return pl_member_kept(c, n);
    }
    if k == K_TINDEX {
        if pl_is_name(c, na(c, n), name) {
            return mode < 5 && (mode != 3 || pl_member_kept(c, n));
        }
        return pl_use_ok(c, na(c, n), name, mode);
    }
    if k == K_INDEX && mode > 0 && mode < 5 && pl_is_name(c, na(c, n), name) {
        // Element read or (as an assignment target) write: the cell stays put.
        return pl_use_ok(c, nb(c, n), name, mode);
    }
    if k == K_INDEX || k == K_RANGE { return pl_use_ok(c, na(c, n), name, mode) && pl_use_ok(c, nb(c, n), name, mode); }
    if k == K_SLICE { return pl_use_ok(c, na(c, n), name, mode) && pl_use_opt(c, nb(c, n), name, mode) && pl_use_opt(c, nc(c, n), name, mode); }
    if k == K_FIELD {
        if mode > 0 && mode < 5 && pl_is_name(c, na(c, n), name) {
            return mode != 3 || pl_member_kept(c, n);
        }
        return pl_use_ok(c, na(c, n), name, mode);
    }
    if k == K_SINIT {
        let fields = nb(c, n);
        let mut i: i64 = 0;
        while i < list_len(c, fields) {
            if !pl_use_ok(c, list_at(c, fields, i + 1), name, mode) {
                return false;
            }
            i = i + 2;
        }
        return true;
    }
    if k == K_LENS { return na(c, n) != name && pl_uses_ok(c, nc(c, n), name, mode); }
    if k == K_CALL {
        if mode == 0 {
            return pl_uses_ok(c, nb(c, n), name, mode);
        }
        let args = nb(c, n);
        let mut i: i64 = 0;
        while i < list_len(c, args) {
            let a = list_at(c, args, i);
            if pl_is_name(c, a, name) {
                if mode >= 5 {
                    if !hd_arg_ok(c, n, i, false) {
                        return false;
                    }
                } else if !pl_arg_ok(c, n, i, false, mode == 3) {
                    return false;
                }
            } else if nk(c, a) == K_ADDR && pl_is_name(c, na(c, a), name) {
                if mode == 6 || (mode == 5 && !hd_arg_ok(c, n, i, true)) {
                    return false;
                }
                if mode < 5 && !pl_arg_ok(c, n, i, true, mode == 3) {
                    return false;
                }
            } else if !pl_use_ok(c, a, name, mode) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if k == K_MACROCALL { return pl_uses_ok(c, nb(c, n), name, mode) && pl_uses_ok(c, nc(c, n), name, mode); }
    if k == K_IF { return pl_use_ok(c, na(c, n), name, mode) && pl_uses_ok(c, nb(c, n), name, mode) && pl_uses_ok(c, nc(c, n), name, mode); }
    if k == K_WHILE { return pl_use_ok(c, na(c, n), name, mode) && pl_uses_ok(c, nb(c, n), name, mode); }
    if k == K_FOR { return pl_use_ok(c, nb(c, n), name, mode) && pl_uses_ok(c, nc(c, n), name, mode); }
    if k == K_RETURN {
        if mode > 0 && mode != 6 && pl_call_takes(c, na(c, n), name) {
            return false;
        }
        return pl_use_opt(c, na(c, n), name, mode);
    }
    if k == K_ASSIGN {
        if pl_is_name(c, na(c, n), name) {
            // heap-autofree frees the old cell here, so the new one must be
            // fresh too (deep-fresh for drop glue).
            if mode == 2 && !pl_fresh_site(c, nb(c, n)) {
                return false;
            }
            // A stack cell reassigned a fresh heap cell could never free
            // it: heap-autofree frees each one at the next `name = v`.
            if mode == 1 && pl_fresh_site(c, nb(c, n)) {
                return false;
            }
            if mode == 4 && !pl_in_place(c, nb(c, n)) {
                return false;
            }
            if mode == 3 && !pl_deep_fresh(c, nb(c, n)) {
                return false;
            }
            if mode == 6 || (mode == 5 && hd_call_kind(c, nb(c, n)) != vget(ck(c, CK_LIFE), LT_CURHK)) {
                return false;
            }
            return pl_use_ok(c, nb(c, n), name, mode);
        }
        return pl_use_ok(c, na(c, n), name, mode) && pl_use_ok(c, nb(c, n), name, mode);
    }
    if k == K_LET { return pl_use_ok(c, nd(c, n), name, mode); }
    if k == K_LETD {
        if pl_is_name(c, nc(c, n), name) && nk(c, na(c, n)) != P_IDENT {
            return mode != 3 && mode < 5;
        }
        return pl_use_ok(c, nc(c, n), name, mode);
    }
    if k == K_MATCH {
        let arms = nb(c, n);
        if pl_is_name(c, na(c, n), name) {
            if mode == 3 {
                return false;
            }
            let mut j: i64 = 0;
            while j < list_len(c, arms) {
                if nk(c, list_at(c, arms, j)) == P_IDENT {
                    return false;
                }
                j = j + 3;
            }
        } else if !pl_use_ok(c, na(c, n), name, mode) {
            return false;
        }
        let mut i: i64 = 0;
        while i < list_len(c, arms) {
            if !pl_use_opt(c, list_at(c, arms, i + 1), name, mode) || !pl_use_ok(c, list_at(c, arms, i + 2), name, mode) {
                return false;
            }
            i = i + 3;
        }
        return true;
    }
    if k == K_FN || k == K_MACRODEF || k == K_USE || k == K_CONST || k == K_TYPEDEF || k == K_ENUM || k == K_UNION || k == K_STRUCT {
        return true;
    }
    return false;
}

fn pl_rest_ok(c: i64, body: i64, from: i64, name: i64, mode: i64) -> bool {
    let mut i = from;
    while i < list_len(c, body) {
        if !pl_use_ok(c, list_at(c, body, i), name, mode) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn pl_max(a: i64, b: i64) -> i64 {
    if b > a {
        return b;
    }
    return a;
}

fn pl_last_list(c: i64, l: i64, name: i64, from: i64, step: i64) -> i64 {
    let mut best: i64 = -1;
    let mut i = from;
    while i < list_len(c, l) {
        best = pl_max(best, pl_last(c, list_at(c, l, i), name));
        i = i + step;
    }
    return best;
}

// Position of the last node in `n` that names `name` (a variable read, a
// reassignment or lens target), or -1.
fn pl_last(c: i64, n: i64, name: i64) -> i64 {
    if n < 0 {
        return -1;
    }
    let k = nk(c, n);
    let mut best: i64 = -1;
    if (k == K_VAR || k == K_LENS) && na(c, n) == name {
        best = npos(c, n);
    }
    if k == K_BIN { return pl_max(pl_last(c, nb(c, n), name), pl_last(c, nc(c, n), name)); }
    if k == K_UN { return pl_last(c, nb(c, n), name); }
    if k == K_ADDR || k == K_TINDEX || k == K_FIELD || k == K_RETURN { return pl_last(c, na(c, n), name); }
    if k == K_INDEX || k == K_RANGE || k == K_ASSIGN { return pl_max(pl_last(c, na(c, n), name), pl_last(c, nb(c, n), name)); }
    if k == K_SLICE { return pl_max(pl_last(c, na(c, n), name), pl_max(pl_last(c, nb(c, n), name), pl_last(c, nc(c, n), name))); }
    if k == K_IF { return pl_max(pl_last(c, na(c, n), name), pl_max(pl_last_list(c, nb(c, n), name, 0, 1), pl_last_list(c, nc(c, n), name, 0, 1))); }
    if k == K_WHILE { return pl_max(pl_last(c, na(c, n), name), pl_last_list(c, nb(c, n), name, 0, 1)); }
    if k == K_FOR { return pl_max(pl_last(c, nb(c, n), name), pl_last_list(c, nc(c, n), name, 0, 1)); }
    if k == K_LET { return pl_last(c, nd(c, n), name); }
    if k == K_LETD { return pl_last(c, nc(c, n), name); }
    if k == K_ARRAY || k == K_TUPLE { return pl_last_list(c, na(c, n), name, 0, 1); }
    if k == K_SINIT { return pl_last_list(c, nb(c, n), name, 1, 2); }
    if k == K_LENS { return pl_max(best, pl_last_list(c, nc(c, n), name, 0, 1)); }
    if k == K_CALL { return pl_last_list(c, nb(c, n), name, 0, 1); }
    if k == K_MACROCALL { return pl_max(pl_last_list(c, nb(c, n), name, 0, 1), pl_last_list(c, nc(c, n), name, 0, 1)); }
    if k == K_MATCH {
        let arms = nb(c, n);
        return pl_max(pl_last(c, na(c, n), name), pl_max(pl_last_list(c, arms, name, 1, 3), pl_last_list(c, arms, name, 2, 3)));
    }
    return best;
}

// Plan every site in expression `n` that no context places: heap.
fn pl_walk(c: i64, p: i64, n: i64) -> i64 {
    if n < 0 {
        return 0;
    }
    if pl_site_kind(c, n) != 0 {
        pl_record(c, p, n, PL_HEAP, -1);
    }
    return pl_parts(c, p, n);
}

fn pl_walk_list(c: i64, p: i64, l: i64, from: i64, step: i64) -> i64 {
    let mut i = from;
    while i < list_len(c, l) {
        pl_walk(c, p, list_at(c, l, i));
        i = i + step;
    }
    return 0;
}

// Words of the cell a struct, array or payload-union literal builds, or
// -1 when cgen cannot size it statically.
fn pl_cell_words(c: i64, v: i64) -> i64 {
    let k = nk(c, v);
    if k == K_SINIT {
        let decl = struct_def(c, na(c, v));
        if decl < 0 {
            return -1;
        }
        return 1 + list_len(c, nb(c, decl)) / 2;
    }
    if k == K_ARRAY || k == K_TUPLE {
        return 1 + list_len(c, na(c, v));
    }
    if k == K_CALL {
        if pl_site_kind(c, v) == 5 {
            return pl_flat_words(c, pl_site_type(c, v));
        }
        return 1 + list_len(c, nb(c, v));
    }
    return -1;
}

// True when the cell of literal `v` fits the stack cap (§3.1) in what is
// left of this function's frame budget.
fn pl_cell_fits(c: i64, p: i64, v: i64) -> bool {
    let words = pl_cell_words(c, v);
    return words > 0 && words <= PL_CELL_MAX && vget(p, PS_WORDS) + words <= PL_FRAME_MAX;
}

// Plan for `let name = v`, statement `i` of `body` (body < 0: not a block
// statement cgen's `gen_block` emits, so never stack). Returns the flag
// `name` is bound with.
fn pl_let(c: i64, p: i64, body: i64, i: i64, name: i64, v: i64) -> i64 {
    let kind = pl_site_kind(c, v);
    let hk = hd_call_kind(c, v);
    if kind == 0 && (hk == 0 || body < 0 || i + 1 >= list_len(c, body)) {
        pl_walk(c, p, v);
        return 0;
    }
    let mut place = PL_HEAP;
    if body >= 0 && kind == 1 && i + 1 < list_len(c, body) && pl_rest_ok(c, body, i + 1, name, 0) {
        place = PL_STACK;
    } else if body >= 0 && ((kind >= 2 && kind <= 4) || pl_rs_call(c, v)) && i + 1 < list_len(c, body) && pl_cell_fits(c, p, v) && (pl_rest_ok(c, body, i + 1, name, 1) || pl_rest_ok(c, body, i + 1, name, 4)) {
        place = PL_STACK;
        vset(p, PS_WORDS, vget(p, PS_WORDS) + pl_cell_words(c, v));
    } else if body >= 0 && (kind == 4 || pl_drop_kind(c, pl_site_type(c, v)) != 0) && pl_rest_ok(c, body, i + 1, name, 2) {
        place = PL_AUTO;
    }
    if place == PL_HEAP && hk > 0 && body >= 0 && i + 1 < list_len(c, body) {
        vset(ck(c, CK_LIFE), LT_CURHK, hk);
        if pl_rest_ok(c, body, i + 1, name, 5) {
            place = PL_AUTO;
            vset(vget(ck(c, CK_LIFE), LT_HSITE), v, hk);
        }
    }
    if kind == 0 && place != PL_AUTO {
        // A handle call that stays unfreed is no cell site.
        pl_walk(c, p, v);
        return 0;
    }
    let mut ends: i64 = -1;
    if place != PL_HEAP {
        ends = npos(c, list_at(c, body, i));
        let mut j = i + 1;
        while j < list_len(c, body) {
            ends = pl_max(ends, pl_last(c, list_at(c, body, j), name));
            j = j + 1;
        }
    }
    pl_record(c, p, v, place, ends);
    vset(ck(c, CK_LIFE), LT_CURTY, pl_site_type(c, v));
    if place == PL_AUTO && pl_deep_fresh(c, v) && pl_rest_ok(c, body, i + 1, name, 3) {
        vset(vget(ck(c, CK_LIFE), LT_DEEP), v, 1);
    }
    pl_parts(c, p, v);
    if place == PL_STACK && kind == 1 {
        return ends + 1;
    }
    if place == PL_STACK {
        return pl_inplace_flag(ends);
    }
    if place == PL_AUTO {
        return pl_inplace_flag(ends) - PL_AUTOFLAG;
    }
    return 0;
}

// Bind a pattern's names as cgen's `bind_pattern_value` does.
fn pl_bind_pattern(c: i64, p: i64, pat: i64) -> i64 {
    let k = nk(c, pat);
    if k == P_IDENT {
        return pl_bind(c, p, na(c, pat), 0);
    }
    if k == P_TUPLE {
        let pats = na(c, pat);
        let mut i: i64 = 0;
        while i < list_len(c, pats) {
            pl_bind_pattern(c, p, list_at(c, pats, i));
            i = i + 1;
        }
        return 0;
    }
    if k == P_VARIANT {
        let bindings = nc(c, pat);
        let mut i: i64 = 0;
        while i < list_len(c, bindings) {
            pl_bind_pattern(c, p, list_at(c, bindings, i));
            i = i + 1;
        }
        return 0;
    }
    if k == P_STRUCT {
        let decl = struct_def(c, na(c, pat));
        if decl < 0 {
            return 0;
        }
        let fields = nb(c, pat);
        let mut i: i64 = 0;
        while i < list_len(c, fields) {
            if struct_field_index(c, decl, list_at(c, fields, i)) >= 0 {
                pl_bind_pattern(c, p, list_at(c, fields, i + 1));
            }
            i = i + 2;
        }
    }
    return 0;
}

// A block cgen emits with `gen_block`: its own scope, and its `let`
// statements may be stack.
fn pl_block(c: i64, p: i64, body: i64) -> i64 {
    let mark = vlen(vget(p, PS_BOUND));
    let mut i: i64 = 0;
    while i < list_len(c, body) {
        let n = list_at(c, body, i);
        let hk = hd_call_kind(c, n);
        if hk > 0 && i + 1 < list_len(c, body) {
            // A fresh result no one reads (not the block's value): both
            // backends emit a statement before the last as a discard.
            pl_temp(c, p, n, n, hk);
            pl_parts(c, p, n);
        } else if i + 1 < list_len(c, body) && pl_site_kind(c, n) == 5 && pl_drop_kind(c, pl_site_type(c, n)) != 0 {
            // A discarded fresh cell (L13d): freed right after it returns,
            // with drop glue (a fresh call's child cells are fresh too).
            let table = ck(c, CK_LIFE);
            vset(vget(table, LT_TEMP), n, n);
            vset(vget(table, LT_DEEP), n, 1);
            pl_record(c, p, n, PL_TEMP, npos(c, n));
            pl_parts(c, p, n);
        } else {
            pl_stmt(c, p, body, i, n);
        }
        i = i + 1;
    }
    return pl_scope_end(p, mark);
}

// Statement `n`; `body`/`i` locate it when it is a block statement.
fn pl_stmt(c: i64, p: i64, body: i64, i: i64, n: i64) -> i64 {
    if nk(c, n) == K_LET {
        let flag = pl_let(c, p, body, i, na(c, n), nd(c, n));
        return pl_bind(c, p, na(c, n), flag);
    }
    return pl_walk(c, p, n);
}

// The children of `n`, in cgen's order, with cgen's scopes.
fn pl_parts(c: i64, p: i64, n: i64) -> i64 {
    let k = nk(c, n);
    if k == K_BIN { pl_walk(c, p, nb(c, n)); return pl_walk(c, p, nc(c, n)); }
    if k == K_UN { return pl_walk(c, p, nb(c, n)); }
    if k == K_ADDR || k == K_TINDEX || k == K_FIELD { return pl_walk(c, p, na(c, n)); }
    if k == K_CALL { return pl_call_args(c, p, n); }
    if k == K_MACROCALL { return pl_walk_list(c, p, nb(c, n), 0, 1); }
    if k == K_TUPLE || k == K_ARRAY { return pl_walk_list(c, p, na(c, n), 0, 1); }
    if k == K_SINIT { return pl_walk_list(c, p, nb(c, n), 1, 2); }
    if k == K_INDEX || k == K_RANGE { pl_walk(c, p, na(c, n)); return pl_walk(c, p, nb(c, n)); }
    if k == K_SLICE { pl_walk(c, p, na(c, n)); pl_walk(c, p, nb(c, n)); return pl_walk(c, p, nc(c, n)); }
    if k == K_LET {
        pl_let(c, p, -1, 0, na(c, n), nd(c, n));
        return pl_bind(c, p, na(c, n), 0);
    }
    if k == K_ASSIGN {
        let target = na(c, n);
        let v = nb(c, n);
        let mut flag: i64 = 0;
        if nk(c, target) == K_VAR {
            flag = pl_flag(c, p, na(c, target));
        }
        if nk(c, v) == K_TUPLE && flag > 0 {
            pl_record(c, p, v, PL_STACK, flag - 1);
            pl_parts(c, p, v);
        } else if pl_flag_inplace(flag) && pl_in_place(c, v) {
            pl_record(c, p, v, PL_STACK, pl_flag_ends(flag));
            pl_parts(c, p, v);
        } else if pl_flag_auto(flag) && pl_rs_call(c, v) {
            pl_record(c, p, v, PL_AUTO, pl_flag_ends(flag));
            pl_parts(c, p, v);
        } else {
            pl_walk(c, p, v);
        }
        return pl_walk(c, p, target);
    }
    if k == K_RETURN {
        let v = na(c, n);
        let kind = pl_site_kind(c, v);
        let inret = vget(p, PS_INRET);
        vset(p, PS_INRET, 1);
        if vget(p, PS_RET) == 1 && ((kind != 0 && kind != 5) || pl_rs_call(c, v)) {
            pl_record(c, p, v, PL_RET, npos(c, n));
            pl_parts(c, p, v);
        } else {
            pl_walk(c, p, v);
        }
        return vset(p, PS_INRET, inret);
    }
    if k == K_IF {
        pl_walk(c, p, na(c, n));
        pl_block(c, p, nb(c, n));
        return pl_block(c, p, nc(c, n));
    }
    if k == K_WHILE {
        pl_walk(c, p, na(c, n));
        return pl_block(c, p, nb(c, n));
    }
    if k == K_FOR {
        let iter = nb(c, n);
        if nk(c, iter) == K_RANGE {
            pl_walk(c, p, na(c, iter));
            pl_walk(c, p, nb(c, iter));
        } else {
            pl_walk(c, p, iter);
        }
        let mark = vlen(vget(p, PS_BOUND));
        pl_bind(c, p, na(c, n), 0);
        pl_block(c, p, nc(c, n));
        return pl_scope_end(p, mark);
    }
    if k == K_LETD {
        let pat = na(c, n);
        let v = nc(c, n);
        if nk(c, v) == K_TUPLE && nk(c, pat) == P_TUPLE && list_len(c, na(c, v)) == list_len(c, na(c, pat)) {
            // Destructured on the spot: cgen never builds the cell.
            pl_parts(c, p, v);
        } else {
            pl_walk(c, p, v);
        }
        return pl_bind_pattern(c, p, pat);
    }
    if k == K_MATCH {
        pl_walk(c, p, na(c, n));
        let arms = nb(c, n);
        let mut i: i64 = 0;
        while i < list_len(c, arms) {
            let mark = vlen(vget(p, PS_BOUND));
            pl_bind_pattern(c, p, list_at(c, arms, i));
            pl_walk(c, p, list_at(c, arms, i + 1));
            pl_stmt(c, p, -1, 0, list_at(c, arms, i + 2));
            pl_scope_end(p, mark);
            i = i + 3;
        }
        return 0;
    }
    if k == K_LENS {
        let mark = vlen(vget(p, PS_BOUND));
        pl_bind(c, p, nb(c, n), pl_flag(c, p, na(c, n)));
        pl_block(c, p, nc(c, n));
        return pl_scope_end(p, mark);
    }
    return 0;
}

// Plan one function (or macro) cgen emits; `prelude` (or -1) holds the
// top-level statements cgen runs at the start of `main`.
fn pl_function(c: i64, p: i64, f: i64, prelude: i64) -> i64 {
    vset(p, PS_FN, f);
    vset(p, PS_RET, 0);
    vset(p, PS_WORDS, 0);
    if life_ret_slot_fn(c, f) {
        vset(p, PS_RET, 1);
    }
    let mark = vlen(vget(p, PS_BOUND));
    let params = nc(c, f);
    let mut i: i64 = 0;
    while i < list_len(c, params) {
        pl_bind(c, p, list_at(c, params, i), 0);
        i = i + 2;
    }
    if prelude >= 0 {
        let mut j: i64 = 0;
        while j < vlen(prelude) {
            pl_stmt(c, p, -1, 0, vget(prelude, j));
            j = j + 1;
        }
    }
    pl_block(c, p, ne(c, f));
    return pl_scope_end(p, mark);
}

// Build the plan for every function in the program. Runs after
// `life_program` (and runs it if nobody did), and again once more items
// are loaded (the Track runtime). Items, top-level statements and `main` are found as
// `generate_c` finds them.
fn life_place_program(c: i64) -> i64 {
    if ck(c, CK_LIFE) == 0 {
        // A caller that checked but skipped `life_program` (the in-memory
        // backend tests): the plan needs the summaries.
        life_program(c);
    }
    let table = ck(c, CK_LIFE);
    while vlen(table) <= LT_GFN {
        vpush(table, 0);
    }
    pl_ret_fns(c);
    pl_glue_fns(c);
    hd_program(c);
    vset(table, LT_PLACE, vfill(vnew_cap(node_count(c) + 1), node_count(c), PL_NONE));
    vset(table, LT_DEEP, vfill(vnew_cap(node_count(c) + 1), node_count(c), 0));
    vset(table, LT_HSITE, vfill(vnew_cap(node_count(c) + 1), node_count(c), 0));
    vset(table, LT_TEMP, vfill(vnew_cap(node_count(c) + 1), node_count(c), -1));
    vset(table, LT_SITES, vnew_cap(256));
    let p = vfill(vnew_cap(PS_WIDTH), PS_WIDTH, 0);
    vset(p, PS_FLAG, vfill(vnew_cap(name_count(c) + 1), name_count(c), 0));
    vset(p, PS_BOUND, vnew_cap(64));
    let items = cx(c, CX_ITEMS);
    let files = cx(c, CX_ITEMFILE);
    let root = cx(c, CX_MAINFILE);
    let prelude = vnew();
    let mut main_fn: i64 = -1;
    let mut i: i64 = 0;
    while i < vlen(items) {
        let n = vget(items, i);
        let k = nk(c, n);
        if vget(files, i) == root && k != K_FN && k != K_MACRODEF {
            vpush(prelude, n);
        }
        if k == K_FN && text_eq(name_text(c, na(c, n)), "main") {
            main_fn = n;
        }
        i = i + 1;
    }
    let mut j: i64 = 0;
    while j < vlen(items) {
        let n = vget(items, j);
        let k = nk(c, n);
        if k == K_FN || k == K_MACRODEF {
            if n == main_fn {
                pl_function(c, p, n, prelude);
            } else {
                pl_function(c, p, n, -1);
            }
        }
        j = j + 1;
    }
    if main_fn < 0 {
        vset(p, PS_FN, -1);
        vset(p, PS_RET, 0);
        let mut q: i64 = 0;
        while q < vlen(prelude) {
            pl_stmt(c, p, -1, 0, vget(prelude, q));
            q = q + 1;
        }
    }
    return 0;
}

// `trackc life --place`: one block per function with sites, in load order:
//   fn <name>                        (`<top>` for top-level statements)
//     L<line> <kind> <place> ends L<line>|-
fn life_place_dump(c: i64) -> i64 {
    let sites = vget(ck(c, CK_LIFE), LT_SITES);
    let b = sb_new();
    let mut cur: i64 = -2;
    let mut i: i64 = 0;
    while i < vlen(sites) {
        let f = vget(sites, i);
        let n = vget(sites, i + 1);
        if f != cur {
            sb_add(b, "fn ");
            if f < 0 {
                sb_add(b, "<top>");
            } else {
                sb_add(b, name_text(c, na(c, f)));
            }
            sb_byte(b, 10);
            cur = f;
        }
        sb_add(b, "  L");
        sb_int(b, life_line(c, npos(c, n)));
        sb_add(b, " ");
        if life_auto_handle(c, n) > 0 {
            sb_add(b, hd_kind_text(life_auto_handle(c, n)));
        } else {
            sb_add(b, pl_kind_text(pl_site_kind(c, n)));
        }
        sb_add(b, " ");
        sb_add(b, pl_place_text(vget(sites, i + 2)));
        if life_auto_deep(c, n) {
            sb_add(b, " deep");
        }
        sb_add(b, " ends ");
        if vget(sites, i + 3) < 0 {
            sb_add(b, "-");
        } else {
            sb_add(b, "L");
            sb_int(b, life_line(c, vget(sites, i + 3)));
        }
        sb_byte(b, 10);
        i = i + 4;
    }
    return sb_text(b);
}
