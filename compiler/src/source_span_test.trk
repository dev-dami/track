import "source_span";

fn assert_i64(actual: i64, expected: i64) -> void {
    if actual != expected {
        abort("source span integer assertion failed");
    }
}

fn assert_bool(actual: bool, expected: bool) -> void {
    if actual != expected {
        abort("source span boolean assertion failed");
    }
}

fn test_positions_are_one_based() -> void {
    let source = "alpha\nbeta\ngamma";
    let first = source_position_at(&source, 0);
    assert_i64(first.0, 1);
    assert_i64(first.1, 1);

    let second_line = source_position_at(&source, 8);
    assert_i64(second_line.0, 2);
    assert_i64(second_line.1, 3);
}

fn test_span_normalizes_offsets() -> void {
    let source = "abc";
    let span = source_span(&source, -5, 99);
    assert_i64(span.0, 0);
    assert_i64(span.1, 3);
    assert_i64(span.2, 1);
    assert_i64(span.3, 1);
    assert_i64(span.4, 1);
    assert_i64(span.5, 4);
}

fn test_empty_span_has_visible_width() -> void {
    let source = "abc";
    let span = source_span(&source, 2, 2);
    assert_i64(source_span_width(&span), 1);
}

fn test_contains_is_end_exclusive() -> void {
    let source = "abcdef";
    let span = source_span(&source, 2, 5);
    assert_bool(source_span_contains(&span, 2), true);
    assert_bool(source_span_contains(&span, 4), true);
    assert_bool(source_span_contains(&span, 5), false);
}

fn test_line_bounds() -> void {
    let source = "one\ntwo\nthree";
    let bounds = source_line_bounds(&source, 5);
    assert_i64(bounds.0, 4);
    assert_i64(bounds.1, 7);
}

fn main() -> void {
    test_positions_are_one_based();
    test_span_normalizes_offsets();
    test_empty_span_has_visible_width();
    test_contains_is_end_exclusive();
    test_line_bounds();
    print("ok");
}
