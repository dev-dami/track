fn runtime_source(b: i64) -> i64 {
    sb_line(b, "/*");
    sb_line(b, " * Track runtime (word ABI).");
    sb_line(b, " *");
    sb_line(b, " * Every function exported to Track takes and returns 64-bit words (`tk_w`):");
    sb_line(b, " * integers and booleans are plain values, strings are NUL-terminated");
    sb_line(b, " * `char*` pointers, and handles (files, Vec, collections, builders) are");
    sb_line(b, " * pointers to runtime-owned records. This single file is linked by both");
    sb_line(b, " * compilers: the Rust bootstrap compiler embeds it with `include_str!`, and");
    sb_line(b, " * the self-hosted compiler embeds a generated copy (`compiler/src/runtime_c.trk`,");
    sb_line(b, " * regenerated by `scripts/embed_runtime.sh`).");
    sb_line(b, " */");
    sb_line(b, "#include <stdio.h>");
    sb_line(b, "#include <stdlib.h>");
    sb_line(b, "#include <string.h>");
    sb_line(b, "#include <time.h>");
    sb_line(b, "#include <unistd.h>");
    sb_line(b, "#include <sys/socket.h>");
    sb_line(b, "#include <netinet/in.h>");
    sb_line(b, "#include <arpa/inet.h>");
    sb_line(b, "#include <fcntl.h>");
    sb_line(b, "#include <sys/stat.h>");
    sb_line(b, "#include <ctype.h>");
    sb_line(b, "#include <stdint.h>");
    sb_line(b, "#include <errno.h>");
    sb_line(b, "#include <signal.h>");
    sb_line(b, "");
    sb_line(b, "typedef int64_t tk_w;");
    sb_line(b, "");
    sb_line(b, "#define TK_PTR(w) ((void *)(uintptr_t)(w))");
    sb_line(b, "#define TK_STR(w) ((const char *)(uintptr_t)(w))");
    sb_line(b, "#define TK_WORD(p) ((tk_w)(uintptr_t)(p))");
    sb_line(b, "");
    sb_line(b, "/* ---------------------------------------------------------------- process */");
    sb_line(b, "");
    sb_line(b, "static int g_argc = 0;");
    sb_line(b, "static char **g_argv = NULL;");
    sb_line(b, "");
    sb_line(b, "/* Called from the generated `main` entry point before any Track code runs. */");
    sb_line(b, "tk_w track_runtime_init(tk_w argc, tk_w argv) {");
    sb_line(b, "    g_argc = (int)argc;");
    sb_line(b, "    g_argv = (char **)TK_PTR(argv);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w os_args_count(void) { return g_argc; }");
    sb_line(b, "");
    sb_line(b, "static char *tk_dup_n(const char *s, size_t n) {");
    sb_line(b, "    char *out = (char *)malloc(n + 1);");
    sb_line(b, "    if (!out) {");
    sb_line(b, "        fprintf(stderr, \"\\nTrack Runtime Error: Out of memory allocation failure!\\n\");");
    sb_line(b, "        exit(137);");
    sb_line(b, "    }");
    sb_line(b, "    if (n > 0) memcpy(out, s, n);");
    sb_line(b, "    out[n] = '\\0';");
    sb_line(b, "    return out;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "static char *tk_dup(const char *s) { return tk_dup_n(s ? s : \"\", s ? strlen(s) : 0); }");
    sb_line(b, "");
    sb_line(b, "tk_w os_arg(tk_w idx) {");
    sb_line(b, "    if (g_argv && idx >= 0 && idx < g_argc) return TK_WORD(tk_dup(g_argv[idx]));");
    sb_line(b, "    return TK_WORD(tk_dup(\"\"));");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w sys_exit(tk_w code) {");
    sb_line(b, "    fflush(stdout);");
    sb_line(b, "    exit((int)code);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "static int is_valid_string_pointer(const void *ptr) {");
    sb_line(b, "    if (!ptr || (uintptr_t)ptr < 0x10000) return 0;");
    sb_line(b, "    int pfd[2];");
    sb_line(b, "    if (pipe(pfd) < 0) return 0;");
    sb_line(b, "    ssize_t res = write(pfd[1], ptr, 1);");
    sb_line(b, "    close(pfd[0]);");
    sb_line(b, "    close(pfd[1]);");
    sb_line(b, "    return res == 1;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "/* Fatal abort: print message and terminate the process. No unwinding —");
    sb_line(b, " * stack frames are simply discarded (linear cleanup is skipped by design). */");
    sb_line(b, "tk_w track_abort(tk_w msg) {");
    sb_line(b, "    const char *s = TK_STR(msg);");
    sb_line(b, "    fflush(stdout);");
    sb_line(b, "    if (s && is_valid_string_pointer(s)) {");
    sb_line(b, "        fprintf(stderr, \"Track abort: %s\\n\", s);");
    sb_line(b, "    } else {");
    sb_line(b, "        fprintf(stderr, \"Track abort\\n\");");
    sb_line(b, "    }");
    sb_line(b, "    fflush(stderr);");
    sb_line(b, "    exit(134);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "/* Integer division by zero or INT64_MIN / -1: trap like a hardware divide");
    sb_line(b, " * fault (SIGFPE) without flushing buffered output. */");
    sb_line(b, "tk_w track_trap_div(void) {");
    sb_line(b, "    raise(SIGFPE);");
    sb_line(b, "    abort();");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w sys_exec(tk_w cmd) {");
    sb_line(b, "    if (!cmd) return -1;");
    sb_line(b, "    fflush(stdout);");
    sb_line(b, "    fflush(stderr);");
    sb_line(b, "    int status = system(TK_STR(cmd));");
    sb_line(b, "    if (status == -1) return -1;");
    sb_line(b, "    if (WIFEXITED(status)) return WEXITSTATUS(status);");
    sb_line(b, "    return 128 + (WIFSIGNALED(status) ? WTERMSIG(status) : 0);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w process_spawn(tk_w cmd) { return sys_exec(cmd); }");
    sb_line(b, "");
    sb_line(b, "tk_w clock_ms(void) {");
    sb_line(b, "    struct timespec ts;");
    sb_line(b, "    clock_gettime(CLOCK_MONOTONIC, &ts);");
    sb_line(b, "    return (tk_w)ts.tv_sec * 1000 + (tk_w)ts.tv_nsec / 1000000;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w env_get(tk_w key) {");
    sb_line(b, "    const char *val = key ? getenv(TK_STR(key)) : NULL;");
    sb_line(b, "    return TK_WORD(tk_dup(val ? val : \"\"));");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w env_exists(tk_w key) { return key && getenv(TK_STR(key)) ? 1 : 0; }");
    sb_line(b, "");
    sb_line(b, "/* ----------------------------------------------------------------- memory */");
    sb_line(b, "");
    sb_line(b, "static size_t g_allocated_bytes = 0;");
    sb_line(b, "static size_t g_max_memory_limit = 536870912; /* 512MB default memory boundary limit */");
    sb_line(b, "");
    sb_line(b, "tk_w sys_set_memory_limit(tk_w bytes) {");
    sb_line(b, "    if (bytes > 0) g_max_memory_limit = (size_t)bytes;");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w sys_get_memory_used(void) { return (tk_w)g_allocated_bytes; }");
    sb_line(b, "");
    sb_line(b, "tk_w alloc(tk_w size_w) {");
    sb_line(b, "    size_t size = (size_t)size_w;");
    sb_line(b, "    if (size_w <= 0) return 0;");
    sb_line(b, "    if (g_allocated_bytes + size > g_max_memory_limit) {");
    sb_line(b, "        fprintf(stderr, \"\\nTrack Runtime Error: Process memory boundary limit exceeded! (Allocated: %zu bytes, Requested: %zu bytes, Limit: %zu bytes)\\n\", g_allocated_bytes, size, g_max_memory_limit);");
    sb_line(b, "        fflush(stderr);");
    sb_line(b, "        exit(137);");
    sb_line(b, "    }");
    sb_line(b, "    size_t *ptr = (size_t *)calloc(1, size + sizeof(size_t));");
    sb_line(b, "    if (!ptr) {");
    sb_line(b, "        fprintf(stderr, \"\\nTrack Runtime Error: Out of memory allocation failure!\\n\");");
    sb_line(b, "        fflush(stderr);");
    sb_line(b, "        exit(137);");
    sb_line(b, "    }");
    sb_line(b, "    *ptr = size;");
    sb_line(b, "    g_allocated_bytes += size;");
    sb_line(b, "    return TK_WORD(ptr + 1);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w dealloc(tk_w p) {");
    sb_line(b, "    if (!p) return 0;");
    sb_line(b, "    size_t *raw = (size_t *)TK_PTR(p) - 1;");
    sb_line(b, "    size_t size = *raw;");
    sb_line(b, "    g_allocated_bytes = g_allocated_bytes >= size ? g_allocated_bytes - size : 0;");
    sb_line(b, "    free(raw);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w mem_realloc(tk_w p, tk_w new_size_w) {");
    sb_line(b, "    if (!p) return alloc(new_size_w);");
    sb_line(b, "    if (new_size_w <= 0) return dealloc(p);");
    sb_line(b, "    size_t new_size = (size_t)new_size_w;");
    sb_line(b, "    size_t *raw = (size_t *)TK_PTR(p) - 1;");
    sb_line(b, "    size_t old_size = *raw;");
    sb_line(b, "    if (g_allocated_bytes - old_size + new_size > g_max_memory_limit) {");
    sb_line(b, "        fprintf(stderr, \"\\nTrack Runtime Error: Process memory boundary limit exceeded! (Allocated: %zu bytes, Requested: %zu bytes, Limit: %zu bytes)\\n\", g_allocated_bytes, new_size, g_max_memory_limit);");
    sb_line(b, "        fflush(stderr);");
    sb_line(b, "        exit(137);");
    sb_line(b, "    }");
    sb_line(b, "    size_t *new_raw = (size_t *)realloc(raw, new_size + sizeof(size_t));");
    sb_line(b, "    if (!new_raw) {");
    sb_line(b, "        fprintf(stderr, \"\\nTrack Runtime Error: Out of memory reallocation failure!\\n\");");
    sb_line(b, "        fflush(stderr);");
    sb_line(b, "        exit(137);");
    sb_line(b, "    }");
    sb_line(b, "    *new_raw = new_size;");
    sb_line(b, "    g_allocated_bytes = g_allocated_bytes - old_size + new_size;");
    sb_line(b, "    return TK_WORD(new_raw + 1);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "/* Copy `count` words to a fresh heap cell (escaping tuples). */");
    sb_line(b, "tk_w track_words_copy(tk_w src, tk_w count) {");
    sb_line(b, "    tk_w dst = alloc(count > 0 ? count * 8 : 8);");
    sb_line(b, "    if (src && count > 0) memcpy(TK_PTR(dst), TK_PTR(src), (size_t)count * 8);");
    sb_line(b, "    return dst;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "/* ------------------------------------------------------------------ print */");
    sb_line(b, "");
    sb_line(b, "tk_w print(tk_w val) {");
    sb_line(b, "    if (val >= 0x10000 && is_valid_string_pointer(TK_PTR(val))) {");
    sb_line(b, "        const char *str = TK_STR(val);");
    sb_line(b, "        int is_str = 1;");
    sb_line(b, "        int len = 0;");
    sb_line(b, "        while (len < 4096) {");
    sb_line(b, "            unsigned char c = (unsigned char)str[len];");
    sb_line(b, "            if (c == 0) break;");
    sb_line(b, "            if (c < 9 || (c > 13 && c < 32) || c > 126) {");
    sb_line(b, "                is_str = 0;");
    sb_line(b, "                break;");
    sb_line(b, "            }");
    sb_line(b, "            len++;");
    sb_line(b, "        }");
    sb_line(b, "        if (is_str && len > 0) {");
    sb_line(b, "            printf(\"%s\\n\", str);");
    sb_line(b, "            return 0;");
    sb_line(b, "        }");
    sb_line(b, "    }");
    sb_line(b, "    printf(\"%lld\\n\", (long long)val);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w println(tk_w val) { return print(val); }");
    sb_line(b, "tk_w print_int(tk_w val) { printf(\"%lld\\n\", (long long)val); return 0; }");
    sb_line(b, "tk_w print_hex(tk_w val) { printf(\"0x%llx\\n\", (unsigned long long)val); return 0; }");
    sb_line(b, "tk_w print_str(tk_w s) { printf(\"%s\\n\", s ? TK_STR(s) : \"\"); return 0; }");
    sb_line(b, "");
    sb_line(b, "tk_w print_err(tk_w s) {");
    sb_line(b, "    if (s) {");
    sb_line(b, "        fflush(stdout);");
    sb_line(b, "        fprintf(stderr, \"%s\\n\", TK_STR(s));");
    sb_line(b, "        fflush(stderr);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w eprint(tk_w s) { return print_err(s); }");
    sb_line(b, "");
    sb_line(b, "/* Unformatted output (no trailing newline, no int/string guessing). */");
    sb_line(b, "tk_w track_out(tk_w s) {");
    sb_line(b, "    if (s) fputs(TK_STR(s), stdout);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w track_err(tk_w s) {");
    sb_line(b, "    if (s) {");
    sb_line(b, "        fflush(stdout);");
    sb_line(b, "        fputs(TK_STR(s), stderr);");
    sb_line(b, "        fflush(stderr);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w read_line(void) {");
    sb_line(b, "    size_t cap = 128, len = 0;");
    sb_line(b, "    char *buf = (char *)malloc(cap);");
    sb_line(b, "    int c;");
    sb_line(b, "    while (buf && (c = fgetc(stdin)) != EOF && c != '\\n') {");
    sb_line(b, "        if (len + 1 >= cap) buf = (char *)realloc(buf, cap *= 2);");
    sb_line(b, "        if (buf) buf[len++] = (char)c;");
    sb_line(b, "    }");
    sb_line(b, "    if (!buf) return TK_WORD(tk_dup(\"\"));");
    sb_line(b, "    buf[len] = '\\0';");
    sb_line(b, "    return TK_WORD(buf);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "/* ---------------------------------------------------------------- strings */");
    sb_line(b, "");
    sb_line(b, "tk_w str_from_literal(tk_w raw) { return TK_WORD(tk_dup(TK_STR(raw))); }");
    sb_line(b, "");
    sb_line(b, "tk_w str_free(tk_w s) {");
    sb_line(b, "    (void)s; /* literals and runtime strings share a representation; never freed */");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w str_len(tk_w s) { return s ? (tk_w)strlen(TK_STR(s)) : 0; }");
    sb_line(b, "");
    sb_line(b, "tk_w str_eq(tk_w a, tk_w b) {");
    sb_line(b, "    if (!a || !b) return a == b ? 1 : 0;");
    sb_line(b, "    return strcmp(TK_STR(a), TK_STR(b)) == 0 ? 1 : 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w str_concat(tk_w a, tk_w b) {");
    sb_line(b, "    size_t a_len = a ? strlen(TK_STR(a)) : 0;");
    sb_line(b, "    size_t b_len = b ? strlen(TK_STR(b)) : 0;");
    sb_line(b, "    char *out = tk_dup_n(\"\", 0);");
    sb_line(b, "    out = (char *)realloc(out, a_len + b_len + 1);");
    sb_line(b, "    if (!out) exit(137);");
    sb_line(b, "    if (a_len) memcpy(out, TK_STR(a), a_len);");
    sb_line(b, "    if (b_len) memcpy(out + a_len, TK_STR(b), b_len);");
    sb_line(b, "    out[a_len + b_len] = '\\0';");
    sb_line(b, "    return TK_WORD(out);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w str_find(tk_w s, tk_w sub) {");
    sb_line(b, "    if (!s || !sub) return -1;");
    sb_line(b, "    const char *p = strstr(TK_STR(s), TK_STR(sub));");
    sb_line(b, "    return p ? (tk_w)(p - TK_STR(s)) : -1;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w str_contains(tk_w s, tk_w sub) {");
    sb_line(b, "    if (!s || !sub) return 0;");
    sb_line(b, "    return strstr(TK_STR(s), TK_STR(sub)) ? 1 : 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w str_to_int(tk_w s) { return s ? atoll(TK_STR(s)) : 0; }");
    sb_line(b, "");
    sb_line(b, "/* Predicate companion for str_to_int: distinguishes a genuine \"0\" from a parse failure. */");
    sb_line(b, "tk_w str_is_int(tk_w s_w) {");
    sb_line(b, "    const char *s = TK_STR(s_w);");
    sb_line(b, "    if (!s || *s == '\\0') return 0;");
    sb_line(b, "    const char *p = s;");
    sb_line(b, "    if (*p == '+' || *p == '-') p++;");
    sb_line(b, "    if (*p == '\\0') return 0;");
    sb_line(b, "    for (; *p; p++) {");
    sb_line(b, "        if (!isdigit((unsigned char)*p)) return 0;");
    sb_line(b, "    }");
    sb_line(b, "    return 1;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w int_to_str(tk_w val) {");
    sb_line(b, "    char buf[32];");
    sb_line(b, "    snprintf(buf, sizeof(buf), \"%lld\", (long long)val);");
    sb_line(b, "    return TK_WORD(tk_dup(buf));");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w str_starts_with(tk_w s, tk_w prefix) {");
    sb_line(b, "    if (!s || !prefix) return 0;");
    sb_line(b, "    size_t lp = strlen(TK_STR(prefix));");
    sb_line(b, "    return strncmp(TK_STR(s), TK_STR(prefix), lp) == 0 ? 1 : 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w str_ends_with(tk_w s, tk_w suffix) {");
    sb_line(b, "    if (!s || !suffix) return 0;");
    sb_line(b, "    size_t ls = strlen(TK_STR(s));");
    sb_line(b, "    size_t lp = strlen(TK_STR(suffix));");
    sb_line(b, "    if (lp > ls) return 0;");
    sb_line(b, "    return strcmp(TK_STR(s) + ls - lp, TK_STR(suffix)) == 0 ? 1 : 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w str_substr(tk_w s_w, tk_w start, tk_w len) {");
    sb_line(b, "    const char *s = TK_STR(s_w);");
    sb_line(b, "    if (!s || start < 0 || len <= 0) return TK_WORD(tk_dup(\"\"));");
    sb_line(b, "    /* Bounded scan: never walk past the requested window of a long source. */");
    sb_line(b, "    size_t avail = strnlen(s, (size_t)start + (size_t)len);");
    sb_line(b, "    if ((size_t)start >= avail) return TK_WORD(tk_dup(\"\"));");
    sb_line(b, "    return TK_WORD(tk_dup_n(s + start, avail - (size_t)start));");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w str_trim(tk_w s_w) {");
    sb_line(b, "    const char *s = TK_STR(s_w);");
    sb_line(b, "    if (!s) return TK_WORD(tk_dup(\"\"));");
    sb_line(b, "    while (*s && isspace((unsigned char)*s)) s++;");
    sb_line(b, "    size_t len = strlen(s);");
    sb_line(b, "    while (len > 0 && isspace((unsigned char)s[len - 1])) len--;");
    sb_line(b, "    return TK_WORD(tk_dup_n(s, len));");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w str_char_at(tk_w s_w, tk_w idx) {");
    sb_line(b, "    const char *s = TK_STR(s_w);");
    sb_line(b, "    if (!s || idx < 0) return 0;");
    sb_line(b, "    size_t len = strnlen(s, (size_t)idx + 1);");
    sb_line(b, "    if ((size_t)idx >= len) return 0;");
    sb_line(b, "    return (unsigned char)s[idx];");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "/* Copy a string's bytes into a collection for O(1) bounds-checked access. */");
    sb_line(b, "tk_w track_i64_collection_new(tk_w requested_cap);");
    sb_line(b, "tk_w track_i64_collection_push(tk_w handle, tk_w value);");
    sb_line(b, "");
    sb_line(b, "tk_w track_str_bytes(tk_w s_w) {");
    sb_line(b, "    const unsigned char *s = (const unsigned char *)TK_STR(s_w);");
    sb_line(b, "    size_t len = s ? strlen((const char *)s) : 0;");
    sb_line(b, "    tk_w out = track_i64_collection_new((tk_w)len + 1);");
    sb_line(b, "    for (size_t i = 0; i < len; i++) track_i64_collection_push(out, s[i]);");
    sb_line(b, "    return out;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w char_is_digit(tk_w c) { return c >= 0 && c < 256 && isdigit((int)c) ? 1 : 0; }");
    sb_line(b, "tk_w char_is_alpha(tk_w c) { return c >= 0 && c < 256 && isalpha((int)c) ? 1 : 0; }");
    sb_line(b, "tk_w char_is_alphanumeric(tk_w c) { return c >= 0 && c < 256 && isalnum((int)c) ? 1 : 0; }");
    sb_line(b, "tk_w char_is_space(tk_w c) { return c >= 0 && c < 256 && isspace((int)c) ? 1 : 0; }");
    sb_line(b, "tk_w char_to_upper(tk_w c) { return c >= 0 && c < 256 ? (unsigned char)toupper((int)c) : c; }");
    sb_line(b, "tk_w char_to_lower(tk_w c) { return c >= 0 && c < 256 ? (unsigned char)tolower((int)c) : c; }");
    sb_line(b, "");
    sb_line(b, "/* ------------------------------------------------------------------ paths */");
    sb_line(b, "");
    sb_line(b, "tk_w path_basename(tk_w path_w) {");
    sb_line(b, "    const char *path = TK_STR(path_w);");
    sb_line(b, "    if (!path) return TK_WORD(tk_dup(\"\"));");
    sb_line(b, "    const char *slash = strrchr(path, '/');");
    sb_line(b, "    return TK_WORD(tk_dup(slash ? slash + 1 : path));");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w path_ext(tk_w path_w) {");
    sb_line(b, "    const char *path = TK_STR(path_w);");
    sb_line(b, "    if (!path) return TK_WORD(tk_dup(\"\"));");
    sb_line(b, "    const char *dot = strrchr(path, '.');");
    sb_line(b, "    if (!dot || dot == path) return TK_WORD(tk_dup(\"\"));");
    sb_line(b, "    return TK_WORD(tk_dup(dot + 1));");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w path_join(tk_w a_w, tk_w b_w) {");
    sb_line(b, "    const char *a = a_w ? TK_STR(a_w) : \"\";");
    sb_line(b, "    const char *b = b_w ? TK_STR(b_w) : \"\";");
    sb_line(b, "    size_t la = strlen(a), lb = strlen(b);");
    sb_line(b, "    int slash = la > 0 && a[la - 1] != '/' && (lb == 0 || b[0] != '/');");
    sb_line(b, "    char *out = tk_dup_n(a, la);");
    sb_line(b, "    out = (char *)realloc(out, la + (size_t)slash + lb + 1);");
    sb_line(b, "    if (!out) exit(137);");
    sb_line(b, "    if (slash) out[la] = '/';");
    sb_line(b, "    memcpy(out + la + slash, b, lb + 1);");
    sb_line(b, "    return TK_WORD(out);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "/* ------------------------------------------------------------------ files */");
    sb_line(b, "");
    sb_line(b, "tk_w file_open(tk_w path, tk_w mode) {");
    sb_line(b, "    if (!path || !mode) return 0;");
    sb_line(b, "    return TK_WORD(fopen(TK_STR(path), TK_STR(mode)));");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w file_close(tk_w f) {");
    sb_line(b, "    if (f) fclose((FILE *)TK_PTR(f));");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w file_read_all(tk_w handle) {");
    sb_line(b, "    FILE *f = (FILE *)TK_PTR(handle);");
    sb_line(b, "    if (!f || fseek(f, 0, SEEK_END) != 0) return TK_WORD(tk_dup(\"\"));");
    sb_line(b, "    long end = ftell(f);");
    sb_line(b, "    if (end < 0 || fseek(f, 0, SEEK_SET) != 0) return TK_WORD(tk_dup(\"\"));");
    sb_line(b, "    char *buf = (char *)malloc((size_t)end + 1);");
    sb_line(b, "    if (!buf) exit(137);");
    sb_line(b, "    size_t got = fread(buf, 1, (size_t)end, f);");
    sb_line(b, "    buf[got] = '\\0';");
    sb_line(b, "    return TK_WORD(buf);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w file_write(tk_w handle, tk_w content) {");
    sb_line(b, "    FILE *f = (FILE *)TK_PTR(handle);");
    sb_line(b, "    if (!f || !content) return -1;");
    sb_line(b, "    size_t len = strlen(TK_STR(content));");
    sb_line(b, "    return fwrite(TK_STR(content), 1, len, f) == len ? 0 : -1;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w file_exists(tk_w path) { return path && access(TK_STR(path), F_OK) == 0 ? 1 : 0; }");
    sb_line(b, "");
    sb_line(b, "tk_w file_remove(tk_w path) { return path && unlink(TK_STR(path)) == 0 ? 0 : -1; }");
    sb_line(b, "");
    sb_line(b, "tk_w file_size(tk_w path) {");
    sb_line(b, "    struct stat st;");
    sb_line(b, "    if (!path || stat(TK_STR(path), &st) != 0) return -1;");
    sb_line(b, "    return (tk_w)st.st_size;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w dir_exists(tk_w path) {");
    sb_line(b, "    struct stat st;");
    sb_line(b, "    return path && stat(TK_STR(path), &st) == 0 && S_ISDIR(st.st_mode) ? 1 : 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w file_copy(tk_w src, tk_w dst) {");
    sb_line(b, "    if (!src || !dst) return -1;");
    sb_line(b, "    FILE *in = fopen(TK_STR(src), \"rb\");");
    sb_line(b, "    if (!in) return -1;");
    sb_line(b, "    FILE *out = fopen(TK_STR(dst), \"wb\");");
    sb_line(b, "    if (!out) {");
    sb_line(b, "        fclose(in);");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    char buf[4096];");
    sb_line(b, "    size_t n;");
    sb_line(b, "    while ((n = fread(buf, 1, sizeof(buf), in)) > 0) fwrite(buf, 1, n, out);");
    sb_line(b, "    fclose(in);");
    sb_line(b, "    fclose(out);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "/* Whole-file helpers: open, transfer, and close in one call. */");
    sb_line(b, "tk_w track_file_read(tk_w path) {");
    sb_line(b, "    FILE *f = path ? fopen(TK_STR(path), \"rb\") : NULL;");
    sb_line(b, "    if (!f) return TK_WORD(tk_dup(\"\"));");
    sb_line(b, "    tk_w out = file_read_all(TK_WORD(f));");
    sb_line(b, "    fclose(f);");
    sb_line(b, "    return out;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w track_file_write_all(tk_w path, tk_w content) {");
    sb_line(b, "    FILE *f = path ? fopen(TK_STR(path), \"wb\") : NULL;");
    sb_line(b, "    if (!f) return -1;");
    sb_line(b, "    tk_w status = file_write(TK_WORD(f), content);");
    sb_line(b, "    if (fclose(f) != 0) status = -1;");
    sb_line(b, "    return status;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "/* ------------------------------------------------------------------- math */");
    sb_line(b, "");
    sb_line(b, "tk_w math_abs(tk_w x) { return x < 0 ? -x : x; }");
    sb_line(b, "tk_w math_min(tk_w a, tk_w b) { return a < b ? a : b; }");
    sb_line(b, "tk_w math_max(tk_w a, tk_w b) { return a > b ? a : b; }");
    sb_line(b, "tk_w math_clamp(tk_w v, tk_w lo, tk_w hi) { return v < lo ? lo : (v > hi ? hi : v); }");
    sb_line(b, "tk_w math_floor(tk_w x) { return x; }");
    sb_line(b, "tk_w math_ceil(tk_w x) { return x; }");
    sb_line(b, "tk_w math_round(tk_w x) { return x; }");
    sb_line(b, "");
    sb_line(b, "tk_w math_pow(tk_w base, tk_w exp) {");
    sb_line(b, "    tk_w result = 1;");
    sb_line(b, "    if (exp < 0) return 0;");
    sb_line(b, "    while (exp > 0) {");
    sb_line(b, "        if (exp & 1) result = (tk_w)((uint64_t)result * (uint64_t)base);");
    sb_line(b, "        base = (tk_w)((uint64_t)base * (uint64_t)base);");
    sb_line(b, "        exp >>= 1;");
    sb_line(b, "    }");
    sb_line(b, "    return result;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w math_sqrt(tk_w x) {");
    sb_line(b, "    if (x <= 0) return 0;");
    sb_line(b, "    uint64_t lo = 0, hi = 3037000499ULL; /* floor(sqrt(INT64_MAX)) */");
    sb_line(b, "    while (lo < hi) {");
    sb_line(b, "        uint64_t mid = (lo + hi + 1) / 2;");
    sb_line(b, "        if (mid * mid <= (uint64_t)x) lo = mid; else hi = mid - 1;");
    sb_line(b, "    }");
    sb_line(b, "    return (tk_w)lo;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "static uint64_t g_rng_state = 0x853c49e65d8dbb29ULL;");
    sb_line(b, "tk_w math_random(void) {");
    sb_line(b, "    uint64_t x = g_rng_state;");
    sb_line(b, "    x ^= x << 13;");
    sb_line(b, "    x ^= x >> 7;");
    sb_line(b, "    x ^= x << 17;");
    sb_line(b, "    g_rng_state = x;");
    sb_line(b, "    return (tk_w)x;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w add(tk_w a, tk_w b) { return a + b; }");
    sb_line(b, "tk_w sum(tk_w a, tk_w b) { return a + b; }");
    sb_line(b, "tk_w sub(tk_w a, tk_w b) { return a - b; }");
    sb_line(b, "");
    sb_line(b, "/* -------------------------------------------------------------------- Vec */");
    sb_line(b, "");
    sb_line(b, "typedef struct {");
    sb_line(b, "    tk_w *data;");
    sb_line(b, "    tk_w len;");
    sb_line(b, "    tk_w cap;");
    sb_line(b, "} TrackVec;");
    sb_line(b, "");
    sb_line(b, "tk_w vec_init(tk_w cap) {");
    sb_line(b, "    TrackVec *v = (TrackVec *)TK_PTR(alloc(sizeof(TrackVec)));");
    sb_line(b, "    v->cap = cap > 0 ? cap : 16;");
    sb_line(b, "    v->data = (tk_w *)TK_PTR(alloc(v->cap * (tk_w)sizeof(tk_w)));");
    sb_line(b, "    v->len = 0;");
    sb_line(b, "    return TK_WORD(v);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w vec_push(tk_w h, tk_w val) {");
    sb_line(b, "    TrackVec *v = (TrackVec *)TK_PTR(h);");
    sb_line(b, "    if (!v) return 0;");
    sb_line(b, "    if (v->len == v->cap) {");
    sb_line(b, "        v->cap *= 2;");
    sb_line(b, "        v->data = (tk_w *)TK_PTR(mem_realloc(TK_WORD(v->data), v->cap * (tk_w)sizeof(tk_w)));");
    sb_line(b, "    }");
    sb_line(b, "    v->data[v->len++] = val;");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w vec_get(tk_w h, tk_w idx) {");
    sb_line(b, "    TrackVec *v = (TrackVec *)TK_PTR(h);");
    sb_line(b, "    return v && idx >= 0 && idx < v->len ? v->data[idx] : 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w vec_set(tk_w h, tk_w idx, tk_w val) {");
    sb_line(b, "    TrackVec *v = (TrackVec *)TK_PTR(h);");
    sb_line(b, "    if (v && idx >= 0 && idx < v->len) v->data[idx] = val;");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w vec_pop(tk_w h) {");
    sb_line(b, "    TrackVec *v = (TrackVec *)TK_PTR(h);");
    sb_line(b, "    return v && v->len > 0 ? v->data[--v->len] : 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w vec_len(tk_w h) {");
    sb_line(b, "    TrackVec *v = (TrackVec *)TK_PTR(h);");
    sb_line(b, "    return v ? v->len : 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w vec_clear(tk_w h) {");
    sb_line(b, "    TrackVec *v = (TrackVec *)TK_PTR(h);");
    sb_line(b, "    if (v) v->len = 0;");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w vec_reserve(tk_w h, tk_w cap) {");
    sb_line(b, "    TrackVec *v = (TrackVec *)TK_PTR(h);");
    sb_line(b, "    if (v && cap > v->cap) {");
    sb_line(b, "        v->data = (tk_w *)TK_PTR(mem_realloc(TK_WORD(v->data), cap * (tk_w)sizeof(tk_w)));");
    sb_line(b, "        v->cap = cap;");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w vec_free(tk_w h) {");
    sb_line(b, "    TrackVec *v = (TrackVec *)TK_PTR(h);");
    sb_line(b, "    if (v) {");
    sb_line(b, "        dealloc(TK_WORD(v->data));");
    sb_line(b, "        dealloc(h);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "/* --------------------------------------------- opaque 64-bit collections */");
    sb_line(b, "");
    sb_line(b, "/* Growable word vectors used by the self-hosted compiler. Track only carries");
    sb_line(b, " * the stable pointer handle; layout and capacity stay in the runtime. */");
    sb_line(b, "typedef struct {");
    sb_line(b, "    tk_w *data;");
    sb_line(b, "    tk_w len;");
    sb_line(b, "    tk_w cap;");
    sb_line(b, "} TrackI64Collection;");
    sb_line(b, "");
    sb_line(b, "tk_w track_i64_collection_new(tk_w requested_cap) {");
    sb_line(b, "    tk_w cap = requested_cap > 0 ? requested_cap : 16;");
    sb_line(b, "    TrackI64Collection *c = (TrackI64Collection *)malloc(sizeof(TrackI64Collection));");
    sb_line(b, "    if (!c) exit(137);");
    sb_line(b, "    c->data = (tk_w *)malloc((size_t)cap * sizeof(tk_w));");
    sb_line(b, "    if (!c->data) exit(137);");
    sb_line(b, "    c->len = 0;");
    sb_line(b, "    c->cap = cap;");
    sb_line(b, "    return TK_WORD(c);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w track_i64_collection_len(tk_w h) {");
    sb_line(b, "    const TrackI64Collection *c = (const TrackI64Collection *)TK_PTR(h);");
    sb_line(b, "    return c ? c->len : 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w track_i64_collection_push(tk_w h, tk_w value) {");
    sb_line(b, "    TrackI64Collection *c = (TrackI64Collection *)TK_PTR(h);");
    sb_line(b, "    if (!c) return -1;");
    sb_line(b, "    if (c->len == c->cap) {");
    sb_line(b, "        c->cap *= 2;");
    sb_line(b, "        c->data = (tk_w *)realloc(c->data, (size_t)c->cap * sizeof(tk_w));");
    sb_line(b, "        if (!c->data) exit(137);");
    sb_line(b, "    }");
    sb_line(b, "    c->data[c->len] = value;");
    sb_line(b, "    return c->len++;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w track_i64_collection_get(tk_w h, tk_w index) {");
    sb_line(b, "    const TrackI64Collection *c = (const TrackI64Collection *)TK_PTR(h);");
    sb_line(b, "    if (!c || index < 0 || index >= c->len) return 0;");
    sb_line(b, "    return c->data[index];");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w track_i64_collection_set(tk_w h, tk_w index, tk_w value) {");
    sb_line(b, "    TrackI64Collection *c = (TrackI64Collection *)TK_PTR(h);");
    sb_line(b, "    if (!c || index < 0 || index >= c->len) return 0;");
    sb_line(b, "    c->data[index] = value;");
    sb_line(b, "    return 1;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w track_i64_collection_pop(tk_w h) {");
    sb_line(b, "    TrackI64Collection *c = (TrackI64Collection *)TK_PTR(h);");
    sb_line(b, "    if (!c || c->len == 0) return 0;");
    sb_line(b, "    return c->data[--c->len];");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "/* Shrink to `len` elements (no-op when already shorter). */");
    sb_line(b, "tk_w track_i64_collection_truncate(tk_w h, tk_w len) {");
    sb_line(b, "    TrackI64Collection *c = (TrackI64Collection *)TK_PTR(h);");
    sb_line(b, "    if (c && len >= 0 && len < c->len) c->len = len;");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "/* --------------------------------------------------------- string builder */");
    sb_line(b, "");
    sb_line(b, "typedef struct {");
    sb_line(b, "    char *data;");
    sb_line(b, "    size_t len;");
    sb_line(b, "    size_t cap;");
    sb_line(b, "} TrackStrBuf;");
    sb_line(b, "");
    sb_line(b, "static void sb_reserve(TrackStrBuf *b, size_t extra) {");
    sb_line(b, "    if (b->len + extra + 1 <= b->cap) return;");
    sb_line(b, "    while (b->len + extra + 1 > b->cap) b->cap *= 2;");
    sb_line(b, "    b->data = (char *)realloc(b->data, b->cap);");
    sb_line(b, "    if (!b->data) exit(137);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w track_sb_new(void) {");
    sb_line(b, "    TrackStrBuf *b = (TrackStrBuf *)malloc(sizeof(TrackStrBuf));");
    sb_line(b, "    if (!b) exit(137);");
    sb_line(b, "    b->cap = 256;");
    sb_line(b, "    b->len = 0;");
    sb_line(b, "    b->data = (char *)malloc(b->cap);");
    sb_line(b, "    if (!b->data) exit(137);");
    sb_line(b, "    b->data[0] = '\\0';");
    sb_line(b, "    return TK_WORD(b);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w track_sb_push(tk_w h, tk_w s) {");
    sb_line(b, "    TrackStrBuf *b = (TrackStrBuf *)TK_PTR(h);");
    sb_line(b, "    if (!b || !s) return 0;");
    sb_line(b, "    size_t n = strlen(TK_STR(s));");
    sb_line(b, "    sb_reserve(b, n);");
    sb_line(b, "    memcpy(b->data + b->len, TK_STR(s), n + 1);");
    sb_line(b, "    b->len += n;");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w track_sb_push_byte(tk_w h, tk_w byte) {");
    sb_line(b, "    TrackStrBuf *b = (TrackStrBuf *)TK_PTR(h);");
    sb_line(b, "    if (!b) return 0;");
    sb_line(b, "    sb_reserve(b, 1);");
    sb_line(b, "    b->data[b->len++] = (char)byte;");
    sb_line(b, "    b->data[b->len] = '\\0';");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w track_sb_push_int(tk_w h, tk_w val) {");
    sb_line(b, "    char buf[32];");
    sb_line(b, "    snprintf(buf, sizeof(buf), \"%lld\", (long long)val);");
    sb_line(b, "    return track_sb_push(h, TK_WORD(buf));");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w track_sb_len(tk_w h) {");
    sb_line(b, "    TrackStrBuf *b = (TrackStrBuf *)TK_PTR(h);");
    sb_line(b, "    return b ? (tk_w)b->len : 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "/* Copy the builder contents into a new string. */");
    sb_line(b, "tk_w track_sb_str(tk_w h) {");
    sb_line(b, "    TrackStrBuf *b = (TrackStrBuf *)TK_PTR(h);");
    sb_line(b, "    return TK_WORD(b ? tk_dup_n(b->data, b->len) : tk_dup(\"\"));");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w track_sb_clear(tk_w h) {");
    sb_line(b, "    TrackStrBuf *b = (TrackStrBuf *)TK_PTR(h);");
    sb_line(b, "    if (b) {");
    sb_line(b, "        b->len = 0;");
    sb_line(b, "        b->data[0] = '\\0';");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "/* ----------------------------------------------------------------- arrays */");
    sb_line(b, "");
    sb_line(b, "/* Array values are cells [length, elements...]; indexing is bounds checked. */");
    sb_line(b, "static void tk_bounds(tk_w a, tk_w i) {");
    sb_line(b, "    if (!a) track_abort(TK_WORD(\"index into a null array\"));");
    sb_line(b, "    if (i < 0 || i >= ((tk_w *)TK_PTR(a))[0]) track_abort(TK_WORD(\"array index out of bounds\"));");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w track_array_get(tk_w a, tk_w i) {");
    sb_line(b, "    tk_bounds(a, i);");
    sb_line(b, "    return ((tk_w *)TK_PTR(a))[i + 1];");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w track_array_set(tk_w a, tk_w i, tk_w v) {");
    sb_line(b, "    tk_bounds(a, i);");
    sb_line(b, "    ((tk_w *)TK_PTR(a))[i + 1] = v;");
    sb_line(b, "    return v;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "/* Copy of a[from..to]; `to` of -1 means the end of the array. */");
    sb_line(b, "tk_w track_array_slice(tk_w a, tk_w from, tk_w to) {");
    sb_line(b, "    tk_w len = a ? ((tk_w *)TK_PTR(a))[0] : 0;");
    sb_line(b, "    if (to < 0) to = len;");
    sb_line(b, "    if (from < 0 || from > to || to > len) track_abort(TK_WORD(\"array slice out of bounds\"));");
    sb_line(b, "    tk_w out = alloc((to - from + 1) * 8);");
    sb_line(b, "    ((tk_w *)TK_PTR(out))[0] = to - from;");
    sb_line(b, "    if (to > from) memcpy((tk_w *)TK_PTR(out) + 1, (tk_w *)TK_PTR(a) + 1 + from, (size_t)(to - from) * 8);");
    sb_line(b, "    return out;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w array_len(tk_w a) { return a ? ((tk_w *)TK_PTR(a))[0] : 0; }");
    sb_line(b, "");
    sb_line(b, "/* A field access whose struct tag matched none of the declaring structs. */");
    sb_line(b, "tk_w track_bad_field(void) {");
    sb_line(b, "    return track_abort(TK_WORD(\"field access on a value of the wrong struct type\"));");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "/* ---------------------------------------------------------------- network */");
    sb_line(b, "");
    sb_line(b, "tk_w net_socket_tcp_listen(tk_w port) {");
    sb_line(b, "    int fd = socket(AF_INET, SOCK_STREAM, 0);");
    sb_line(b, "    if (fd < 0) return -1;");
    sb_line(b, "    int opt = 1;");
    sb_line(b, "    setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));");
    sb_line(b, "    struct sockaddr_in addr;");
    sb_line(b, "    memset(&addr, 0, sizeof(addr));");
    sb_line(b, "    addr.sin_family = AF_INET;");
    sb_line(b, "    addr.sin_addr.s_addr = INADDR_ANY;");
    sb_line(b, "    addr.sin_port = htons((uint16_t)port);");
    sb_line(b, "    if (bind(fd, (struct sockaddr *)&addr, sizeof(addr)) < 0) {");
    sb_line(b, "        if (errno == EADDRINUSE) {");
    sb_line(b, "            fprintf(stderr, \"Track Network Error: Port conflict! Port %d is already in use by another process.\\n\", (int)port);");
    sb_line(b, "        } else {");
    sb_line(b, "            fprintf(stderr, \"Track Network Error: Failed to bind TCP socket on port %d (errno: %d).\\n\", (int)port, errno);");
    sb_line(b, "        }");
    sb_line(b, "        fflush(stderr);");
    sb_line(b, "        close(fd);");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    if (listen(fd, 128) < 0) {");
    sb_line(b, "        close(fd);");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    return fd;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w net_socket_accept(tk_w server_fd) {");
    sb_line(b, "    if (server_fd < 0) return -1;");
    sb_line(b, "    struct sockaddr_in client_addr;");
    sb_line(b, "    socklen_t addrlen = sizeof(client_addr);");
    sb_line(b, "    return accept((int)server_fd, (struct sockaddr *)&client_addr, &addrlen);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w net_socket_connect(tk_w host, tk_w port) {");
    sb_line(b, "    if (!host) return -1;");
    sb_line(b, "    int fd = socket(AF_INET, SOCK_STREAM, 0);");
    sb_line(b, "    if (fd < 0) return -1;");
    sb_line(b, "    struct sockaddr_in addr;");
    sb_line(b, "    memset(&addr, 0, sizeof(addr));");
    sb_line(b, "    addr.sin_family = AF_INET;");
    sb_line(b, "    addr.sin_port = htons((uint16_t)port);");
    sb_line(b, "    if (inet_pton(AF_INET, TK_STR(host), &addr.sin_addr) <= 0 ||");
    sb_line(b, "        connect(fd, (struct sockaddr *)&addr, sizeof(addr)) < 0) {");
    sb_line(b, "        close(fd);");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    return fd;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w net_socket_send(tk_w fd, tk_w data, tk_w len) {");
    sb_line(b, "    if (fd < 0 || !data) return -1;");
    sb_line(b, "    return (tk_w)send((int)fd, TK_PTR(data), (size_t)len, 0);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w net_socket_recv(tk_w fd, tk_w buf, tk_w max_len) {");
    sb_line(b, "    if (fd < 0 || !buf) return -1;");
    sb_line(b, "    return (tk_w)recv((int)fd, TK_PTR(buf), (size_t)max_len, 0);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "tk_w net_socket_close(tk_w fd) {");
    sb_line(b, "    if (fd >= 0) close((int)fd);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    return 0;
}

