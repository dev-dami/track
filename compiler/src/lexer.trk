// lexer.trk — tokenizer for Track source files.
//
// Mirrors the bootstrap lexer (`src/lexer/mod.rs`): whitespace is
// [ \t\r\n], `//` comments run to the end of the line, identifiers are
// ASCII [A-Za-z_][A-Za-z0-9_]*, integers are decimal i64, and strings are
// unescaped at lex time. Each token is a TK_WIDTH-word record
// (kind, value, start, end) with positions in the global position space.

import "base";

const TK_WIDTH = 4;

const TK_EOF = 0;
const TK_INT = 1;
const TK_STR = 2;
const TK_IDENT = 3;

// Keywords (their spellings are interned first, in this order, so the
// name id of a keyword spelling is its index in `keyword_spellings`).
const TK_IMPORT = 10;
const TK_USE = 11;
const TK_LET = 12;
const TK_MUT = 13;
const TK_WITH = 14;
const TK_FN = 15;
const TK_RETURN = 16;
const TK_IF = 17;
const TK_ELSE = 18;
const TK_WHILE = 19;
const TK_FOR = 20;
const TK_IN = 21;
const TK_TRUE = 22;
const TK_FALSE = 23;
const TK_STRUCT = 24;
const TK_ENUM = 25;
const TK_UNION = 26;
const TK_MATCH = 27;
const TK_AS = 28;
const TK_CONST = 29;
const TK_TYPE = 30;
const TK_TY_U8 = 31;
const TK_TY_I8 = 32;
const TK_TY_I32 = 33;
const TK_TY_U32 = 34;
const TK_TY_I64 = 35;
const TK_TY_U64 = 36;
const TK_TY_BOOL = 37;
const TK_TY_VOID = 38;
const TK_TY_PTR = 39;
const KW_COUNT = 30;

const TK_ATMACRO = 40;
const TK_AT = 41;
const TK_EQ = 60;
const TK_EQEQ = 61;
const TK_NEQ = 62;
const TK_BANG = 63;
const TK_LBRACE = 64;
const TK_RBRACE = 65;
const TK_LPAREN = 66;
const TK_RPAREN = 67;
const TK_LBRACKET = 68;
const TK_RBRACKET = 69;
const TK_COMMA = 70;
const TK_COLON = 71;
const TK_COLONCOLON = 72;
const TK_ARROW = 73;
const TK_FATARROW = 74;
const TK_SEMI = 75;
const TK_DOTDOT = 76;
const TK_DOT = 77;
const TK_UNDERSCORE = 78;
const TK_AMP = 79;
const TK_PIPE = 80;
const TK_STAR = 81;
const TK_PLUS = 82;
const TK_MINUS = 83;
const TK_SLASH = 84;
const TK_PERCENT = 85;
const TK_LT = 86;
const TK_GT = 87;
const TK_LTE = 88;
const TK_GTE = 89;
const TK_AMPAMP = 90;
const TK_PIPEPIPE = 91;
const TK_SHL = 92;
const TK_SHR = 93;

fn keyword_spelling(i: i64) -> i64 {
    if i == 0 { return "import"; }
    if i == 1 { return "use"; }
    if i == 2 { return "let"; }
    if i == 3 { return "mut"; }
    if i == 4 { return "with"; }
    if i == 5 { return "fn"; }
    if i == 6 { return "return"; }
    if i == 7 { return "if"; }
    if i == 8 { return "else"; }
    if i == 9 { return "while"; }
    if i == 10 { return "for"; }
    if i == 11 { return "in"; }
    if i == 12 { return "true"; }
    if i == 13 { return "false"; }
    if i == 14 { return "struct"; }
    if i == 15 { return "enum"; }
    if i == 16 { return "union"; }
    if i == 17 { return "match"; }
    if i == 18 { return "as"; }
    if i == 19 { return "const"; }
    if i == 20 { return "type"; }
    if i == 21 { return "u8"; }
    if i == 22 { return "i8"; }
    if i == 23 { return "i32"; }
    if i == 24 { return "u32"; }
    if i == 25 { return "i64"; }
    if i == 26 { return "u64"; }
    if i == 27 { return "bool"; }
    if i == 28 { return "void"; }
    return "ptr";
}

// Intern keyword spellings so that name id == keyword index. Must run on a
// fresh context before anything else is interned.
fn lex_init(c: i64) -> i64 {
    let mut i: i64 = 0;
    while i < KW_COUNT {
        intern(c, keyword_spelling(i));
        i = i + 1;
    }
    return 0;
}

fn tok_count(c: i64) -> i64 { return vlen(cx(c, CX_TOKS)) / TK_WIDTH; }
fn tok_kind(c: i64, t: i64) -> i64 { return vget(cx(c, CX_TOKS), t * TK_WIDTH); }
fn tok_value(c: i64, t: i64) -> i64 { return vget(cx(c, CX_TOKS), t * TK_WIDTH + 1); }
fn tok_start(c: i64, t: i64) -> i64 { return vget(cx(c, CX_TOKS), t * TK_WIDTH + 2); }
fn tok_end(c: i64, t: i64) -> i64 { return vget(cx(c, CX_TOKS), t * TK_WIDTH + 3); }

fn push_token(c: i64, kind: i64, value: i64, start: i64, end: i64) -> i64 {
    let toks = cx(c, CX_TOKS);
    vpush(toks, kind);
    vpush(toks, value);
    vpush(toks, start);
    vpush(toks, end);
    return 0;
}

fn is_ident_start_byte(b: i64) -> bool {
    if b >= 97 && b <= 122 { return true; }
    if b >= 65 && b <= 90 { return true; }
    return b == 95;
}

fn is_digit_byte(b: i64) -> bool {
    return b >= 48 && b <= 57;
}

fn is_ident_byte(b: i64) -> bool {
    if is_ident_start_byte(b) { return true; }
    return is_digit_byte(b);
}

fn is_space_byte(b: i64) -> bool {
    if b == 32 || b == 10 { return true; }
    return b == 9 || b == 13;
}

// Byte at `i`, or -1 past the end.
fn byte_at(bytes: i64, i: i64) -> i64 {
    if i >= vlen(bytes) {
        return -1;
    }
    return vget(bytes, i);
}

// Punctuation token kind starting at `i`, and its length (0 if none).
fn punct(b: i64, b2: i64) -> (i64, i64) {
    if b == 61 {
        if b2 == 61 { return (TK_EQEQ, 2); }
        if b2 == 62 { return (TK_FATARROW, 2); }
        return (TK_EQ, 1);
    }
    if b == 33 {
        if b2 == 61 { return (TK_NEQ, 2); }
        return (TK_BANG, 1);
    }
    if b == 58 {
        if b2 == 58 { return (TK_COLONCOLON, 2); }
        return (TK_COLON, 1);
    }
    if b == 45 {
        if b2 == 62 { return (TK_ARROW, 2); }
        return (TK_MINUS, 1);
    }
    if b == 46 {
        if b2 == 46 { return (TK_DOTDOT, 2); }
        return (TK_DOT, 1);
    }
    if b == 60 {
        if b2 == 61 { return (TK_LTE, 2); }
        if b2 == 60 { return (TK_SHL, 2); }
        return (TK_LT, 1);
    }
    if b == 62 {
        if b2 == 61 { return (TK_GTE, 2); }
        if b2 == 62 { return (TK_SHR, 2); }
        return (TK_GT, 1);
    }
    if b == 38 {
        if b2 == 38 { return (TK_AMPAMP, 2); }
        return (TK_AMP, 1);
    }
    if b == 124 {
        if b2 == 124 { return (TK_PIPEPIPE, 2); }
        return (TK_PIPE, 1);
    }
    if b == 123 { return (TK_LBRACE, 1); }
    if b == 125 { return (TK_RBRACE, 1); }
    if b == 40 { return (TK_LPAREN, 1); }
    if b == 41 { return (TK_RPAREN, 1); }
    if b == 91 { return (TK_LBRACKET, 1); }
    if b == 93 { return (TK_RBRACKET, 1); }
    if b == 44 { return (TK_COMMA, 1); }
    if b == 59 { return (TK_SEMI, 1); }
    if b == 42 { return (TK_STAR, 1); }
    if b == 43 { return (TK_PLUS, 1); }
    if b == 47 { return (TK_SLASH, 1); }
    if b == 37 { return (TK_PERCENT, 1); }
    return (0, 0);
}

fn lex_ident(c: i64, bytes: i64, start: i64, base: i64) -> i64 {
    let mut i = start;
    while is_ident_byte(byte_at(bytes, i)) {
        i = i + 1;
    }
    if i - start == 1 && vget(bytes, start) == 95 {
        push_token(c, TK_UNDERSCORE, 0, base + start, base + i);
        return i;
    }
    let sb = cx(c, CX_SB);
    sb_reset(sb);
    let mut j = start;
    while j < i {
        sb_byte(sb, vget(bytes, j));
        j = j + 1;
    }
    let id = intern(c, sb_text(sb));
    if id < KW_COUNT {
        push_token(c, TK_IMPORT + id, id, base + start, base + i);
    } else {
        push_token(c, TK_IDENT, id, base + start, base + i);
    }
    return i;
}

fn lex_int(c: i64, bytes: i64, start: i64, base: i64) -> i64 {
    let mut i = start;
    let mut value: i64 = 0;
    while is_digit_byte(byte_at(bytes, i)) {
        let digit = vget(bytes, i) - 48;
        if value > (9223372036854775807 - digit) / 10 {
            fail_at(c, base + start, "E0002", "integer literal is out of range for i64");
        }
        value = value * 10 + digit;
        i = i + 1;
    }
    push_token(c, TK_INT, value, base + start, base + i);
    return i;
}

fn lex_string(c: i64, bytes: i64, start: i64, base: i64) -> i64 {
    let sb = cx(c, CX_SB);
    sb_reset(sb);
    let mut i = start + 1;
    let mut open = true;
    while open {
        let b = byte_at(bytes, i);
        if b < 0 {
            fail_at(c, base + start, "E0003", "unterminated string literal");
        }
        if b == 34 {
            open = false;
            i = i + 1;
        } else if b == 92 {
            let e = byte_at(bytes, i + 1);
            if e < 0 {
                fail_at(c, base + start, "E0003", "unterminated string literal");
            }
            if e == 110 {
                sb_byte(sb, 10);
            } else if e == 114 {
                sb_byte(sb, 13);
            } else if e == 116 {
                sb_byte(sb, 9);
            } else if e == 48 {
                sb_byte(sb, 0);
            } else if e == 34 || e == 39 || e == 92 {
                sb_byte(sb, e);
            } else {
                sb_byte(sb, 92);
                sb_byte(sb, e);
            }
            i = i + 2;
        } else {
            sb_byte(sb, b);
            i = i + 1;
        }
    }
    push_token(c, TK_STR, sb_text(sb), base + start, base + i);
    return i;
}

fn lex_at(c: i64, bytes: i64, start: i64, base: i64) -> i64 {
    let mut is_macro = true;
    let word: i64 = "macro";
    let mut k: i64 = 0;
    while k < 5 {
        if byte_at(bytes, start + 1 + k) != str_char_at(word, k) {
            is_macro = false;
        }
        k = k + 1;
    }
    if is_macro {
        push_token(c, TK_ATMACRO, 0, base + start, base + start + 6);
        return start + 6;
    }
    push_token(c, TK_AT, 0, base + start, base + start + 1);
    return start + 1;
}

// Tokenize file `f`, appending its tokens (terminated by TK_EOF) to the
// token table. Returns the index of the file's first token.
fn lex_file(c: i64, f: i64) -> i64 {
    let bytes = vget(cx(c, CX_BYTES), f);
    let base = vget(cx(c, CX_BASES), f);
    let first = tok_count(c);
    let n = vlen(bytes);
    let mut i: i64 = 0;
    while i < n {
        let b = vget(bytes, i);
        let b2 = byte_at(bytes, i + 1);
        if is_space_byte(b) {
            i = i + 1;
        } else if b == 47 && b2 == 47 {
            while i < n && vget(bytes, i) != 10 {
                i = i + 1;
            }
        } else if is_ident_start_byte(b) {
            i = lex_ident(c, bytes, i, base);
        } else if is_digit_byte(b) {
            i = lex_int(c, bytes, i, base);
        } else if b == 34 {
            i = lex_string(c, bytes, i, base);
        } else if b == 64 {
            i = lex_at(c, bytes, i, base);
        } else {
            let (kind, width) = punct(b, b2);
            if width == 0 {
                fail_at(c, base + i, "E0001", "unexpected character");
            }
            push_token(c, kind, 0, base + i, base + i + width);
            i = i + width;
        }
    }
    push_token(c, TK_EOF, 0, base + n, base + n);
    return first;
}

// Human-readable token kind, used by diagnostics and `trackc tokens`.
fn token_kind_text(kind: i64) -> i64 {
    if kind == TK_EOF { return "end of file"; }
    if kind == TK_INT { return "integer"; }
    if kind == TK_STR { return "string"; }
    if kind == TK_IDENT { return "identifier"; }
    if kind >= TK_IMPORT && kind < TK_IMPORT + KW_COUNT {
        return text_cat3("'", keyword_spelling(kind - TK_IMPORT), "'");
    }
    if kind == TK_ATMACRO { return "'@macro'"; }
    if kind == TK_AT { return "'@'"; }
    if kind == TK_EQ { return "'='"; }
    if kind == TK_EQEQ { return "'=='"; }
    if kind == TK_NEQ { return "'!='"; }
    if kind == TK_BANG { return "'!'"; }
    if kind == TK_LBRACE { return "'{'"; }
    if kind == TK_RBRACE { return "'}'"; }
    if kind == TK_LPAREN { return "'('"; }
    if kind == TK_RPAREN { return "')'"; }
    if kind == TK_LBRACKET { return "'['"; }
    if kind == TK_RBRACKET { return "']'"; }
    if kind == TK_COMMA { return "','"; }
    if kind == TK_COLON { return "':'"; }
    if kind == TK_COLONCOLON { return "'::'"; }
    if kind == TK_ARROW { return "'->'"; }
    if kind == TK_FATARROW { return "'=>'"; }
    if kind == TK_SEMI { return "';'"; }
    if kind == TK_DOTDOT { return "'..'"; }
    if kind == TK_DOT { return "'.'"; }
    if kind == TK_UNDERSCORE { return "'_'"; }
    if kind == TK_AMP { return "'&'"; }
    if kind == TK_PIPE { return "'|'"; }
    if kind == TK_STAR { return "'*'"; }
    if kind == TK_PLUS { return "'+'"; }
    if kind == TK_MINUS { return "'-'"; }
    if kind == TK_SLASH { return "'/'"; }
    if kind == TK_PERCENT { return "'%'"; }
    if kind == TK_LT { return "'<'"; }
    if kind == TK_GT { return "'>'"; }
    if kind == TK_LTE { return "'<='"; }
    if kind == TK_GTE { return "'>='"; }
    if kind == TK_AMPAMP { return "'&&'"; }
    if kind == TK_PIPEPIPE { return "'||'"; }
    if kind == TK_SHL { return "'<<'"; }
    return "'>>'";
}

// Register a source file and return its id. Positions of file `f` start at
// the end of the previous file plus one, so every byte has a unique
// global position.
fn add_source(c: i64, path: i64, src: i64) -> i64 {
    let srcs = cx(c, CX_SRCS);
    let bases = cx(c, CX_BASES);
    let f = vlen(srcs);
    let mut base: i64 = 0;
    if f > 0 {
        base = vget(bases, f - 1) + vlen(vget(cx(c, CX_BYTES), f - 1)) + 1;
    }
    vpush(srcs, src);
    vpush(cx(c, CX_PATHS), path);
    vpush(bases, base);
    vpush(cx(c, CX_BYTES), text_bytes(src));
    return f;
}
