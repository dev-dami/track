// lexer.trk — Native tokenizer core (v0.7)
// Self-contained for `yard build` — duplicates `Token` from `token.trk`
// so codegen sees the union in this compilation unit. `token.trk` remains
// the canonical definition; this copy must stay in sync.

union Token {
    Import, Use, Let, Mut, With, Fn, Return, If, Else, While, For, In, True, False,
    Struct, Enum, Union, Match, As, AtMacro, Const, TypeDef, At,
    TyU8, TyI8, TyI32, TyU32, TyI64, TyU64, TyBool, TyVoid, TyPtr,
    Int(i64), StrLit(Str), Ident(Str),
    Eq, EqEq, Neq, Bang, LBrace, RBrace, LParen, RParen, LBracket, RBracket,
    Comma, Colon, ColonColon, Arrow, FatArrow, Semicolon, DotDot, Dot,
    Underscore, Amp, Pipe, Star, Plus, Minus, Slash, Percent, Lt, Gt, Lte, Gte,
    AmpAmp, PipePipe, Shl, Shr, Eof, Unknown,
}

fn keyword_or_ident_extended(lex: Str) -> Token {
    let eq_use = str_eq(&lex, "use");
    if eq_use { let _used = lex; return Token::Use; } else {
    let eq_with = str_eq(&lex, "with");
    if eq_with { let _used = lex; return Token::With; } else {
    let eq_for = str_eq(&lex, "for");
    if eq_for { let _used = lex; return Token::For; } else {
    let eq_in = str_eq(&lex, "in");
    if eq_in { let _used = lex; return Token::In; } else {
    let eq_as = str_eq(&lex, "as");
    if eq_as { let _used = lex; return Token::As; } else {
    let eq_const = str_eq(&lex, "const");
    if eq_const { let _used = lex; return Token::Const; } else {
    let eq_type = str_eq(&lex, "type");
    if eq_type { let _used = lex; return Token::TypeDef; } else {
    let eq_u8 = str_eq(&lex, "u8");
    if eq_u8 { let _used = lex; return Token::TyU8; } else {
    let eq_i8 = str_eq(&lex, "i8");
    if eq_i8 { let _used = lex; return Token::TyI8; } else {
    let eq_i32 = str_eq(&lex, "i32");
    if eq_i32 { let _used = lex; return Token::TyI32; } else {
    let eq_u32 = str_eq(&lex, "u32");
    if eq_u32 { let _used = lex; return Token::TyU32; } else {
    let eq_i64 = str_eq(&lex, "i64");
    if eq_i64 { let _used = lex; return Token::TyI64; } else {
    let eq_u64 = str_eq(&lex, "u64");
    if eq_u64 { let _used = lex; return Token::TyU64; } else {
    let eq_bool = str_eq(&lex, "bool");
    if eq_bool { let _used = lex; return Token::TyBool; } else {
    let eq_void = str_eq(&lex, "void");
    if eq_void { let _used = lex; return Token::TyVoid; } else {
    let eq_ptr = str_eq(&lex, "ptr");
    if eq_ptr { let _used = lex; return Token::TyPtr; } else {
        return keyword_or_ident(lex);
    } } } } } } } } } } } } } } } }
}

fn keyword_or_ident(lex: Str) -> Token {
    // Keep this table in lock-step with src/lexer/mod.rs. Parser work depends
    // on every reserved word being classified before it reaches the AST.
    let eq_import = str_eq(&lex, "import");
    if eq_import {
        let _c = lex;
        return Token::Import;
    } else {
        let eq_let = str_eq(&lex, "let");
        if eq_let {
            let _c2 = lex;
            return Token::Let;
        } else {
            let eq_mut = str_eq(&lex, "mut");
            if eq_mut {
                let _c3 = lex;
                return Token::Mut;
            } else {
                let eq_fn = str_eq(&lex, "fn");
                if eq_fn {
                    let _c4 = lex;
                    return Token::Fn;
                } else {
                    let eq_return = str_eq(&lex, "return");
                    if eq_return {
                        let _c5 = lex;
                        return Token::Return;
                    } else {
                        let eq_if = str_eq(&lex, "if");
                        if eq_if {
                            let _c6 = lex;
                            return Token::If;
                        } else {
                            let eq_else = str_eq(&lex, "else");
                            if eq_else {
                                let _c7 = lex;
                                return Token::Else;
                            } else {
                                let eq_while = str_eq(&lex, "while");
                                if eq_while {
                                    let _c8 = lex;
                                    return Token::While;
                                } else {
                                    let eq_true = str_eq(&lex, "true");
                                    if eq_true {
                                        let _c9 = lex;
                                        return Token::True;
                                    } else {
                                        let eq_false = str_eq(&lex, "false");
                                        if eq_false {
                                            let _c10 = lex;
                                            return Token::False;
                                        } else {
                                            let eq_struct = str_eq(&lex, "struct");
                                            if eq_struct {
                                                let _c11 = lex;
                                                return Token::Struct;
                                            } else {
                                                let eq_enum = str_eq(&lex, "enum");
                                                if eq_enum {
                                                    let _c12 = lex;
                                                    return Token::Enum;
                                                } else {
                                                    let eq_union = str_eq(&lex, "union");
                                                    if eq_union {
                                                        let _c13 = lex;
                                                        return Token::Union;
                                                    } else {
                                                        let eq_match = str_eq(&lex, "match");
                                                        if eq_match {
                                                            let _c14 = lex;
                                                            return Token::Match;
                                                        } else {
                                                            return Token::Ident(lex);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn token_kind_name(tok: Token) -> Str {
    let mut out = "Other";
    match tok {
        Token::Import => out = "Import",
        Token::Use => out = "Use",
        Token::Let => out = "Let",
        Token::Mut => out = "Mut",
        Token::With => out = "With",
        Token::Fn => out = "Fn",
        Token::Return => out = "Return",
        Token::If => out = "If",
        Token::Else => out = "Else",
        Token::While => out = "While",
        Token::For => out = "For",
        Token::In => out = "In",
        Token::True => out = "True",
        Token::False => out = "False",
        Token::Struct => out = "Struct",
        Token::Enum => out = "Enum",
        Token::Union => out = "Union",
        Token::Match => out = "Match",
        Token::As => out = "As",
        Token::Const => out = "Const",
        Token::TypeDef => out = "TypeDef",
        Token::TyU8 => out = "TyU8",
        Token::TyI8 => out = "TyI8",
        Token::TyI32 => out = "TyI32",
        Token::TyU32 => out = "TyU32",
        Token::TyI64 => out = "TyI64",
        Token::TyU64 => out = "TyU64",
        Token::TyBool => out = "TyBool",
        Token::TyVoid => out = "TyVoid",
        Token::TyPtr => out = "TyPtr",
        Token::Eof => out = "Eof",
        Token::Unknown => out = "Unknown",
        Token::Int(_) => out = "Int",
        Token::StrLit(_) => out = "StrLit",
        Token::Ident(_) => out = "Ident",
        _ => out = "Other",
    }
    return out;
}

fn token_kind_code(tok: Token) -> i64 {
    let mut out: i64 = 0;
    match tok {
        Token::Use => out = 1,
        Token::With => out = 2,
        Token::For => out = 3,
        Token::In => out = 4,
        Token::As => out = 5,
        Token::Const => out = 6,
        Token::TypeDef => out = 7,
        Token::TyI32 => out = 8,
        Token::TyU64 => out = 9,
        Token::TyBool => out = 10,
        Token::TyVoid => out = 11,
        Token::TyPtr => out = 12,
        _ => out = 0,
    }
    return out;
}

fn is_alpha_char(c: u8) -> bool {
    return char_is_alpha(c);
}

fn is_digit_char(c: u8) -> bool {
    return char_is_digit(c);
}

fn is_ident_start(c: u8) -> bool {
    if char_is_alpha(c) {
        return true;
    }
    if c == 95 {
        return true;
    }
    return false;
}

fn is_ident_continue(c: u8) -> bool {
    if char_is_alphanumeric(c) {
        return true;
    }
    if c == 95 {
        return true;
    }
    return false;
}

fn skip_ws_and_comments(src: &Str, pos: i64) -> i64 {
    let len = str_len(src);
    let mut p = pos;
    let mut skipping = true;
    while p < len && skipping {
        let ch = str_char_at(src, p);
        if char_is_space(ch) {
            p = p + 1;
        } else {
            if ch == 47 {
                let nxt = str_char_at(src, p + 1);
                if nxt == 47 {
                    p = p + 2;
                    let mut in_comment = true;
                    while p < len && in_comment {
                        let c2 = str_char_at(src, p);
                        if c2 == 10 {
                            in_comment = false;
                            p = p + 1;
                        } else {
                            p = p + 1;
                        }
                    }
                } else {
                    skipping = false;
                }
            } else {
                skipping = false;
            }
        }
    }
    return p;
}

fn lex_number(src: &Str, start: i64) -> (Token, i64) {
    let len = str_len(src);
    let mut p = start;
    let mut val: i64 = 0;
    let mut cont = true;
    while p < len && cont {
        let ch = str_char_at(src, p);
        if char_is_digit(ch) {
            let digit: i64 = ch - 48;
            val = val * 10 + digit;
            p = p + 1;
        } else {
            cont = false;
        }
    }
    let tok = Token::Int(val);
    return (tok, p);
}

fn lex_ident(src: &Str, start: i64) -> (Token, i64) {
    let len = str_len(src);
    let mut p = start;
    let mut cont = true;
    while p < len && cont {
        let ch = str_char_at(src, p);
        if is_ident_continue(ch) {
            p = p + 1;
        } else {
            cont = false;
        }
    }
    let slice_len = p - start;
    let lexeme = str_substr(src, start, slice_len);
    let tok = keyword_or_ident_extended(lexeme);
    return (tok, p);
}

fn lex_string(src: &Str, start: i64) -> (Token, i64) {
    let len = str_len(src);
    let mut p = start + 1;
    let mut open = true;
    while p < len && open {
        let ch = str_char_at(src, p);
        if ch == 92 {
            p = p + 2;
        } else {
            if ch == 34 {
                p = p + 1;
                open = false;
            } else {
                p = p + 1;
            }
        }
    }
    let inner_len = p - start - 2;
    let inner = str_substr(src, start + 1, inner_len);
    let tok = Token::StrLit(inner);
    return (tok, p);
}

fn lex_next(src: &Str, pos: i64) -> (Token, i64) {
    let p0 = skip_ws_and_comments(src, pos);
    let len = str_len(src);
    if p0 >= len {
        return (Token::Eof, p0);
    }
    let ch = str_char_at(src, p0);
    let ch2 = str_char_at(src, p0 + 1);

    if ch == 34 {
        return lex_string(src, p0);
    }
    if char_is_digit(ch) {
        return lex_number(src, p0);
    }
    if ch == 95 && !is_ident_continue(ch2) {
        return (Token::Underscore, p0 + 1);
    }
    if is_ident_start(ch) {
        return lex_ident(src, p0);
    }

    if ch == 58 {
        if ch2 == 58 {
            return (Token::ColonColon, p0 + 2);
        }
        return (Token::Colon, p0 + 1);
    }
    if ch == 61 {
        if ch2 == 61 {
            return (Token::EqEq, p0 + 2);
        }
        if ch2 == 62 {
            return (Token::FatArrow, p0 + 2);
        }
        return (Token::Eq, p0 + 1);
    }
    if ch == 33 {
        if ch2 == 61 {
            return (Token::Neq, p0 + 2);
        }
        return (Token::Bang, p0 + 1);
    }
    if ch == 60 {
        if ch2 == 61 {
            return (Token::Lte, p0 + 2);
        }
        if ch2 == 60 {
            return (Token::Shl, p0 + 2);
        }
        return (Token::Lt, p0 + 1);
    }
    if ch == 62 {
        if ch2 == 61 {
            return (Token::Gte, p0 + 2);
        }
        if ch2 == 62 {
            return (Token::Shr, p0 + 2);
        }
        return (Token::Gt, p0 + 1);
    }
    if ch == 45 {
        if ch2 == 62 {
            return (Token::Arrow, p0 + 2);
        }
        return (Token::Minus, p0 + 1);
    }
    if ch == 46 {
        if ch2 == 46 {
            return (Token::DotDot, p0 + 2);
        }
        return (Token::Dot, p0 + 1);
    }
    if ch == 38 {
        if ch2 == 38 {
            return (Token::AmpAmp, p0 + 2);
        }
        return (Token::Amp, p0 + 1);
    }
    if ch == 124 {
        if ch2 == 124 {
            return (Token::PipePipe, p0 + 2);
        }
        return (Token::Pipe, p0 + 1);
    }

    if ch == 123 {
        return (Token::LBrace, p0 + 1);
    }
    if ch == 125 {
        return (Token::RBrace, p0 + 1);
    }
    if ch == 40 {
        return (Token::LParen, p0 + 1);
    }
    if ch == 41 {
        return (Token::RParen, p0 + 1);
    }
    if ch == 91 {
        return (Token::LBracket, p0 + 1);
    }
    if ch == 93 {
        return (Token::RBracket, p0 + 1);
    }
    if ch == 44 {
        return (Token::Comma, p0 + 1);
    }
    if ch == 59 {
        return (Token::Semicolon, p0 + 1);
    }
    if ch == 42 {
        return (Token::Star, p0 + 1);
    }
    if ch == 43 {
        return (Token::Plus, p0 + 1);
    }
    if ch == 47 {
        return (Token::Slash, p0 + 1);
    }
    if ch == 37 {
        return (Token::Percent, p0 + 1);
    }
    if ch == 95 {
        return (Token::Underscore, p0 + 1);
    }
    if ch == 64 {
        let maybe = str_substr(src, p0, 6);
        let is_macro = str_eq(&maybe, "@macro");
        if is_macro {
            let _c = maybe;
            return (Token::AtMacro, p0 + 6);
        } else {
            let _c2 = maybe;
            return (Token::At, p0 + 1);
        }
    }

    return (Token::Unknown, p0 + 1);
}

// Parser-facing API: preserves the token's end-exclusive byte range while
// retaining the existing two-value lexer API for v0.7 callers.
fn lex_next_spanned(src: &Str, pos: i64) -> (Token, i64, i64) {
    let start = skip_ws_and_comments(src, pos);
    let (token, next) = lex_next(src, pos);
    return (token, start, next);
}

// Stable parser token record: (tag, start byte, end byte, next byte).
// Payloads are recovered from the source span, avoiding ABI coupling between
// tagged-union payloads and the bootstrap parser's object files.
type TokenRecord = (i64, i64, i64, i64);

fn token_tag_eof() -> i64 { return 0; }
fn token_tag_let() -> i64 { return 3; }
fn token_tag_mut() -> i64 { return 4; }
fn token_tag_return() -> i64 { return 7; }
fn token_tag_true() -> i64 { return 13; }
fn token_tag_false() -> i64 { return 14; }
fn token_tag_int() -> i64 { return 32; }
fn token_tag_string() -> i64 { return 33; }
fn token_tag_identifier() -> i64 { return 34; }
fn token_tag_eq() -> i64 { return 35; }
fn token_tag_bang() -> i64 { return 38; }
fn token_tag_lparen() -> i64 { return 41; }
fn token_tag_rparen() -> i64 { return 42; }
fn token_tag_semicolon() -> i64 { return 50; }
fn token_tag_underscore() -> i64 { return 53; }
fn token_tag_star() -> i64 { return 56; }
fn token_tag_plus() -> i64 { return 57; }
fn token_tag_minus() -> i64 { return 58; }
fn token_tag_slash() -> i64 { return 59; }
fn token_tag_percent() -> i64 { return 60; }

fn token_text_tag(text: &Str) -> i64 {
    if str_eq(text, "import") { return 1; }
    if str_eq(text, "use") { return 2; }
    if str_eq(text, "let") { return 3; }
    if str_eq(text, "mut") { return 4; }
    if str_eq(text, "with") { return 5; }
    if str_eq(text, "fn") { return 6; }
    if str_eq(text, "return") { return 7; }
    if str_eq(text, "if") { return 8; }
    if str_eq(text, "else") { return 9; }
    if str_eq(text, "while") { return 10; }
    if str_eq(text, "for") { return 11; }
    if str_eq(text, "in") { return 12; }
    if str_eq(text, "true") { return 13; }
    if str_eq(text, "false") { return 14; }
    if str_eq(text, "struct") { return 15; }
    if str_eq(text, "enum") { return 16; }
    if str_eq(text, "union") { return 17; }
    if str_eq(text, "match") { return 18; }
    if str_eq(text, "as") { return 19; }
    if str_eq(text, "const") { return 21; }
    if str_eq(text, "type") { return 22; }
    if str_eq(text, "u8") { return 23; }
    if str_eq(text, "i8") { return 24; }
    if str_eq(text, "i32") { return 25; }
    if str_eq(text, "u32") { return 26; }
    if str_eq(text, "i64") { return 27; }
    if str_eq(text, "u64") { return 28; }
    if str_eq(text, "bool") { return 29; }
    if str_eq(text, "void") { return 30; }
    if str_eq(text, "ptr") { return 31; }
    if str_eq(text, "_") { return 53; }
    return 34;
}

fn token_symbol_tag(ch: u8, ch2: u8) -> i64 {
    if ch == 61 && ch2 == 61 { return 36; }
    if ch == 61 && ch2 == 62 { return 49; }
    if ch == 33 && ch2 == 61 { return 37; }
    if ch == 58 && ch2 == 58 { return 47; }
    if ch == 45 && ch2 == 62 { return 48; }
    if ch == 46 && ch2 == 46 { return 51; }
    if ch == 60 && ch2 == 61 { return 63; }
    if ch == 62 && ch2 == 61 { return 64; }
    if ch == 38 && ch2 == 38 { return 65; }
    if ch == 124 && ch2 == 124 { return 66; }
    if ch == 60 && ch2 == 60 { return 67; }
    if ch == 62 && ch2 == 62 { return 68; }
    if ch == 61 { return 35; }
    if ch == 33 { return 38; }
    if ch == 123 { return 39; }
    if ch == 125 { return 40; }
    if ch == 40 { return 41; }
    if ch == 41 { return 42; }
    if ch == 91 { return 43; }
    if ch == 93 { return 44; }
    if ch == 44 { return 45; }
    if ch == 58 { return 46; }
    if ch == 59 { return 50; }
    if ch == 46 { return 52; }
    if ch == 38 { return 54; }
    if ch == 124 { return 55; }
    if ch == 95 { return 53; }
    if ch == 42 { return 56; }
    if ch == 43 { return 57; }
    if ch == 45 { return 58; }
    if ch == 47 { return 59; }
    if ch == 37 { return 60; }
    if ch == 60 { return 61; }
    if ch == 62 { return 62; }
    if ch == 64 { return 69; }
    return -1;
}

fn lex_next_record(src: &Str, pos: i64) -> TokenRecord {
    let (_token, start, end) = lex_next_spanned(src, pos);
    let length: i64 = str_len(src);
    if start >= length {
        return (token_tag_eof(), start, end, end);
    }
    let ch = str_char_at(src, start);
    let ch2 = str_char_at(src, start + 1);
    if char_is_digit(ch) {
        return (token_tag_int(), start, end, end);
    }
    if ch == 34 {
        return (token_tag_string(), start, end, end);
    }
    if is_ident_start(ch) {
        let text = str_substr(src, start, end - start);
        let tag = token_text_tag(&text);
        return (tag, start, end, end);
    }
    if ch == 64 {
        let macro_text = str_substr(src, start, end - start);
        if str_eq(&macro_text, "@macro") {
            return (20, start, end, end);
        }
    }
    return (token_symbol_tag(ch, ch2), start, end, end);
}

fn is_eof_token(tok: Token) -> bool {
    let mut out = false;
    match tok {
        Token::Eof => out = true,
        _ => out = false,
    }
    return out;
}

fn count_tokens(src: &Str) -> i64 {
    let len = str_len(src);
    let mut pos: i64 = 0;
    let mut count: i64 = 0;
    let mut done = false;
    while pos < len {
        if done {
            pos = len;
        } else {
            let (tok, next) = lex_next(src, pos);
            let eof = is_eof_token(tok);
            if eof {
                done = true;
            } else {
                count = count + 1;
                pos = next;
                if count > 100 {
                    done = true;
                }
            }
        }
    }
    return count;
}

fn dump_tokens(src: &Str) -> void {
    let len = str_len(src);
    let mut pos: i64 = 0;
    let mut done = false;
    while pos < len {
        if done {
            pos = len;
        } else {
            let (tok, next) = lex_next(src, pos);
            let kind = token_kind_name(tok);
            let is_eof = str_eq(&kind, "Eof");
            if is_eof {
                let _c = kind;
                done = true;
            } else {
                print(kind);
                pos = next;
            }
        }
    }
}
