// cgen.trk — portable C backend.
//
// Every Track value is a 64-bit word (`tk_w`), exactly as in the bootstrap
// Cranelift backend: integers and booleans are plain words, strings are
// `char*`, tuples and payload-union cells are pointers to word arrays.
// Expressions compile to C expression text; constructs that need
// statements (calls, `if`/`match` values, short-circuit logic) are lowered
// into temporaries declared at the top of the function, so the output is
// plain C99 with no compiler extensions.
//
// Output is deterministic: items are emitted in load order and every
// counter restarts per function.

import "base";
import "lexer";
import "ast";
import "symbols";
import "runtime_c";
import "life";

const G_DECLS = 0;    // current function: local declarations
const G_BODY = 1;     // current function: statements
const G_NLOCAL = 2;
const G_NTEMP = 3;
const G_NSLOT = 4;    // stack tuple slots declared so far
const G_INDENT = 5;
const G_BOUND = 6;    // scope stack: (name, previous binding) pairs
const G_AUTO = 7;     // current function: (local id, site node) of live heap-autofree locals
const G_RETVAL = 8;   // current function returns a value
const G_EXTERNS = 9;  // extern (non-runtime) functions in first-use order
const G_FUNCS = 10;   // emitted function definitions
const G_PROTOS = 11;  // user function prototypes
const G_SLOTS = 15;

fn g(c: i64, slot: i64) -> i64 { return vget(cx(c, CX_GEN), slot); }
fn g_set(c: i64, slot: i64, v: i64) -> i64 { return vset(cx(c, CX_GEN), slot, v); }

fn g_counter(c: i64, slot: i64) -> i64 {
    let n = g(c, slot);
    g_set(c, slot, n + 1);
    return n;
}

// Append one statement line to the current function body.
fn emit(c: i64, line: i64) -> i64 {
    let b = g(c, G_BODY);
    let mut i: i64 = 0;
    while i < g(c, G_INDENT) {
        sb_add(b, "    ");
        i = i + 1;
    }
    return sb_line(b, line);
}

fn indent(c: i64, delta: i64) -> i64 {
    return g_set(c, G_INDENT, g(c, G_INDENT) + delta);
}

fn temp(c: i64) -> i64 {
    let name = text_cat("t", text_of_int(g_counter(c, G_NTEMP)));
    sb_line(g(c, G_DECLS), text_cat3("    tk_w ", name, " = 0;"));
    return name;
}

fn local_name(c: i64, id: i64) -> i64 {
    return text_cat("l", text_of_int(id));
}

// Declare a fresh C local for Track variable `name` and bind it.
fn new_local(c: i64, name: i64) -> i64 {
    let id = g_counter(c, G_NLOCAL);
    let text = local_name(c, id);
    sb_line(g(c, G_DECLS), text_cat3("    tk_w ", text, text_cat3(" = 0; /* ", name_text(c, name), " */")));
    bind(c, name, id);
    return id;
}

fn bind(c: i64, name: i64, id: i64) -> i64 {
    let bound = g(c, G_BOUND);
    vpush(bound, name);
    vpush(bound, ni(c, name, NI_CVAR));
    return ni_set(c, name, NI_CVAR, id);
}

fn scope_begin(c: i64) -> i64 { return vlen(g(c, G_BOUND)); }

fn scope_end(c: i64, mark: i64) -> i64 {
    let bound = g(c, G_BOUND);
    while vlen(bound) > mark {
        let prev = vpop(bound);
        let name = vpop(bound);
        ni_set(c, name, NI_CVAR, prev);
    }
    return 0;
}


// ------------------------------------------------------------ literals

fn c_string(s: i64) -> i64 {
    let bytes = text_bytes(s);
    let b = sb_new();
    sb_add(b, "TK_S(\"");
    let mut i: i64 = 0;
    while i < vlen(bytes) {
        let x = vget(bytes, i);
        if x == 34 {
            sb_add(b, "\\\"");
        } else if x == 92 {
            sb_add(b, "\\\\");
        } else if x == 63 {
            sb_add(b, "\\?");
        } else if x == 10 {
            sb_add(b, "\\n");
        } else if x == 9 {
            sb_add(b, "\\t");
        } else if x >= 32 && x < 127 {
            sb_byte(b, x);
        } else {
            sb_byte(b, 92);
            sb_byte(b, 48 + (x / 64) % 8);
            sb_byte(b, 48 + (x / 8) % 8);
            sb_byte(b, 48 + x % 8);
        }
        i = i + 1;
    }
    sb_add(b, "\")");
    return sb_text(b);
}

// Integer literal text valid for every i64 (INT64_MIN has no literal).
fn c_int(v: i64) -> i64 {
    if v == -9223372036854775807 - 1 {
        return "INT64_MIN";
    }
    return text_of_int(v);
}

fn paren2(a: i64, op: i64, b: i64) -> i64 {
    return text_cat3("(", text_cat3(a, op, b), ")");
}

// ---------------------------------------------------------- expressions

fn gen_list_values(c: i64, l: i64) -> i64 {
    let values = vnew();
    let mut i: i64 = 0;
    while i < list_len(c, l) {
        vpush(values, gen(c, list_at(c, l, i)));
        i = i + 1;
    }
    return values;
}

// Heap cell holding the given words (escaping tuples, union payloads).
fn gen_cell(c: i64, words: i64) -> i64 {
    return gen_cell_note(c, words, "");
}

// `gen_cell` with `note` (a C comment, or "") after the allocation.
fn gen_cell_note(c: i64, words: i64, note: i64) -> i64 {
    let t = temp(c);
    let mut size = vlen(words);
    if size < 1 {
        size = 1;
    }
    emit(c, text_cat3(t, " = alloc(", text_cat3(text_of_int(size * 8), ");", note)));
    let mut i: i64 = 0;
    while i < vlen(words) {
        emit(c, text_cat3("TK_AT(", t, text_cat3(", ", text_of_int(i), text_cat3(") = ", vget(words, i), ";"))));
        i = i + 1;
    }
    return t;
}

fn binary_text(op: i64, l: i64, r: i64) -> i64 {
    if op == OP_ADD { return paren2(l, " + ", r); }
    if op == OP_SUB { return paren2(l, " - ", r); }
    if op == OP_MUL { return paren2(l, " * ", r); }
    if op == OP_DIV { return text_cat3("tk_div(", l, text_cat3(", ", r, ")")); }
    if op == OP_MOD { return text_cat3("tk_mod(", l, text_cat3(", ", r, ")")); }
    if op == OP_EQ { return paren2(l, " == ", r); }
    if op == OP_NEQ { return paren2(l, " != ", r); }
    if op == OP_LT { return paren2(l, " < ", r); }
    if op == OP_GT { return paren2(l, " > ", r); }
    if op == OP_LTE { return paren2(l, " <= ", r); }
    if op == OP_GTE { return paren2(l, " >= ", r); }
    if op == OP_BAND { return paren2(l, " & ", r); }
    if op == OP_BOR { return paren2(l, " | ", r); }
    if op == OP_SHL { return text_cat3("tk_shl(", l, text_cat3(", ", r, ")")); }
    return text_cat3("tk_shr(", l, text_cat3(", ", r, ")"));
}

fn gen_logic(c: i64, n: i64) -> i64 {
    let r = temp(c);
    let l = gen(c, nb(c, n));
    emit(c, text_cat3(r, " = (", text_cat(l, " != 0);")));
    if na(c, n) == OP_AND {
        emit(c, text_cat3("if (", r, ") {"));
    } else {
        emit(c, text_cat3("if (!", r, ") {"));
    }
    indent(c, 1);
    let rhs = gen(c, nc(c, n));
    emit(c, text_cat3(r, " = (", text_cat(rhs, " != 0);")));
    indent(c, -1);
    emit(c, "}");
    return r;
}

// Struct literal: heap cell [tag, fields in declaration order].
fn gen_struct_init(c: i64, n: i64) -> i64 {
    let fields = nb(c, n);
    let names = vnew();
    let values = vnew();
    let mut i: i64 = 0;
    while i < list_len(c, fields) {
        vpush(names, list_at(c, fields, i));
        vpush(values, gen(c, list_at(c, fields, i + 1)));
        i = i + 2;
    }
    let words = vnew();
    vpush(words, c_int(struct_tag(c, na(c, n))));
    let decl = struct_def(c, na(c, n));
    if decl < 0 {
        let mut j: i64 = 0;
        while j < vlen(values) {
            vpush(words, vget(values, j));
            j = j + 1;
        }
        return gen_site_cell(c, n, words);
    }
    let order = nb(c, decl);
    let mut f: i64 = 0;
    while f < list_len(c, order) {
        let mut v: i64 = "0";
        let mut k: i64 = 0;
        while k < vlen(names) {
            if vget(names, k) == list_at(c, order, f) {
                v = vget(values, k);
            }
            k = k + 1;
        }
        vpush(words, v);
        f = f + 2;
    }
    return gen_site_cell(c, n, words);
}

// Read (store == 0) or write a struct field of the cell in temp `base`.
// A field name declared by several structs dispatches on the tag.
fn gen_field_access(c: i64, base: i64, field: i64, store: i64) -> i64 {
    let cands = field_candidates(c, field);
    if vlen(cands) == 2 {
        let slot = load_text(base, vget(cands, 1) + 1);
        if store != 0 {
            emit(c, text_cat3(slot, " = ", text_cat(store, ";")));
            return store;
        }
        return slot;
    }
    let tag = load_text(base, 0);
    if store != 0 {
        let mut i: i64 = 0;
        while i < vlen(cands) {
            let mut head: i64 = "if (";
            if i > 0 {
                head = "} else if (";
            }
            emit(c, text_cat3(head, paren2(tag, " == ", c_int(vget(cands, i))), ") {"));
            emit(c, text_cat3("    ", load_text(base, vget(cands, i + 1) + 1), text_cat3(" = ", store, ";")));
            i = i + 2;
        }
        if vlen(cands) > 0 {
            emit(c, "} else {");
            emit(c, "    track_bad_field();");
            emit(c, "}");
        } else {
            emit(c, "track_bad_field();");
        }
        return store;
    }
    let b = sb_new();
    sb_add(b, "(");
    let mut j: i64 = 0;
    while j < vlen(cands) {
        sb_add(b, paren2(tag, " == ", c_int(vget(cands, j))));
        sb_add(b, " ? ");
        sb_add(b, load_text(base, vget(cands, j + 1) + 1));
        sb_add(b, " : ");
        j = j + 2;
    }
    sb_add(b, "track_bad_field())");
    return sb_text(b);
}

fn gen_into_temp(c: i64, value: i64) -> i64 {
    let t = temp(c);
    emit(c, text_cat3(t, " = ", text_cat(value, ";")));
    return t;
}

fn gen_assign_place(c: i64, target: i64, v: i64) -> i64 {
    let k = nk(c, target);
    if k == K_FIELD {
        let base = gen_into_temp(c, gen(c, na(c, target)));
        return gen_field_access(c, base, nb(c, target), v);
    }
    if k == K_TINDEX {
        let base = gen_into_temp(c, gen(c, na(c, target)));
        emit(c, text_cat3(load_text(base, nb(c, target)), " = ", text_cat(v, ";")));
        return v;
    }
    if k == K_INDEX {
        let arr = gen(c, na(c, target));
        let idx = gen(c, nb(c, target));
        emit(c, text_cat3("track_array_set(", arr, text_cat3(", ", idx, text_cat3(", ", v, ");"))));
    }
    return v;
}

fn gen_var(c: i64, n: i64) -> i64 {
    let name = na(c, n);
    let local = ni(c, name, NI_CVAR);
    if local >= 0 {
        return local_name(c, local);
    }
    let disc = variant_disc(c, name);
    if is_qualified(c, name) {
        if disc < 0 {
            return "0";
        }
        if is_payload_variant(c, name) {
            let words = vnew();
            vpush(words, text_of_int(disc));
            vpush(words, "0");
            return gen_cell(c, words);
        }
        return c_int(disc);
    }
    if ni(c, name, NI_CONSTOK) == 1 {
        return c_int(ni(c, name, NI_CONSTVAL));
    }
    if ni(c, name, NI_CONSTOK) == 3 {
        return gen(c, nb(c, ni(c, name, NI_CONST)));
    }
    return "0";
}

fn arg_at(args: i64, i: i64) -> i64 {
    if i < vlen(args) {
        return vget(args, i);
    }
    return "0";
}

fn call_text(sym: i64, args: i64, arity: i64) -> i64 {
    let b = sb_new();
    sb_add(b, sym);
    sb_add(b, "(");
    let mut i: i64 = 0;
    while i < arity {
        if i > 0 {
            sb_add(b, ", ");
        }
        sb_add(b, arg_at(args, i));
        i = i + 1;
    }
    sb_add(b, ")");
    return sb_text(b);
}

// Machine builtins of the Track runtime (docs/native.md): raw memory words
// and bytes, and the Linux x86-64 `syscall` instruction. Lowered inline;
// returns false for any other name.
fn gen_raw_builtin(c: i64, name: i64, args: i64, t: i64) -> bool {
    if text_eq(name, "load64") {
        emit(c, text_cat3(t, " = TK_AT(", text_cat(arg_at(args, 0), ", 0);")));
        return true;
    }
    if text_eq(name, "store64") {
        emit(c, text_cat3("TK_AT(", arg_at(args, 0), text_cat3(", 0) = ", arg_at(args, 1), ";")));
        return true;
    }
    if text_eq(name, "load8") {
        emit(c, text_cat3(t, " = (tk_w)*(unsigned char *)(uintptr_t)(", text_cat(arg_at(args, 0), ");")));
        return true;
    }
    if text_eq(name, "store8") {
        emit(c, text_cat3("*(unsigned char *)(uintptr_t)(", arg_at(args, 0), text_cat3(") = (unsigned char)(", arg_at(args, 1), ");")));
        return true;
    }
    if text_eq(name, "syscall6") {
        let b = sb_new();
        sb_add(b, "{ register tk_w r10 __asm__(\"r10\") = ");
        sb_add(b, arg_at(args, 4));
        sb_add(b, "; register tk_w r8 __asm__(\"r8\") = ");
        sb_add(b, arg_at(args, 5));
        sb_add(b, "; register tk_w r9 __asm__(\"r9\") = ");
        sb_add(b, arg_at(args, 6));
        sb_add(b, "; __asm__ volatile (\"syscall\" : \"=a\"(");
        sb_add(b, t);
        sb_add(b, ") : \"a\"(");
        sb_add(b, arg_at(args, 0));
        sb_add(b, "), \"D\"(");
        sb_add(b, arg_at(args, 1));
        sb_add(b, "), \"S\"(");
        sb_add(b, arg_at(args, 2));
        sb_add(b, "), \"d\"(");
        sb_add(b, arg_at(args, 3));
        sb_add(b, "), \"r\"(r10), \"r\"(r8), \"r\"(r9) : \"rcx\", \"r11\", \"memory\"); }");
        emit(c, sb_text(b));
        return true;
    }
    return false;
}

fn gen_call(c: i64, n: i64, args_list: i64) -> i64 {
    let name = na(c, n);
    let args = gen_list_values(c, args_list);
    if is_qualified(c, name) {
        let disc = variant_disc(c, name);
        if disc >= 0 {
            if is_payload_variant(c, name) {
                let words = vnew();
                vpush(words, text_of_int(disc));
                let mut i: i64 = 0;
                while i < vlen(args) {
                    vpush(words, vget(args, i));
                    i = i + 1;
                }
                return gen_site_cell(c, n, words);
            }
            return text_of_int(disc);
        }
    }
    let mut target = name;
    if ni(c, name, NI_FN) < 0 {
        target = last_segment(c, name);
    }
    let t = temp(c);
    let f = ni(c, target, NI_FN);
    if f >= 0 {
        let arity = list_len(c, nc(c, f)) / 2;
        emit(c, text_cat3(t, " = ", text_cat(call_text(text_cat("tk_", name_text(c, target)), args, arity), ";")));
        return t;
    }
    if gen_raw_builtin(c, name_text(c, target), args, t) {
        return t;
    }
    let mut sym = target;
    if text_eq(name_text(c, target), "abort") {
        sym = intern(c, "track_abort");
    }
    let mut arity = ni(c, sym, NI_EXTERN);
    if arity < 0 {
        arity = vlen(args);
        ni_set(c, sym, NI_EXTERN, arity);
        vpush(g(c, G_EXTERNS), sym);
    }
    emit(c, text_cat3(t, " = ", text_cat(call_text(name_text(c, sym), args, arity), ";")));
    return t;
}

// Generate a block; returns the value text of its last statement. The
// heap-autofree locals it declared are freed when it ends.
fn gen_block(c: i64, body: i64) -> i64 {
    let mark = scope_begin(c);
    let auto = g(c, G_AUTO);
    let amark = vlen(auto);
    let mut last: i64 = "0";
    let mut i: i64 = 0;
    while i < list_len(c, body) {
        last = gen(c, list_at(c, body, i));
        i = i + 1;
    }
    if vlen(auto) > amark {
        // The value is read before the frees.
        last = gen_into_temp(c, last);
        gen_frees(c, amark);
        while vlen(auto) > amark {
            vpop(auto);
        }
    }
    scope_end(c, mark);
    return last;
}

// ------------------------------------------------------- auto-free (L9)
//
// A local whose `let` site the plan marks heap-autofree owns its cell
// until the block ends (or a `return` leaves it); `x = v` frees the old
// cell first. Sites marked deep also free the child cells their type owns
// (drop glue, `gen_drop`); the others free only their own cell.

const DROP_DEPTH = 4; // nesting levels drop glue follows; deeper cells leak

// Free, in reverse declaration order, the heap-autofree locals from entry
// `from` of the G_AUTO stack on.
fn gen_frees(c: i64, from: i64) -> i64 {
    let auto = g(c, G_AUTO);
    let mut i = vlen(auto) - 2;
    while i >= from {
        gen_free_local(c, vget(auto, i), vget(auto, i + 1));
        i = i - 2;
    }
    return 0;
}

fn gen_free_local(c: i64, id: i64, site: i64) -> i64 {
    if life_auto_deep(c, site) {
        return gen_drop(c, local_name(c, id), pl_site_type(c, site), 0);
    }
    return emit(c, text_cat3("dealloc(", local_name(c, id), ");"));
}

// The heap-autofree entry of local `id`, or -1.
fn auto_entry(c: i64, id: i64) -> i64 {
    let auto = g(c, G_AUTO);
    let mut i: i64 = 0;
    while i < vlen(auto) {
        if vget(auto, i) == id {
            return i;
        }
        i = i + 2;
    }
    return -1;
}

// Drop glue for the cell in `p` of type `t`: free its owned child cells
// (struct fields and tuple elements `pl_drop_kind` names), then the cell.
fn gen_drop(c: i64, p: i64, t: i64, depth: i64) -> i64 {
    let kind = pl_drop_kind(c, t);
    if depth < DROP_DEPTH && (kind == 1 || kind == 2) {
        let mut types: i64 = -1;
        let mut from: i64 = 0;
        let mut step: i64 = 1;
        if kind == 1 {
            types = nb(c, struct_def(c, na(c, t)));
            from = 1;
            step = 2;
        } else {
            types = na(c, t);
        }
        let mut i = from;
        while i < list_len(c, types) {
            let ft = list_at(c, types, i);
            if pl_drop_kind(c, ft) != 0 {
                let child = gen_into_temp(c, load_text(p, (i - from) / step + kind % 2));
                emit(c, text_cat3("if (", child, ") {"));
                indent(c, 1);
                gen_drop(c, child, ft, depth + 1);
                indent(c, -1);
                emit(c, "}");
            }
            i = i + step;
        }
    }
    return emit(c, text_cat3("dealloc(", p, ");"));
}

fn gen_if(c: i64, n: i64) -> i64 {
    let r = temp(c);
    let cond = gen(c, na(c, n));
    emit(c, text_cat3("if (", cond, ") {"));
    indent(c, 1);
    let then_value = gen_block(c, nb(c, n));
    emit(c, text_cat3(r, " = ", text_cat(then_value, ";")));
    indent(c, -1);
    emit(c, "} else {");
    indent(c, 1);
    let else_value = gen_block(c, nc(c, n));
    emit(c, text_cat3(r, " = ", text_cat(else_value, ";")));
    indent(c, -1);
    emit(c, "}");
    return r;
}

fn gen_while(c: i64, n: i64) -> i64 {
    emit(c, "while (1) {");
    indent(c, 1);
    let cond = gen(c, na(c, n));
    emit(c, text_cat3("if (!(", cond, ")) break;"));
    gen_block(c, nb(c, n));
    indent(c, -1);
    emit(c, "}");
    return "0";
}

fn gen_for(c: i64, n: i64) -> i64 {
    let iter = nb(c, n);
    let start = temp(c);
    let end = temp(c);
    if nk(c, iter) == K_RANGE {
        emit(c, text_cat3(start, " = ", text_cat(gen(c, na(c, iter)), ";")));
        emit(c, text_cat3(end, " = ", text_cat(gen(c, nb(c, iter)), ";")));
    } else {
        emit(c, text_cat(start, " = 0;"));
        emit(c, text_cat3(end, " = ", text_cat(gen(c, iter), ";")));
    }
    emit(c, text_cat3("while (", start, text_cat3(" < ", end, ") {")));
    indent(c, 1);
    let mark = scope_begin(c);
    let var = new_local(c, na(c, n));
    emit(c, text_cat3(local_name(c, var), " = ", text_cat(start, ";")));
    gen_block(c, nc(c, n));
    scope_end(c, mark);
    emit(c, text_cat3(start, " = ", text_cat(start, " + 1;")));
    indent(c, -1);
    emit(c, "}");
    return "0";
}

fn gen_return(c: i64, n: i64) -> i64 {
    let value = na(c, n);
    let mut v: i64 = "0";
    if value >= 0 {
        v = gen(c, value);
    }
    if vlen(g(c, G_AUTO)) > 0 {
        if g(c, G_RETVAL) == 1 {
            v = gen_into_temp(c, v);
        }
        gen_frees(c, 0);
    }
    if g(c, G_RETVAL) == 1 {
        emit(c, text_cat3("return ", v, ";"));
    } else {
        emit(c, "return 0;");
    }
    return "0";
}

// A tuple, struct, array or payload-union literal is a heap cell unless
// the placement plan (life.trk, `life_place_of`) puts it on the stack:
// then it lives in a stack slot of the current frame, one slot per literal
// site, reused on every execution. Same layout, so readers never know.
fn gen_tuple(c: i64, n: i64) -> i64 {
    return gen_cell(c, gen_list_values(c, na(c, n)));
}

fn gen_stack_tuple(c: i64, n: i64) -> i64 {
    return gen_slot(c, gen_list_values(c, na(c, n)));
}

// The cell of literal `n` holding `words`: a stack slot when the plan
// says stack, else a heap cell.
fn gen_site_cell(c: i64, n: i64, words: i64) -> i64 {
    if life_place_of(c, n) == PL_STACK {
        return gen_slot(c, words);
    }
    if life_place_of(c, n) == PL_AUTO {
        return gen_cell_note(c, words, " /* heap-autofree */");
    }
    return gen_cell(c, words);
}

// A stack slot `tk_w sN[k]` holding `values`.
fn gen_slot(c: i64, values: i64) -> i64 {
    // Evaluate every element before storing: `p = (p.1, p.0)` may write
    // the slot `p` already points at.
    let tmps = vnew();
    let mut i: i64 = 0;
    while i < vlen(values) {
        vpush(tmps, gen_into_temp(c, vget(values, i)));
        i = i + 1;
    }
    let slot = text_cat("s", text_of_int(g_counter(c, G_NSLOT)));
    let mut size = vlen(tmps);
    if size < 1 {
        size = 1;
    }
    sb_line(g(c, G_DECLS), text_cat3("    tk_w ", slot, text_cat3("[", text_of_int(size), "];")));
    let mut j: i64 = 0;
    while j < vlen(tmps) {
        emit(c, text_cat3(slot, text_cat3("[", text_of_int(j), "] = "), text_cat(vget(tmps, j), ";")));
        j = j + 1;
    }
    return text_cat3("TK_W(", slot, ")");
}

fn load_text(base: i64, i: i64) -> i64 {
    return text_cat3("TK_AT(", base, text_cat3(", ", text_of_int(i), ")"));
}

fn bind_pattern_value(c: i64, p: i64, value: i64) -> i64 {
    let k = nk(c, p);
    if k == P_IDENT {
        let id = new_local(c, na(c, p));
        emit(c, text_cat3(local_name(c, id), " = ", text_cat(value, ";")));
        return 0;
    }
    if k == P_TUPLE {
        let pats = na(c, p);
        let mut i: i64 = 0;
        while i < list_len(c, pats) {
            bind_pattern_value(c, list_at(c, pats, i), load_text(value, i));
            i = i + 1;
        }
        return 0;
    }
    if k == P_VARIANT {
        let bindings = nc(c, p);
        let payload = is_payload_union(c, na(c, p));
        let mut i: i64 = 0;
        while i < list_len(c, bindings) {
            if payload {
                bind_pattern_value(c, list_at(c, bindings, i), load_text(value, i + 1));
            } else {
                bind_pattern_value(c, list_at(c, bindings, i), value);
            }
            i = i + 1;
        }
        return 0;
    }
    if k == P_STRUCT {
        let decl = struct_def(c, na(c, p));
        if decl < 0 {
            return 0;
        }
        let fields = nb(c, p);
        let mut i: i64 = 0;
        while i < list_len(c, fields) {
            let idx = struct_field_index(c, decl, list_at(c, fields, i));
            if idx >= 0 {
                bind_pattern_value(c, list_at(c, fields, i + 1), load_text(value, idx + 1));
            }
            i = i + 2;
        }
    }
    return 0;
}

// C condition text that is non-zero when pattern `p` matches `value`.
fn pattern_cond(c: i64, p: i64, value: i64) -> i64 {
    let k = nk(c, p);
    if k == P_LIT {
        let lit = na(c, p);
        if nk(c, lit) == K_STR {
            return text_cat3("(str_eq(", value, text_cat3(", ", c_string(na(c, lit)), ") != 0)"));
        }
        return paren2(value, " == ", gen(c, lit));
    }
    if k == P_VARIANT {
        let vname = variant_name(c, na(c, p), nb(c, p));
        let mut disc = variant_disc(c, vname);
        if disc < 0 {
            disc = 0;
        }
        if is_payload_union(c, na(c, p)) {
            return paren2(load_text(value, 0), " == ", text_of_int(disc));
        }
        return paren2(value, " == ", text_of_int(disc));
    }
    if k == P_TUPLE {
        let pats = na(c, p);
        let mut cond: i64 = "(1";
        let mut i: i64 = 0;
        while i < list_len(c, pats) {
            cond = text_cat3(cond, " && ", pattern_cond(c, list_at(c, pats, i), load_text(value, i)));
            i = i + 1;
        }
        return text_cat(cond, ")");
    }
    if k == P_STRUCT {
        let decl = struct_def(c, na(c, p));
        if decl < 0 {
            return "1";
        }
        let mut cond = text_cat3("(", paren2(load_text(value, 0), " == ", c_int(struct_tag(c, na(c, p)))), "");
        let fields = nb(c, p);
        let mut i: i64 = 0;
        while i < list_len(c, fields) {
            let idx = struct_field_index(c, decl, list_at(c, fields, i));
            if idx >= 0 {
                cond = text_cat3(cond, " && ", pattern_cond(c, list_at(c, fields, i + 1), load_text(value, idx + 1)));
            }
            i = i + 2;
        }
        return text_cat(cond, ")");
    }
    return "1";
}

fn gen_match(c: i64, n: i64) -> i64 {
    let m = temp(c);
    emit(c, text_cat3(m, " = ", text_cat(gen(c, na(c, n)), ";")));
    let r = temp(c);
    let done = temp(c);
    // Temps start at 0 only on function entry; a match in a loop runs again.
    emit(c, text_cat(done, " = 0;"));
    let arms = nb(c, n);
    let mut i: i64 = 0;
    while i < list_len(c, arms) {
        let pattern = list_at(c, arms, i);
        let guard = list_at(c, arms, i + 1);
        let body = list_at(c, arms, i + 2);
        emit(c, text_cat3("if (!", done, ") {"));
        indent(c, 1);
        let cond = pattern_cond(c, pattern, m);
        emit(c, text_cat3("if (", cond, ") {"));
        indent(c, 1);
        let mark = scope_begin(c);
        bind_pattern_value(c, pattern, m);
        if guard >= 0 {
            let gv = gen(c, guard);
            emit(c, text_cat3("if (", gv, ") {"));
            indent(c, 1);
        }
        emit(c, text_cat(done, " = 1;"));
        let value = gen(c, body);
        emit(c, text_cat3(r, " = ", text_cat(value, ";")));
        if guard >= 0 {
            indent(c, -1);
            emit(c, "}");
        }
        scope_end(c, mark);
        indent(c, -1);
        emit(c, "}");
        indent(c, -1);
        emit(c, "}");
        i = i + 3;
    }
    return r;
}

fn gen_letd(c: i64, n: i64) -> i64 {
    let pattern = na(c, n);
    let value = nc(c, n);
    if nk(c, value) == K_TUPLE && nk(c, pattern) == P_TUPLE && list_len(c, na(c, value)) == list_len(c, na(c, pattern)) {
        let values = gen_list_values(c, na(c, value));
        let tmps = vnew();
        let mut i: i64 = 0;
        while i < vlen(values) {
            let t = temp(c);
            emit(c, text_cat3(t, " = ", text_cat(vget(values, i), ";")));
            vpush(tmps, t);
            i = i + 1;
        }
        let pats = na(c, pattern);
        let mut j: i64 = 0;
        while j < vlen(tmps) {
            bind_pattern_value(c, list_at(c, pats, j), vget(tmps, j));
            j = j + 1;
        }
        return "0";
    }
    let t = temp(c);
    emit(c, text_cat3(t, " = ", text_cat(gen(c, value), ";")));
    bind_pattern_value(c, pattern, t);
    return "0";
}

fn gen_lens(c: i64, n: i64) -> i64 {
    let mark = scope_begin(c);
    let target = ni(c, na(c, n), NI_CVAR);
    if target >= 0 {
        bind(c, nb(c, n), target);
    }
    let value = gen_block(c, nc(c, n));
    let t = temp(c);
    emit(c, text_cat3(t, " = ", text_cat(value, ";")));
    scope_end(c, mark);
    return t;
}

fn gen(c: i64, n: i64) -> i64 {
    let k = nk(c, n);
    if k == K_INT { return text_of_int(na(c, n)); }
    if k == K_BOOL { return text_of_int(na(c, n)); }
    if k == K_STR { return c_string(na(c, n)); }
    if k == K_VAR { return gen_var(c, n); }
    if k == K_BIN {
        let op = na(c, n);
        if op == OP_AND || op == OP_OR {
            return gen_logic(c, n);
        }
        let l = gen(c, nb(c, n));
        let r = gen(c, nc(c, n));
        return binary_text(op, l, r);
    }
    if k == K_UN {
        let v = gen(c, nb(c, n));
        if na(c, n) == OP_NEG { return text_cat3("(-", v, ")"); }
        if na(c, n) == OP_NOT { return text_cat3("(", v, " == 0)"); }
        return v;
    }
    if k == K_ADDR { return gen(c, na(c, n)); }
    if k == K_CALL { return gen_call(c, n, nb(c, n)); }
    if k == K_MACROCALL { return gen_call(c, n, nb(c, n)); }
    if k == K_LET {
        if nk(c, nd(c, n)) == K_TUPLE && life_place_of(c, nd(c, n)) == PL_STACK {
            let sv = gen_stack_tuple(c, nd(c, n));
            let sid = new_local(c, na(c, n));
            emit(c, text_cat3(local_name(c, sid), " = ", text_cat(sv, ";")));
            return local_name(c, sid);
        }
        let v = gen(c, nd(c, n));
        let id = new_local(c, na(c, n));
        emit(c, text_cat3(local_name(c, id), " = ", text_cat(v, ";")));
        if life_place_of(c, nd(c, n)) == PL_AUTO {
            vpush(g(c, G_AUTO), id);
            vpush(g(c, G_AUTO), nd(c, n));
        }
        return local_name(c, id);
    }
    if k == K_ASSIGN {
        let target = na(c, n);
        let mut v: i64 = 0;
        if nk(c, nb(c, n)) == K_TUPLE && life_place_of(c, nb(c, n)) == PL_STACK {
            v = gen_stack_tuple(c, nb(c, n));
        } else {
            v = gen(c, nb(c, n));
        }
        if nk(c, target) == K_VAR && ni(c, na(c, target), NI_CVAR) >= 0 {
            let id = ni(c, na(c, target), NI_CVAR);
            let at = auto_entry(c, id);
            if at >= 0 {
                // The new cell is built before the old one is freed.
                v = gen_into_temp(c, v);
                gen_free_local(c, id, vget(g(c, G_AUTO), at + 1));
            }
            emit(c, text_cat3(local_name(c, id), " = ", text_cat(v, ";")));
            return local_name(c, id);
        }
        return gen_assign_place(c, target, gen_into_temp(c, v));
    }
    if k == K_IF { return gen_if(c, n); }
    if k == K_WHILE { return gen_while(c, n); }
    if k == K_FOR { return gen_for(c, n); }
    if k == K_RETURN { return gen_return(c, n); }
    if k == K_LENS { return gen_lens(c, n); }
    if k == K_TUPLE { return gen_tuple(c, n); }
    if k == K_TINDEX { return load_text(gen(c, na(c, n)), nb(c, n)); }
    if k == K_LETD { return gen_letd(c, n); }
    if k == K_MATCH { return gen_match(c, n); }
    if k == K_SLICE {
        let base = gen(c, na(c, n));
        let mut from: i64 = "0";
        if nb(c, n) >= 0 {
            from = gen(c, nb(c, n));
        }
        let mut to: i64 = "-1";
        if nc(c, n) >= 0 {
            to = gen(c, nc(c, n));
        }
        return gen_into_temp(c, text_cat3("track_array_slice(", base, text_cat3(", ", from, text_cat3(", ", to, ")"))));
    }
    if k == K_ARRAY {
        let words = gen_list_values(c, na(c, n));
        let cell = vnew();
        vpush(cell, text_of_int(vlen(words)));
        let mut i: i64 = 0;
        while i < vlen(words) {
            vpush(cell, vget(words, i));
            i = i + 1;
        }
        return gen_site_cell(c, n, cell);
    }
    if k == K_INDEX {
        let arr = gen(c, na(c, n));
        let idx = gen(c, nb(c, n));
        return gen_into_temp(c, text_cat3("track_array_get(", arr, text_cat3(", ", idx, ")")));
    }
    if k == K_FIELD {
        let base = gen_into_temp(c, gen(c, na(c, n)));
        return gen_into_temp(c, gen_field_access(c, base, nb(c, n), 0));
    }
    if k == K_SINIT { return gen_struct_init(c, n); }
    if k == K_RANGE {
        let s = gen(c, na(c, n));
        let e = gen(c, nb(c, n));
        return paren2(e, " - ", s);
    }
    // Declarations nested in a body produce no code.
    return "0";
}

// ------------------------------------------------------------ functions

fn fn_symbol(c: i64, name: i64) -> i64 {
    return text_cat("tk_", name_text(c, name));
}

fn fn_signature(c: i64, f: i64) -> i64 {
    let params = nc(c, f);
    let b = sb_new();
    sb_add(b, "tk_w ");
    sb_add(b, fn_symbol(c, na(c, f)));
    sb_add(b, "(");
    let count = list_len(c, params) / 2;
    if count == 0 {
        sb_add(b, "void");
    }
    let mut i: i64 = 0;
    while i < count {
        if i > 0 {
            sb_add(b, ", ");
        }
        sb_add(b, "tk_w a");
        sb_int(b, i);
        i = i + 1;
    }
    sb_add(b, ")");
    return sb_text(b);
}

// Emit one function. `prelude` is a list of top-level statements run at
// entry (the root module's globals, for `main`), or -1.
fn gen_function(c: i64, f: i64, prelude: i64) -> i64 {
    g_set(c, G_DECLS, sb_new());
    g_set(c, G_BODY, sb_new());
    g_set(c, G_NLOCAL, 0);
    g_set(c, G_NTEMP, 0);
    g_set(c, G_NSLOT, 0);
    g_set(c, G_INDENT, 1);
    let is_main = text_eq(name_text(c, na(c, f)), "main");
    let ret = nd(c, f);
    let mut returns: i64 = 0;
    if is_main || (ret >= 0 && !is_prim(c, ret, PRIM_VOID)) {
        returns = 1;
    }
    g_set(c, G_RETVAL, returns);
    g_set(c, G_AUTO, vnew());
    let mark = scope_begin(c);
    let params = nc(c, f);
    let mut i: i64 = 0;
    while i < list_len(c, params) {
        let id = new_local(c, list_at(c, params, i));
        emit(c, text_cat3(local_name(c, id), " = a", text_cat(text_of_int(i / 2), ";")));
        i = i + 2;
    }
    if prelude >= 0 {
        let mut p: i64 = 0;
        while p < vlen(prelude) {
            gen(c, vget(prelude, p));
            p = p + 1;
        }
    }
    let last = gen_block(c, ne(c, f));
    if is_main {
        emit(c, "return 0;");
    } else if returns == 1 {
        emit(c, text_cat3("return ", last, ";"));
    } else {
        emit(c, "return 0;");
    }
    scope_end(c, mark);
    let out = g(c, G_FUNCS);
    sb_line(out, "");
    sb_add(out, fn_signature(c, f));
    sb_line(out, " {");
    sb_add(out, sb_text(g(c, G_DECLS)));
    sb_add(out, sb_text(g(c, G_BODY)));
    sb_line(out, "}");
    sb_line(g(c, G_PROTOS), text_cat(fn_signature(c, f), ";"));
    return 0;
}

fn is_declaration(c: i64, n: i64) -> bool {
    let k = nk(c, n);
    return k == K_FN || k == K_MACRODEF;
}

fn c_prelude(b: i64) -> i64 {
    sb_line(b, "/* Generated by trackc. Do not edit. */");
    sb_line(b, "#include <stdint.h>");
    sb_line(b, "typedef int64_t tk_w;");
    sb_line(b, "#define TK_W(p) ((tk_w)(uintptr_t)(p))");
    sb_line(b, "#define TK_S(s) TK_W(s)");
    sb_line(b, "#define TK_AT(p, i) (((tk_w *)(uintptr_t)(p))[i])");
    sb_line(b, "");
    sb_line(b, "/* runtime (runtime/track_runtime.c) */");
    runtime_prototypes(b);
    sb_line(b, "");
    // Hot collection ops inline into the program; the layout mirrors
    // TrackI64Collection in runtime/track_runtime.c. Growth still calls
    // the runtime, so push only inlines its fast path.
    sb_line(b, "typedef struct { tk_w *data; tk_w len; tk_w cap; } tk_coll;");
    sb_line(b, "static inline tk_w tk_coll_len(tk_w h) { const tk_coll *c = (const tk_coll *)(uintptr_t)h; return c ? c->len : 0; }");
    sb_line(b, "static inline tk_w tk_coll_get(tk_w h, tk_w i) {");
    sb_line(b, "    const tk_coll *c = (const tk_coll *)(uintptr_t)h;");
    sb_line(b, "    return c && i >= 0 && i < c->len ? c->data[i] : 0;");
    sb_line(b, "}");
    sb_line(b, "static inline tk_w tk_coll_set(tk_w h, tk_w i, tk_w v) {");
    sb_line(b, "    tk_coll *c = (tk_coll *)(uintptr_t)h;");
    sb_line(b, "    if (!c || i < 0 || i >= c->len) return 0;");
    sb_line(b, "    c->data[i] = v;");
    sb_line(b, "    return 1;");
    sb_line(b, "}");
    sb_line(b, "static inline tk_w tk_coll_push(tk_w h, tk_w v) {");
    sb_line(b, "    tk_coll *c = (tk_coll *)(uintptr_t)h;");
    sb_line(b, "    if (c && c->len < c->cap) { c->data[c->len] = v; return c->len++; }");
    sb_line(b, "    return track_i64_collection_push(h, v);");
    sb_line(b, "}");
    sb_line(b, "#define track_i64_collection_len tk_coll_len");
    sb_line(b, "#define track_i64_collection_get tk_coll_get");
    sb_line(b, "#define track_i64_collection_set tk_coll_set");
    sb_line(b, "#define track_i64_collection_push tk_coll_push");
    // Array cells are [length, elements...] (runtime/track_runtime.c); a
    // failing bounds check calls the runtime op, which aborts as before.
    sb_line(b, "static inline tk_w tki_arr_get(tk_w a, tk_w i) {");
    sb_line(b, "    const tk_w *p = (const tk_w *)(uintptr_t)a;");
    sb_line(b, "    if (__builtin_expect(p && i >= 0 && i < p[0], 1)) return p[i + 1];");
    sb_line(b, "    return track_array_get(a, i);");
    sb_line(b, "}");
    sb_line(b, "static inline tk_w tki_arr_set(tk_w a, tk_w i, tk_w v) {");
    sb_line(b, "    tk_w *p = (tk_w *)(uintptr_t)a;");
    sb_line(b, "    if (__builtin_expect(p && i >= 0 && i < p[0], 1)) { p[i + 1] = v; return v; }");
    sb_line(b, "    return track_array_set(a, i, v);");
    sb_line(b, "}");
    sb_line(b, "#define track_array_get tki_arr_get");
    sb_line(b, "#define track_array_set tki_arr_set");
    // Freestanding builds (--rt=track) have no libc memchr/memcpy, so
    // these string helpers only apply to hosted builds.
    sb_line(b, "#if __STDC_HOSTED__");
    // A NUL before idx reads as 0, like the runtime's strnlen check.
    sb_line(b, "static inline tk_w tki_str_char_at(tk_w s, tk_w idx) {");
    sb_line(b, "    const unsigned char *p = (const unsigned char *)(uintptr_t)s;");
    sb_line(b, "    if (!p || idx < 0) return 0;");
    sb_line(b, "    return __builtin_memchr(p, 0, (unsigned long)idx) ? 0 : p[idx];");
    sb_line(b, "}");
    // String builder fast paths; the layout mirrors TrackStrBuf. Growth
    // and null handles call the runtime.
    sb_line(b, "typedef struct { char *data; uintptr_t len; uintptr_t cap; } tki_sb;");
    sb_line(b, "static inline tk_w tki_sb_push_n(tk_w h, const char *s, uintptr_t n) {");
    sb_line(b, "    tki_sb *b = (tki_sb *)(uintptr_t)h;");
    sb_line(b, "    if (b && b->len + n + 1 <= b->cap) { __builtin_memcpy(b->data + b->len, s, n + 1); b->len += n; return 0; }");
    sb_line(b, "    return track_sb_push(h, TK_W(s));");
    sb_line(b, "}");
    sb_line(b, "static inline tk_w tki_sb_push(tk_w h, tk_w s) {");
    sb_line(b, "    if (!s) return track_sb_push(h, s);");
    sb_line(b, "    const char *p = (const char *)(uintptr_t)s;");
    sb_line(b, "    return tki_sb_push_n(h, p, __builtin_strlen(p));");
    sb_line(b, "}");
    sb_line(b, "static inline tk_w tki_sb_push_byte(tk_w h, tk_w byte) {");
    sb_line(b, "    tki_sb *b = (tki_sb *)(uintptr_t)h;");
    sb_line(b, "    if (b && b->len + 2 <= b->cap) { b->data[b->len++] = (char)byte; b->data[b->len] = 0; return 0; }");
    sb_line(b, "    return track_sb_push_byte(h, byte);");
    sb_line(b, "}");
    sb_line(b, "static inline tk_w tki_sb_push_int(tk_w h, tk_w v) {");
    sb_line(b, "    char buf[24]; char *e = buf + 23; char *p = e;");
    sb_line(b, "    uint64_t u = v < 0 ? 0 - (uint64_t)v : (uint64_t)v;");
    sb_line(b, "    *e = 0;");
    sb_line(b, "    do { *--p = (char)('0' + u % 10); u /= 10; } while (u);");
    sb_line(b, "    if (v < 0) *--p = '-';");
    sb_line(b, "    return tki_sb_push_n(h, p, (uintptr_t)(e - p));");
    sb_line(b, "}");
    sb_line(b, "#define str_char_at tki_str_char_at");
    sb_line(b, "#define track_sb_push tki_sb_push");
    sb_line(b, "#define track_sb_push_byte tki_sb_push_byte");
    sb_line(b, "#define track_sb_push_int tki_sb_push_int");
    sb_line(b, "#endif");
    sb_line(b, "");
    sb_line(b, "static tk_w tk_div(tk_w a, tk_w b) {");
    sb_line(b, "    if (b == 0 || (b == -1 && a == INT64_MIN)) return track_trap_div();");
    sb_line(b, "    return a / b;");
    sb_line(b, "}");
    sb_line(b, "static tk_w tk_mod(tk_w a, tk_w b) {");
    sb_line(b, "    if (b == 0 || (b == -1 && a == INT64_MIN)) return track_trap_div();");
    sb_line(b, "    return a % b;");
    sb_line(b, "}");
    sb_line(b, "static tk_w tk_shl(tk_w a, tk_w b) { return (tk_w)((uint64_t)a << (b & 63)); }");
    sb_line(b, "static tk_w tk_shr(tk_w a, tk_w b) { return (tk_w)((uint64_t)a >> (b & 63)); }");
    return 0;
}

// A program linked with the Track runtime (`--rt=track`, compiler/rt/)
// defines `rt_start` and every runtime function itself. Runtime names the
// emitter calls directly (`alloc`, `track_array_get`, ...) become aliases
// of the Track definitions, and `_start` replaces the C `main`
// (docs/native.md has the stack contract).
fn track_runtime_entry(c: i64, out: i64) -> i64 {
    sb_line(out, "/* Track runtime aliases */");
    let mut id: i64 = 0;
    while id < name_count(c) {
        let f = ni(c, id, NI_FN);
        if f >= 0 && ni(c, id, NI_EXTERN) >= 0 && !is_qualified(c, id) {
            // The prelude may map a runtime name to an inline helper.
            sb_line(out, text_cat("#undef ", name_text(c, id)));
            let b = sb_new();
            sb_add(b, "tk_w ");
            sb_add(b, name_text(c, id));
            sb_add(b, "(");
            let arity = list_len(c, nc(c, f)) / 2;
            if arity == 0 {
                sb_add(b, "void");
            }
            let mut a: i64 = 0;
            while a < arity {
                if a > 0 {
                    sb_add(b, ", ");
                }
                sb_add(b, "tk_w");
                a = a + 1;
            }
            sb_add(b, ") __attribute__((alias(\"tk_");
            sb_add(b, name_text(c, id));
            sb_add(b, "\")));");
            sb_line(out, sb_text(b));
        }
        id = id + 1;
    }
    sb_line(out, "");
    sb_line(out, "__asm__(\".text\\n.globl _start\\n_start:\\n\\txor %ebp, %ebp\\n\\tmov (%rsp), %rdi\\n\\tlea 8(%rsp), %rsi\\n\\tand $-16, %rsp\\n\\tcall tk_rt_start\\n\\thlt\\n\");");
    return 0;
}

// Generate the C translation unit for the loaded, checked program.
fn generate_c(c: i64) -> i64 {
    life_place_program(c);
    let state = vfill(vnew_cap(G_SLOTS), G_SLOTS, 0);
    vset(c, CX_GEN, state);
    g_set(c, G_BOUND, vnew());
    g_set(c, G_EXTERNS, vnew());
    g_set(c, G_FUNCS, sb_new());
    g_set(c, G_PROTOS, sb_new());
    register_runtime(c);
    let items = cx(c, CX_ITEMS);
    let files = cx(c, CX_ITEMFILE);
    let root = cx(c, CX_MAINFILE);
    // Top-level statements of the root module run at the start of main.
    let prelude = vnew();
    let mut main_fn: i64 = -1;
    let mut i: i64 = 0;
    while i < vlen(items) {
        let n = vget(items, i);
        if vget(files, i) == root && !is_declaration(c, n) {
            vpush(prelude, n);
        }
        if nk(c, n) == K_FN && text_eq(name_text(c, na(c, n)), "main") {
            main_fn = n;
        }
        i = i + 1;
    }
    // No `main`: an empty one runs the top-level statements. Registered
    // before any function is emitted so calls to it (the Track runtime's
    // rt_start) resolve to tk_main, as in ngen.
    let mut synthetic: i64 = -1;
    if main_fn < 0 {
        synthetic = node_new(c, K_FN, intern(c, "main"), 0, 0, -1, 0, -1);
        ni_set(c, intern(c, "main"), NI_FN, synthetic);
    }
    let mut j: i64 = 0;
    while j < vlen(items) {
        let n = vget(items, j);
        if is_declaration(c, n) {
            if n == main_fn {
                gen_function(c, n, prelude);
            } else {
                gen_function(c, n, -1);
            }
        }
        j = j + 1;
    }
    if synthetic >= 0 {
        gen_function(c, synthetic, prelude);
    }
    let out = sb_new();
    c_prelude(out);
    let externs = g(c, G_EXTERNS);
    if vlen(externs) > 0 {
        sb_line(out, "");
        sb_line(out, "/* external functions */");
        let mut e: i64 = 0;
        while e < vlen(externs) {
            let name = vget(externs, e);
            let arity = ni(c, name, NI_EXTERN);
            let b = sb_new();
            sb_add(b, "tk_w ");
            sb_add(b, name_text(c, name));
            sb_add(b, "(");
            if arity == 0 {
                sb_add(b, "void");
            }
            let mut a: i64 = 0;
            while a < arity {
                if a > 0 {
                    sb_add(b, ", ");
                }
                sb_add(b, "tk_w");
                a = a + 1;
            }
            sb_add(b, ");");
            sb_line(out, sb_text(b));
            e = e + 1;
        }
    }
    sb_line(out, "");
    sb_line(out, "/* functions */");
    sb_add(out, sb_text(g(c, G_PROTOS)));
    sb_add(out, sb_text(g(c, G_FUNCS)));
    sb_line(out, "");
    if ni(c, intern(c, "rt_start"), NI_FN) >= 0 {
        track_runtime_entry(c, out);
        return sb_text(out);
    }
    sb_line(out, "int main(int argc, char **argv) {");
    sb_line(out, "    track_runtime_init((tk_w)argc, TK_W(argv));");
    sb_line(out, "    return (int)tk_main();");
    sb_line(out, "}");
    return sb_text(out);
}
