// lexer_test.trk — native unit tests for the self-hosted lexer (v0.7)
// Run via `yard test` (discovers src/*_test.trk). Each `test_*` aborts on
// failure; `main` prints `ok` on success. Uses the same `count_tokens` /
// `lex_next` that `main.trk` uses, so the suite validates the real lexer.

import "lexer";

fn assert_eq_i64(a: i64, b: i64) -> void {
    if a != b {
        abort("assert_eq_i64 failed");
    }
}

fn assert_eq_bool(a: bool, b: bool) -> void {
    if a != b {
        abort("assert_eq_bool failed");
    }
}

// --- helpers ---

fn test_simple_let() -> void {
    let src = "let x = 42;";
    let c = count_tokens(&src);
    // Let Ident Eq Int Semicolon = 5
    assert_eq_i64(c, 5);
}

fn test_import() -> void {
    let src = "import \"std/io\";";
    let c = count_tokens(&src);
    // Import StrLit Semicolon = 3
    assert_eq_i64(c, 3);
}

fn test_fn() -> void {
    let src = "fn main() -> void { }";
    let c = count_tokens(&src);
    // Fn Ident LParen RParen Arrow TyVoid LBrace RBrace = 8
    assert_eq_i64(c, 8);
}

fn test_if_else() -> void {
    let src = "if true { } else { }";
    let c = count_tokens(&src);
    // If True LBrace RBrace Else LBrace RBrace = 7
    assert_eq_i64(c, 7);
}

fn test_ops() -> void {
    let src = "x + y - z * w / v % u";
    let c = count_tokens(&src);
    // Ident Plus Ident Minus Ident Star Ident Slash Ident Percent Ident = 11
    assert_eq_i64(c, 11);
}

fn test_cmp() -> void {
    let src = "a == b != c <= d >= e";
    let c = count_tokens(&src);
    // Ident EqEq Ident Neq Ident Lte Ident Gte Ident = 9
    assert_eq_i64(c, 9);
}

fn test_logic() -> void {
    let src = "a && b || c";
    let c = count_tokens(&src);
    // Ident AmpAmp Ident PipePipe Ident = 5
    assert_eq_i64(c, 5);
}

fn test_shift() -> void {
    let src = "a << b >> c";
    let c = count_tokens(&src);
    // Ident Shl Ident Shr Ident = 5
    assert_eq_i64(c, 5);
}

fn test_string_and_comment() -> void {
    let src = "\"hello\" // comment\n let";
    let c = count_tokens(&src);
    // StrLit Let = 2 (comment and whitespace skipped)
    assert_eq_i64(c, 2);
}

fn test_lex_next_kind() -> void {
    let src = "let";
    let c = count_tokens(&src);
    assert_eq_i64(c, 1);
}

fn test_lex_next_spanned_skips_trivia() -> void {
    let src = "  // lead\nlet";
    let (tok, start, end) = lex_next_spanned(&src, 0);
    let kind = token_kind_name(tok);
    let is_let = str_eq(&kind, "Let");
    assert_eq_bool(is_let, true);
    assert_eq_i64(start, 10);
    assert_eq_i64(end, 13);
}

fn test_parser_token_records() -> void {
    let src = "let value = 42;";
    let let_record = lex_next_record(&src, 0);
    assert_eq_i64(let_record.0, token_tag_let());
    assert_eq_i64(let_record.1, 0);
    assert_eq_i64(let_record.2, 3);

    let ident_record = lex_next_record(&src, let_record.3);
    assert_eq_i64(ident_record.0, token_tag_identifier());
    let eq_record = lex_next_record(&src, ident_record.3);
    assert_eq_i64(eq_record.0, token_tag_eq());
    let int_record = lex_next_record(&src, eq_record.3);
    assert_eq_i64(int_record.0, token_tag_int());
}

fn test_standalone_underscore_record() -> void {
    let src = "_ name";
    let underscore = lex_next_record(&src, 0);
    assert_eq_i64(underscore.0, token_tag_underscore());
    let name = lex_next_record(&src, underscore.3);
    assert_eq_i64(name.0, token_tag_identifier());
}

fn main() -> void {
    test_simple_let();
    test_import();
    test_fn();
    test_if_else();
    test_ops();
    test_cmp();
    test_logic();
    test_shift();
    test_string_and_comment();
    test_lex_next_kind();
    test_lex_next_spanned_skips_trivia();
    test_parser_token_records();
    test_standalone_underscore_record();
    print("ok");
}
