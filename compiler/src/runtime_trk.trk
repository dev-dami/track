    sb_line(b, "");
    sb_line(b, "const SYS_READ = 0;");
    sb_line(b, "const SYS_WRITE = 1;");
    sb_line(b, "const SYS_OPEN = 2;");
    sb_line(b, "const SYS_CLOSE = 3;");
    sb_line(b, "const SYS_STAT = 4;");
    sb_line(b, "const SYS_LSEEK = 8;");
    sb_line(b, "const SYS_MMAP = 9;");
    sb_line(b, "const SYS_MUNMAP = 11;");
    sb_line(b, "const SYS_MREMAP = 25;");
    sb_line(b, "const SYS_MADVISE = 28;");
    sb_line(b, "const MADV_POPULATE_WRITE = 23;");
    sb_line(b, "const MADV_HUGEPAGE = 14;");
    sb_line(b, "const RT_HUGE = 2097152;");
    sb_line(b, "const RT_POP_MIN = 65536;");
    sb_line(b, "const RT_POP_MAX = 2097152;");
    sb_line(b, "const SYS_PIPE = 22;");
    sb_line(b, "const SYS_ACCESS = 21;");
    sb_line(b, "const SYS_GETPID = 39;");
    sb_line(b, "const SYS_FORK = 57;");
    sb_line(b, "const SYS_EXECVE = 59;");
    sb_line(b, "const SYS_WAIT4 = 61;");
    sb_line(b, "const SYS_KILL = 62;");
    sb_line(b, "const SYS_UNLINK = 87;");
    sb_line(b, "const SYS_CLOCK_GETTIME = 228;");
    sb_line(b, "const SYS_EXIT_GROUP = 231;");
    sb_line(b, "");
    sb_line(b, "fn rs(off: i64) -> i64 { return load64(RT_BASE + off); }");
    sb_line(b, "fn rs_set(off: i64, v: i64) -> i64 { return store64(RT_BASE + off, v); }");
    sb_line(b, "");
    sb_line(b, "fn sys0(nr: i64) -> i64 { return syscall6(nr, 0, 0, 0, 0, 0, 0); }");
    sb_line(b, "fn sys1(nr: i64, a: i64) -> i64 { return syscall6(nr, a, 0, 0, 0, 0, 0); }");
    sb_line(b, "fn sys2(nr: i64, a: i64, b: i64) -> i64 { return syscall6(nr, a, b, 0, 0, 0, 0); }");
    sb_line(b, "fn sys3(nr: i64, a: i64, b: i64, d: i64) -> i64 { return syscall6(nr, a, b, d, 0, 0, 0); }");
    sb_line(b, "");
    sb_line(b, "fn rt_exit_now(code: i64) -> i64 {");
    sb_line(b, "    sys1(SYS_EXIT_GROUP, code);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Anonymous private read/write mapping of `len` bytes; exits 137 on failure.");
    sb_line(b, "fn rt_mmap(len: i64) -> i64 {");
    sb_line(b, "    let p = syscall6(SYS_MMAP, 0, len, 3, 34, -1, 0);");
    sb_line(b, "    if p < 0 && p > -4096 {");
    sb_line(b, "        rt_oom(\"\\nTrack Runtime Error: Out of memory allocation failure!\\n\");");
    sb_line(b, "    }");
    sb_line(b, "    return p;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn rt_oom(msg: i64) -> i64 {");
    sb_line(b, "    rt_err_bytes(msg, rt_strlen(msg));");
    sb_line(b, "    rt_exit_now(137);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Map the state page and record the process arguments.");
    sb_line(b, "fn track_runtime_init(argc: i64, argv: i64) -> i64 {");
    sb_line(b, "    // MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE");
    sb_line(b, "    let p = syscall6(SYS_MMAP, RT_BASE, RT_STATE_SIZE, 3, 1048610, -1, 0);");
    sb_line(b, "    if p != RT_BASE {");
    sb_line(b, "        rt_exit_now(137);");
    sb_line(b, "    }");
    sb_line(b, "    rs_set(RS_ARGC, argc);");
    sb_line(b, "    rs_set(RS_ARGV, argv);");
    sb_line(b, "    rs_set(RS_ENVP, argv + 8 * (argc + 1));");
    sb_line(b, "    rs_set(RS_LIMIT, 536870912);");
    sb_line(b, "    rs_set(RS_RNG, 0 - 8846114314301621463);");
    sb_line(b, "    rs_set(RS_OUTBUF, rt_mmap(RT_OUT_CAP));");
    sb_line(b, "    rs_set(RS_ONE, 1);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// ------------------------------------------------------------ allocator");
    sb_line(b, "//");
    sb_line(b, "// Every block has one header word before the payload:");
    sb_line(b, "// `requested_size << 8 | class`.");
    sb_line(b, "//");
    sb_line(b, "// Small blocks (up to 64 KiB with the header) are powers of two from 32");
    sb_line(b, "// bytes, class k = log2 of the block size. Freed ones go on a per-class");
    sb_line(b, "// free list (the next pointer lives in the first payload word). They are");
    sb_line(b, "// carved from 64 MiB arenas that are faulted in ahead of the bump pointer");
    sb_line(b, "// with MADV_POPULATE_WRITE (one call per step, not one fault per page);");
    sb_line(b, "// fresh arena memory is already zero.");
    sb_line(b, "//");
    sb_line(b, "// Large blocks get a mapping of their own, sized to the page, with class");
    sb_line(b, "// RT_LARGE_TAG and the mapping length in the word before the header.");
    sb_line(b, "// Growing one is an mremap that moves pages, not bytes. Freeing one keeps");
    sb_line(b, "// the mapping (already faulted in) in a small cache, the large-block");
    sb_line(b, "// cache, for the next large request: best fit, so a cached block may");
    sb_line(b, "// serve a smaller request, whose later growth then needs no syscall.");
    sb_line(b, "// The cache holds at most RT_LC_MAX blocks and RT_LC_CAP bytes; past");
    sb_line(b, "// either bound the oldest blocks go back to the kernel. Cached blocks");
    sb_line(b, "// are not in use: RS_USED never counts them.");
    sb_line(b, "//");
    sb_line(b, "// trackc --native inlines the arena bump path for constant sizes");
    sb_line(b, "// (ngen.trk ng_alloc_const): keep RS_HEAP, RS_HEAP_END, RS_FREE, RS_USED,");
    sb_line(b, "// RS_LIMIT, the header layout and the power-of-two classes in step with it.");
    sb_line(b, "");
    sb_line(b, "fn rt_class(need: i64) -> i64 {");
    sb_line(b, "    let mut k: i64 = 5;");
    sb_line(b, "    while (1 << k) < need {");
    sb_line(b, "        k = k + 1;");
    sb_line(b, "    }");
    sb_line(b, "    return k;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn rt_page_up(n: i64) -> i64 { return (n + 4095) & (0 - 4096); }");
    sb_line(b, "");
    sb_line(b, "// Ask for 2 MiB pages on a mapping big enough to hold one.");
    sb_line(b, "fn rt_huge(p: i64, len: i64) -> i64 {");
    sb_line(b, "    if len >= RT_HUGE {");
    sb_line(b, "        syscall6(SYS_MADVISE, p, len, MADV_HUGEPAGE, 0, 0, 0);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Fault in [from, to) now, in one call: the pages are about to be written.");
    sb_line(b, "fn rt_prefault(from: i64, to: i64) -> i64 {");
    sb_line(b, "    if to > from {");
    sb_line(b, "        syscall6(SYS_MADVISE, from, to - from, MADV_POPULATE_WRITE, 0, 0, 0);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Payload of at least `size` bytes; zeroed when `zero` is true.");
    sb_line(b, "fn rt_block(size: i64, zero: bool) -> i64 {");
    sb_line(b, "    if size > RT_SMALL_MAX {");
    sb_line(b, "        return rt_large(size, zero);");
    sb_line(b, "    }");
    sb_line(b, "    let k = rt_class(size + 8);");
    sb_line(b, "    let slot = RS_FREE + 8 * k;");
    sb_line(b, "    let head = rs(slot);");
    sb_line(b, "    if head != 0 {");
    sb_line(b, "        rs_set(slot, load64(head));");
    sb_line(b, "        store64(head - 8, k);");
    sb_line(b, "        if zero {");
    sb_line(b, "            memset(head, 0, (1 << k) - 8);");
    sb_line(b, "        }");
    sb_line(b, "        return head;");
    sb_line(b, "    }");
    sb_line(b, "    let bsize = 1 << k;");
    sb_line(b, "    let mut cur = rs(RS_HEAP);");
    sb_line(b, "    if cur + bsize > rs(RS_HEAP_END) || cur == 0 {");
    sb_line(b, "        if cur == 0 || cur + bsize > rs(RS_ARENA_END) {");
    sb_line(b, "            cur = rt_mmap(RT_ARENA);");
    sb_line(b, "            rt_huge(cur, RT_ARENA);");
    sb_line(b, "            rs_set(RS_ARENA_END, cur + RT_ARENA);");
    sb_line(b, "            rs_set(RS_HEAP_END, cur);");
    sb_line(b, "        }");
    sb_line(b, "        rt_populate(cur + bsize);");
    sb_line(b, "    }");
    sb_line(b, "    rs_set(RS_HEAP, cur + bsize);");
    sb_line(b, "    store64(cur, k);");
    sb_line(b, "    return cur + 8;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Large block: [mapping length][header][payload ...]. A cached mapping");
    sb_line(b, "// is reused when one is big enough (zeroed up to `size` when `zero`);");
    sb_line(b, "// otherwise a fresh one, already zero, is mapped and faulted in.");
    sb_line(b, "fn rt_large(size: i64, zero: bool) -> i64 {");
    sb_line(b, "    let len = rt_page_up(size + 16);");
    sb_line(b, "    let mut big = rt_lc_take(len);");
    sb_line(b, "    if big != 0 {");
    sb_line(b, "        if zero {");
    sb_line(b, "            memset(big + 16, 0, size);");
    sb_line(b, "        }");
    sb_line(b, "    } else {");
    sb_line(b, "        big = rt_mmap(len);");
    sb_line(b, "        rt_huge(big, len);");
    sb_line(b, "        rt_prefault(big, big + len);");
    sb_line(b, "        store64(big, len);");
    sb_line(b, "    }");
    sb_line(b, "    store64(big + 8, (size << 8) | RT_LARGE_TAG);");
    sb_line(b, "    return big + 16;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// The smallest cached mapping of at least `len` bytes, taken out of the");
    sb_line(b, "// cache; 0 when none is big enough.");
    sb_line(b, "fn rt_lc_take(len: i64) -> i64 {");
    sb_line(b, "    let n = rs(RS_LC_N);");
    sb_line(b, "    let mut best: i64 = -1;");
    sb_line(b, "    let mut best_len: i64 = 0;");
    sb_line(b, "    let mut i: i64 = 0;");
    sb_line(b, "    while i < n {");
    sb_line(b, "        let m = load64(RT_BASE + RS_LC_SLOTS + 8 * i);");
    sb_line(b, "        let l = load64(m);");
    sb_line(b, "        if l >= len && (best < 0 || l < best_len) {");
    sb_line(b, "            best = i;");
    sb_line(b, "            best_len = l;");
    sb_line(b, "        }");
    sb_line(b, "        i = i + 1;");
    sb_line(b, "    }");
    sb_line(b, "    if best < 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    let m = load64(RT_BASE + RS_LC_SLOTS + 8 * best);");
    sb_line(b, "    rt_lc_remove(best);");
    sb_line(b, "    return m;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Drop cache slot `i`, keeping the others in age order.");
    sb_line(b, "fn rt_lc_remove(i: i64) -> i64 {");
    sb_line(b, "    let n = rs(RS_LC_N);");
    sb_line(b, "    let at = RT_BASE + RS_LC_SLOTS;");
    sb_line(b, "    rs_set(RS_LC_BYTES, rs(RS_LC_BYTES) - load64(load64(at + 8 * i)));");
    sb_line(b, "    let mut j = i;");
    sb_line(b, "    while j + 1 < n {");
    sb_line(b, "        store64(at + 8 * j, load64(at + 8 * j + 8));");
    sb_line(b, "        j = j + 1;");
    sb_line(b, "    }");
    sb_line(b, "    rs_set(RS_LC_N, n - 1);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Keep the freed mapping `m` for reuse, unmapping the oldest cached");
    sb_line(b, "// blocks past the cache's bounds (or `m` itself when it alone is past");
    sb_line(b, "// the byte bound).");
    sb_line(b, "fn rt_lc_put(m: i64) -> i64 {");
    sb_line(b, "    let len = load64(m);");
    sb_line(b, "    if len > RT_LC_CAP {");
    sb_line(b, "        syscall6(SYS_MUNMAP, m, len, 0, 0, 0, 0);");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    while rs(RS_LC_N) == RT_LC_MAX || rs(RS_LC_BYTES) + len > RT_LC_CAP {");
    sb_line(b, "        let old = load64(RT_BASE + RS_LC_SLOTS);");
    sb_line(b, "        let old_len = load64(old);");
    sb_line(b, "        rt_lc_remove(0);");
    sb_line(b, "        syscall6(SYS_MUNMAP, old, old_len, 0, 0, 0, 0);");
    sb_line(b, "    }");
    sb_line(b, "    let n = rs(RS_LC_N);");
    sb_line(b, "    store64(RT_BASE + RS_LC_SLOTS + 8 * n, m);");
    sb_line(b, "    rs_set(RS_LC_N, n + 1);");
    sb_line(b, "    rs_set(RS_LC_BYTES, rs(RS_LC_BYTES) + len);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Fault in the arena ahead of the bump pointer, past at least `need`.");
    sb_line(b, "// Steps double from 64 KiB to 2 MiB, so small programs do not pay for");
    sb_line(b, "// memory they never touch. RS_HEAP_END marks the populated end: the");
    sb_line(b, "// inlined bump path falls back to `alloc` when it reaches it.");
    sb_line(b, "fn rt_populate(need: i64) -> i64 {");
    sb_line(b, "    let mut step = rs(RS_POP_STEP);");
    sb_line(b, "    if step < RT_POP_MIN {");
    sb_line(b, "        step = RT_POP_MIN;");
    sb_line(b, "    }");
    sb_line(b, "    let from = rs(RS_HEAP_END);");
    sb_line(b, "    let mut to = from + step;");
    sb_line(b, "    if to < need {");
    sb_line(b, "        to = rt_page_up(need);");
    sb_line(b, "    }");
    sb_line(b, "    if to > rs(RS_ARENA_END) {");
    sb_line(b, "        to = rs(RS_ARENA_END);");
    sb_line(b, "    }");
    sb_line(b, "    rt_prefault(from, to);");
    sb_line(b, "    rs_set(RS_HEAP_END, to);");
    sb_line(b, "    if step < RT_POP_MAX {");
    sb_line(b, "        rs_set(RS_POP_STEP, step * 2);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn rt_malloc(size: i64) -> i64 { return rt_block(size, false); }");
    sb_line(b, "");
    sb_line(b, "fn rt_free(p: i64) -> i64 {");
    sb_line(b, "    if p == 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    let k = load64(p - 8) & 255;");
    sb_line(b, "    if k == RT_LARGE_TAG {");
    sb_line(b, "        rt_lc_put(p - 16);");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    let slot = RS_FREE + 8 * k;");
    sb_line(b, "    store64(p, rs(slot));");
    sb_line(b, "    rs_set(slot, p);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Usable bytes of block `p`.");
    sb_line(b, "fn rt_capacity(p: i64) -> i64 {");
    sb_line(b, "    let k = load64(p - 8) & 255;");
    sb_line(b, "    if k == RT_LARGE_TAG {");
    sb_line(b, "        return load64(p - 16) - 16;");
    sb_line(b, "    }");
    sb_line(b, "    return (1 << k) - 8;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn rt_realloc(p: i64, size: i64) -> i64 {");
    sb_line(b, "    if p == 0 {");
    sb_line(b, "        return rt_malloc(size);");
    sb_line(b, "    }");
    sb_line(b, "    let cap = rt_capacity(p);");
    sb_line(b, "    if size <= cap {");
    sb_line(b, "        return p;");
    sb_line(b, "    }");
    sb_line(b, "    if (load64(p - 8) & 255) == RT_LARGE_TAG {");
    sb_line(b, "        // A mapping of its own: the kernel moves the pages, and the grown");
    sb_line(b, "        // part (zero, and about to be filled) is faulted in in one call.");
    sb_line(b, "        let old = load64(p - 16);");
    sb_line(b, "        let len = rt_page_up(size + 16);");
    sb_line(b, "        let q = syscall6(SYS_MREMAP, p - 16, old, len, 1, 0, 0);");
    sb_line(b, "        if q < 0 && q > -4096 {");
    sb_line(b, "            rt_oom(\"\\nTrack Runtime Error: Out of memory allocation failure!\\n\");");
    sb_line(b, "        }");
    sb_line(b, "        rt_huge(q, len);");
    sb_line(b, "        rt_prefault(q + old, q + len);");
    sb_line(b, "        store64(q, len);");
    sb_line(b, "        return q + 16;");
    sb_line(b, "    }");
    sb_line(b, "    let q = rt_malloc(size);");
    sb_line(b, "    rt_copy(q, p, cap);");
    sb_line(b, "    rt_free(p);");
    sb_line(b, "    return q;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// ------------------------------------------------------- raw memory ops");
    sb_line(b, "");
    sb_line(b, "// x86-64 allows unaligned word access, so copy words whatever the");
    sb_line(b, "// alignment, four at a time in the bulk.");
    sb_line(b, "fn rt_copy(dst: i64, src: i64, n: i64) -> i64 {");
    sb_line(b, "    let mut i: i64 = 0;");
    sb_line(b, "    let quads = n & (0 - 32);");
    sb_line(b, "    while i < quads {");
    sb_line(b, "        let a = load64(src + i);");
    sb_line(b, "        let b = load64(src + i + 8);");
    sb_line(b, "        let c = load64(src + i + 16);");
    sb_line(b, "        let d = load64(src + i + 24);");
    sb_line(b, "        store64(dst + i, a);");
    sb_line(b, "        store64(dst + i + 8, b);");
    sb_line(b, "        store64(dst + i + 16, c);");
    sb_line(b, "        store64(dst + i + 24, d);");
    sb_line(b, "        i = i + 32;");
    sb_line(b, "    }");
    sb_line(b, "    let words = n & (0 - 8);");
    sb_line(b, "    while i < words {");
    sb_line(b, "        store64(dst + i, load64(src + i));");
    sb_line(b, "        i = i + 8;");
    sb_line(b, "    }");
    sb_line(b, "    while i < n {");
    sb_line(b, "        store8(dst + i, load8(src + i));");
    sb_line(b, "        i = i + 1;");
    sb_line(b, "    }");
    sb_line(b, "    return dst;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn rt_zero(dst: i64, n: i64) -> i64 {");
    sb_line(b, "    if n > 0 {");
    sb_line(b, "        memset(dst, 0, n);");
    sb_line(b, "    }");
    sb_line(b, "    return dst;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// strlen, two words at a time once aligned (an aligned 16-byte pair");
    sb_line(b, "// holding a byte of the string never crosses into another page).");
    sb_line(b, "fn rt_strlen(s: i64) -> i64 {");
    sb_line(b, "    let mut p = s;");
    sb_line(b, "    while (p & 15) != 0 {");
    sb_line(b, "        if load8(p) == 0 {");
    sb_line(b, "            return p - s;");
    sb_line(b, "        }");
    sb_line(b, "        p = p + 1;");
    sb_line(b, "    }");
    sb_line(b, "    // One statement per operation with simple right operands, so the");
    sb_line(b, "    // native backend keeps everything in registers.");
    sb_line(b, "    let ones = 72340172838076673;          // 0x0101010101010101");
    sb_line(b, "    let highs = 0 - 9187201950435737472;   // 0x8080808080808080");
    sb_line(b, "    let m1: i64 = -1;");
    sb_line(b, "    let mut hit: i64 = 0;");
    sb_line(b, "    while hit == 0 {");
    sb_line(b, "        let v = load64(p);");
    sb_line(b, "        let u = load64(p + 8);");
    sb_line(b, "        let nv = m1 - v;");
    sb_line(b, "        let nu = m1 - u;");
    sb_line(b, "        let mut x = v - ones;");
    sb_line(b, "        x = x & nv;");
    sb_line(b, "        let mut y = u - ones;");
    sb_line(b, "        y = y & nu;");
    sb_line(b, "        x = x | y;");
    sb_line(b, "        hit = x & highs;");
    sb_line(b, "        p = p + 16;");
    sb_line(b, "    }");
    sb_line(b, "    p = p - 16;");
    sb_line(b, "    while load8(p) != 0 {");
    sb_line(b, "        p = p + 1;");
    sb_line(b, "    }");
    sb_line(b, "    return p - s;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// strnlen, a word at a time once aligned. An aligned word holding a byte");
    sb_line(b, "// of the string never crosses into another page, so reading it is safe.");
    sb_line(b, "fn rt_strnlen(s: i64, max: i64) -> i64 {");
    sb_line(b, "    if max <= 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    let end = s + max;");
    sb_line(b, "    let mut p = s;");
    sb_line(b, "    while (p & 7) != 0 {");
    sb_line(b, "        if p >= end {");
    sb_line(b, "            return max;");
    sb_line(b, "        }");
    sb_line(b, "        if load8(p) == 0 {");
    sb_line(b, "            return p - s;");
    sb_line(b, "        }");
    sb_line(b, "        p = p + 1;");
    sb_line(b, "    }");
    sb_line(b, "    let ones = 72340172838076673;          // 0x0101010101010101");
    sb_line(b, "    let highs = 0 - 9187201950435737472;   // 0x8080808080808080");
    sb_line(b, "    while p < end {");
    sb_line(b, "        let v = load64(p);");
    sb_line(b, "        if ((v - ones) & (0 - v - 1) & highs) != 0 {");
    sb_line(b, "            while load8(p) != 0 {");
    sb_line(b, "                p = p + 1;");
    sb_line(b, "            }");
    sb_line(b, "            if p - s < max {");
    sb_line(b, "                return p - s;");
    sb_line(b, "            }");
    sb_line(b, "            return max;");
    sb_line(b, "        }");
    sb_line(b, "        p = p + 8;");
    sb_line(b, "    }");
    sb_line(b, "    return max;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// New NUL-terminated copy of `n` bytes at `s`.");
    sb_line(b, "fn rt_dup_n(s: i64, n: i64) -> i64 {");
    sb_line(b, "    let out = rt_malloc(n + 1);");
    sb_line(b, "    if n > 0 {");
    sb_line(b, "        rt_copy(out, s, n);");
    sb_line(b, "    }");
    sb_line(b, "    store8(out + n, 0);");
    sb_line(b, "    return out;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn rt_dup(s: i64) -> i64 {");
    sb_line(b, "    if s == 0 {");
    sb_line(b, "        return rt_dup_n(\"\", 0);");
    sb_line(b, "    }");
    sb_line(b, "    return rt_dup_n(s, rt_strlen(s));");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// ------------------------------------------------- counted allocation API");
    sb_line(b, "");
    sb_line(b, "fn rt_limit_exceeded(requested: i64) -> i64 {");
    sb_line(b, "    let b = track_sb_new();");
    sb_line(b, "    track_sb_push(b, \"\\nTrack Runtime Error: Process memory boundary limit exceeded! (Allocated: \");");
    sb_line(b, "    track_sb_push_int(b, rs(RS_USED));");
    sb_line(b, "    track_sb_push(b, \" bytes, Requested: \");");
    sb_line(b, "    track_sb_push_int(b, requested);");
    sb_line(b, "    track_sb_push(b, \" bytes, Limit: \");");
    sb_line(b, "    track_sb_push_int(b, rs(RS_LIMIT));");
    sb_line(b, "    track_sb_push(b, \" bytes)\\n\");");
    sb_line(b, "    rt_err_bytes(load64(b), track_sb_len(b));");
    sb_line(b, "    rt_exit_now(137);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn sys_set_memory_limit(bytes: i64) -> i64 {");
    sb_line(b, "    if bytes > 0 {");
    sb_line(b, "        rs_set(RS_LIMIT, bytes);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn sys_get_memory_used() -> i64 { return rs(RS_USED); }");
    sb_line(b, "");
    sb_line(b, "fn alloc(size: i64) -> i64 { return rt_alloc(size, true); }");
    sb_line(b, "");
    sb_line(b, "// `alloc` without the zeroing: for blocks whose every payload word is");
    sb_line(b, "// written before any is read (cell literals and constructors, array");
    sb_line(b, "// copies). A reused block keeps its old bytes; fresh memory is zero anyway.");
    sb_line(b, "// trackc --native inlines it for constant sizes (ngen.trk ng_alloc_const).");
    sb_line(b, "fn track_alloc_nz(size: i64) -> i64 { return rt_alloc(size, false); }");
    sb_line(b, "");
    sb_line(b, "fn rt_alloc(size: i64, zero: bool) -> i64 {");
    sb_line(b, "    if size <= 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    if rs(RS_USED) + size > rs(RS_LIMIT) {");
    sb_line(b, "        rt_limit_exceeded(size);");
    sb_line(b, "    }");
    sb_line(b, "    let p = rt_block(size, zero);");
    sb_line(b, "    store64(p - 8, (size << 8) | (load64(p - 8) & 255));");
    sb_line(b, "    rs_set(RS_USED, rs(RS_USED) + size);");
    sb_line(b, "    return p;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn dealloc(p: i64) -> i64 {");
    sb_line(b, "    if p == 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    let size = load64(p - 8) >> 8;");
    sb_line(b, "    let used = rs(RS_USED);");
    sb_line(b, "    if used >= size {");
    sb_line(b, "        rs_set(RS_USED, used - size);");
    sb_line(b, "    } else {");
    sb_line(b, "        rs_set(RS_USED, 0);");
    sb_line(b, "    }");
    sb_line(b, "    rt_free(p);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn mem_realloc(p: i64, new_size: i64) -> i64 {");
    sb_line(b, "    if p == 0 {");
    sb_line(b, "        return alloc(new_size);");
    sb_line(b, "    }");
    sb_line(b, "    if new_size <= 0 {");
    sb_line(b, "        return dealloc(p);");
    sb_line(b, "    }");
    sb_line(b, "    let old_size = load64(p - 8) >> 8;");
    sb_line(b, "    if rs(RS_USED) - old_size + new_size > rs(RS_LIMIT) {");
    sb_line(b, "        rt_limit_exceeded(new_size);");
    sb_line(b, "    }");
    sb_line(b, "    let q = rt_realloc(p, new_size);");
    sb_line(b, "    store64(q - 8, (new_size << 8) | (load64(q - 8) & 255));");
    sb_line(b, "    rs_set(RS_USED, rs(RS_USED) - old_size + new_size);");
    sb_line(b, "    return q;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Copy `count` words to a fresh heap cell (escaping tuples).");
    sb_line(b, "fn track_words_copy(src: i64, count: i64) -> i64 {");
    sb_line(b, "    let mut bytes: i64 = 8;");
    sb_line(b, "    if count > 0 {");
    sb_line(b, "        bytes = count * 8;");
    sb_line(b, "    }");
    sb_line(b, "    if src == 0 || count <= 0 {");
    sb_line(b, "        return alloc(bytes);");
    sb_line(b, "    }");
    sb_line(b, "    let dst = track_alloc_nz(bytes);");
    sb_line(b, "    rt_copy(dst, src, count * 8);");
    sb_line(b, "    return dst;");
    sb_line(b, "}");
    return 0;
}

fn rt_module_source_1(b: i64) -> i64 {
    sb_line(b, "// rt/io.trk — Track runtime: entry point, exit, stdout/stderr, printing.");
    sb_line(b, "//");
    sb_line(b, "// stdout is buffered in the runtime (64 KiB) and flushed when full, before");
    sb_line(b, "// anything is written to stderr, before a child process runs, and at exit,");
    sb_line(b, "// matching the C runtime's stdio behaviour for redirected output.");
    sb_line(b, "");
    sb_line(b, "// The process entry. `_start` calls this with argc and argv (see");
    sb_line(b, "// docs/native.md for the stack contract); it never returns.");
    sb_line(b, "fn rt_start(argc: i64, argv: i64) -> i64 {");
    sb_line(b, "    track_runtime_init(argc, argv);");
    sb_line(b, "    let code: i64 = main();");
    sb_line(b, "    return sys_exit(code);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn rt_write_all(fd: i64, p: i64, n: i64) -> i64 {");
    sb_line(b, "    let mut done: i64 = 0;");
    sb_line(b, "    while done < n {");
    sb_line(b, "        let w = sys3(SYS_WRITE, fd, p + done, n - done);");
    sb_line(b, "        if w == -4 {");
    sb_line(b, "            // EINTR: retry");
    sb_line(b, "        } else if w <= 0 {");
    sb_line(b, "            return -1;");
    sb_line(b, "        } else {");
    sb_line(b, "            done = done + w;");
    sb_line(b, "        }");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn rt_flush() -> i64 {");
    sb_line(b, "    let n = rs(RS_OUTLEN);");
    sb_line(b, "    if n > 0 {");
    sb_line(b, "        rt_write_all(1, rs(RS_OUTBUF), n);");
    sb_line(b, "        rs_set(RS_OUTLEN, 0);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn rt_out_bytes(p: i64, n: i64) -> i64 {");
    sb_line(b, "    let len = rs(RS_OUTLEN);");
    sb_line(b, "    if len + n > RT_OUT_CAP {");
    sb_line(b, "        rt_flush();");
    sb_line(b, "        if n > RT_OUT_CAP {");
    sb_line(b, "            return rt_write_all(1, p, n);");
    sb_line(b, "        }");
    sb_line(b, "        rt_copy(rs(RS_OUTBUF), p, n);");
    sb_line(b, "        rs_set(RS_OUTLEN, n);");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    rt_copy(rs(RS_OUTBUF) + len, p, n);");
    sb_line(b, "    rs_set(RS_OUTLEN, len + n);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn rt_out_str(s: i64) -> i64 { return rt_out_bytes(s, rt_strlen(s)); }");
    sb_line(b, "");
    sb_line(b, "fn rt_out_byte(b: i64) -> i64 {");
    sb_line(b, "    let len = rs(RS_OUTLEN);");
    sb_line(b, "    if len >= RT_OUT_CAP {");
    sb_line(b, "        rt_flush();");
    sb_line(b, "        store8(rs(RS_OUTBUF), b);");
    sb_line(b, "        rs_set(RS_OUTLEN, 1);");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    store8(rs(RS_OUTBUF) + len, b);");
    sb_line(b, "    rs_set(RS_OUTLEN, len + 1);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn rt_err_bytes(p: i64, n: i64) -> i64 {");
    sb_line(b, "    rt_flush();");
    sb_line(b, "    return rt_write_all(2, p, n);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn rt_err_str(s: i64) -> i64 { return rt_err_bytes(s, rt_strlen(s)); }");
    sb_line(b, "");
    sb_line(b, "fn sys_exit(code: i64) -> i64 {");
    sb_line(b, "    rt_flush();");
    sb_line(b, "    rt_exit_now(code);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Formats `val` in decimal into the number scratch; returns its address");
    sb_line(b, "// and stores the length at RS_NUM + 24.");
    sb_line(b, "fn rt_fmt_int(val: i64) -> i64 {");
    sb_line(b, "    let end = RT_BASE + RS_NUM + 23;");
    sb_line(b, "    let mut p = end;");
    sb_line(b, "    let mut n = val;");
    sb_line(b, "    if n == 0 {");
    sb_line(b, "        p = p - 1;");
    sb_line(b, "        store8(p, 48);");
    sb_line(b, "    }");
    sb_line(b, "    while n != 0 {");
    sb_line(b, "        let q = n / 10;");
    sb_line(b, "        let mut d = n - q * 10;");
    sb_line(b, "        if d < 0 {");
    sb_line(b, "            d = 0 - d;");
    sb_line(b, "        }");
    sb_line(b, "        p = p - 1;");
    sb_line(b, "        store8(p, 48 + d);");
    sb_line(b, "        n = q;");
    sb_line(b, "    }");
    sb_line(b, "    if val < 0 {");
    sb_line(b, "        p = p - 1;");
    sb_line(b, "        store8(p, 45);");
    sb_line(b, "    }");
    sb_line(b, "    store8(end, 0);");
    sb_line(b, "    return p;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn rt_out_int(val: i64) -> i64 { return rt_out_str(rt_fmt_int(val)); }");
    sb_line(b, "");
    sb_line(b, "// Readable-memory probe used by `print` and `track_abort`: write one byte");
    sb_line(b, "// of `p` into a pipe; the kernel reports EFAULT for unmapped memory.");
    sb_line(b, "fn rt_readable(p: i64) -> bool {");
    sb_line(b, "    if p < 65536 {");
    sb_line(b, "        return false;");
    sb_line(b, "    }");
    sb_line(b, "    if sys1(SYS_PIPE, RT_BASE + RS_PIPE) < 0 {");
    sb_line(b, "        return false;");
    sb_line(b, "    }");
    sb_line(b, "    let fds = rs(RS_PIPE);");
    sb_line(b, "    let rd = fds & 4294967295;");
    sb_line(b, "    let wr = fds >> 32;");
    sb_line(b, "    let res = sys3(SYS_WRITE, wr, p, 1);");
    sb_line(b, "    sys1(SYS_CLOSE, rd);");
    sb_line(b, "    sys1(SYS_CLOSE, wr);");
    sb_line(b, "    return res == 1;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn print(val: i64) -> i64 {");
    sb_line(b, "    if val >= 65536 && rt_readable(val) {");
    sb_line(b, "        let mut is_str = true;");
    sb_line(b, "        let mut len: i64 = 0;");
    sb_line(b, "        let mut going = true;");
    sb_line(b, "        while going && len < 4096 {");
    sb_line(b, "            let ch = load8(val + len);");
    sb_line(b, "            if ch == 0 {");
    sb_line(b, "                going = false;");
    sb_line(b, "            } else if ch < 9 || (ch > 13 && ch < 32) || ch > 126 {");
    sb_line(b, "                is_str = false;");
    sb_line(b, "                going = false;");
    sb_line(b, "            } else {");
    sb_line(b, "                len = len + 1;");
    sb_line(b, "            }");
    sb_line(b, "        }");
    sb_line(b, "        if is_str && len > 0 {");
    sb_line(b, "            rt_out_str(val);");
    sb_line(b, "            rt_out_byte(10);");
    sb_line(b, "            return 0;");
    sb_line(b, "        }");
    sb_line(b, "    }");
    sb_line(b, "    rt_out_int(val);");
    sb_line(b, "    rt_out_byte(10);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn println(val: i64) -> i64 { return print(val); }");
    sb_line(b, "");
    sb_line(b, "fn print_int(val: i64) -> i64 {");
    sb_line(b, "    rt_out_int(val);");
    sb_line(b, "    rt_out_byte(10);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn print_hex(val: i64) -> i64 {");
    sb_line(b, "    rt_out_bytes(\"0x\", 2);");
    sb_line(b, "    let mut shift: i64 = 60;");
    sb_line(b, "    let mut started = false;");
    sb_line(b, "    while shift >= 0 {");
    sb_line(b, "        let d = (val >> shift) & 15;");
    sb_line(b, "        if d != 0 || started || shift == 0 {");
    sb_line(b, "            started = true;");
    sb_line(b, "            if d < 10 {");
    sb_line(b, "                rt_out_byte(48 + d);");
    sb_line(b, "            } else {");
    sb_line(b, "                rt_out_byte(87 + d);");
    sb_line(b, "            }");
    sb_line(b, "        }");
    sb_line(b, "        shift = shift - 4;");
    sb_line(b, "    }");
    sb_line(b, "    rt_out_byte(10);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn print_str(s: i64) -> i64 {");
    sb_line(b, "    if s != 0 {");
    sb_line(b, "        rt_out_str(s);");
    sb_line(b, "    }");
    sb_line(b, "    rt_out_byte(10);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn print_err(s: i64) -> i64 {");
    sb_line(b, "    if s != 0 {");
    sb_line(b, "        let n = rt_strlen(s);");
    sb_line(b, "        let line = rt_malloc(n + 1);");
    sb_line(b, "        rt_copy(line, s, n);");
    sb_line(b, "        store8(line + n, 10);");
    sb_line(b, "        rt_err_bytes(line, n + 1);");
    sb_line(b, "        rt_free(line);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn eprint(s: i64) -> i64 { return print_err(s); }");
    sb_line(b, "");
    sb_line(b, "// Unformatted output (no trailing newline, no int/string guessing).");
    sb_line(b, "fn track_out(s: i64) -> i64 {");
    sb_line(b, "    if s != 0 {");
    sb_line(b, "        rt_out_str(s);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn track_err(s: i64) -> i64 {");
    sb_line(b, "    if s != 0 {");
    sb_line(b, "        rt_err_str(s);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn read_line() -> i64 {");
    sb_line(b, "    let mut cap: i64 = 128;");
    sb_line(b, "    let mut buf = rt_malloc(cap);");
    sb_line(b, "    let mut len: i64 = 0;");
    sb_line(b, "    let cell = RT_BASE + RS_NUM;");
    sb_line(b, "    let mut going = true;");
    sb_line(b, "    while going {");
    sb_line(b, "        let r = sys3(SYS_READ, 0, cell, 1);");
    sb_line(b, "        if r == -4 {");
    sb_line(b, "            // EINTR: retry");
    sb_line(b, "        } else if r <= 0 {");
    sb_line(b, "            going = false;");
    sb_line(b, "        } else {");
    sb_line(b, "            let ch = load8(cell);");
    sb_line(b, "            if ch == 10 {");
    sb_line(b, "                going = false;");
    sb_line(b, "            } else {");
    sb_line(b, "                if len + 1 >= cap {");
    sb_line(b, "                    cap = cap * 2;");
    sb_line(b, "                    buf = rt_realloc(buf, cap);");
    sb_line(b, "                }");
    sb_line(b, "                store8(buf + len, ch);");
    sb_line(b, "                len = len + 1;");
    sb_line(b, "            }");
    sb_line(b, "        }");
    sb_line(b, "    }");
    sb_line(b, "    store8(buf + len, 0);");
    sb_line(b, "    return buf;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Read n >= 0 bytes of stdin (fewer at end of input), flushing stdout");
    sb_line(b, "// first, as the C runtime's track_stdin_read does.");
    sb_line(b, "fn track_stdin_read(n: i64) -> i64 {");
    sb_line(b, "    rt_flush();");
    sb_line(b, "    let buf = rt_malloc(n + 1);");
    sb_line(b, "    let mut got: i64 = 0;");
    sb_line(b, "    let mut r: i64 = 1;");
    sb_line(b, "    while got < n && r != 0 {");
    sb_line(b, "        r = sys3(SYS_READ, 0, buf + got, n - got);");
    sb_line(b, "        if r > 0 {");
    sb_line(b, "            got = got + r;");
    sb_line(b, "        } else if r != -4 {");
    sb_line(b, "            r = 0; // end of input or error; -4 is EINTR: retry");
    sb_line(b, "        }");
    sb_line(b, "    }");
    sb_line(b, "    store8(buf + got, 0);");
    sb_line(b, "    return buf;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Fatal abort: print message and terminate the process with status 134.");
    sb_line(b, "fn track_abort(msg: i64) -> i64 {");
    sb_line(b, "    rt_flush();");
    sb_line(b, "    if msg != 0 && rt_readable(msg) {");
    sb_line(b, "        rt_err_str(\"Track abort: \");");
    sb_line(b, "        rt_err_str(msg);");
    sb_line(b, "        rt_err_str(\"\\n\");");
    sb_line(b, "    } else {");
    sb_line(b, "        rt_err_str(\"Track abort\\n\");");
    sb_line(b, "    }");
    sb_line(b, "    rt_exit_now(134);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Integer division by zero or INT64_MIN / -1: flush what was printed, then");
    sb_line(b, "// SIGFPE (shell status 136), as runtime/track_runtime.c does.");
    sb_line(b, "fn track_trap_div() -> i64 {");
    sb_line(b, "    rt_flush();");
    sb_line(b, "    let pid = sys0(SYS_GETPID);");
    sb_line(b, "    sys2(SYS_KILL, pid, 8);");
    sb_line(b, "    sys2(SYS_KILL, pid, 6);");
    sb_line(b, "    rt_exit_now(134);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    return 0;
}

fn rt_module_source_2(b: i64) -> i64 {
    sb_line(b, "// rt/str.trk — Track runtime: strings, characters, paths.");
    sb_line(b, "//");
    sb_line(b, "// Strings are NUL-terminated byte pointers. Runtime strings are never");
    sb_line(b, "// freed (`str_free` is a no-op), as in the C runtime.");
    sb_line(b, "");
    sb_line(b, "fn rt_is_space(ch: i64) -> bool { return ch == 32 || (ch >= 9 && ch <= 13); }");
    sb_line(b, "fn rt_is_digit(ch: i64) -> bool { return ch >= 48 && ch <= 57; }");
    sb_line(b, "fn rt_is_alpha(ch: i64) -> bool { return (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122); }");
    sb_line(b, "");
    sb_line(b, "fn str_from_literal(raw: i64) -> i64 { return rt_dup(raw); }");
    sb_line(b, "");
    sb_line(b, "fn str_free(s: i64) -> i64 { return 0; }");
    sb_line(b, "");
    sb_line(b, "// Free a string the compiler proved fresh (docs/lifecycles.md §3.5): a");
    sb_line(b, "// runtime result the caller owns, never a literal. str_free stays a no-op");
    sb_line(b, "// because user code may pass it either.");
    sb_line(b, "fn track_str_free(s: i64) -> i64 { return rt_free(s); }");
    sb_line(b, "");
    sb_line(b, "fn str_len(s: i64) -> i64 {");
    sb_line(b, "    if s == 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    return rt_strlen(s);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn str_eq(a: i64, b: i64) -> bool {");
    sb_line(b, "    if a == 0 || b == 0 {");
    sb_line(b, "        return a == b;");
    sb_line(b, "    }");
    sb_line(b, "    let mut i: i64 = 0;");
    sb_line(b, "    while true {");
    sb_line(b, "        let x = load8(a + i);");
    sb_line(b, "        if x != load8(b + i) {");
    sb_line(b, "            return false;");
    sb_line(b, "        }");
    sb_line(b, "        if x == 0 {");
    sb_line(b, "            return true;");
    sb_line(b, "        }");
    sb_line(b, "        i = i + 1;");
    sb_line(b, "    }");
    sb_line(b, "    return true;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn str_concat(a: i64, b: i64) -> i64 {");
    sb_line(b, "    let mut la: i64 = 0;");
    sb_line(b, "    let mut lb: i64 = 0;");
    sb_line(b, "    if a != 0 {");
    sb_line(b, "        la = rt_strlen(a);");
    sb_line(b, "    }");
    sb_line(b, "    if b != 0 {");
    sb_line(b, "        lb = rt_strlen(b);");
    sb_line(b, "    }");
    sb_line(b, "    let out = rt_malloc(la + lb + 1);");
    sb_line(b, "    if la > 0 {");
    sb_line(b, "        rt_copy(out, a, la);");
    sb_line(b, "    }");
    sb_line(b, "    if lb > 0 {");
    sb_line(b, "        rt_copy(out + la, b, lb);");
    sb_line(b, "    }");
    sb_line(b, "    store8(out + la + lb, 0);");
    sb_line(b, "    return out;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Does `sub` occur in `s` at byte offset `at`? (`s` long enough or NUL-stopped)");
    sb_line(b, "fn rt_match_at(s: i64, at: i64, sub: i64) -> bool {");
    sb_line(b, "    let mut j: i64 = 0;");
    sb_line(b, "    while true {");
    sb_line(b, "        let y = load8(sub + j);");
    sb_line(b, "        if y == 0 {");
    sb_line(b, "            return true;");
    sb_line(b, "        }");
    sb_line(b, "        if load8(s + at + j) != y {");
    sb_line(b, "            return false;");
    sb_line(b, "        }");
    sb_line(b, "        j = j + 1;");
    sb_line(b, "    }");
    sb_line(b, "    return true;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// strstr as an index, or -1.");
    sb_line(b, "fn rt_find(s: i64, sub: i64) -> i64 {");
    sb_line(b, "    let first = load8(sub);");
    sb_line(b, "    if first == 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    let mut i: i64 = 0;");
    sb_line(b, "    while true {");
    sb_line(b, "        let ch = load8(s + i);");
    sb_line(b, "        if ch == 0 {");
    sb_line(b, "            return -1;");
    sb_line(b, "        }");
    sb_line(b, "        if ch == first && rt_match_at(s, i, sub) {");
    sb_line(b, "            return i;");
    sb_line(b, "        }");
    sb_line(b, "        i = i + 1;");
    sb_line(b, "    }");
    sb_line(b, "    return -1;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn str_find(s: i64, sub: i64) -> i64 {");
    sb_line(b, "    if s == 0 || sub == 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    return rt_find(s, sub);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn str_contains(s: i64, sub: i64) -> i64 {");
    sb_line(b, "    if s == 0 || sub == 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    if rt_find(s, sub) >= 0 {");
    sb_line(b, "        return 1;");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// atoll: leading space, optional sign, then digits.");
    sb_line(b, "fn str_to_int(s: i64) -> i64 {");
    sb_line(b, "    if s == 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    let mut p = s;");
    sb_line(b, "    while rt_is_space(load8(p)) {");
    sb_line(b, "        p = p + 1;");
    sb_line(b, "    }");
    sb_line(b, "    let mut neg = false;");
    sb_line(b, "    if load8(p) == 45 {");
    sb_line(b, "        neg = true;");
    sb_line(b, "        p = p + 1;");
    sb_line(b, "    } else if load8(p) == 43 {");
    sb_line(b, "        p = p + 1;");
    sb_line(b, "    }");
    sb_line(b, "    let mut n: i64 = 0;");
    sb_line(b, "    while rt_is_digit(load8(p)) {");
    sb_line(b, "        n = n * 10 - (load8(p) - 48);");
    sb_line(b, "        p = p + 1;");
    sb_line(b, "    }");
    sb_line(b, "    if neg {");
    sb_line(b, "        return n;");
    sb_line(b, "    }");
    sb_line(b, "    return 0 - n;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn str_is_int(s: i64) -> i64 {");
    sb_line(b, "    if s == 0 || load8(s) == 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    let mut p = s;");
    sb_line(b, "    if load8(p) == 43 || load8(p) == 45 {");
    sb_line(b, "        p = p + 1;");
    sb_line(b, "    }");
    sb_line(b, "    if load8(p) == 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    while load8(p) != 0 {");
    sb_line(b, "        if !rt_is_digit(load8(p)) {");
    sb_line(b, "            return 0;");
    sb_line(b, "        }");
    sb_line(b, "        p = p + 1;");
    sb_line(b, "    }");
    sb_line(b, "    return 1;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn int_to_str(val: i64) -> i64 { return rt_dup(rt_fmt_int(val)); }");
    sb_line(b, "");
    sb_line(b, "fn str_starts_with(s: i64, prefix: i64) -> bool {");
    sb_line(b, "    if s == 0 || prefix == 0 {");
    sb_line(b, "        return false;");
    sb_line(b, "    }");
    sb_line(b, "    return rt_match_at(s, 0, prefix);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn str_ends_with(s: i64, suffix: i64) -> bool {");
    sb_line(b, "    if s == 0 || suffix == 0 {");
    sb_line(b, "        return false;");
    sb_line(b, "    }");
    sb_line(b, "    let ls = rt_strlen(s);");
    sb_line(b, "    let lp = rt_strlen(suffix);");
    sb_line(b, "    if lp > ls {");
    sb_line(b, "        return false;");
    sb_line(b, "    }");
    sb_line(b, "    return rt_match_at(s, ls - lp, suffix);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn str_substr(s: i64, start: i64, len: i64) -> i64 {");
    sb_line(b, "    if s == 0 || start < 0 || len <= 0 {");
    sb_line(b, "        return rt_dup_n(\"\", 0);");
    sb_line(b, "    }");
    sb_line(b, "    let avail = rt_strnlen(s, start + len);");
    sb_line(b, "    if start >= avail {");
    sb_line(b, "        return rt_dup_n(\"\", 0);");
    sb_line(b, "    }");
    sb_line(b, "    return rt_dup_n(s + start, avail - start);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn str_trim(s: i64) -> i64 {");
    sb_line(b, "    if s == 0 {");
    sb_line(b, "        return rt_dup_n(\"\", 0);");
    sb_line(b, "    }");
    sb_line(b, "    let mut p = s;");
    sb_line(b, "    while load8(p) != 0 && rt_is_space(load8(p)) {");
    sb_line(b, "        p = p + 1;");
    sb_line(b, "    }");
    sb_line(b, "    let mut len = rt_strlen(p);");
    sb_line(b, "    while len > 0 && rt_is_space(load8(p + len - 1)) {");
    sb_line(b, "        len = len - 1;");
    sb_line(b, "    }");
    sb_line(b, "    return rt_dup_n(p, len);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn str_char_at(s: i64, idx: i64) -> i64 {");
    sb_line(b, "    if s == 0 || idx < 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    if rt_strnlen(s, idx + 1) <= idx {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    return load8(s + idx);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Copy a string's bytes into a collection for O(1) bounds-checked access.");
    sb_line(b, "fn track_str_bytes(s: i64) -> i64 {");
    sb_line(b, "    let mut len: i64 = 0;");
    sb_line(b, "    if s != 0 {");
    sb_line(b, "        len = rt_strlen(s);");
    sb_line(b, "    }");
    sb_line(b, "    let out = track_i64_collection_new(len + 1);");
    sb_line(b, "    let data = load64(out);");
    sb_line(b, "    let mut i: i64 = 0;");
    sb_line(b, "    while i < len {");
    sb_line(b, "        store64(data + 8 * i, load8(s + i));");
    sb_line(b, "        i = i + 1;");
    sb_line(b, "    }");
    sb_line(b, "    store64(out + 8, len);");
    sb_line(b, "    return out;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn char_is_digit(ch: i64) -> bool { return rt_is_digit(ch); }");
    sb_line(b, "fn char_is_alpha(ch: i64) -> bool { return rt_is_alpha(ch); }");
    sb_line(b, "fn char_is_alphanumeric(ch: i64) -> bool { return rt_is_alpha(ch) || rt_is_digit(ch); }");
    sb_line(b, "fn char_is_space(ch: i64) -> bool { return rt_is_space(ch); }");
    sb_line(b, "");
    sb_line(b, "fn char_to_upper(ch: i64) -> i64 {");
    sb_line(b, "    if ch >= 97 && ch <= 122 {");
    sb_line(b, "        return ch - 32;");
    sb_line(b, "    }");
    sb_line(b, "    return ch;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn char_to_lower(ch: i64) -> i64 {");
    sb_line(b, "    if ch >= 65 && ch <= 90 {");
    sb_line(b, "        return ch + 32;");
    sb_line(b, "    }");
    sb_line(b, "    return ch;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// ------------------------------------------------------------------ paths");
    sb_line(b, "");
    sb_line(b, "// Byte offset of the last `ch` in `s`, or -1.");
    sb_line(b, "fn rt_last_index(s: i64, ch: i64) -> i64 {");
    sb_line(b, "    let mut found: i64 = -1;");
    sb_line(b, "    let mut i: i64 = 0;");
    sb_line(b, "    while load8(s + i) != 0 {");
    sb_line(b, "        if load8(s + i) == ch {");
    sb_line(b, "            found = i;");
    sb_line(b, "        }");
    sb_line(b, "        i = i + 1;");
    sb_line(b, "    }");
    sb_line(b, "    return found;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn path_basename(path: i64) -> i64 {");
    sb_line(b, "    if path == 0 {");
    sb_line(b, "        return rt_dup_n(\"\", 0);");
    sb_line(b, "    }");
    sb_line(b, "    return rt_dup(path + rt_last_index(path, 47) + 1);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn path_ext(path: i64) -> i64 {");
    sb_line(b, "    if path == 0 {");
    sb_line(b, "        return rt_dup_n(\"\", 0);");
    sb_line(b, "    }");
    sb_line(b, "    let dot = rt_last_index(path, 46);");
    sb_line(b, "    if dot <= 0 {");
    sb_line(b, "        return rt_dup_n(\"\", 0);");
    sb_line(b, "    }");
    sb_line(b, "    return rt_dup(path + dot + 1);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn path_join(a: i64, b: i64) -> i64 {");
    sb_line(b, "    let mut pa: i64 = \"\";");
    sb_line(b, "    let mut pb: i64 = \"\";");
    sb_line(b, "    if a != 0 {");
    sb_line(b, "        pa = a;");
    sb_line(b, "    }");
    sb_line(b, "    if b != 0 {");
    sb_line(b, "        pb = b;");
    sb_line(b, "    }");
    sb_line(b, "    let la = rt_strlen(pa);");
    sb_line(b, "    let lb = rt_strlen(pb);");
    sb_line(b, "    let mut slash: i64 = 0;");
    sb_line(b, "    if la > 0 && load8(pa + la - 1) != 47 && (lb == 0 || load8(pb) != 47) {");
    sb_line(b, "        slash = 1;");
    sb_line(b, "    }");
    sb_line(b, "    let out = rt_malloc(la + slash + lb + 1);");
    sb_line(b, "    rt_copy(out, pa, la);");
    sb_line(b, "    if slash == 1 {");
    sb_line(b, "        store8(out + la, 47);");
    sb_line(b, "    }");
    sb_line(b, "    rt_copy(out + la + slash, pb, lb + 1);");
    sb_line(b, "    return out;");
    sb_line(b, "}");
    return 0;
}

fn rt_module_source_3(b: i64) -> i64 {
    sb_line(b, "// rt/vec.trk — Track runtime: Vec, word collections, string builders,");
    sb_line(b, "// arrays, math.");
    sb_line(b, "//");
    sb_line(b, "// Handles point to three-word records `[data, len, cap]`, the same layout");
    sb_line(b, "// as the C runtime's structs, so code that inlines the hot collection");
    sb_line(b, "// operations keeps working on either runtime.");
    sb_line(b, "");
    sb_line(b, "// -------------------------------------------------------------------- Vec");
    sb_line(b, "");
    sb_line(b, "fn vec_init(cap: i64) -> i64 {");
    sb_line(b, "    let v = track_alloc_nz(24);");
    sb_line(b, "    let mut n = cap;");
    sb_line(b, "    if n <= 0 {");
    sb_line(b, "        n = 16;");
    sb_line(b, "    }");
    sb_line(b, "    store64(v + 16, n);");
    sb_line(b, "    store64(v, alloc(n * 8));");
    sb_line(b, "    store64(v + 8, 0);");
    sb_line(b, "    return v;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn vec_push(v: i64, val: i64) -> i64 {");
    sb_line(b, "    if v == 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    let len = load64(v + 8);");
    sb_line(b, "    if len == load64(v + 16) {");
    sb_line(b, "        let cap = load64(v + 16) * 2;");
    sb_line(b, "        store64(v + 16, cap);");
    sb_line(b, "        store64(v, mem_realloc(load64(v), cap * 8));");
    sb_line(b, "    }");
    sb_line(b, "    store64(load64(v) + 8 * len, val);");
    sb_line(b, "    store64(v + 8, len + 1);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn vec_get(v: i64, idx: i64) -> i64 {");
    sb_line(b, "    if v != 0 && idx >= 0 && idx < load64(v + 8) {");
    sb_line(b, "        return load64(load64(v) + 8 * idx);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn vec_set(v: i64, idx: i64, val: i64) -> i64 {");
    sb_line(b, "    if v != 0 && idx >= 0 && idx < load64(v + 8) {");
    sb_line(b, "        store64(load64(v) + 8 * idx, val);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn vec_pop(v: i64) -> i64 {");
    sb_line(b, "    if v != 0 && load64(v + 8) > 0 {");
    sb_line(b, "        let len = load64(v + 8) - 1;");
    sb_line(b, "        store64(v + 8, len);");
    sb_line(b, "        return load64(load64(v) + 8 * len);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn vec_len(v: i64) -> i64 {");
    sb_line(b, "    if v == 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    return load64(v + 8);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn vec_clear(v: i64) -> i64 {");
    sb_line(b, "    if v != 0 {");
    sb_line(b, "        store64(v + 8, 0);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn vec_reserve(v: i64, cap: i64) -> i64 {");
    sb_line(b, "    if v != 0 && cap > load64(v + 16) {");
    sb_line(b, "        store64(v, mem_realloc(load64(v), cap * 8));");
    sb_line(b, "        store64(v + 16, cap);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn vec_free(v: i64) -> i64 {");
    sb_line(b, "    if v != 0 {");
    sb_line(b, "        dealloc(load64(v));");
    sb_line(b, "        dealloc(v);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// ---------------------------------------------- opaque 64-bit collections");
    sb_line(b, "");
    sb_line(b, "fn track_i64_collection_new(requested_cap: i64) -> i64 {");
    sb_line(b, "    let mut cap = requested_cap;");
    sb_line(b, "    if cap <= 0 {");
    sb_line(b, "        cap = 16;");
    sb_line(b, "    }");
    sb_line(b, "    let h = rt_malloc(24);");
    sb_line(b, "    store64(h, rt_malloc(cap * 8));");
    sb_line(b, "    store64(h + 8, 0);");
    sb_line(b, "    store64(h + 16, cap);");
    sb_line(b, "    return h;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn track_i64_collection_len(h: i64) -> i64 {");
    sb_line(b, "    if h == 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    return load64(h + 8);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn track_i64_collection_push(h: i64, value: i64) -> i64 {");
    sb_line(b, "    if h == 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let len = load64(h + 8);");
    sb_line(b, "    if len == load64(h + 16) {");
    sb_line(b, "        let cap = len * 2;");
    sb_line(b, "        store64(h + 16, cap);");
    sb_line(b, "        store64(h, rt_realloc(load64(h), cap * 8));");
    sb_line(b, "    }");
    sb_line(b, "    store64(load64(h) + 8 * len, value);");
    sb_line(b, "    store64(h + 8, len + 1);");
    sb_line(b, "    return len;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn track_i64_collection_get(h: i64, index: i64) -> i64 {");
    sb_line(b, "    if h == 0 || index < 0 || index >= load64(h + 8) {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    return load64(load64(h) + 8 * index);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn track_i64_collection_set(h: i64, index: i64, value: i64) -> i64 {");
    sb_line(b, "    if h == 0 || index < 0 || index >= load64(h + 8) {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    store64(load64(h) + 8 * index, value);");
    sb_line(b, "    return 1;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn track_i64_collection_pop(h: i64) -> i64 {");
    sb_line(b, "    if h == 0 || load64(h + 8) == 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    let len = load64(h + 8) - 1;");
    sb_line(b, "    store64(h + 8, len);");
    sb_line(b, "    return load64(load64(h) + 8 * len);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Free a collection and its storage (fresh handles only, §3.5).");
    sb_line(b, "fn track_i64_collection_free(h: i64) -> i64 {");
    sb_line(b, "    if h != 0 {");
    sb_line(b, "        rt_free(load64(h));");
    sb_line(b, "        rt_free(h);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Shrink to `len` elements (no-op when already shorter).");
    sb_line(b, "fn track_i64_collection_truncate(h: i64, len: i64) -> i64 {");
    sb_line(b, "    if h != 0 && len >= 0 && len < load64(h + 8) {");
    sb_line(b, "        store64(h + 8, len);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// --------------------------------------------------------- string builder");
    sb_line(b, "");
    sb_line(b, "fn rt_sb_reserve(b: i64, extra: i64) -> i64 {");
    sb_line(b, "    let need = load64(b + 8) + extra + 1;");
    sb_line(b, "    let mut cap = load64(b + 16);");
    sb_line(b, "    if need <= cap {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    while need > cap {");
    sb_line(b, "        cap = cap * 2;");
    sb_line(b, "    }");
    sb_line(b, "    store64(b + 16, cap);");
    sb_line(b, "    store64(b, rt_realloc(load64(b), cap));");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn track_sb_new() -> i64 {");
    sb_line(b, "    let b = rt_malloc(24);");
    sb_line(b, "    let data = rt_malloc(256);");
    sb_line(b, "    store8(data, 0);");
    sb_line(b, "    store64(b, data);");
    sb_line(b, "    store64(b + 8, 0);");
    sb_line(b, "    store64(b + 16, 256);");
    sb_line(b, "    return b;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn rt_sb_bytes(b: i64, p: i64, n: i64) -> i64 {");
    sb_line(b, "    rt_sb_reserve(b, n);");
    sb_line(b, "    let len = load64(b + 8);");
    sb_line(b, "    let data = load64(b);");
    sb_line(b, "    rt_copy(data + len, p, n);");
    sb_line(b, "    store8(data + len + n, 0);");
    sb_line(b, "    store64(b + 8, len + n);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Copies while the capacity lasts (one pass, no strlen; a leaf): only a");
    sb_line(b, "// push that outgrows the buffer measures the string and reallocates.");
    sb_line(b, "fn track_sb_push(b: i64, s: i64) -> i64 {");
    sb_line(b, "    if b == 0 || s == 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    let len = load64(b + 8);");
    sb_line(b, "    let dst = load64(b) + len;");
    sb_line(b, "    let room = load64(b + 16) - len - 1;");
    sb_line(b, "    let mut i: i64 = 0;");
    sb_line(b, "    let mut ch = load8(s);");
    sb_line(b, "    while ch != 0 {");
    sb_line(b, "        if i >= room {");
    sb_line(b, "            return rt_sb_push_slow(b, s);");
    sb_line(b, "        }");
    sb_line(b, "        store8(dst + i, ch);");
    sb_line(b, "        i = i + 1;");
    sb_line(b, "        ch = load8(s + i);");
    sb_line(b, "    }");
    sb_line(b, "    store8(dst + i, 0);");
    sb_line(b, "    store64(b + 8, len + i);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn rt_sb_push_slow(b: i64, s: i64) -> i64 {");
    sb_line(b, "    return rt_sb_bytes(b, s, rt_strlen(s));");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn track_sb_push_byte(b: i64, byte: i64) -> i64 {");
    sb_line(b, "    if b == 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    if load64(b + 8) + 2 > load64(b + 16) {");
    sb_line(b, "        rt_sb_reserve(b, 1);");
    sb_line(b, "    }");
    sb_line(b, "    let len = load64(b + 8);");
    sb_line(b, "    let data = load64(b);");
    sb_line(b, "    store8(data + len, byte);");
    sb_line(b, "    store8(data + len + 1, 0);");
    sb_line(b, "    store64(b + 8, len + 1);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Non-negative values below 10^8 are formatted straight into the buffer");
    sb_line(b, "// as one word: eight digits with leading zeros, split by multiply and");
    sb_line(b, "// shift in SWAR lanes (no table), then shifted right past the leading");
    sb_line(b, "// zeros (little-endian: the first digit is the low byte). Four locals in");
    sb_line(b, "// all (the parameters are reused once dead), so the native backend keeps");
    sb_line(b, "// them in the free argument registers of a leaf and needs no frame:");
    sb_line(b, "// growth and other values tail-call the slow path.");
    sb_line(b, "//   v / 10000      = v * 109951163 >> 40             (v < 10^8)");
    sb_line(b, "//   lane n / 100   = n * 5243 >> 19, two 32-bit lanes (n < 10^4)");
    sb_line(b, "//   lane n / 10    = n * 103 >> 10, four 16-bit lanes (n < 100)");
    sb_line(b, "fn track_sb_push_int(b: i64, val: i64) -> i64 {");
    sb_line(b, "    if b == 0 || val < 0 || val >= 100000000 {");
    sb_line(b, "        return rt_sb_push_int_slow(b, val);");
    sb_line(b, "    }");
    sb_line(b, "    let mut y = load64(b + 16) - 9;");
    sb_line(b, "    if load64(b + 8) > y {");
    sb_line(b, "        return rt_sb_push_int_slow(b, val);");
    sb_line(b, "    }");
    sb_line(b, "    y = val * 109951163;");
    sb_line(b, "    y = y >> 40;");
    sb_line(b, "    let mut x = y * 10000;");
    sb_line(b, "    x = val - x;");
    sb_line(b, "    x = x << 32;");
    sb_line(b, "    x = x + y;");
    sb_line(b, "    y = x * 5243;");
    sb_line(b, "    y = y >> 19;");
    sb_line(b, "    y = y & 545460846719;               // 0x0000007f0000007f");
    sb_line(b, "    x = x - y * 100;");
    sb_line(b, "    x = x << 16;");
    sb_line(b, "    x = x + y;");
    sb_line(b, "    y = x * 103;");
    sb_line(b, "    y = y >> 10;");
    sb_line(b, "    y = y & 4222189076152335;           // 0x000f000f000f000f");
    sb_line(b, "    x = x - y * 10;");
    sb_line(b, "    x = x << 8;");
    sb_line(b, "    x = x + y;");
    sb_line(b, "    x = x | 3472328296227680304;        // 0x3030303030303030");
    sb_line(b, "    // y = the digit count; then val (dead) is the shift, then the end.");
    sb_line(b, "    y = 8;");
    sb_line(b, "    if val < 10000 {");
    sb_line(b, "        if val < 10 { y = 1; } else if val < 100 { y = 2; } else if val < 1000 { y = 3; } else { y = 4; }");
    sb_line(b, "    } else if val < 100000 { y = 5; } else if val < 1000000 { y = 6; } else if val < 10000000 { y = 7; }");
    sb_line(b, "    val = 8 - y;");
    sb_line(b, "    val = val << 3;");
    sb_line(b, "    x = x >> val;");
    sb_line(b, "    val = load64(b + 8);");
    sb_line(b, "    store64(b + 8, val + y);");
    sb_line(b, "    val = val + load64(b);");
    sb_line(b, "    store64(val, x);");
    sb_line(b, "    store8(val + y, 0);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn rt_sb_push_int_slow(b: i64, val: i64) -> i64 {");
    sb_line(b, "    if b == 0 || val < 0 || val >= 100000000 {");
    sb_line(b, "        return track_sb_push(b, rt_fmt_int(val));");
    sb_line(b, "    }");
    sb_line(b, "    rt_sb_reserve(b, 20);");
    sb_line(b, "    return track_sb_push_int(b, val);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn track_sb_len(b: i64) -> i64 {");
    sb_line(b, "    if b == 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    return load64(b + 8);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Copy the builder contents into a new string.");
    sb_line(b, "fn track_sb_str(b: i64) -> i64 {");
    sb_line(b, "    if b == 0 {");
    sb_line(b, "        return rt_dup_n(\"\", 0);");
    sb_line(b, "    }");
    sb_line(b, "    return rt_dup_n(load64(b), load64(b + 8));");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Free a string builder and its buffer (fresh handles only, §3.5).");
    sb_line(b, "fn track_sb_free(b: i64) -> i64 {");
    sb_line(b, "    if b != 0 {");
    sb_line(b, "        rt_free(load64(b));");
    sb_line(b, "        rt_free(b);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn track_sb_clear(b: i64) -> i64 {");
    sb_line(b, "    if b != 0 {");
    sb_line(b, "        store64(b + 8, 0);");
    sb_line(b, "        store8(load64(b), 0);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// ----------------------------------------------------------------- arrays");
    sb_line(b, "");
    sb_line(b, "// Array values are cells [length, elements...]; indexing is bounds checked.");
    sb_line(b, "fn rt_bounds(a: i64, i: i64) -> i64 {");
    sb_line(b, "    if a == 0 {");
    sb_line(b, "        track_abort(\"index into a null array\");");
    sb_line(b, "    }");
    sb_line(b, "    if i < 0 || i >= load64(a) {");
    sb_line(b, "        track_abort(\"array index out of bounds\");");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn track_array_get(a: i64, i: i64) -> i64 {");
    sb_line(b, "    rt_bounds(a, i);");
    sb_line(b, "    return load64(a + 8 + 8 * i);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn track_array_set(a: i64, i: i64, v: i64) -> i64 {");
    sb_line(b, "    rt_bounds(a, i);");
    sb_line(b, "    store64(a + 8 + 8 * i, v);");
    sb_line(b, "    return v;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Copy of a[from..to]; `to` of -1 means the end of the array.");
    sb_line(b, "fn track_array_slice(a: i64, from: i64, to: i64) -> i64 {");
    sb_line(b, "    let mut len: i64 = 0;");
    sb_line(b, "    if a != 0 {");
    sb_line(b, "        len = load64(a);");
    sb_line(b, "    }");
    sb_line(b, "    let mut end = to;");
    sb_line(b, "    if end < 0 {");
    sb_line(b, "        end = len;");
    sb_line(b, "    }");
    sb_line(b, "    if from < 0 || from > end || end > len {");
    sb_line(b, "        track_abort(\"array slice out of bounds\");");
    sb_line(b, "    }");
    sb_line(b, "    let out = track_alloc_nz((end - from + 1) * 8);");
    sb_line(b, "    store64(out, end - from);");
    sb_line(b, "    if end > from {");
    sb_line(b, "        rt_copy(out + 8, a + 8 + 8 * from, (end - from) * 8);");
    sb_line(b, "    }");
    sb_line(b, "    return out;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn array_len(a: i64) -> i64 {");
    sb_line(b, "    if a == 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    return load64(a);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// A field access whose struct tag matched none of the declaring structs.");
    sb_line(b, "fn track_bad_field() -> i64 {");
    sb_line(b, "    return track_abort(\"field access on a value of the wrong struct type\");");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// ------------------------------------------------------------------- math");
    sb_line(b, "");
    sb_line(b, "fn math_abs(x: i64) -> i64 {");
    sb_line(b, "    if x < 0 {");
    sb_line(b, "        return 0 - x;");
    sb_line(b, "    }");
    sb_line(b, "    return x;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn math_min(a: i64, b: i64) -> i64 {");
    sb_line(b, "    if a < b {");
    sb_line(b, "        return a;");
    sb_line(b, "    }");
    sb_line(b, "    return b;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn math_max(a: i64, b: i64) -> i64 {");
    sb_line(b, "    if a > b {");
    sb_line(b, "        return a;");
    sb_line(b, "    }");
    sb_line(b, "    return b;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn math_clamp(v: i64, lo: i64, hi: i64) -> i64 {");
    sb_line(b, "    if v < lo {");
    sb_line(b, "        return lo;");
    sb_line(b, "    }");
    sb_line(b, "    if v > hi {");
    sb_line(b, "        return hi;");
    sb_line(b, "    }");
    sb_line(b, "    return v;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn math_floor(x: i64) -> i64 { return x; }");
    sb_line(b, "fn math_ceil(x: i64) -> i64 { return x; }");
    sb_line(b, "fn math_round(x: i64) -> i64 { return x; }");
    sb_line(b, "");
    sb_line(b, "fn math_pow(base: i64, exp: i64) -> i64 {");
    sb_line(b, "    if exp < 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    let mut result: i64 = 1;");
    sb_line(b, "    let mut b = base;");
    sb_line(b, "    let mut e = exp;");
    sb_line(b, "    while e > 0 {");
    sb_line(b, "        if (e & 1) != 0 {");
    sb_line(b, "            result = result * b;");
    sb_line(b, "        }");
    sb_line(b, "        b = b * b;");
    sb_line(b, "        e = e >> 1;");
    sb_line(b, "    }");
    sb_line(b, "    return result;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn math_sqrt(x: i64) -> i64 {");
    sb_line(b, "    if x <= 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    let mut lo: i64 = 0;");
    sb_line(b, "    let mut hi: i64 = 3037000499;");
    sb_line(b, "    while lo < hi {");
    sb_line(b, "        let mid = (lo + hi + 1) / 2;");
    sb_line(b, "        if mid * mid <= x {");
    sb_line(b, "            lo = mid;");
    sb_line(b, "        } else {");
    sb_line(b, "            hi = mid - 1;");
    sb_line(b, "        }");
    sb_line(b, "    }");
    sb_line(b, "    return lo;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn rt_xor(a: i64, b: i64) -> i64 { return (a | b) - (a & b); }");
    sb_line(b, "");
    sb_line(b, "fn math_random() -> i64 {");
    sb_line(b, "    let mut x = rs(RS_RNG);");
    sb_line(b, "    x = rt_xor(x, x << 13);");
    sb_line(b, "    x = rt_xor(x, x >> 7);");
    sb_line(b, "    x = rt_xor(x, x << 17);");
    sb_line(b, "    rs_set(RS_RNG, x);");
    sb_line(b, "    return x;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn add(a: i64, b: i64) -> i64 { return a + b; }");
    sb_line(b, "fn sum(a: i64, b: i64) -> i64 { return a + b; }");
    sb_line(b, "fn sub(a: i64, b: i64) -> i64 { return a - b; }");
    return 0;
}

fn rt_module_source_4(b: i64) -> i64 {
    sb_line(b, "// rt/os/linux.trk — Track runtime OS layer for Linux: arguments,");
    sb_line(b, "// environment, processes, clock, files, sockets, all through Linux x86-64");
    sb_line(b, "// system calls. Every OS layer (rt/os/<os>.trk) defines the same OS");
    sb_line(b, "// interface (docs/native.md, \"The OS layer\"); trackc loads the one for");
    sb_line(b, "// the target. On Linux the portable modules' own `syscall6` calls go");
    sb_line(b, "// straight to the kernel; other OS layers also define `os_syscall`.");
    sb_line(b, "");
    sb_line(b, "// ---------------------------------------------------------------- process");
    sb_line(b, "");
    sb_line(b, "fn os_args_count() -> i64 { return rs(RS_ARGC); }");
    sb_line(b, "");
    sb_line(b, "fn os_arg(idx: i64) -> i64 {");
    sb_line(b, "    if idx >= 0 && idx < rs(RS_ARGC) {");
    sb_line(b, "        return rt_dup(load64(rs(RS_ARGV) + 8 * idx));");
    sb_line(b, "    }");
    sb_line(b, "    return rt_dup_n(\"\", 0);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Value of environment variable `key` (\"NAME=value\"), or 0 when unset.");
    sb_line(b, "fn rt_getenv(key: i64) -> i64 {");
    sb_line(b, "    let mut e = rs(RS_ENVP);");
    sb_line(b, "    while load64(e) != 0 {");
    sb_line(b, "        let entry = load64(e);");
    sb_line(b, "        let mut i: i64 = 0;");
    sb_line(b, "        while load8(key + i) != 0 && load8(key + i) == load8(entry + i) {");
    sb_line(b, "            i = i + 1;");
    sb_line(b, "        }");
    sb_line(b, "        if load8(key + i) == 0 && load8(entry + i) == 61 {");
    sb_line(b, "            return entry + i + 1;");
    sb_line(b, "        }");
    sb_line(b, "        e = e + 8;");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn env_get(key: i64) -> i64 {");
    sb_line(b, "    if key == 0 {");
    sb_line(b, "        return rt_dup_n(\"\", 0);");
    sb_line(b, "    }");
    sb_line(b, "    let v = rt_getenv(key);");
    sb_line(b, "    if v == 0 {");
    sb_line(b, "        return rt_dup_n(\"\", 0);");
    sb_line(b, "    }");
    sb_line(b, "    return rt_dup(v);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn env_exists(key: i64) -> i64 {");
    sb_line(b, "    if key != 0 && rt_getenv(key) != 0 {");
    sb_line(b, "        return 1;");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// system(3): /bin/sh -c cmd; exit status, or 128 + signal.");
    sb_line(b, "fn sys_exec(cmd: i64) -> i64 {");
    sb_line(b, "    if cmd == 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    rt_flush();");
    sb_line(b, "    let pid = sys0(SYS_FORK);");
    sb_line(b, "    if pid < 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    if pid == 0 {");
    sb_line(b, "        let argv = RT_BASE + RS_EXECV;");
    sb_line(b, "        store64(argv, \"sh\");");
    sb_line(b, "        store64(argv + 8, \"-c\");");
    sb_line(b, "        store64(argv + 16, cmd);");
    sb_line(b, "        store64(argv + 24, 0);");
    sb_line(b, "        sys3(SYS_EXECVE, \"/bin/sh\", argv, rs(RS_ENVP));");
    sb_line(b, "        rt_exit_now(127);");
    sb_line(b, "    }");
    sb_line(b, "    let status_at = RT_BASE + RS_WAIT;");
    sb_line(b, "    store64(status_at, 0);");
    sb_line(b, "    let mut r = syscall6(SYS_WAIT4, pid, status_at, 0, 0, 0, 0);");
    sb_line(b, "    while r == -4 {");
    sb_line(b, "        r = syscall6(SYS_WAIT4, pid, status_at, 0, 0, 0, 0);");
    sb_line(b, "    }");
    sb_line(b, "    if r < 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let status = load64(status_at) & 4294967295;");
    sb_line(b, "    if (status & 127) == 0 {");
    sb_line(b, "        return (status >> 8) & 255;");
    sb_line(b, "    }");
    sb_line(b, "    return 128 + (status & 127);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn process_spawn(cmd: i64) -> i64 { return sys_exec(cmd); }");
    sb_line(b, "");
    sb_line(b, "fn clock_ms() -> i64 {");
    sb_line(b, "    let ts = RT_BASE + RS_TIME;");
    sb_line(b, "    sys2(SYS_CLOCK_GETTIME, 1, ts);");
    sb_line(b, "    return load64(ts) * 1000 + load64(ts + 8) / 1000000;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// ------------------------------------------------------------------ files");
    sb_line(b, "//");
    sb_line(b, "// A file handle is a runtime record [fd]; 0 when the open failed.");
    sb_line(b, "");
    sb_line(b, "const O_RDONLY = 0;");
    sb_line(b, "const O_WRONLY_CREAT_TRUNC = 577;    // O_WRONLY | O_CREAT | O_TRUNC");
    sb_line(b, "const O_WRONLY_CREAT_APPEND = 1089;  // O_WRONLY | O_CREAT | O_APPEND");
    sb_line(b, "const O_RDWR = 2;");
    sb_line(b, "");
    sb_line(b, "// open(2) flags for an fopen(3) mode string.");
    sb_line(b, "fn rt_open_flags(mode: i64) -> i64 {");
    sb_line(b, "    let m = load8(mode);");
    sb_line(b, "    let plus = rt_find(mode, \"+\") >= 0;");
    sb_line(b, "    if m == 114 {");
    sb_line(b, "        if plus {");
    sb_line(b, "            return O_RDWR;");
    sb_line(b, "        }");
    sb_line(b, "        return O_RDONLY;");
    sb_line(b, "    }");
    sb_line(b, "    if m == 119 {");
    sb_line(b, "        if plus {");
    sb_line(b, "            return 578;                   // O_RDWR | O_CREAT | O_TRUNC");
    sb_line(b, "        }");
    sb_line(b, "        return O_WRONLY_CREAT_TRUNC;");
    sb_line(b, "    }");
    sb_line(b, "    if m == 97 {");
    sb_line(b, "        if plus {");
    sb_line(b, "            return 1090;                  // O_RDWR | O_CREAT | O_APPEND");
    sb_line(b, "        }");
    sb_line(b, "        return O_WRONLY_CREAT_APPEND;");
    sb_line(b, "    }");
    sb_line(b, "    return -1;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn file_open(path: i64, mode: i64) -> i64 {");
    sb_line(b, "    if path == 0 || mode == 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    let flags = rt_open_flags(mode);");
    sb_line(b, "    if flags < 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    let fd = sys3(SYS_OPEN, path, flags | 524288, 438);  // O_CLOEXEC, 0666");
    sb_line(b, "    if fd < 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    let h = rt_malloc(8);");
    sb_line(b, "    store64(h, fd);");
    sb_line(b, "    return h;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn file_close(h: i64) -> i64 {");
    sb_line(b, "    if h != 0 {");
    sb_line(b, "        sys1(SYS_CLOSE, load64(h));");
    sb_line(b, "        rt_free(h);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Read everything from `fd` to end of file; \"\" on error. The size from");
    sb_line(b, "// lseek only sizes the first buffer: files whose size is not known up");
    sb_line(b, "// front (/proc, pipes) read whole too.");
    sb_line(b, "fn rt_read_fd(fd: i64) -> i64 {");
    sb_line(b, "    let mut cap: i64 = 4096;");
    sb_line(b, "    let end = sys3(SYS_LSEEK, fd, 0, 2);");
    sb_line(b, "    if end >= 0 {");
    sb_line(b, "        if sys3(SYS_LSEEK, fd, 0, 0) < 0 {");
    sb_line(b, "            return rt_dup_n(\"\", 0);");
    sb_line(b, "        }");
    sb_line(b, "        cap = end + 1;");
    sb_line(b, "    }");
    sb_line(b, "    let mut buf = rt_malloc(cap + 1);");
    sb_line(b, "    let mut got: i64 = 0;");
    sb_line(b, "    let mut going = true;");
    sb_line(b, "    while going {");
    sb_line(b, "        if got == cap {");
    sb_line(b, "            cap = cap * 2;");
    sb_line(b, "            buf = rt_realloc(buf, cap + 1);");
    sb_line(b, "        }");
    sb_line(b, "        let r = sys3(SYS_READ, fd, buf + got, cap - got);");
    sb_line(b, "        if r == -4 {");
    sb_line(b, "            // EINTR: retry");
    sb_line(b, "        } else if r <= 0 {");
    sb_line(b, "            going = false;");
    sb_line(b, "        } else {");
    sb_line(b, "            got = got + r;");
    sb_line(b, "        }");
    sb_line(b, "    }");
    sb_line(b, "    store8(buf + got, 0);");
    sb_line(b, "    return buf;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn file_read_all(h: i64) -> i64 {");
    sb_line(b, "    if h == 0 {");
    sb_line(b, "        return rt_dup_n(\"\", 0);");
    sb_line(b, "    }");
    sb_line(b, "    return rt_read_fd(load64(h));");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn file_write(h: i64, content: i64) -> i64 {");
    sb_line(b, "    if h == 0 || content == 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    return rt_write_all(load64(h), content, rt_strlen(content));");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn file_exists(path: i64) -> i64 {");
    sb_line(b, "    if path != 0 && sys2(SYS_ACCESS, path, 0) == 0 {");
    sb_line(b, "        return 1;");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn file_remove(path: i64) -> i64 {");
    sb_line(b, "    if path != 0 && sys1(SYS_UNLINK, path) == 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    return -1;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn file_size(path: i64) -> i64 {");
    sb_line(b, "    let st = RT_BASE + RS_STAT;");
    sb_line(b, "    if path == 0 || sys2(SYS_STAT, path, st) != 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    return load64(st + 48);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn dir_exists(path: i64) -> bool {");
    sb_line(b, "    let st = RT_BASE + RS_STAT;");
    sb_line(b, "    if path == 0 || sys2(SYS_STAT, path, st) != 0 {");
    sb_line(b, "        return false;");
    sb_line(b, "    }");
    sb_line(b, "    return (load64(st + 24) & 61440) == 16384;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn file_copy(src: i64, dst: i64) -> i64 {");
    sb_line(b, "    if src == 0 || dst == 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let fin = sys3(SYS_OPEN, src, O_RDONLY | 524288, 0);");
    sb_line(b, "    if fin < 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let fout = sys3(SYS_OPEN, dst, O_WRONLY_CREAT_TRUNC | 524288, 438);");
    sb_line(b, "    if fout < 0 {");
    sb_line(b, "        sys1(SYS_CLOSE, fin);");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let buf = rt_malloc(65536);");
    sb_line(b, "    let mut going = true;");
    sb_line(b, "    while going {");
    sb_line(b, "        let n = sys3(SYS_READ, fin, buf, 65536);");
    sb_line(b, "        if n == -4 {");
    sb_line(b, "            // EINTR: retry");
    sb_line(b, "        } else if n <= 0 {");
    sb_line(b, "            going = false;");
    sb_line(b, "        } else {");
    sb_line(b, "            rt_write_all(fout, buf, n);");
    sb_line(b, "        }");
    sb_line(b, "    }");
    sb_line(b, "    rt_free(buf);");
    sb_line(b, "    sys1(SYS_CLOSE, fin);");
    sb_line(b, "    sys1(SYS_CLOSE, fout);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Whole-file helpers: open, transfer, and close in one call.");
    sb_line(b, "fn track_file_read(path: i64) -> i64 {");
    sb_line(b, "    if path == 0 {");
    sb_line(b, "        return rt_dup_n(\"\", 0);");
    sb_line(b, "    }");
    sb_line(b, "    let fd = sys3(SYS_OPEN, path, O_RDONLY | 524288, 0);");
    sb_line(b, "    if fd < 0 {");
    sb_line(b, "        return rt_dup_n(\"\", 0);");
    sb_line(b, "    }");
    sb_line(b, "    let out = rt_read_fd(fd);");
    sb_line(b, "    sys1(SYS_CLOSE, fd);");
    sb_line(b, "    return out;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn track_file_write_all(path: i64, content: i64) -> i64 {");
    sb_line(b, "    if path == 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let fd = sys3(SYS_OPEN, path, O_WRONLY_CREAT_TRUNC | 524288, 438);");
    sb_line(b, "    if fd < 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let mut status: i64 = -1;");
    sb_line(b, "    if content != 0 {");
    sb_line(b, "        status = rt_write_all(fd, content, rt_strlen(content));");
    sb_line(b, "    }");
    sb_line(b, "    if sys1(SYS_CLOSE, fd) != 0 {");
    sb_line(b, "        status = -1;");
    sb_line(b, "    }");
    sb_line(b, "    return status;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// ---------------------------------------------------------------- network");
    sb_line(b, "");
    sb_line(b, "const SYS_SOCKET = 41;");
    sb_line(b, "const SYS_CONNECT = 42;");
    sb_line(b, "const SYS_ACCEPT = 43;");
    sb_line(b, "const SYS_SENDTO = 44;");
    sb_line(b, "const SYS_RECVFROM = 45;");
    sb_line(b, "const SYS_BIND = 49;");
    sb_line(b, "const SYS_LISTEN = 50;");
    sb_line(b, "const SYS_SETSOCKOPT = 54;");
    sb_line(b, "");
    sb_line(b, "// struct sockaddr_in for AF_INET, `port`, and the IPv4 address word `addr`");
    sb_line(b, "// (network byte order already packed little-endian in memory).");
    sb_line(b, "fn rt_sockaddr(port: i64, addr: i64) -> i64 {");
    sb_line(b, "    let sa = RT_BASE + RS_SOCK;");
    sb_line(b, "    let p = port & 65535;");
    sb_line(b, "    store64(sa, 2 | ((p >> 8) << 16) | ((p & 255) << 24) | ((addr & 4294967295) << 32));");
    sb_line(b, "    store64(sa + 8, 0);");
    sb_line(b, "    return sa;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// inet_pton for dotted-quad IPv4; -1 when malformed.");
    sb_line(b, "fn rt_parse_ipv4(s: i64) -> i64 {");
    sb_line(b, "    let mut addr: i64 = 0;");
    sb_line(b, "    let mut part: i64 = 0;");
    sb_line(b, "    let mut digits: i64 = 0;");
    sb_line(b, "    let mut parts: i64 = 0;");
    sb_line(b, "    let mut i: i64 = 0;");
    sb_line(b, "    while true {");
    sb_line(b, "        let ch = load8(s + i);");
    sb_line(b, "        if rt_is_digit(ch) {");
    sb_line(b, "            part = part * 10 + ch - 48;");
    sb_line(b, "            digits = digits + 1;");
    sb_line(b, "            if part > 255 || digits > 3 {");
    sb_line(b, "                return -1;");
    sb_line(b, "            }");
    sb_line(b, "        } else if ch == 46 || ch == 0 {");
    sb_line(b, "            if digits == 0 || parts == 4 {");
    sb_line(b, "                return -1;");
    sb_line(b, "            }");
    sb_line(b, "            addr = addr | (part << (8 * parts));");
    sb_line(b, "            parts = parts + 1;");
    sb_line(b, "            part = 0;");
    sb_line(b, "            digits = 0;");
    sb_line(b, "            if ch == 0 {");
    sb_line(b, "                if parts != 4 {");
    sb_line(b, "                    return -1;");
    sb_line(b, "                }");
    sb_line(b, "                return addr;");
    sb_line(b, "            }");
    sb_line(b, "        } else {");
    sb_line(b, "            return -1;");
    sb_line(b, "        }");
    sb_line(b, "        i = i + 1;");
    sb_line(b, "    }");
    sb_line(b, "    return -1;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn net_socket_tcp_listen(port: i64) -> i64 {");
    sb_line(b, "    let fd = sys3(SYS_SOCKET, 2, 1, 0);");
    sb_line(b, "    if fd < 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    syscall6(SYS_SETSOCKOPT, fd, 1, 2, RT_BASE + RS_ONE, 4, 0);");
    sb_line(b, "    let r = sys3(SYS_BIND, fd, rt_sockaddr(port, 0), 16);");
    sb_line(b, "    if r < 0 {");
    sb_line(b, "        let b = track_sb_new();");
    sb_line(b, "        if r == -98 {");
    sb_line(b, "            track_sb_push(b, \"Track Network Error: Port conflict! Port \");");
    sb_line(b, "            track_sb_push_int(b, port);");
    sb_line(b, "            track_sb_push(b, \" is already in use by another process.\\n\");");
    sb_line(b, "        } else {");
    sb_line(b, "            track_sb_push(b, \"Track Network Error: Failed to bind TCP socket on port \");");
    sb_line(b, "            track_sb_push_int(b, port);");
    sb_line(b, "            track_sb_push(b, \" (errno: \");");
    sb_line(b, "            track_sb_push_int(b, 0 - r);");
    sb_line(b, "            track_sb_push(b, \").\\n\");");
    sb_line(b, "        }");
    sb_line(b, "        rt_err_bytes(load64(b), track_sb_len(b));");
    sb_line(b, "        sys1(SYS_CLOSE, fd);");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    if sys2(SYS_LISTEN, fd, 128) < 0 {");
    sb_line(b, "        sys1(SYS_CLOSE, fd);");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    return fd;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn net_socket_accept(server_fd: i64) -> i64 {");
    sb_line(b, "    if server_fd < 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let r = sys3(SYS_ACCEPT, server_fd, 0, 0);");
    sb_line(b, "    if r < 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    return r;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn net_socket_connect(host: i64, port: i64) -> i64 {");
    sb_line(b, "    if host == 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let fd = sys3(SYS_SOCKET, 2, 1, 0);");
    sb_line(b, "    if fd < 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let addr = rt_parse_ipv4(host);");
    sb_line(b, "    if addr < 0 || sys3(SYS_CONNECT, fd, rt_sockaddr(port, addr), 16) < 0 {");
    sb_line(b, "        sys1(SYS_CLOSE, fd);");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    return fd;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn net_socket_send(fd: i64, data: i64, len: i64) -> i64 {");
    sb_line(b, "    if fd < 0 || data == 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let r = syscall6(SYS_SENDTO, fd, data, len, 0, 0, 0);");
    sb_line(b, "    if r < 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    return r;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn net_socket_recv(fd: i64, buf: i64, max_len: i64) -> i64 {");
    sb_line(b, "    if fd < 0 || buf == 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let r = syscall6(SYS_RECVFROM, fd, buf, max_len, 0, 0, 0);");
    sb_line(b, "    if r < 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    return r;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn net_socket_close(fd: i64) -> i64 {");
    sb_line(b, "    if fd >= 0 {");
    sb_line(b, "        sys1(SYS_CLOSE, fd);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    return 0;
}

fn rt_module_source_5(b: i64) -> i64 {
    sb_line(b, "// rt/os/windows.trk — Track runtime OS layer for Windows (kernel32).");
    sb_line(b, "//");
    sb_line(b, "// Implements the OS interface (docs/native.md, \"The OS layer\") with");
    sb_line(b, "// kernel32 functions called through the import table (`extern`):");
    sb_line(b, "//");
    sb_line(b, "//   os_start         process entry: argc/argv from GetCommandLineW, then rt_start");
    sb_line(b, "//   os_syscall       the kernel calls the portable modules (mem, io, libc)");
    sb_line(b, "//                    make through `syscall6`, by Linux number: read, write,");
    sb_line(b, "//                    open, close, stat, lseek, mmap, munmap, mremap,");
    sb_line(b, "//                    madvise, pipe, access, getpid, kill, unlink,");
    sb_line(b, "//                    clock_gettime, exit_group, fchmod. trackc lowers");
    sb_line(b, "//                    `syscall6(nr, a..f)` to `os_syscall(nr, a..e)` on");
    sb_line(b, "//                    every target but Linux.");
    sb_line(b, "//   os_args_count, os_arg, env_get, env_exists, sys_exec, process_spawn,");
    sb_line(b, "//   clock_ms, file_open, file_close, file_read_all, file_write,");
    sb_line(b, "//   file_exists, file_remove, file_size, dir_exists, file_copy,");
    sb_line(b, "//   track_file_read, track_file_write_all, net_socket_* (not yet: -1)");
    sb_line(b, "//");
    sb_line(b, "// A file descriptor is a HANDLE; 0, 1 and 2 stand for the standard");
    sb_line(b, "// handles. Paths and arguments are UTF-8 in Track and UTF-16 for Windows.");
    sb_line(b, "");
    sb_line(b, "extern \"kernel32.dll\" fn GetStdHandle(which: i64) -> i64;");
    sb_line(b, "extern \"kernel32.dll\" fn WriteFile(h: i64, buf: i64, n: i64, done: i64, ov: i64) -> i32;");
    sb_line(b, "extern \"kernel32.dll\" fn ReadFile(h: i64, buf: i64, n: i64, done: i64, ov: i64) -> i32;");
    sb_line(b, "extern \"kernel32.dll\" fn CreateFileW(path: i64, access: i64, share: i64, sec: i64, disp: i64, flags: i64, tmpl: i64) -> i64;");
    sb_line(b, "extern \"kernel32.dll\" fn CloseHandle(h: i64) -> i32;");
    sb_line(b, "extern \"kernel32.dll\" fn ExitProcess(code: i64) -> i64;");
    sb_line(b, "extern \"kernel32.dll\" fn VirtualAlloc(addr: i64, size: i64, kind: i64, prot: i64) -> i64;");
    sb_line(b, "extern \"kernel32.dll\" fn VirtualFree(addr: i64, size: i64, kind: i64) -> i32;");
    sb_line(b, "extern \"kernel32.dll\" fn GetCommandLineW() -> i64;");
    sb_line(b, "extern \"kernel32.dll\" fn GetEnvironmentVariableW(name: i64, buf: i64, n: i64) -> u32;");
    sb_line(b, "extern \"kernel32.dll\" fn GetFileAttributesW(path: i64) -> u32;");
    sb_line(b, "extern \"kernel32.dll\" fn GetFileAttributesExW(path: i64, level: i64, info: i64) -> i32;");
    sb_line(b, "extern \"kernel32.dll\" fn DeleteFileW(path: i64) -> i32;");
    sb_line(b, "extern \"kernel32.dll\" fn SetFileInformationByHandle(h: i64, class: i64, info: i64, size: i64) -> i32;");
    sb_line(b, "extern \"kernel32.dll\" fn SetFilePointerEx(h: i64, dist: i64, newpos: i64, how: i64) -> i32;");
    sb_line(b, "extern \"kernel32.dll\" fn QueryPerformanceCounter(out: i64) -> i32;");
    sb_line(b, "extern \"kernel32.dll\" fn QueryPerformanceFrequency(out: i64) -> i32;");
    sb_line(b, "extern \"kernel32.dll\" fn GetSystemTimePreciseAsFileTime(out: i64) -> i64;");
    sb_line(b, "extern \"kernel32.dll\" fn CreatePipe(rd: i64, wr: i64, sec: i64, size: i64) -> i32;");
    sb_line(b, "extern \"kernel32.dll\" fn GetCurrentProcessId() -> u32;");
    sb_line(b, "extern \"kernel32.dll\" fn GetLastError() -> u32;");
    sb_line(b, "extern \"kernel32.dll\" fn CreateProcessW(app: i64, cmd: i64, psec: i64, tsec: i64, inherit: i64, flags: i64, env: i64, dir: i64, si: i64, pi: i64) -> i32;");
    sb_line(b, "extern \"kernel32.dll\" fn WaitForSingleObject(h: i64, ms: i64) -> u32;");
    sb_line(b, "extern \"kernel32.dll\" fn GetExitCodeProcess(h: i64, code: i64) -> i32;");
    sb_line(b, "");
    sb_line(b, "const WS_SCRATCH = 6144;     // 64 bytes of out-parameters in the state page");
    sb_line(b, "const WS_STAT = 6208;        // WIN32_FILE_ATTRIBUTE_DATA (36 bytes)");
    sb_line(b, "");
    sb_line(b, "fn ws(off: i64) -> i64 { return RT_BASE + WS_SCRATCH + off; }");
    sb_line(b, "");
    sb_line(b, "// ------------------------------------------------------------- UTF-16");
    sb_line(b, "");
    sb_line(b, "// A UTF-16 copy (NUL-terminated, heap) of the UTF-8 text `s`.");
    sb_line(b, "fn win_wide(s: i64) -> i64 {");
    sb_line(b, "    let n = rt_strlen(s);");
    sb_line(b, "    let w = rt_malloc(4 * n + 4);");
    sb_line(b, "    let mut i: i64 = 0;");
    sb_line(b, "    let mut o: i64 = 0;");
    sb_line(b, "    while i < n {");
    sb_line(b, "        let b0 = load8(s + i);");
    sb_line(b, "        let mut cp = b0;");
    sb_line(b, "        let mut k: i64 = 1;");
    sb_line(b, "        if b0 >= 240 && i + 3 < n + 1 {");
    sb_line(b, "            cp = ((b0 & 7) << 18) | ((load8(s + i + 1) & 63) << 12) | ((load8(s + i + 2) & 63) << 6) | (load8(s + i + 3) & 63);");
    sb_line(b, "            k = 4;");
    sb_line(b, "        } else if b0 >= 224 {");
    sb_line(b, "            cp = ((b0 & 15) << 12) | ((load8(s + i + 1) & 63) << 6) | (load8(s + i + 2) & 63);");
    sb_line(b, "            k = 3;");
    sb_line(b, "        } else if b0 >= 192 {");
    sb_line(b, "            cp = ((b0 & 31) << 6) | (load8(s + i + 1) & 63);");
    sb_line(b, "            k = 2;");
    sb_line(b, "        }");
    sb_line(b, "        if cp >= 65536 {");
    sb_line(b, "            let v = cp - 65536;");
    sb_line(b, "            win_put16(w + o, 55296 + (v >> 10));");
    sb_line(b, "            win_put16(w + o + 2, 56320 + (v & 1023));");
    sb_line(b, "            o = o + 4;");
    sb_line(b, "        } else {");
    sb_line(b, "            win_put16(w + o, cp);");
    sb_line(b, "            o = o + 2;");
    sb_line(b, "        }");
    sb_line(b, "        i = i + k;");
    sb_line(b, "    }");
    sb_line(b, "    win_put16(w + o, 0);");
    sb_line(b, "    return w;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn win_put16(p: i64, v: i64) -> i64 {");
    sb_line(b, "    store8(p, v & 255);");
    sb_line(b, "    return store8(p + 1, (v >> 8) & 255);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn win_get16(p: i64) -> i64 { return load8(p) | (load8(p + 1) << 8); }");
    sb_line(b, "");
    sb_line(b, "// Append the UTF-8 encoding of `cp` at `out`; returns the bytes written.");
    sb_line(b, "fn win_utf8(out: i64, cp: i64) -> i64 {");
    sb_line(b, "    if cp < 128 {");
    sb_line(b, "        store8(out, cp);");
    sb_line(b, "        return 1;");
    sb_line(b, "    }");
    sb_line(b, "    if cp < 2048 {");
    sb_line(b, "        store8(out, 192 | (cp >> 6));");
    sb_line(b, "        store8(out + 1, 128 | (cp & 63));");
    sb_line(b, "        return 2;");
    sb_line(b, "    }");
    sb_line(b, "    if cp < 65536 {");
    sb_line(b, "        store8(out, 224 | (cp >> 12));");
    sb_line(b, "        store8(out + 1, 128 | ((cp >> 6) & 63));");
    sb_line(b, "        store8(out + 2, 128 | (cp & 63));");
    sb_line(b, "        return 3;");
    sb_line(b, "    }");
    sb_line(b, "    store8(out, 240 | (cp >> 18));");
    sb_line(b, "    store8(out + 1, 128 | ((cp >> 12) & 63));");
    sb_line(b, "    store8(out + 2, 128 | ((cp >> 6) & 63));");
    sb_line(b, "    store8(out + 3, 128 | (cp & 63));");
    sb_line(b, "    return 4;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Code point of the UTF-16 text at `w` (a surrogate pair or one unit).");
    sb_line(b, "fn win_cp(w: i64) -> i64 {");
    sb_line(b, "    let u = win_get16(w);");
    sb_line(b, "    if u >= 55296 && u < 56320 {");
    sb_line(b, "        let v = win_get16(w + 2);");
    sb_line(b, "        if v >= 56320 && v < 57344 {");
    sb_line(b, "            return 65536 + ((u - 55296) << 10) + (v - 56320);");
    sb_line(b, "        }");
    sb_line(b, "    }");
    sb_line(b, "    return u;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Bytes of UTF-16 that code point `cp` took.");
    sb_line(b, "fn win_cplen(cp: i64) -> i64 {");
    sb_line(b, "    if cp >= 65536 {");
    sb_line(b, "        return 4;");
    sb_line(b, "    }");
    sb_line(b, "    return 2;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// A UTF-8 copy (heap) of `n` UTF-16 units at `w`.");
    sb_line(b, "fn win_narrow(w: i64, n: i64) -> i64 {");
    sb_line(b, "    let out = rt_malloc(3 * n + 1);");
    sb_line(b, "    let mut i: i64 = 0;");
    sb_line(b, "    let mut o: i64 = 0;");
    sb_line(b, "    while i < 2 * n {");
    sb_line(b, "        let cp = win_cp(w + i);");
    sb_line(b, "        i = i + win_cplen(cp);");
    sb_line(b, "        o = o + win_utf8(out + o, cp);");
    sb_line(b, "    }");
    sb_line(b, "    store8(out + o, 0);");
    sb_line(b, "    return out;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// ------------------------------------------------------------- process");
    sb_line(b, "");
    sb_line(b, "fn win_space(u: i64) -> bool { return u == 32 || u == 9; }");
    sb_line(b, "");
    sb_line(b, "// The process entry (trackc's Windows `_start` calls it): split");
    sb_line(b, "// GetCommandLineW the way CommandLineToArgvW does, as UTF-8, into an");
    sb_line(b, "// argv array followed by an empty envp, then rt_start.");
    sb_line(b, "fn os_start() -> i64 {");
    sb_line(b, "    let cl = GetCommandLineW();");
    sb_line(b, "    let mut wl: i64 = 0;");
    sb_line(b, "    while win_get16(cl + 2 * wl) != 0 {");
    sb_line(b, "        wl = wl + 1;");
    sb_line(b, "    }");
    sb_line(b, "    let size = 8 * (wl + 4) + 4 * wl + 64;");
    sb_line(b, "    let argv = VirtualAlloc(0, size, 12288, 4);");
    sb_line(b, "    let mut out = argv + 8 * (wl + 4);");
    sb_line(b, "    let mut argc: i64 = 0;");
    sb_line(b, "    let mut i: i64 = 0;");
    sb_line(b, "    while true {");
    sb_line(b, "        while win_space(win_get16(cl + 2 * i)) {");
    sb_line(b, "            i = i + 1;");
    sb_line(b, "        }");
    sb_line(b, "        if win_get16(cl + 2 * i) == 0 {");
    sb_line(b, "            store64(argv + 8 * argc, 0);");
    sb_line(b, "            store64(argv + 8 * argc + 8, 0);");
    sb_line(b, "            return rt_start(argc, argv);");
    sb_line(b, "        }");
    sb_line(b, "        store64(argv + 8 * argc, out);");
    sb_line(b, "        argc = argc + 1;");
    sb_line(b, "        let mut quoted = false;");
    sb_line(b, "        let mut going = true;");
    sb_line(b, "        while going {");
    sb_line(b, "            let u = win_get16(cl + 2 * i);");
    sb_line(b, "            if u == 0 || (!quoted && win_space(u)) {");
    sb_line(b, "                going = false;");
    sb_line(b, "            } else if u == 92 {");
    sb_line(b, "                let mut nb: i64 = 0;");
    sb_line(b, "                while win_get16(cl + 2 * i) == 92 {");
    sb_line(b, "                    nb = nb + 1;");
    sb_line(b, "                    i = i + 1;");
    sb_line(b, "                }");
    sb_line(b, "                if win_get16(cl + 2 * i) == 34 {");
    sb_line(b, "                    let mut h: i64 = 0;");
    sb_line(b, "                    while h < nb / 2 {");
    sb_line(b, "                        store8(out, 92);");
    sb_line(b, "                        out = out + 1;");
    sb_line(b, "                        h = h + 1;");
    sb_line(b, "                    }");
    sb_line(b, "                    if nb % 2 == 1 {");
    sb_line(b, "                        store8(out, 34);");
    sb_line(b, "                        out = out + 1;");
    sb_line(b, "                        i = i + 1;");
    sb_line(b, "                    }");
    sb_line(b, "                } else {");
    sb_line(b, "                    let mut h: i64 = 0;");
    sb_line(b, "                    while h < nb {");
    sb_line(b, "                        store8(out, 92);");
    sb_line(b, "                        out = out + 1;");
    sb_line(b, "                        h = h + 1;");
    sb_line(b, "                    }");
    sb_line(b, "                }");
    sb_line(b, "            } else if u == 34 {");
    sb_line(b, "                if quoted && win_get16(cl + 2 * i + 2) == 34 {");
    sb_line(b, "                    store8(out, 34);");
    sb_line(b, "                    out = out + 1;");
    sb_line(b, "                    i = i + 1;");
    sb_line(b, "                } else {");
    sb_line(b, "                    quoted = !quoted;");
    sb_line(b, "                }");
    sb_line(b, "                i = i + 1;");
    sb_line(b, "            } else {");
    sb_line(b, "                let cp = win_cp(cl + 2 * i);");
    sb_line(b, "                i = i + win_cplen(cp) / 2;");
    sb_line(b, "                out = out + win_utf8(out, cp);");
    sb_line(b, "            }");
    sb_line(b, "        }");
    sb_line(b, "        store8(out, 0);");
    sb_line(b, "        out = out + 1;");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn os_args_count() -> i64 { return rs(RS_ARGC); }");
    sb_line(b, "");
    sb_line(b, "fn os_arg(idx: i64) -> i64 {");
    sb_line(b, "    if idx >= 0 && idx < rs(RS_ARGC) {");
    sb_line(b, "        return rt_dup(load64(rs(RS_ARGV) + 8 * idx));");
    sb_line(b, "    }");
    sb_line(b, "    return rt_dup_n(\"\", 0);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Value of environment variable `key` (heap UTF-8), or 0 when unset.");
    sb_line(b, "fn rt_getenv(key: i64) -> i64 {");
    sb_line(b, "    let wk = win_wide(key);");
    sb_line(b, "    let mut cap: i64 = 256;");
    sb_line(b, "    let mut buf = rt_malloc(2 * cap);");
    sb_line(b, "    let mut n = GetEnvironmentVariableW(wk, buf, cap);");
    sb_line(b, "    if n > cap {");
    sb_line(b, "        cap = n;");
    sb_line(b, "        rt_free(buf);");
    sb_line(b, "        buf = rt_malloc(2 * cap);");
    sb_line(b, "        n = GetEnvironmentVariableW(wk, buf, cap);");
    sb_line(b, "    }");
    sb_line(b, "    rt_free(wk);");
    sb_line(b, "    if n == 0 && GetLastError() == 203 {");
    sb_line(b, "        rt_free(buf);");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    let v = win_narrow(buf, n);");
    sb_line(b, "    rt_free(buf);");
    sb_line(b, "    return v;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn env_get(key: i64) -> i64 {");
    sb_line(b, "    if key == 0 {");
    sb_line(b, "        return rt_dup_n(\"\", 0);");
    sb_line(b, "    }");
    sb_line(b, "    let v = rt_getenv(key);");
    sb_line(b, "    if v == 0 {");
    sb_line(b, "        return rt_dup_n(\"\", 0);");
    sb_line(b, "    }");
    sb_line(b, "    return v;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn env_exists(key: i64) -> i64 {");
    sb_line(b, "    if key != 0 {");
    sb_line(b, "        let v = rt_getenv(key);");
    sb_line(b, "        if v != 0 {");
    sb_line(b, "            rt_free(v);");
    sb_line(b, "            return 1;");
    sb_line(b, "        }");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// system(3) with cmd.exe: `cmd.exe /c cmd`; the exit code, -1 when the");
    sb_line(b, "// process could not start.");
    sb_line(b, "fn sys_exec(cmd: i64) -> i64 {");
    sb_line(b, "    if cmd == 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    rt_flush();");
    sb_line(b, "    let line = str_concat(\"cmd.exe /c \", cmd);");
    sb_line(b, "    let wl = win_wide(line);");
    sb_line(b, "    let si = rt_malloc(104);");
    sb_line(b, "    rt_zero(si, 104);");
    sb_line(b, "    store64(si, 104);");
    sb_line(b, "    let pi = rt_malloc(24);");
    sb_line(b, "    rt_zero(pi, 24);");
    sb_line(b, "    let ok = CreateProcessW(0, wl, 0, 0, 1, 0, 0, 0, si, pi);");
    sb_line(b, "    rt_free(wl);");
    sb_line(b, "    if ok == 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let hp = load64(pi);");
    sb_line(b, "    WaitForSingleObject(hp, 4294967295);");
    sb_line(b, "    store64(ws(0), 0);");
    sb_line(b, "    GetExitCodeProcess(hp, ws(0));");
    sb_line(b, "    CloseHandle(hp);");
    sb_line(b, "    CloseHandle(load64(pi + 8));");
    sb_line(b, "    return load64(ws(0)) & 4294967295;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn process_spawn(cmd: i64) -> i64 { return sys_exec(cmd); }");
    sb_line(b, "");
    sb_line(b, "fn clock_ms() -> i64 {");
    sb_line(b, "    QueryPerformanceFrequency(ws(0));");
    sb_line(b, "    QueryPerformanceCounter(ws(8));");
    sb_line(b, "    let f = load64(ws(0));");
    sb_line(b, "    let t = load64(ws(8));");
    sb_line(b, "    return t / f * 1000 + (t % f) * 1000 / f;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// ---------------------------------------------------------- kernel calls");
    sb_line(b, "");
    sb_line(b, "fn win_handle(fd: i64) -> i64 {");
    sb_line(b, "    if fd >= 0 && fd <= 2 {");
    sb_line(b, "        return GetStdHandle(-10 - fd);");
    sb_line(b, "    }");
    sb_line(b, "    return fd;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// open(2) flags -> CreateFileW; a HANDLE or -2 (ENOENT).");
    sb_line(b, "fn win_open(path: i64, flags: i64) -> i64 {");
    sb_line(b, "    let mode = flags & 3;");
    sb_line(b, "    let mut access: i64 = 2147483648;         // GENERIC_READ");
    sb_line(b, "    if mode == 1 {");
    sb_line(b, "        access = 1073741824;                  // GENERIC_WRITE");
    sb_line(b, "    } else if mode == 2 {");
    sb_line(b, "        access = 3221225472;");
    sb_line(b, "    }");
    sb_line(b, "    let mut disp: i64 = 3;                    // OPEN_EXISTING");
    sb_line(b, "    if (flags & 64) != 0 {");
    sb_line(b, "        disp = 4;                             // OPEN_ALWAYS");
    sb_line(b, "        if (flags & 512) != 0 {");
    sb_line(b, "            disp = 2;                         // CREATE_ALWAYS");
    sb_line(b, "        }");
    sb_line(b, "    } else if (flags & 512) != 0 {");
    sb_line(b, "        disp = 5;                             // TRUNCATE_EXISTING");
    sb_line(b, "    }");
    sb_line(b, "    let wp = win_wide(path);");
    sb_line(b, "    let h = CreateFileW(wp, access, 7, 0, disp, 128, 0);");
    sb_line(b, "    rt_free(wp);");
    sb_line(b, "    if h == -1 || h == 0 {");
    sb_line(b, "        return -2;");
    sb_line(b, "    }");
    sb_line(b, "    if (flags & 1024) != 0 {");
    sb_line(b, "        SetFilePointerEx(h, 0, 0, 2);");
    sb_line(b, "    }");
    sb_line(b, "    return h;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn win_stat(path: i64, st: i64) -> i64 {");
    sb_line(b, "    let wp = win_wide(path);");
    sb_line(b, "    let ok = GetFileAttributesExW(wp, 0, RT_BASE + WS_STAT);");
    sb_line(b, "    rt_free(wp);");
    sb_line(b, "    if ok == 0 {");
    sb_line(b, "        return -2;");
    sb_line(b, "    }");
    sb_line(b, "    let attrs = load64(RT_BASE + WS_STAT) & 4294967295;");
    sb_line(b, "    let hi = load64(RT_BASE + WS_STAT + 28) & 4294967295;");
    sb_line(b, "    let lo = load64(RT_BASE + WS_STAT + 32) & 4294967295;");
    sb_line(b, "    rt_zero(st, 144);");
    sb_line(b, "    if (attrs & 16) != 0 {");
    sb_line(b, "        store64(st + 24, 16877);              // S_IFDIR | 0755");
    sb_line(b, "    } else {");
    sb_line(b, "        store64(st + 24, 33188);              // S_IFREG | 0644");
    sb_line(b, "    }");
    sb_line(b, "    store64(st + 48, (hi << 32) | lo);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// The `syscall6` calls of the portable runtime modules, by Linux number;");
    sb_line(b, "// -38 (ENOSYS) for the ones Windows has no counterpart for here.");
    sb_line(b, "fn os_syscall(nr: i64, a: i64, b: i64, d: i64, e: i64, f: i64) -> i64 {");
    sb_line(b, "    if nr == 0 || nr == 1 {");
    sb_line(b, "        store64(ws(0), 0);");
    sb_line(b, "        let mut ok: i64 = 0;");
    sb_line(b, "        if nr == 0 {");
    sb_line(b, "            ok = ReadFile(win_handle(a), b, d, ws(0), 0);");
    sb_line(b, "        } else {");
    sb_line(b, "            ok = WriteFile(win_handle(a), b, d, ws(0), 0);");
    sb_line(b, "        }");
    sb_line(b, "        if ok == 0 {");
    sb_line(b, "            let why = GetLastError();");
    sb_line(b, "            if nr == 0 && (why == 109 || why == 38) {");
    sb_line(b, "                return 0;                     // broken pipe / end of file");
    sb_line(b, "            }");
    sb_line(b, "            if why == 998 {");
    sb_line(b, "                return -14;                   // EFAULT");
    sb_line(b, "            }");
    sb_line(b, "            return -5;");
    sb_line(b, "        }");
    sb_line(b, "        return load64(ws(0)) & 4294967295;");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 2 {");
    sb_line(b, "        return win_open(a, b);");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 3 {");
    sb_line(b, "        if a > 2 && CloseHandle(a) == 0 {");
    sb_line(b, "            return -9;");
    sb_line(b, "        }");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 4 {");
    sb_line(b, "        return win_stat(a, b);");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 8 {");
    sb_line(b, "        if SetFilePointerEx(win_handle(a), b, ws(0), d) == 0 {");
    sb_line(b, "            return -29;                       // ESPIPE");
    sb_line(b, "        }");
    sb_line(b, "        return load64(ws(0));");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 9 {");
    sb_line(b, "        let p = VirtualAlloc(a, b, 12288, 4);  // MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE");
    sb_line(b, "        if p == 0 {");
    sb_line(b, "            return -12;");
    sb_line(b, "        }");
    sb_line(b, "        return p;");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 11 {");
    sb_line(b, "        VirtualFree(a, 0, 32768);             // MEM_RELEASE");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 25 {");
    sb_line(b, "        let q = VirtualAlloc(0, d, 12288, 4);");
    sb_line(b, "        if q == 0 {");
    sb_line(b, "            return -12;");
    sb_line(b, "        }");
    sb_line(b, "        let mut n = b;");
    sb_line(b, "        if d < n {");
    sb_line(b, "            n = d;");
    sb_line(b, "        }");
    sb_line(b, "        rt_copy(q, a, n);");
    sb_line(b, "        VirtualFree(a, 0, 32768);");
    sb_line(b, "        return q;");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 28 || nr == 91 {");
    sb_line(b, "        return 0;                             // madvise, fchmod");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 22 {");
    sb_line(b, "        if CreatePipe(ws(0), ws(8), 0, 0) == 0 {");
    sb_line(b, "            return -24;");
    sb_line(b, "        }");
    sb_line(b, "        store64(a, (load64(ws(0)) & 4294967295) | (load64(ws(8)) << 32));");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 21 {");
    sb_line(b, "        let wp = win_wide(a);");
    sb_line(b, "        let attrs = GetFileAttributesW(wp);");
    sb_line(b, "        rt_free(wp);");
    sb_line(b, "        if attrs == 4294967295 {");
    sb_line(b, "            return -2;");
    sb_line(b, "        }");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 87 {");
    sb_line(b, "        // POSIX semantics: the name goes now even while handles are open");
    sb_line(b, "        let wp = win_wide(a);");
    sb_line(b, "        let mut ok: i64 = 0;");
    sb_line(b, "        let h = CreateFileW(wp, 65536, 7, 0, 3, 33554432, 0);   // DELETE, OPEN_EXISTING, BACKUP_SEMANTICS");
    sb_line(b, "        if h != -1 && h != 0 {");
    sb_line(b, "            store64(ws(0), 3);                                  // FILE_DISPOSITION_DELETE | POSIX_SEMANTICS");
    sb_line(b, "            ok = SetFileInformationByHandle(h, 21, ws(0), 4);");
    sb_line(b, "            CloseHandle(h);");
    sb_line(b, "        }");
    sb_line(b, "        if ok == 0 {");
    sb_line(b, "            ok = DeleteFileW(wp);");
    sb_line(b, "        }");
    sb_line(b, "        rt_free(wp);");
    sb_line(b, "        if ok == 0 {");
    sb_line(b, "            return -2;");
    sb_line(b, "        }");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 39 {");
    sb_line(b, "        return GetCurrentProcessId();");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 62 {");
    sb_line(b, "        ExitProcess(128 + b);                 // a signal: die with 128 + signo");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 228 {");
    sb_line(b, "        QueryPerformanceFrequency(ws(0));");
    sb_line(b, "        QueryPerformanceCounter(ws(8));");
    sb_line(b, "        let fr = load64(ws(0));");
    sb_line(b, "        let t = load64(ws(8));");
    sb_line(b, "        store64(b, t / fr);");
    sb_line(b, "        store64(b + 8, (t % fr) * 1000000000 / fr);");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 231 || nr == 60 {");
    sb_line(b, "        ExitProcess(a);");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    return -38;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// ------------------------------------------------------------------ files");
    sb_line(b, "//");
    sb_line(b, "// A file handle is a runtime record [HANDLE]; 0 when the open failed.");
    sb_line(b, "");
    sb_line(b, "const O_RDONLY = 0;");
    sb_line(b, "const O_WRONLY_CREAT_TRUNC = 577;");
    sb_line(b, "const O_WRONLY_CREAT_APPEND = 1089;");
    sb_line(b, "const O_RDWR = 2;");
    sb_line(b, "");
    sb_line(b, "fn rt_open_flags(mode: i64) -> i64 {");
    sb_line(b, "    let m = load8(mode);");
    sb_line(b, "    let plus = rt_find(mode, \"+\") >= 0;");
    sb_line(b, "    if m == 114 {");
    sb_line(b, "        if plus {");
    sb_line(b, "            return O_RDWR;");
    sb_line(b, "        }");
    sb_line(b, "        return O_RDONLY;");
    sb_line(b, "    }");
    sb_line(b, "    if m == 119 {");
    sb_line(b, "        if plus {");
    sb_line(b, "            return 578;");
    sb_line(b, "        }");
    sb_line(b, "        return O_WRONLY_CREAT_TRUNC;");
    sb_line(b, "    }");
    sb_line(b, "    if m == 97 {");
    sb_line(b, "        if plus {");
    sb_line(b, "            return 1090;");
    sb_line(b, "        }");
    sb_line(b, "        return O_WRONLY_CREAT_APPEND;");
    sb_line(b, "    }");
    sb_line(b, "    return -1;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn file_open(path: i64, mode: i64) -> i64 {");
    sb_line(b, "    if path == 0 || mode == 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    let flags = rt_open_flags(mode);");
    sb_line(b, "    if flags < 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    let fd = win_open(path, flags);");
    sb_line(b, "    if fd < 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    let h = rt_malloc(8);");
    sb_line(b, "    store64(h, fd);");
    sb_line(b, "    return h;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn file_close(h: i64) -> i64 {");
    sb_line(b, "    if h != 0 {");
    sb_line(b, "        CloseHandle(load64(h));");
    sb_line(b, "        rt_free(h);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Everything from `fd` to end of file; \"\" on error.");
    sb_line(b, "fn rt_read_fd(fd: i64) -> i64 {");
    sb_line(b, "    let mut cap: i64 = 4096;");
    sb_line(b, "    let end = os_syscall(8, fd, 0, 2, 0, 0);");
    sb_line(b, "    if end >= 0 {");
    sb_line(b, "        if os_syscall(8, fd, 0, 0, 0, 0) < 0 {");
    sb_line(b, "            return rt_dup_n(\"\", 0);");
    sb_line(b, "        }");
    sb_line(b, "        cap = end + 1;");
    sb_line(b, "    }");
    sb_line(b, "    let mut buf = rt_malloc(cap + 1);");
    sb_line(b, "    let mut got: i64 = 0;");
    sb_line(b, "    let mut going = true;");
    sb_line(b, "    while going {");
    sb_line(b, "        if got == cap {");
    sb_line(b, "            cap = cap * 2;");
    sb_line(b, "            buf = rt_realloc(buf, cap + 1);");
    sb_line(b, "        }");
    sb_line(b, "        let r = os_syscall(0, fd, buf + got, cap - got, 0, 0);");
    sb_line(b, "        if r <= 0 {");
    sb_line(b, "            going = false;");
    sb_line(b, "        } else {");
    sb_line(b, "            got = got + r;");
    sb_line(b, "        }");
    sb_line(b, "    }");
    sb_line(b, "    store8(buf + got, 0);");
    sb_line(b, "    return buf;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn file_read_all(h: i64) -> i64 {");
    sb_line(b, "    if h == 0 {");
    sb_line(b, "        return rt_dup_n(\"\", 0);");
    sb_line(b, "    }");
    sb_line(b, "    return rt_read_fd(load64(h));");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn file_write(h: i64, content: i64) -> i64 {");
    sb_line(b, "    if h == 0 || content == 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    return rt_write_all(load64(h), content, rt_strlen(content));");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn file_exists(path: i64) -> i64 {");
    sb_line(b, "    if path != 0 && os_syscall(21, path, 0, 0, 0, 0) == 0 {");
    sb_line(b, "        return 1;");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn file_remove(path: i64) -> i64 {");
    sb_line(b, "    if path != 0 && os_syscall(87, path, 0, 0, 0, 0) == 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    return -1;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn file_size(path: i64) -> i64 {");
    sb_line(b, "    let st = RT_BASE + RS_STAT;");
    sb_line(b, "    if path == 0 || win_stat(path, st) != 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    return load64(st + 48);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn dir_exists(path: i64) -> bool {");
    sb_line(b, "    let st = RT_BASE + RS_STAT;");
    sb_line(b, "    if path == 0 || win_stat(path, st) != 0 {");
    sb_line(b, "        return false;");
    sb_line(b, "    }");
    sb_line(b, "    return (load64(st + 24) & 61440) == 16384;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn file_copy(src: i64, dst: i64) -> i64 {");
    sb_line(b, "    if src == 0 || dst == 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let content = track_file_read(src);");
    sb_line(b, "    if file_exists(src) == 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let fd = win_open(dst, O_WRONLY_CREAT_TRUNC);");
    sb_line(b, "    if fd < 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    rt_write_all(fd, content, rt_strlen(content));");
    sb_line(b, "    CloseHandle(fd);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn track_file_read(path: i64) -> i64 {");
    sb_line(b, "    if path == 0 {");
    sb_line(b, "        return rt_dup_n(\"\", 0);");
    sb_line(b, "    }");
    sb_line(b, "    let fd = win_open(path, O_RDONLY);");
    sb_line(b, "    if fd < 0 {");
    sb_line(b, "        return rt_dup_n(\"\", 0);");
    sb_line(b, "    }");
    sb_line(b, "    let out = rt_read_fd(fd);");
    sb_line(b, "    CloseHandle(fd);");
    sb_line(b, "    return out;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn track_file_write_all(path: i64, content: i64) -> i64 {");
    sb_line(b, "    if path == 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let fd = win_open(path, O_WRONLY_CREAT_TRUNC);");
    sb_line(b, "    if fd < 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let mut status: i64 = -1;");
    sb_line(b, "    if content != 0 {");
    sb_line(b, "        status = rt_write_all(fd, content, rt_strlen(content));");
    sb_line(b, "    }");
    sb_line(b, "    if CloseHandle(fd) == 0 {");
    sb_line(b, "        status = -1;");
    sb_line(b, "    }");
    sb_line(b, "    return status;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// ---------------------------------------------------------------- network");
    sb_line(b, "//");
    sb_line(b, "// Not yet on Windows (Winsock): every call fails.");
    sb_line(b, "");
    sb_line(b, "fn net_socket_tcp_listen(port: i64) -> i64 { return -1; }");
    sb_line(b, "fn net_socket_accept(server_fd: i64) -> i64 { return -1; }");
    sb_line(b, "fn net_socket_connect(host: i64, port: i64) -> i64 { return -1; }");
    sb_line(b, "fn net_socket_send(fd: i64, data: i64, len: i64) -> i64 { return -1; }");
    sb_line(b, "fn net_socket_recv(fd: i64, buf: i64, max_len: i64) -> i64 { return -1; }");
    sb_line(b, "fn net_socket_close(fd: i64) -> i64 { return 0; }");
    return 0;
}

fn rt_module_source_6(b: i64) -> i64 {
    sb_line(b, "// rt/os/macos.trk — Track runtime OS layer for macOS, through libSystem.");
    sb_line(b, "//");
    sb_line(b, "// Implements the OS interface (docs/native.md, \"The OS layer\") with");
    sb_line(b, "// libSystem functions called through the import table (`extern`; dyld");
    sb_line(b, "// binds them, macho.trk):");
    sb_line(b, "//");
    sb_line(b, "//   os_start         process entry: LC_MAIN's main(argc, argv, envp, apple)");
    sb_line(b, "//                    hands argc and argv over; then rt_start");
    sb_line(b, "//   os_syscall       the kernel calls the portable modules (mem, io, libc)");
    sb_line(b, "//                    make through `syscall6`, by Linux number, mapped to");
    sb_line(b, "//                    libSystem: open flags, mmap flags, the stat layout,");
    sb_line(b, "//                    clock ids and socket options translated, failures as");
    sb_line(b, "//                    -errno (errno from __error())");
    sb_line(b, "//   os_args_count, os_arg, env_get, env_exists, sys_exec, process_spawn,");
    sb_line(b, "//   clock_ms, file_*, dir_exists, track_file_*, net_socket_*");
    sb_line(b, "//");
    sb_line(b, "// libSystem returns -1 and sets errno; os_syscall returns -errno like the");
    sb_line(b, "// Linux kernel, with macOS errno values (ENOENT, EINTR, EBADF agree).");
    sb_line(b, "");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_read(fd: i64, buf: i64, n: i64) -> i64 as \"read\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_write(fd: i64, buf: i64, n: i64) -> i64 as \"write\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_open(path: i64, flags: i64, mode: i64) -> i32 as \"open\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_close(fd: i64) -> i32 as \"close\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_stat(path: i64, st: i64) -> i32 as \"stat\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_lseek(fd: i64, off: i64, how: i64) -> i64 as \"lseek\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_mmap(addr: i64, len: i64, prot: i64, flags: i64, fd: i64, off: i64) -> i64 as \"mmap\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_munmap(addr: i64, len: i64) -> i32 as \"munmap\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_pipe(fds: i64) -> i32 as \"pipe\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_access(path: i64, mode: i64) -> i32 as \"access\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_getpid() -> i32 as \"getpid\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_kill(pid: i64, sig: i64) -> i32 as \"kill\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_unlink(path: i64) -> i32 as \"unlink\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_clock_gettime(id: i64, ts: i64) -> i32 as \"clock_gettime\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_exit(code: i64) -> i64 as \"exit\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_fchmod(fd: i64, mode: i64) -> i32 as \"fchmod\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_errno_at() -> i64 as \"__error\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_environ_at() -> i64 as \"_NSGetEnviron\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_system(cmd: i64) -> i32 as \"system\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_socket(domain: i64, kind: i64, proto: i64) -> i32 as \"socket\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_setsockopt(fd: i64, level: i64, opt: i64, val: i64, len: i64) -> i32 as \"setsockopt\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_bind(fd: i64, addr: i64, len: i64) -> i32 as \"bind\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_listen(fd: i64, backlog: i64) -> i32 as \"listen\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_accept(fd: i64, addr: i64, len: i64) -> i32 as \"accept\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_connect(fd: i64, addr: i64, len: i64) -> i32 as \"connect\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_send(fd: i64, buf: i64, n: i64, flags: i64) -> i64 as \"send\";");
    sb_line(b, "extern \"libSystem.B.dylib\" fn c_recv(fd: i64, buf: i64, n: i64, flags: i64) -> i64 as \"recv\";");
    sb_line(b, "");
    sb_line(b, "const MS_STAT = 6400;        // macOS struct stat (144 bytes) in the state page");
    sb_line(b, "");
    sb_line(b, "// ---------------------------------------------------------------- process");
    sb_line(b, "");
    sb_line(b, "// The process entry (trackc's macOS entry calls it with LC_MAIN's argc");
    sb_line(b, "// and argv; envp follows argv as on Linux, and rt_getenv reads environ).");
    sb_line(b, "fn os_start(argc: i64, argv: i64) -> i64 {");
    sb_line(b, "    return rt_start(argc, argv);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn os_args_count() -> i64 { return rs(RS_ARGC); }");
    sb_line(b, "");
    sb_line(b, "fn os_arg(idx: i64) -> i64 {");
    sb_line(b, "    if idx >= 0 && idx < rs(RS_ARGC) {");
    sb_line(b, "        return rt_dup(load64(rs(RS_ARGV) + 8 * idx));");
    sb_line(b, "    }");
    sb_line(b, "    return rt_dup_n(\"\", 0);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Value of environment variable `key` (\"NAME=value\"), or 0 when unset.");
    sb_line(b, "fn rt_getenv(key: i64) -> i64 {");
    sb_line(b, "    let mut e = load64(c_environ_at());");
    sb_line(b, "    while load64(e) != 0 {");
    sb_line(b, "        let entry = load64(e);");
    sb_line(b, "        let mut i: i64 = 0;");
    sb_line(b, "        while load8(key + i) != 0 && load8(key + i) == load8(entry + i) {");
    sb_line(b, "            i = i + 1;");
    sb_line(b, "        }");
    sb_line(b, "        if load8(key + i) == 0 && load8(entry + i) == 61 {");
    sb_line(b, "            return entry + i + 1;");
    sb_line(b, "        }");
    sb_line(b, "        e = e + 8;");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn env_get(key: i64) -> i64 {");
    sb_line(b, "    if key == 0 {");
    sb_line(b, "        return rt_dup_n(\"\", 0);");
    sb_line(b, "    }");
    sb_line(b, "    let v = rt_getenv(key);");
    sb_line(b, "    if v == 0 {");
    sb_line(b, "        return rt_dup_n(\"\", 0);");
    sb_line(b, "    }");
    sb_line(b, "    return rt_dup(v);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn env_exists(key: i64) -> i64 {");
    sb_line(b, "    if key != 0 && rt_getenv(key) != 0 {");
    sb_line(b, "        return 1;");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// system(3): /bin/sh -c cmd; exit status, or 128 + signal.");
    sb_line(b, "fn sys_exec(cmd: i64) -> i64 {");
    sb_line(b, "    if cmd == 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    rt_flush();");
    sb_line(b, "    let status = c_system(cmd);");
    sb_line(b, "    if status < 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    if (status & 127) == 0 {");
    sb_line(b, "        return (status >> 8) & 255;");
    sb_line(b, "    }");
    sb_line(b, "    return 128 + (status & 127);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn process_spawn(cmd: i64) -> i64 { return sys_exec(cmd); }");
    sb_line(b, "");
    sb_line(b, "fn clock_ms() -> i64 {");
    sb_line(b, "    let ts = RT_BASE + RS_TIME;");
    sb_line(b, "    c_clock_gettime(6, ts);                   // CLOCK_MONOTONIC");
    sb_line(b, "    return load64(ts) * 1000 + load64(ts + 8) / 1000000;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// ---------------------------------------------------------- kernel calls");
    sb_line(b, "");
    sb_line(b, "// A libSystem result: -errno when it failed (-1).");
    sb_line(b, "fn mac_ret(r: i64) -> i64 {");
    sb_line(b, "    if r == -1 {");
    sb_line(b, "        return 0 - (load64(c_errno_at()) & 4294967295);");
    sb_line(b, "    }");
    sb_line(b, "    return r;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Linux open(2) flags -> macOS.");
    sb_line(b, "fn mac_oflags(f: i64) -> i64 {");
    sb_line(b, "    let mut m = f & 3;");
    sb_line(b, "    if (f & 64) != 0 { m = m | 512; }            // O_CREAT");
    sb_line(b, "    if (f & 128) != 0 { m = m | 2048; }          // O_EXCL");
    sb_line(b, "    if (f & 512) != 0 { m = m | 1024; }          // O_TRUNC");
    sb_line(b, "    if (f & 1024) != 0 { m = m | 8; }            // O_APPEND");
    sb_line(b, "    if (f & 2048) != 0 { m = m | 4; }            // O_NONBLOCK");
    sb_line(b, "    if (f & 65536) != 0 { m = m | 1048576; }     // O_DIRECTORY");
    sb_line(b, "    if (f & 524288) != 0 { m = m | 16777216; }   // O_CLOEXEC");
    sb_line(b, "    return m;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Linux mmap(2) flags -> macOS; MAP_FIXED_NOREPLACE becomes a hint that");
    sb_line(b, "// must be met (os_syscall checks).");
    sb_line(b, "fn mac_mflags(f: i64) -> i64 {");
    sb_line(b, "    let mut m = f & 19;                           // MAP_SHARED | MAP_PRIVATE | MAP_FIXED");
    sb_line(b, "    if (f & 32) != 0 { m = m | 4096; }           // MAP_ANON");
    sb_line(b, "    if (f & 16384) != 0 { m = m | 64; }          // MAP_NORESERVE");
    sb_line(b, "    return m;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// stat(2) into the Linux struct stat layout the portable code reads:");
    sb_line(b, "// st_mode at 24, st_size at 48 (macOS 64-bit-inode stat: 4 and 96).");
    sb_line(b, "fn mac_stat(path: i64, st: i64) -> i64 {");
    sb_line(b, "    let ms = RT_BASE + MS_STAT;");
    sb_line(b, "    let r = mac_ret(c_stat(path, ms));");
    sb_line(b, "    if r < 0 {");
    sb_line(b, "        return r;");
    sb_line(b, "    }");
    sb_line(b, "    rt_zero(st, 144);");
    sb_line(b, "    store64(st + 24, load64(ms + 4) & 65535);");
    sb_line(b, "    store64(st + 48, load64(ms + 96));");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// The `syscall6` calls of the portable runtime modules, by Linux number;");
    sb_line(b, "// -38 (ENOSYS) for the rest.");
    sb_line(b, "fn os_syscall(nr: i64, a: i64, b: i64, d: i64, e: i64, f: i64) -> i64 {");
    sb_line(b, "    if nr == 0 {");
    sb_line(b, "        return mac_ret(c_read(a, b, d));");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 1 {");
    sb_line(b, "        return mac_ret(c_write(a, b, d));");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 2 {");
    sb_line(b, "        return mac_ret(c_open(a, mac_oflags(b), d));");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 3 {");
    sb_line(b, "        return mac_ret(c_close(a));");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 4 {");
    sb_line(b, "        return mac_stat(a, b);");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 8 {");
    sb_line(b, "        return mac_ret(c_lseek(a, b, d));");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 9 {");
    sb_line(b, "        let p = mac_ret(c_mmap(a, b, d, mac_mflags(e), f, 0));");
    sb_line(b, "        if p >= 0 && (e & 1048576) != 0 && p != a {");
    sb_line(b, "            c_munmap(p, b);");
    sb_line(b, "            return -17;                           // EEXIST: the hint was not met");
    sb_line(b, "        }");
    sb_line(b, "        return p;");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 11 {");
    sb_line(b, "        return mac_ret(c_munmap(a, b));");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 25 {");
    sb_line(b, "        // mremap(old, old_len, new_len, MAYMOVE): a new mapping, copied");
    sb_line(b, "        let q = mac_ret(c_mmap(0, d, 3, 4098, -1, 0));");
    sb_line(b, "        if q < 0 {");
    sb_line(b, "            return q;");
    sb_line(b, "        }");
    sb_line(b, "        let mut n = b;");
    sb_line(b, "        if d < n {");
    sb_line(b, "            n = d;");
    sb_line(b, "        }");
    sb_line(b, "        rt_copy(q, a, n);");
    sb_line(b, "        c_munmap(a, b);");
    sb_line(b, "        return q;");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 28 {");
    sb_line(b, "        return 0;                                 // madvise: hints only");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 91 {");
    sb_line(b, "        return mac_ret(c_fchmod(a, b));");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 22 {");
    sb_line(b, "        return mac_ret(c_pipe(a));");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 21 {");
    sb_line(b, "        return mac_ret(c_access(a, b));");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 87 {");
    sb_line(b, "        return mac_ret(c_unlink(a));");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 39 {");
    sb_line(b, "        return c_getpid();");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 62 {");
    sb_line(b, "        return mac_ret(c_kill(a, b));");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 228 {");
    sb_line(b, "        let mut id = a;");
    sb_line(b, "        if id == 1 {");
    sb_line(b, "            id = 6;                               // CLOCK_MONOTONIC");
    sb_line(b, "        }");
    sb_line(b, "        return mac_ret(c_clock_gettime(id, b));");
    sb_line(b, "    }");
    sb_line(b, "    if nr == 231 || nr == 60 {");
    sb_line(b, "        c_exit(a);");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    return -38;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// ------------------------------------------------------------------ files");
    sb_line(b, "//");
    sb_line(b, "// A file handle is a runtime record [fd]; 0 when the open failed.");
    sb_line(b, "");
    sb_line(b, "const O_RDONLY = 0;");
    sb_line(b, "const O_WRONLY_CREAT_TRUNC = 577;    // O_WRONLY | O_CREAT | O_TRUNC");
    sb_line(b, "const O_WRONLY_CREAT_APPEND = 1089;  // O_WRONLY | O_CREAT | O_APPEND");
    sb_line(b, "const O_RDWR = 2;");
    sb_line(b, "");
    sb_line(b, "// open(2) flags for an fopen(3) mode string.");
    sb_line(b, "fn rt_open_flags(mode: i64) -> i64 {");
    sb_line(b, "    let m = load8(mode);");
    sb_line(b, "    let plus = rt_find(mode, \"+\") >= 0;");
    sb_line(b, "    if m == 114 {");
    sb_line(b, "        if plus {");
    sb_line(b, "            return O_RDWR;");
    sb_line(b, "        }");
    sb_line(b, "        return O_RDONLY;");
    sb_line(b, "    }");
    sb_line(b, "    if m == 119 {");
    sb_line(b, "        if plus {");
    sb_line(b, "            return 578;                   // O_RDWR | O_CREAT | O_TRUNC");
    sb_line(b, "        }");
    sb_line(b, "        return O_WRONLY_CREAT_TRUNC;");
    sb_line(b, "    }");
    sb_line(b, "    if m == 97 {");
    sb_line(b, "        if plus {");
    sb_line(b, "            return 1090;                  // O_RDWR | O_CREAT | O_APPEND");
    sb_line(b, "        }");
    sb_line(b, "        return O_WRONLY_CREAT_APPEND;");
    sb_line(b, "    }");
    sb_line(b, "    return -1;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn file_open(path: i64, mode: i64) -> i64 {");
    sb_line(b, "    if path == 0 || mode == 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    let flags = rt_open_flags(mode);");
    sb_line(b, "    if flags < 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    let fd = sys3(SYS_OPEN, path, flags | 524288, 438);  // O_CLOEXEC, 0666");
    sb_line(b, "    if fd < 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    let h = rt_malloc(8);");
    sb_line(b, "    store64(h, fd);");
    sb_line(b, "    return h;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn file_close(h: i64) -> i64 {");
    sb_line(b, "    if h != 0 {");
    sb_line(b, "        sys1(SYS_CLOSE, load64(h));");
    sb_line(b, "        rt_free(h);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Read everything from `fd` to end of file; \"\" on error. The size from");
    sb_line(b, "// lseek only sizes the first buffer: files whose size is not known up");
    sb_line(b, "// front (/proc, pipes) read whole too.");
    sb_line(b, "fn rt_read_fd(fd: i64) -> i64 {");
    sb_line(b, "    let mut cap: i64 = 4096;");
    sb_line(b, "    let end = sys3(SYS_LSEEK, fd, 0, 2);");
    sb_line(b, "    if end >= 0 {");
    sb_line(b, "        if sys3(SYS_LSEEK, fd, 0, 0) < 0 {");
    sb_line(b, "            return rt_dup_n(\"\", 0);");
    sb_line(b, "        }");
    sb_line(b, "        cap = end + 1;");
    sb_line(b, "    }");
    sb_line(b, "    let mut buf = rt_malloc(cap + 1);");
    sb_line(b, "    let mut got: i64 = 0;");
    sb_line(b, "    let mut going = true;");
    sb_line(b, "    while going {");
    sb_line(b, "        if got == cap {");
    sb_line(b, "            cap = cap * 2;");
    sb_line(b, "            buf = rt_realloc(buf, cap + 1);");
    sb_line(b, "        }");
    sb_line(b, "        let r = sys3(SYS_READ, fd, buf + got, cap - got);");
    sb_line(b, "        if r == -4 {");
    sb_line(b, "            // EINTR: retry");
    sb_line(b, "        } else if r <= 0 {");
    sb_line(b, "            going = false;");
    sb_line(b, "        } else {");
    sb_line(b, "            got = got + r;");
    sb_line(b, "        }");
    sb_line(b, "    }");
    sb_line(b, "    store8(buf + got, 0);");
    sb_line(b, "    return buf;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn file_read_all(h: i64) -> i64 {");
    sb_line(b, "    if h == 0 {");
    sb_line(b, "        return rt_dup_n(\"\", 0);");
    sb_line(b, "    }");
    sb_line(b, "    return rt_read_fd(load64(h));");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn file_write(h: i64, content: i64) -> i64 {");
    sb_line(b, "    if h == 0 || content == 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    return rt_write_all(load64(h), content, rt_strlen(content));");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn file_exists(path: i64) -> i64 {");
    sb_line(b, "    if path != 0 && sys2(SYS_ACCESS, path, 0) == 0 {");
    sb_line(b, "        return 1;");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn file_remove(path: i64) -> i64 {");
    sb_line(b, "    if path != 0 && sys1(SYS_UNLINK, path) == 0 {");
    sb_line(b, "        return 0;");
    sb_line(b, "    }");
    sb_line(b, "    return -1;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn file_size(path: i64) -> i64 {");
    sb_line(b, "    let st = RT_BASE + RS_STAT;");
    sb_line(b, "    if path == 0 || sys2(SYS_STAT, path, st) != 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    return load64(st + 48);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn dir_exists(path: i64) -> bool {");
    sb_line(b, "    let st = RT_BASE + RS_STAT;");
    sb_line(b, "    if path == 0 || sys2(SYS_STAT, path, st) != 0 {");
    sb_line(b, "        return false;");
    sb_line(b, "    }");
    sb_line(b, "    return (load64(st + 24) & 61440) == 16384;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn file_copy(src: i64, dst: i64) -> i64 {");
    sb_line(b, "    if src == 0 || dst == 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let fin = sys3(SYS_OPEN, src, O_RDONLY | 524288, 0);");
    sb_line(b, "    if fin < 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let fout = sys3(SYS_OPEN, dst, O_WRONLY_CREAT_TRUNC | 524288, 438);");
    sb_line(b, "    if fout < 0 {");
    sb_line(b, "        sys1(SYS_CLOSE, fin);");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let buf = rt_malloc(65536);");
    sb_line(b, "    let mut going = true;");
    sb_line(b, "    while going {");
    sb_line(b, "        let n = sys3(SYS_READ, fin, buf, 65536);");
    sb_line(b, "        if n == -4 {");
    sb_line(b, "            // EINTR: retry");
    sb_line(b, "        } else if n <= 0 {");
    sb_line(b, "            going = false;");
    sb_line(b, "        } else {");
    sb_line(b, "            rt_write_all(fout, buf, n);");
    sb_line(b, "        }");
    sb_line(b, "    }");
    sb_line(b, "    rt_free(buf);");
    sb_line(b, "    sys1(SYS_CLOSE, fin);");
    sb_line(b, "    sys1(SYS_CLOSE, fout);");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// Whole-file helpers: open, transfer, and close in one call.");
    sb_line(b, "fn track_file_read(path: i64) -> i64 {");
    sb_line(b, "    if path == 0 {");
    sb_line(b, "        return rt_dup_n(\"\", 0);");
    sb_line(b, "    }");
    sb_line(b, "    let fd = sys3(SYS_OPEN, path, O_RDONLY | 524288, 0);");
    sb_line(b, "    if fd < 0 {");
    sb_line(b, "        return rt_dup_n(\"\", 0);");
    sb_line(b, "    }");
    sb_line(b, "    let out = rt_read_fd(fd);");
    sb_line(b, "    sys1(SYS_CLOSE, fd);");
    sb_line(b, "    return out;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn track_file_write_all(path: i64, content: i64) -> i64 {");
    sb_line(b, "    if path == 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let fd = sys3(SYS_OPEN, path, O_WRONLY_CREAT_TRUNC | 524288, 438);");
    sb_line(b, "    if fd < 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let mut status: i64 = -1;");
    sb_line(b, "    if content != 0 {");
    sb_line(b, "        status = rt_write_all(fd, content, rt_strlen(content));");
    sb_line(b, "    }");
    sb_line(b, "    if sys1(SYS_CLOSE, fd) != 0 {");
    sb_line(b, "        status = -1;");
    sb_line(b, "    }");
    sb_line(b, "    return status;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// ---------------------------------------------------------------- network");
    sb_line(b, "");
    sb_line(b, "// struct sockaddr_in for AF_INET (BSD: sin_len first), `port`, and the");
    sb_line(b, "// IPv4 address word `addr` (network byte order packed little-endian).");
    sb_line(b, "fn rt_sockaddr(port: i64, addr: i64) -> i64 {");
    sb_line(b, "    let sa = RT_BASE + RS_SOCK;");
    sb_line(b, "    let p = port & 65535;");
    sb_line(b, "    store64(sa, 16 | (2 << 8) | ((p >> 8) << 16) | ((p & 255) << 24) | ((addr & 4294967295) << 32));");
    sb_line(b, "    store64(sa + 8, 0);");
    sb_line(b, "    return sa;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "// inet_pton for dotted-quad IPv4; -1 when malformed.");
    sb_line(b, "fn rt_parse_ipv4(s: i64) -> i64 {");
    sb_line(b, "    let mut addr: i64 = 0;");
    sb_line(b, "    let mut part: i64 = 0;");
    sb_line(b, "    let mut digits: i64 = 0;");
    sb_line(b, "    let mut parts: i64 = 0;");
    sb_line(b, "    let mut i: i64 = 0;");
    sb_line(b, "    while true {");
    sb_line(b, "        let ch = load8(s + i);");
    sb_line(b, "        if rt_is_digit(ch) {");
    sb_line(b, "            part = part * 10 + ch - 48;");
    sb_line(b, "            digits = digits + 1;");
    sb_line(b, "            if part > 255 || digits > 3 {");
    sb_line(b, "                return -1;");
    sb_line(b, "            }");
    sb_line(b, "        } else if ch == 46 || ch == 0 {");
    sb_line(b, "            if digits == 0 || parts == 4 {");
    sb_line(b, "                return -1;");
    sb_line(b, "            }");
    sb_line(b, "            addr = addr | (part << (8 * parts));");
    sb_line(b, "            parts = parts + 1;");
    sb_line(b, "            part = 0;");
    sb_line(b, "            digits = 0;");
    sb_line(b, "            if ch == 0 {");
    sb_line(b, "                if parts != 4 {");
    sb_line(b, "                    return -1;");
    sb_line(b, "                }");
    sb_line(b, "                return addr;");
    sb_line(b, "            }");
    sb_line(b, "        } else {");
    sb_line(b, "            return -1;");
    sb_line(b, "        }");
    sb_line(b, "        i = i + 1;");
    sb_line(b, "    }");
    sb_line(b, "    return -1;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn net_socket_tcp_listen(port: i64) -> i64 {");
    sb_line(b, "    let fd = c_socket(2, 1, 0);");
    sb_line(b, "    if fd < 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    c_setsockopt(fd, 65535, 4, RT_BASE + RS_ONE, 4);   // SOL_SOCKET, SO_REUSEADDR");
    sb_line(b, "    let r = mac_ret(c_bind(fd, rt_sockaddr(port, 0), 16));");
    sb_line(b, "    if r < 0 {");
    sb_line(b, "        let b = track_sb_new();");
    sb_line(b, "        if r == -48 {");
    sb_line(b, "            track_sb_push(b, \"Track Network Error: Port conflict! Port \");");
    sb_line(b, "            track_sb_push_int(b, port);");
    sb_line(b, "            track_sb_push(b, \" is already in use by another process.\\n\");");
    sb_line(b, "        } else {");
    sb_line(b, "            track_sb_push(b, \"Track Network Error: Failed to bind TCP socket on port \");");
    sb_line(b, "            track_sb_push_int(b, port);");
    sb_line(b, "            track_sb_push(b, \" (errno: \");");
    sb_line(b, "            track_sb_push_int(b, 0 - r);");
    sb_line(b, "            track_sb_push(b, \").\\n\");");
    sb_line(b, "        }");
    sb_line(b, "        rt_err_bytes(load64(b), track_sb_len(b));");
    sb_line(b, "        c_close(fd);");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    if c_listen(fd, 128) < 0 {");
    sb_line(b, "        c_close(fd);");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    return fd;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn net_socket_accept(server_fd: i64) -> i64 {");
    sb_line(b, "    if server_fd < 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let r = c_accept(server_fd, 0, 0);");
    sb_line(b, "    if r < 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    return r;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn net_socket_connect(host: i64, port: i64) -> i64 {");
    sb_line(b, "    if host == 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let fd = c_socket(2, 1, 0);");
    sb_line(b, "    if fd < 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let addr = rt_parse_ipv4(host);");
    sb_line(b, "    if addr < 0 || c_connect(fd, rt_sockaddr(port, addr), 16) < 0 {");
    sb_line(b, "        c_close(fd);");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    return fd;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn net_socket_send(fd: i64, data: i64, len: i64) -> i64 {");
    sb_line(b, "    if fd < 0 || data == 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let r = c_send(fd, data, len, 0);");
    sb_line(b, "    if r < 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    return r;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn net_socket_recv(fd: i64, buf: i64, max_len: i64) -> i64 {");
    sb_line(b, "    if fd < 0 || buf == 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    let r = c_recv(fd, buf, max_len, 0);");
    sb_line(b, "    if r < 0 {");
    sb_line(b, "        return -1;");
    sb_line(b, "    }");
    sb_line(b, "    return r;");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn net_socket_close(fd: i64) -> i64 {");
    sb_line(b, "    if fd >= 0 {");
    sb_line(b, "        c_close(fd);");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    return 0;
}

fn rt_module_source_7(b: i64) -> i64 {
    sb_line(b, "// libc.trk — the few libc entry points trackc's ELF writer (elf.trk)");
    sb_line(b, "// calls by their libc names, so the Rust bootstrap compiler can link them");
    sb_line(b, "// from libc. With the Track runtime (--rt=track, --native) these");
    sb_line(b, "// definitions stand in for libc.");
    sb_line(b, "");
    sb_line(b, "fn open64(path: i64, flags: i64, mode: i64) -> i64 {");
    sb_line(b, "    return syscall6(2, path, flags, mode, 0, 0, 0);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn write(fd: i64, buf: i64, n: i64) -> i64 {");
    sb_line(b, "    return syscall6(1, fd, buf, n, 0, 0, 0);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn fchmod(fd: i64, mode: i64) -> i64 {");
    sb_line(b, "    return syscall6(91, fd, mode, 0, 0, 0, 0);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn close(fd: i64) -> i64 {");
    sb_line(b, "    return syscall6(3, fd, 0, 0, 0, 0, 0);");
    sb_line(b, "}");
    sb_line(b, "");
    sb_line(b, "fn memset(p: i64, v: i64, n: i64) -> i64 {");
    sb_line(b, "    let mut i: i64 = 0;");
    sb_line(b, "    while i < n {");
    sb_line(b, "        store8(p + i, v);");
    sb_line(b, "        i = i + 1;");
    sb_line(b, "    }");
    sb_line(b, "    return 0;");
    sb_line(b, "}");
    return 0;
}

fn rt_module_source(i: i64) -> i64 {
    let b = sb_new();
    if i == 0 { rt_module_source_0(b); }
    if i == 1 { rt_module_source_1(b); }
    if i == 2 { rt_module_source_2(b); }
    if i == 3 { rt_module_source_3(b); }
    if i == 4 { rt_module_source_4(b); }
    if i == 5 { rt_module_source_5(b); }
    if i == 6 { rt_module_source_6(b); }
    if i == 7 { rt_module_source_7(b); }
    return sb_text(b);
}
