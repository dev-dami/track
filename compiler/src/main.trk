// main.trk — trackc, the self-hosted Track compiler.
//
//   trackc build [-g] <file.trk> [-o <exe>]  static x86-64 ELF; -g/--symbols adds .symtab
//                                         (--native is accepted and ignored)
//   trackc run <file.trk> [args...]       build to a temporary file and run
//   trackc check <file.trk>               parse and ownership-check only
//   --deny-warnings (any command, any position) makes warnings exit 1
//   trackc tokens <file.trk>              dump the token stream
//   trackc life <file.trk>                dump inferred lifecycle summaries
//   trackc life --place <file.trk>        dump the placement plan per site
//   trackc --version
//
// Pipeline: loader (lexer + parser for every imported module) → checker →
// lifecycle pass → native x86-64 emitter (ngen, x64) with the Track runtime
// (compiler/rt/, embedded in runtime_trk.trk) → static ELF (elf). No C
// compiler, assembler or linker is involved.

import "base";
import "lexer";
import "ast";
import "parser";
import "loader";
import "symbols";
import "checker";
import "life";
import "ngen";
import "runtime_trk";
import "lsp";

fn trackc_version() -> i64 { return "1.0.0"; }

fn usage() -> i64 {
    err("trackc 1.0.0 — the self-hosted Track compiler\n\n");
    err("USAGE:\n");
    err("    trackc build <file.trk> [-o <exe>]     Compile to a static x86-64 Linux ELF\n");
    err("        -g, --symbols                      ...with a symbol table (nm, perf, gdb)\n");
    err("    trackc run <file.trk> [args...]        Compile and run\n");
    err("    trackc check <file.trk>                Parse and ownership-check only\n");
    err("    trackc tokens <file.trk>               Dump the token stream\n");
    err("    trackc life <file.trk>                 Dump inferred lifecycle summaries\n");
    err("    trackc life --place <file.trk>         Dump the placement plan per allocation site\n");
    err("    trackc lsp                             Language server (JSON-RPC over stdio)\n");
    err("    trackc --version                       Show version info\n");
    err("\nOPTIONS:\n");
    err("    --deny-warnings  exit 1 when any warning is reported\n");
    return 0;
}

// True when `flag` appears among the arguments after the command.
fn has_flag(flag: i64) -> bool {
    let mut i: i64 = 2;
    while i < arg_count() {
        if text_eq(arg_text(i), flag) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Load and check the user program exactly as `trackc check` does, then, when
// `with_rt`, load the Track runtime (compiler/rt/, embedded in
// runtime_trk.trk). The runtime is loaded after checking so its plain-i64
// definitions of str_concat, vec_push... never replace the builtin
// signatures the ownership checker types the user program with.
fn load_checked(path: i64, with_rt: bool) -> i64 {
    let c = cx_new();
    lex_init(c);
    load_program(c, path);
    collect_symbols(c);
    check_program(c);
    life_program(c);
    if !text_eq(arg_text(1), "life") {
        life_fail_pending(c);
    }
    life_warnings(c);
    finish_warnings(c);
    if with_rt {
        let from = vlen(cx(c, CX_ITEMS));
        let node_from = node_count(c);
        let mut m: i64 = 0;
        while m < rt_module_count() {
            load_embedded_module(c, rt_module_name(m), rt_module_source(m));
            m = m + 1;
        }
        isolate_runtime(c, from, node_from);
        collect_symbols_from(c, from);
    }
    return c;
}

// Print the warnings found while checking. They never change the exit
// status unless `--deny-warnings` is given.
fn finish_warnings(c: i64) -> i64 {
    let n = flush_warnings(c);
    if n > 0 && has_flag("--deny-warnings") {
        err(text_cat3("error: ", warning_count_text(n), " denied by --deny-warnings\n"));
        quit(1);
    }
    return n;
}

fn warning_count_text(n: i64) -> i64 {
    if n == 1 {
        return "1 warning";
    }
    return text_cat(text_of_int(n), " warnings");
}

fn front_end(path: i64) -> i64 {
    return load_checked(path, false);
}

// Value following `-o`, or 0.
fn output_flag() -> i64 {
    let mut i: i64 = 2;
    while i < arg_count() - 1 {
        if text_eq(arg_text(i), "-o") {
            return arg_text(i + 1);
        }
        i = i + 1;
    }
    return 0;
}

// Wrap in single quotes for /bin/sh.
fn shell_quote(s: i64) -> i64 {
    let bytes = text_bytes(s);
    let b = sb_new();
    sb_byte(b, 39);
    let mut i: i64 = 0;
    while i < vlen(bytes) {
        if vget(bytes, i) == 39 {
            sb_add(b, "'\\''");
        } else {
            sb_byte(b, vget(bytes, i));
        }
        i = i + 1;
    }
    sb_byte(b, 39);
    return sb_text(b);
}

fn file_stem(path: i64) -> i64 {
    let slash = last_slash(path);
    let mut name = path;
    if slash >= 0 {
        name = str_substr(path, slash + 1, text_len(path) - slash - 1);
    }
    if text_ends(name, ".trk") {
        return str_substr(name, 0, text_len(name) - 4);
    }
    return name;
}

fn make_dir(dir: i64) -> i64 {
    if path_exists(dir) {
        return 0;
    }
    return shell(text_cat3("mkdir -p ", shell_quote(dir), " 2>/dev/null"));
}

// Index of the source file argument: the first after the command that is
// neither an option nor the value of `-o`.
fn file_arg_index() -> i64 {
    let mut i: i64 = 2;
    while i < arg_count() {
        let a = arg_text(i);
        if text_eq(a, "-o") {
            i = i + 2;
        } else if text_starts(a, "--rt=") || text_eq(a, "--native") || text_eq(a, "--deny-warnings") || text_eq(a, "--place") || text_eq(a, "-g") || text_eq(a, "--symbols") {
            i = i + 1;
        } else {
            return i;
        }
    }
    return -1;
}

// Load, check and lower `path` with the Track runtime straight to a static
// x86-64 ELF executable at `exe`; `-g` (or `--symbols`) adds a symbol table
// naming every function.
fn build_native(path: i64, exe: i64) -> i64 {
    let c = load_checked(path, true);
    life_place_program(c); // stack cells (ngen `ng_site_cell`)
    let body = generate_native(c);
    if body == 0 {
        quit(1);
    }
    let mut syms: i64 = 0;
    if has_flag("-g") || has_flag("--symbols") {
        syms = native_symbols(c); // .symtab (docs/native.md)
    }
    let dir = path_dir(exe);
    if text_len(dir) > 0 && make_dir(dir) != 0 {
        err(text_cat3("trackc: cannot create directory '", dir, "'\n"));
        quit(1);
    }
    if elf_write_file(exe, body, native_code_len(c), syms) != 0 {
        err(text_cat3("trackc: cannot write '", exe, "'\n"));
        quit(1);
    }
    return 0;
}

// `trackc build [-g] <file.trk> [-o <exe>]`.
fn cmd_build(path: i64) -> i64 {
    let mut exe = output_flag();
    if exe == 0 {
        exe = file_stem(path);
    }
    build_native(path, exe);
    out(text_cat3("✓ Built: ", exe, "\n"));
    return 0;
}

fn require_file() -> i64 {
    let i = file_arg_index();
    if i < 0 {
        err("Error: expected a .trk file path\n");
        quit(1);
    }
    return arg_text(i);
}

fn cmd_run(path: i64) -> i64 {
    let mut tmp: i64 = "/tmp";
    if env_exists("TMPDIR") != 0 {
        let t: i64 = env_get("TMPDIR");
        if text_len(t) > 0 {
            tmp = t;
        }
    }
    let exe = text_cat3(tmp, "/trackc_run_", text_of_int(clock_ms()));
    build_native(path, exe);
    let cmd = sb_new();
    sb_add(cmd, shell_quote(exe));
    let mut i: i64 = file_arg_index() + 1;
    while i < arg_count() {
        sb_add(cmd, " ");
        sb_add(cmd, shell_quote(arg_text(i)));
        i = i + 1;
    }
    let status = shell(sb_text(cmd));
    file_remove(exe);
    quit(status);
    return 0;
}

fn cmd_tokens(path: i64) -> i64 {
    let c = cx_new();
    lex_init(c);
    let f = add_source(c, path, read_text(path));
    let first = lex_file(c, f);
    let mut t = first;
    let mut going = true;
    while going {
        let kind = tok_kind(c, t);
        let line = sb_new();
        sb_add(line, token_kind_text(kind));
        if kind == TK_INT {
            sb_add(line, " ");
            sb_int(line, tok_value(c, t));
        } else if kind == TK_IDENT {
            sb_add(line, " ");
            sb_add(line, name_text(c, tok_value(c, t)));
        } else if kind == TK_STR {
            sb_add(line, " ");
            sb_add(line, token_text_literal(tok_value(c, t)));
        }
        sb_byte(line, 10);
        out(sb_text(line));
        if kind == TK_EOF {
            going = false;
        }
        t = t + 1;
    }
    return 0;
}

// A string token as `tokens` prints it: TK_S("...") with C-style escapes.
fn token_text_literal(s: i64) -> i64 {
    let bytes = text_bytes(s);
    let b = sb_new();
    sb_add(b, "TK_S(\"");
    let mut i: i64 = 0;
    while i < vlen(bytes) {
        let x = vget(bytes, i);
        if x == 34 {
            sb_add(b, "\\\"");
        } else if x == 92 {
            sb_add(b, "\\\\");
        } else if x == 63 {
            sb_add(b, "\\?");
        } else if x == 10 {
            sb_add(b, "\\n");
        } else if x == 9 {
            sb_add(b, "\\t");
        } else if x >= 32 && x < 127 {
            sb_byte(b, x);
        } else {
            sb_byte(b, 92);
            sb_byte(b, 48 + (x / 64) % 8);
            sb_byte(b, 48 + (x / 8) % 8);
            sb_byte(b, 48 + x % 8);
        }
        i = i + 1;
    }
    sb_add(b, "\")");
    return sb_text(b);
}

fn main() -> i64 {
    if arg_count() < 2 {
        usage();
        return 1;
    }
    let command = arg_text(1);
    if text_eq(command, "--version") || text_eq(command, "-v") || text_eq(command, "version") {
        out(text_cat3("trackc ", trackc_version(), "\n"));
        return 0;
    }
    if text_eq(command, "--help") || text_eq(command, "-h") || text_eq(command, "help") {
        usage();
        return 0;
    }
    if text_eq(command, "build") {
        cmd_build(require_file());
        return 0;
    }
    if text_eq(command, "run") {
        cmd_run(require_file());
        return 0;
    }
    if text_eq(command, "check") {
        let path = require_file();
        let c = front_end(path);
        let n = cx(c, CX_NWARN);
        if n > 0 {
            out(text_cat3("✓ Check passed: ", path, text_cat3(" (", warning_count_text(n), ")\n")));
        } else {
            out(text_cat3("✓ Check passed: ", path, "\n"));
        }
        return 0;
    }
    if text_eq(command, "life") {
        let c = front_end(require_file());
        if has_flag("--place") {
            life_place_program(c);
            out(life_place_dump(c));
            return 0;
        }
        out(life_dump(c));
        return 0;
    }
    if text_eq(command, "lsp") {
        return lsp_main();
    }
    if text_eq(command, "tokens") {
        cmd_tokens(require_file());
        return 0;
    }
    err(text_cat3("Unknown command: '", command, "'\n\n"));
    usage();
    return 1;
}
