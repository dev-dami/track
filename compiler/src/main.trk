// main.trk — trackc, the self-hosted Track compiler.
//
//   trackc build <file.trk> [-o <exe>]    compile to a native executable
//   trackc run <file.trk> [args...]       build to a temporary file and run
//   trackc check <file.trk>               parse and ownership-check only
//   trackc emit-c <file.trk> [-o <file.c>] write the generated C
//   trackc tokens <file.trk>              dump the token stream
//   trackc --version
//
// Pipeline: loader (lexer + parser for every imported module) → checker →
// C emitter → the platform C compiler (`$CC`, default `cc`) with the
// runtime from runtime/track_runtime.c written beside the generated code.

import "base";
import "lexer";
import "ast";
import "parser";
import "loader";
import "symbols";
import "checker";
import "cgen";
import "runtime_c";

fn trackc_version() -> i64 { return "1.0.0"; }

fn usage() -> i64 {
    err("trackc 1.0.0 — the self-hosted Track compiler\n\n");
    err("USAGE:\n");
    err("    trackc build <file.trk> [-o <exe>]     Compile to a native executable\n");
    err("    trackc run <file.trk> [args...]        Compile and run\n");
    err("    trackc check <file.trk>                Parse and ownership-check only\n");
    err("    trackc emit-c <file.trk> [-o <out.c>]  Write the generated C\n");
    err("    trackc tokens <file.trk>               Dump the token stream\n");
    err("    trackc --version                       Show version info\n");
    return 0;
}

fn front_end(path: i64) -> i64 {
    let c = cx_new();
    lex_init(c);
    load_program(c, path);
    collect_symbols(c);
    check_program(c);
    return c;
}

// Value following `-o`, or 0.
fn output_flag() -> i64 {
    let mut i: i64 = 2;
    while i < arg_count() - 1 {
        if text_eq(arg_text(i), "-o") {
            return arg_text(i + 1);
        }
        i = i + 1;
    }
    return 0;
}

// Wrap in single quotes for /bin/sh.
fn shell_quote(s: i64) -> i64 {
    let bytes = text_bytes(s);
    let b = sb_new();
    sb_byte(b, 39);
    let mut i: i64 = 0;
    while i < vlen(bytes) {
        if vget(bytes, i) == 39 {
            sb_add(b, "'\\''");
        } else {
            sb_byte(b, vget(bytes, i));
        }
        i = i + 1;
    }
    sb_byte(b, 39);
    return sb_text(b);
}

fn file_stem(path: i64) -> i64 {
    let slash = last_slash(path);
    let mut name = path;
    if slash >= 0 {
        name = str_substr(path, slash + 1, text_len(path) - slash - 1);
    }
    if text_ends(name, ".trk") {
        return str_substr(name, 0, text_len(name) - 4);
    }
    return name;
}

fn c_compiler() -> i64 {
    if env_exists("CC") != 0 {
        let cc: i64 = env_get("CC");
        if text_len(cc) > 0 {
            return cc;
        }
    }
    return "cc";
}

fn env_or_empty(name: i64) -> i64 {
    if env_exists(name) != 0 {
        return env_get(name);
    }
    return "";
}

// Directory holding compiled runtime objects: $TRACKC_CACHE, else
// $XDG_CACHE_HOME/trackc, else $HOME/.cache/trackc, else /tmp.
fn cache_dir() -> i64 {
    let explicit = env_or_empty("TRACKC_CACHE");
    if text_len(explicit) > 0 {
        return explicit;
    }
    let xdg = env_or_empty("XDG_CACHE_HOME");
    if text_len(xdg) > 0 {
        return text_cat(xdg, "/trackc");
    }
    let home = env_or_empty("HOME");
    if text_len(home) > 0 {
        return text_cat(home, "/.cache/trackc");
    }
    return "/tmp/trackc-cache";
}

fn make_dir(dir: i64) -> i64 {
    if path_exists(dir) {
        return 0;
    }
    return shell(text_cat3("mkdir -p ", shell_quote(dir), " 2>/dev/null"));
}

fn cc_flags(opt: i64) -> i64 {
    return text_cat3("-std=gnu99 ", opt, " -fwrapv -fno-strict-aliasing -fno-builtin -w");
}

// Compile the runtime once per (compiler, flags, source) into the cache and
// return the object path, or "" when the cache is unusable. The object is
// built from a file named after its key, so it never depends on which
// program triggered the build; equal inputs still link to equal executables.
fn runtime_object(runtime_text: i64, cc: i64) -> i64 {
    let mut dir = cache_dir();
    if !text_starts(dir, "/") {
        // The link step runs from another directory.
        dir = text_cat3(env_or_empty("PWD"), "/", dir);
    }
    if make_dir(dir) != 0 {
        return "";
    }
    let h = text_of_int(text_hash(text_cat3(cc, cc_flags("-O2"), runtime_text)));
    let key = text_cat3(h, "-", text_of_int(text_len(runtime_text)));
    let obj = text_cat3(dir, "/rt-", text_cat(key, ".o"));
    if path_exists(obj) {
        return obj;
    }
    let src_name = text_cat3("rt-", key, ".c");
    if write_text(text_cat3(dir, "/", src_name), runtime_text) != 0 {
        return "";
    }
    let tmp = text_cat3("rt-", key, ".o.tmp$$");
    let cmd = sb_new();
    sb_add(cmd, "cd ");
    sb_add(cmd, shell_quote(dir));
    sb_add(cmd, " && ");
    sb_add(cmd, cc);
    sb_add(cmd, " ");
    sb_add(cmd, cc_flags("-O2"));
    sb_add(cmd, " -c -o ");
    sb_add(cmd, tmp);
    sb_add(cmd, " ");
    sb_add(cmd, shell_quote(src_name));
    sb_add(cmd, " && mv ");
    sb_add(cmd, tmp);
    sb_add(cmd, " ");
    sb_add(cmd, shell_quote(text_cat3("rt-", key, ".o")));
    if shell(sb_text(cmd)) != 0 {
        return "";
    }
    return obj;
}

// Write `<exe>.c` and `<exe>.rt.c`, then compile inside the output
// directory so the object files only record the base names; equal inputs
// therefore produce byte-identical executables in any directory. The
// runtime is linked from a cached object (always built at -O2) when one can
// be had. `build` passes -O2; `run` passes -O1 for faster turnaround.
fn compile_c(c_source: i64, exe: i64, opt: i64) -> i64 {
    let rt = sb_new();
    runtime_source(rt);
    let runtime_text = sb_text(rt);
    let mut dir = path_dir(exe);
    if text_len(dir) == 0 {
        dir = ".";
    }
    if make_dir(dir) != 0 {
        err(text_cat3("trackc: cannot create directory '", dir, "'\n"));
        quit(1);
    }
    let program_c = text_cat(exe, ".c");
    let runtime_file = text_cat(exe, ".rt.c");
    if write_text(program_c, c_source) != 0 {
        err(text_cat3("trackc: cannot write '", program_c, "'\n"));
        quit(1);
    }
    if write_text(runtime_file, runtime_text) != 0 {
        err(text_cat3("trackc: cannot write '", runtime_file, "'\n"));
        quit(1);
    }
    let cc = c_compiler();
    let obj = runtime_object(runtime_text, cc);
    let base = file_stem(exe);
    let cmd = sb_new();
    sb_add(cmd, "cd ");
    sb_add(cmd, shell_quote(dir));
    sb_add(cmd, " && ");
    sb_add(cmd, cc);
    sb_add(cmd, " ");
    sb_add(cmd, cc_flags(opt));
    sb_add(cmd, " -o ");
    sb_add(cmd, shell_quote(base));
    sb_add(cmd, " ");
    sb_add(cmd, shell_quote(text_cat(base, ".c")));
    sb_add(cmd, " ");
    if text_len(obj) > 0 {
        sb_add(cmd, shell_quote(obj));
    } else {
        sb_add(cmd, shell_quote(text_cat(base, ".rt.c")));
    }
    let status = shell(sb_text(cmd));
    if status != 0 {
        err(text_cat3("trackc: C compiler failed (exit ", text_of_int(status), ")\n"));
        quit(1);
    }
    return 0;
}

fn require_file() -> i64 {
    if arg_count() < 3 {
        err("Error: expected a .trk file path\n");
        quit(1);
    }
    return arg_text(2);
}

fn cmd_build(path: i64) -> i64 {
    let c = front_end(path);
    let mut exe = output_flag();
    if exe == 0 {
        exe = file_stem(path);
    }
    compile_c(generate_c(c), exe, "-O2");
    out(text_cat3("✓ Built: ", exe, "\n"));
    return 0;
}

fn cmd_emit(path: i64) -> i64 {
    let c = front_end(path);
    let code = generate_c(c);
    let dest = output_flag();
    if dest == 0 {
        out(code);
        return 0;
    }
    if write_text(dest, code) != 0 {
        err(text_cat3("trackc: cannot write '", dest, "'\n"));
        quit(1);
    }
    return 0;
}

fn cmd_run(path: i64) -> i64 {
    let c = front_end(path);
    let mut tmp: i64 = "/tmp";
    if env_exists("TMPDIR") != 0 {
        let t: i64 = env_get("TMPDIR");
        if text_len(t) > 0 {
            tmp = t;
        }
    }
    let exe = text_cat3(tmp, "/trackc_run_", text_of_int(clock_ms()));
    compile_c(generate_c(c), exe, "-O1");
    let cmd = sb_new();
    sb_add(cmd, shell_quote(exe));
    let mut i: i64 = 3;
    while i < arg_count() {
        sb_add(cmd, " ");
        sb_add(cmd, shell_quote(arg_text(i)));
        i = i + 1;
    }
    let status = shell(sb_text(cmd));
    file_remove(exe);
    file_remove(text_cat(exe, ".c"));
    file_remove(text_cat(exe, ".rt.c"));
    quit(status);
    return 0;
}

fn cmd_tokens(path: i64) -> i64 {
    let c = cx_new();
    lex_init(c);
    let f = add_source(c, path, read_text(path));
    let first = lex_file(c, f);
    let mut t = first;
    let mut going = true;
    while going {
        let kind = tok_kind(c, t);
        let line = sb_new();
        sb_add(line, token_kind_text(kind));
        if kind == TK_INT {
            sb_add(line, " ");
            sb_int(line, tok_value(c, t));
        } else if kind == TK_IDENT {
            sb_add(line, " ");
            sb_add(line, name_text(c, tok_value(c, t)));
        } else if kind == TK_STR {
            sb_add(line, " ");
            sb_add(line, c_string(tok_value(c, t)));
        }
        sb_byte(line, 10);
        out(sb_text(line));
        if kind == TK_EOF {
            going = false;
        }
        t = t + 1;
    }
    return 0;
}

fn main() -> i64 {
    if arg_count() < 2 {
        usage();
        return 1;
    }
    let command = arg_text(1);
    if text_eq(command, "--version") || text_eq(command, "-v") || text_eq(command, "version") {
        out(text_cat3("trackc ", trackc_version(), "\n"));
        return 0;
    }
    if text_eq(command, "--help") || text_eq(command, "-h") || text_eq(command, "help") {
        usage();
        return 0;
    }
    if text_eq(command, "build") {
        cmd_build(require_file());
        return 0;
    }
    if text_eq(command, "run") {
        cmd_run(require_file());
        return 0;
    }
    if text_eq(command, "check") {
        let path = require_file();
        front_end(path);
        out(text_cat3("✓ Check passed: ", path, "\n"));
        return 0;
    }
    if text_eq(command, "emit-c") {
        cmd_emit(require_file());
        return 0;
    }
    if text_eq(command, "tokens") {
        cmd_tokens(require_file());
        return 0;
    }
    err(text_cat3("Unknown command: '", command, "'\n\n"));
    usage();
    return 1;
}
