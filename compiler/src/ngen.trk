// ngen.trk — native x86-64 backend: lowers the checked AST straight to
// machine code (x64.trk) and a static ELF executable (elf.trk).
//
// It mirrors cgen.trk construct for construct under the same word ABI.
// The design is deliberately simple: every expression leaves its value in
// rax, operands wait on the machine stack, rcx is the second scratch
// register, and every Track local or temporary is an rbp-relative frame
// slot (slot k lives at [rbp - 8(k+1)]).
//
// Calling convention (internal; every callee is Track code): the caller
// pushes the arguments left to right, `call`s, and pops them; the callee
// finds argument i of n at [rbp + 16 + 8(n-1-i)] and returns in rax.
// No register is preserved across calls.
//
// Runtime functions are ordinary Track functions (compiler/rt). `_start`
// calls rt_start(argc, argv), then main(), then sys_exit(result).

import "base";
import "ast";
import "symbols";
import "x64";
import "elf";

const NG_CODE = 0;     // code bytes
const NG_DATA = 1;     // data bytes (string literals)
const NG_NSLOT = 2;    // frame slots used by the current function
const NG_BOUND = 3;    // scope stack: (name, previous binding) pairs
const NG_STRMAP = 4;   // name id of a literal's text -> data offset (or -1)
const NG_RETVAL = 5;   // current function returns a value
const NG_CALLS = 6;    // call fixups: (rel32 position, function name id)
const NG_STRS = 7;     // data fixups: (rel32 position, data offset)
const NG_MISSING = 8;  // undefined functions that were called
const NG_REG = 9;      // slot -> register (-1: frame memory), second pass
const NG_USE = 10;     // slot -> weighted use count, first pass
const NG_DEPTH = 11;   // loop nesting depth while generating
const NG_NSAVE = 12;   // callee-saved registers saved by this function
const NG_PASS = 13;    // 1: counting pass, 2: final pass
const NG_NPARAM = 14;  // parameters of the current function (slots 0..n-1)
const NG_INLDEPTH = 15; // nesting of inlined calls
const NG_SAVED = 16;   // registers saved in the prologue, in order
const NG_OPV = 17;     // scratch: value of the last classified operand
const NG_INL = 18;     // name id -> 0 unknown, 1 inlinable, 2 not
const NG_COLD = 19;    // out-of-line stubs: (jump list, runtime name id, nargs)
const NG_CBIND = 20;   // constants bound to inlined parameters (NI_CVAR -2 - i)
const NG_BODYOK = 21;  // name id -> 0 unknown, -1 no, else names declared
const NG_EXITS = 22;   // stack of return-jump lists of inlined bodies
const NG_NONE = 23;    // an empty vector
const NG_AB = 24;      // scratch: address base slot
const NG_AI = 25;      // scratch: address index slot (-1)
const NG_AD = 26;      // scratch: address displacement
const NG_ACC = 27;     // accumulator slot of an accumulator-recursive function (-1)
const NG_ACCFN = 28;   // that function
const NG_ACCTOP = 29;  // its loop head
const NG_CLOB = 30;    // the function runs `syscall` sequences that clobber r8/r9
const NG_VOLX = 31;    // the function clobbers volatile registers (calls, syscalls, scratch-heavy prims)
const NG_STACKARGS = 32; // the current function takes its arguments on the stack (> 6 parameters)
const NG_FRAMELESS = 33; // the current function has no rbp frame
const NG_ACCLVL = 34;  // inlining depth (NG_EXITS length) the accumulator loop belongs to
const NG_CURFN = 35;   // the function being generated
const NG_TAIL = 36;    // the call being generated is in tail position
const NG_TAILDONE = 37; // ... and was emitted as a jump
const NG_SLEN = 38;    // slot -> length of the array literal it always holds (-1)
const NG_SMAX = 39;    // slot -> upper bound of its value, known to be >= 0 (-1)
const NG_ASSIGNED = 40; // names assigned anywhere in the function (-1: unknown)
const NG_PIN = 41;     // (slot, register) pairs: slots pinned to a caller-saved register
const NG_ACCBODY = 42; // accumulator loop: code position after its guard (-1)
const NG_ACCRET = 43;  // accumulator loop: guard jumps waiting for the loop's exit code (-1)
const NG_STRLEN = 44;  // (string slot, length slot) pairs hoisted by enclosing store-free loops
const NG_CHOIST = 45;  // (handle slot, data slot, length slot) triples hoisted by enclosing loops
const NG_PUREC = 46;   // ng_pure also accepts collection get/set/len (header-preserving)
const NG_CELLFRAME = 47; // the current function holds a stack cell (keeps its rbp frame)
const NG_NOSTACK = 48; // literals of the current function refused stack cells (0: none)
const NG_SLOTS = 49;

fn ng(c: i64, slot: i64) -> i64 { return vget(cx(c, CX_GEN), slot); }
fn ng_set(c: i64, slot: i64, v: i64) -> i64 { return vset(cx(c, CX_GEN), slot, v); }
fn ncode(c: i64) -> i64 { return ng(c, NG_CODE); }

// ------------------------------------------------------------ frame

fn ng_slot(c: i64) -> i64 {
    let k = ng(c, NG_NSLOT);
    ng_set(c, NG_NSLOT, k + 1);
    return k;
}

// Frame offset of a memory slot: parameters stay where the caller pushed
// them; other slots sit below the callee-saved register save area.
fn ng_disp(c: i64, k: i64) -> i64 {
    let mut np = ng(c, NG_NPARAM);
    if ng(c, NG_STACKARGS) == 0 {
        np = 0;
    }
    if k < np {
        return 16 + 8 * (np - 1 - k);
    }
    return 0 - 8 * (k - np + 1 + ng(c, NG_NSAVE));
}

// Register holding slot k (-1: memory); counts the use in the first pass.
fn ng_reg(c: i64, k: i64) -> i64 {
    if ng(c, NG_PASS) == 1 {
        let uses = ng(c, NG_USE);
        if vlen(uses) <= k {
            vfill(uses, k + 1 - vlen(uses), 0);
        }
        let mut d = ng(c, NG_DEPTH);
        if d > 6 {
            d = 6;
        }
        vset(uses, k, vget(uses, k) + (1 << (3 * d)));
        return -1;
    }
    let regs = ng(c, NG_REG);
    if k < vlen(regs) {
        return vget(regs, k);
    }
    return -1;
}

fn ng_load_to(c: i64, k: i64, r: i64) -> i64 {
    let s = ng_reg(c, k);
    if s >= 0 {
        return x_mov_rr(ncode(c), r, s);
    }
    return x_rm(ncode(c), 139, r, 5, ng_disp(c, k));
}

fn ng_store_from(c: i64, k: i64, r: i64) -> i64 {
    let s = ng_reg(c, k);
    if s >= 0 {
        return x_mov_rr(ncode(c), s, r);
    }
    return x_rm(ncode(c), 137, r, 5, ng_disp(c, k));
}

fn ng_load(c: i64, k: i64) -> i64 { return ng_load_to(c, k, 0); }
fn ng_store(c: i64, k: i64) -> i64 { return ng_store_from(c, k, 0); }

// slot k = value of `n`, computed in k's register when that register is
// not an operand of `n` (rax is not left holding the value).
fn ng_gen_into(c: i64, n: i64, k: i64) -> i64 {
    let r = ng_reg(c, k);
    let kind = nk(c, n);
    if r >= 0 && kind == K_BIN {
        let op = na(c, n);
        let l = nb(c, n);
        let rr = nc(c, n);
        let lk = ng_opnd(c, l);
        let lv = ng(c, NG_OPV);
        let rk = ng_opnd(c, rr);
        let rv = ng(c, NG_OPV);
        let okop = op == OP_ADD || op == OP_SUB || op == OP_BAND || op == OP_BOR || op == OP_MUL || op == OP_SHL || op == OP_SHR;
        if lk > 0 && rk > 0 && okop && ng_op_direct(op, rk, rv) && !(rk == 2 && rv == k) {
            ng_opnd_to(c, lk, lv, r);
            return ng_op_apply(c, op, r, rk, rv);
        }
    }
    if r >= 0 {
        let vk = ng_opnd(c, n);
        let vv = ng(c, NG_OPV);
        if vk > 0 {
            return ng_opnd_to(c, vk, vv, r);
        }
    }
    ng_gen(c, n);
    return ng_store(c, k);
}

// Store rax in a fresh temporary slot.
fn ng_temp(c: i64) -> i64 {
    let k = ng_slot(c);
    ng_store(c, k);
    return k;
}

fn ng_bind(c: i64, name: i64, k: i64) -> i64 {
    let bound = ng(c, NG_BOUND);
    vpush(bound, name);
    vpush(bound, ni(c, name, NI_CVAR));
    return ni_set(c, name, NI_CVAR, k);
}

fn ng_new_local(c: i64, name: i64) -> i64 {
    let k = ng_slot(c);
    ng_bind(c, name, k);
    return k;
}

fn ng_scope_begin(c: i64) -> i64 { return vlen(ng(c, NG_BOUND)); }

fn ng_scope_end(c: i64, mark: i64) -> i64 {
    let bound = ng(c, NG_BOUND);
    while vlen(bound) > mark {
        let prev = vpop(bound);
        let name = vpop(bound);
        ni_set(c, name, NI_CVAR, prev);
    }
    return 0;
}

// ------------------------------------------------------------ calls

// Argument registers of the internal convention for functions of at most
// six parameters: rdi, rsi, r10, r11, rdx, rcx (the first four are never
// expression scratch, so a leaf function keeps them as its locals).
fn ng_arg_reg(i: i64) -> i64 {
    if i == 0 { return 7; }
    if i == 1 { return 6; }
    if i == 2 { return 10; }
    if i == 3 { return 11; }
    if i == 4 { return 2; }
    return 1;
}

// Call function `name` (id) with `nargs` words already pushed.
fn ng_call_id(c: i64, name: i64, nargs: i64) -> i64 {
    if nargs <= 6 {
        let mut i: i64 = nargs - 1;
        while i >= 0 {
            x_pop_r(ncode(c), ng_arg_reg(i));
            i = i - 1;
        }
        return ng_call_regs(c, name, nargs);
    }
    // more than six: the callee pops its pushed arguments (ret imm16)
    return ng_call_regs(c, name, nargs);
}

// The call itself: arguments already in registers (or pushed, > 6).
fn ng_call_regs(c: i64, name: i64, nargs: i64) -> i64 {
    ng_set(c, NG_VOLX, 1);
    let pos = x_call(ncode(c));
    let fix = ng(c, NG_CALLS);
    vpush(fix, pos);
    return vpush(fix, name);
}

// Call a runtime function by name text with `nargs` words pushed.
fn ng_call_rt(c: i64, text: i64, nargs: i64) -> i64 {
    return ng_call_id(c, intern(c, text), nargs);
}

fn ng_push_imm(c: i64, v: i64) -> i64 {
    x_mov_rax_imm(ncode(c), v);
    return x_push_rax(ncode(c));
}

// Heap cell from `count` words pushed in order; leaves the cell in rax.
fn ng_cell(c: i64, count: i64) -> i64 {
    let b = ncode(c);
    let mut size = count;
    if size < 1 {
        size = 1;
    }
    ng_alloc_const(c, size * 8);
    x_mov_rcx_rax(b);
    let mut i: i64 = count - 1;
    while i >= 0 {
        x_pop_rax(b);
        x_store_at_rcx(b, i * 8);
        i = i - 1;
    }
    return x_bytes3(b, 72, 137, 200); // mov rax, rcx
}

// ------------------------------------------------------------ stack cells

// True when literal `n` gets frame slots instead of a heap cell: the
// placement plan (life.trk, `life_place_of`) says stack, and no `return`
// of the function hands its local to a call (`ng_bar_walk`).
fn ng_stack_site(c: i64, n: i64) -> bool {
    if life_place_of(c, n) != PL_STACK {
        return false;
    }
    let bars = ng(c, NG_NOSTACK);
    return bars == 0 || !ng_vhas(bars, n);
}

// `words` contiguous frame slots for one stack cell, reused on every
// execution of the site (the plan ends the cell before the site runs
// again). Returns the base slot: word i sits at ng_disp(base) + 8i. The
// slots are never in registers (they have no counted uses), and a function
// with a stack cell keeps its rbp frame (NG_CELLFRAME).
fn ng_cell_slots(c: i64, words: i64) -> i64 {
    let mut w = words;
    if w < 1 {
        w = 1;
    }
    let first = ng(c, NG_NSLOT);
    ng_set(c, NG_NSLOT, first + w);
    ng_set(c, NG_CELLFRAME, 1);
    return first + w - 1;
}

// The cell of site `n` from `count` words pushed in order: frame slots when
// `ng_stack_site`, else a heap cell. Leaves the cell address in rax.
fn ng_site_cell(c: i64, n: i64, count: i64) -> i64 {
    if !ng_stack_site(c, n) {
        return ng_cell(c, count);
    }
    let b = ncode(c);
    let base = ng_cell_slots(c, count);
    let d = ng_disp(c, base);
    if count < 1 {
        x_mov_mi(b, 5, d, 0);
    }
    let mut i: i64 = count - 1;
    while i >= 0 {
        x_pop_rax(b);
        x_rm(b, 137, 0, 5, d + 8 * i);
        i = i - 1;
    }
    return x_rm(b, 141, 0, 5, d); // lea rax, [rbp + d]
}

// Stack-cell refusals for the function being generated. A tail call tears
// the frame down before the callee runs, and an accumulator loop reruns
// the body over the same slots, so a local handed to any call inside a
// `return` value (`return f(&p)`, `return x + f(p)`) must not be a frame
// cell. Mode 0 collects those names into `names`; mode 1 records in
// `sites` the literal of every `let`/assignment that binds one of them.
fn ng_bar_walk(c: i64, n: i64, names: i64, sites: i64, mode: i64, in_ret: bool) -> i64 {
    if n < 0 {
        return 0;
    }
    let k = nk(c, n);
    if k == K_RETURN { return ng_bar_walk(c, na(c, n), names, sites, mode, true); }
    if k == K_CALL || k == K_MACROCALL {
        let args = nb(c, n);
        let mut i: i64 = 0;
        while i < list_len(c, args) {
            let a = list_at(c, args, i);
            if mode == 0 && in_ret {
                if nk(c, a) == K_VAR {
                    vpush(names, na(c, a));
                } else if nk(c, a) == K_ADDR && nk(c, na(c, a)) == K_VAR {
                    vpush(names, na(c, na(c, a)));
                }
            }
            ng_bar_walk(c, a, names, sites, mode, in_ret);
            i = i + 1;
        }
        return 0;
    }
    if k == K_LET {
        if mode == 1 && ng_vhas(names, na(c, n)) {
            vpush(sites, nd(c, n));
        }
        return ng_bar_walk(c, nd(c, n), names, sites, mode, in_ret);
    }
    if k == K_ASSIGN {
        let t = na(c, n);
        if mode == 1 && nk(c, t) == K_VAR && ng_vhas(names, na(c, t)) {
            vpush(sites, nb(c, n));
        }
        ng_bar_walk(c, t, names, sites, mode, in_ret);
        return ng_bar_walk(c, nb(c, n), names, sites, mode, in_ret);
    }
    if k == K_BIN { ng_bar_walk(c, nb(c, n), names, sites, mode, in_ret); return ng_bar_walk(c, nc(c, n), names, sites, mode, in_ret); }
    if k == K_UN { return ng_bar_walk(c, nb(c, n), names, sites, mode, in_ret); }
    if k == K_ADDR || k == K_TINDEX || k == K_FIELD { return ng_bar_walk(c, na(c, n), names, sites, mode, in_ret); }
    if k == K_TUPLE || k == K_ARRAY { return ng_bar_list(c, na(c, n), names, sites, mode, in_ret, 0, 1); }
    if k == K_SINIT { return ng_bar_list(c, nb(c, n), names, sites, mode, in_ret, 1, 2); }
    if k == K_INDEX || k == K_RANGE { ng_bar_walk(c, na(c, n), names, sites, mode, in_ret); return ng_bar_walk(c, nb(c, n), names, sites, mode, in_ret); }
    if k == K_SLICE {
        ng_bar_walk(c, na(c, n), names, sites, mode, in_ret);
        ng_bar_walk(c, nb(c, n), names, sites, mode, in_ret);
        return ng_bar_walk(c, nc(c, n), names, sites, mode, in_ret);
    }
    if k == K_IF {
        ng_bar_walk(c, na(c, n), names, sites, mode, in_ret);
        ng_bar_list(c, nb(c, n), names, sites, mode, in_ret, 0, 1);
        return ng_bar_list(c, nc(c, n), names, sites, mode, in_ret, 0, 1);
    }
    if k == K_WHILE {
        ng_bar_walk(c, na(c, n), names, sites, mode, in_ret);
        return ng_bar_list(c, nb(c, n), names, sites, mode, in_ret, 0, 1);
    }
    if k == K_FOR {
        ng_bar_walk(c, nb(c, n), names, sites, mode, in_ret);
        return ng_bar_list(c, nc(c, n), names, sites, mode, in_ret, 0, 1);
    }
    if k == K_LETD { return ng_bar_walk(c, nc(c, n), names, sites, mode, in_ret); }
    if k == K_LENS { return ng_bar_list(c, nc(c, n), names, sites, mode, in_ret, 0, 1); }
    if k == K_MATCH {
        ng_bar_walk(c, na(c, n), names, sites, mode, in_ret);
        let arms = nb(c, n);
        let mut i: i64 = 0;
        while i < list_len(c, arms) {
            ng_bar_walk(c, list_at(c, arms, i + 1), names, sites, mode, in_ret);
            ng_bar_walk(c, list_at(c, arms, i + 2), names, sites, mode, in_ret);
            i = i + 3;
        }
    }
    return 0;
}

fn ng_bar_list(c: i64, l: i64, names: i64, sites: i64, mode: i64, in_ret: bool, from: i64, step: i64) -> i64 {
    let mut i = from;
    while i < list_len(c, l) {
        ng_bar_walk(c, list_at(c, l, i), names, sites, mode, in_ret);
        i = i + step;
    }
    return 0;
}

// The literals of function body `body` (and `prelude`, or -1) that must
// not be stack cells (`ng_bar_walk`), or 0 when there are none.
fn ng_stack_bars(c: i64, body: i64, prelude: i64) -> i64 {
    let names = vnew();
    let sites = vnew();
    let mut mode: i64 = 0;
    while mode < 2 {
        ng_bar_list(c, body, names, sites, mode, false, 0, 1);
        if prelude >= 0 {
            let mut p: i64 = 0;
            while p < vlen(prelude) {
                ng_bar_walk(c, vget(prelude, p), names, sites, mode, false);
                p = p + 1;
            }
        }
        if vlen(names) == 0 {
            return 0;
        }
        mode = mode + 1;
    }
    if vlen(sites) == 0 {
        return 0;
    }
    return sites;
}

// Value of runtime constant `text`, or -1 when it is not a known constant.
fn ng_rt_const(c: i64, text: i64) -> i64 {
    let id = intern(c, text);
    if ni(c, id, NI_CONSTOK) == 1 {
        return ni(c, id, NI_CONSTVAL);
    }
    return -1;
}

// rax = alloc(size) for a constant size: the bump-allocator fast path of
// compiler/rt/mem.trk inline (fresh arena memory is already zero), the
// runtime call when the limit, the arena end or a free block intervene.
fn ng_alloc_const(c: i64, size: i64) -> i64 {
    let b = ncode(c);
    let base = ng_rt_const(c, "RT_BASE");
    let used = ng_rt_const(c, "RS_USED");
    let limit = ng_rt_const(c, "RS_LIMIT");
    let heap = ng_rt_const(c, "RS_HEAP");
    let hend = ng_rt_const(c, "RS_HEAP_END");
    let free = ng_rt_const(c, "RS_FREE");
    if base < 0 || used < 0 || limit < 0 || heap < 0 || hend < 0 || free < 0 || size > 65536 {
        ng_push_imm(c, size);
        return ng_call_rt(c, "alloc", 1);
    }
    let mut k: i64 = 5;
    while (1 << k) < size + 8 {
        k = k + 1;
    }
    let slow = vnew();
    x_mov_ri(b, 6, base);
    x_rm(b, 139, 0, 6, used);
    x_ri(b, 0, 0, size);
    x_rm(b, 59, 0, 6, limit);
    vpush(slow, x_jcc(b, 15));          // jg: over the limit
    x_rm(b, 139, 2, 6, free + 8 * k);
    x_rr(b, 133, 2, 2);
    vpush(slow, x_jcc(b, 5));           // a free block: let rt reuse it
    x_rm(b, 139, 0, 6, heap);
    x_test_rax(b);
    vpush(slow, x_jcc(b, 4));
    x_rm(b, 141, 1, 0, 1 << k);         // lea rcx, [rax + block]
    x_rm(b, 59, 1, 6, hend);
    vpush(slow, x_jcc(b, 15));          // jg: arena exhausted
    x_rm(b, 137, 1, 6, heap);
    x_mov_mi(b, 0, 0, (size << 8) | k); // header
    x_ri(b, 0, 0, 8);
    x_mi(b, 0, 6, used, size);
    let done = x_jmp(b);
    ng_patch_all(c, slow);
    ng_push_imm(c, size);
    ng_call_rt(c, "alloc", 1);
    return x_patch_here(b, done);
}

// String literal: identical literals share one copy in the data, so
// `"abc" == "abc"` holds as with the C backend's literal merging.
fn ng_string(c: i64, s: i64) -> i64 {
    let data = ng(c, NG_DATA);
    let id = intern(c, s);
    let map = ng(c, NG_STRMAP);
    if vlen(map) <= id {
        vfill(map, id + 1 - vlen(map), -1);
    }
    let mut off = vget(map, id);
    if off < 0 {
        off = vlen(data);
        vset(map, id, off);
        let bytes = text_bytes(s);
        let mut i: i64 = 0;
        while i < vlen(bytes) {
            vpush(data, vget(bytes, i));
            i = i + 1;
        }
        vpush(data, 0);
    }
    let pos = x_lea_rip(ncode(c));
    let fix = ng(c, NG_STRS);
    vpush(fix, pos);
    vpush(fix, off);
    return 0;
}

// ------------------------------------------------------------ expressions



// ------------------------------------------------------------ facts

// Names assigned in statement list `l` go on `out`; false when the list
// holds a construct this scan does not follow.
fn ng_scan_assigns(c: i64, l: i64, out: i64) -> bool {
    let mut i: i64 = 0;
    while i < list_len(c, l) {
        if !ng_scan_node(c, list_at(c, l, i), out) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn ng_scan_node(c: i64, n: i64, out: i64) -> bool {
    if n < 0 {
        return true;
    }
    let k = nk(c, n);
    if k == K_MATCH || k == K_LETD {
        return false;
    }
    if k == K_ASSIGN {
        if nk(c, na(c, n)) == K_VAR {
            vpush(out, na(c, na(c, n)));
        }
        return ng_scan_node(c, nb(c, n), out);
    }
    if k == K_IF {
        return ng_scan_assigns(c, nb(c, n), out) && ng_scan_assigns(c, nc(c, n), out);
    }
    if k == K_WHILE {
        return ng_scan_assigns(c, nb(c, n), out);
    }
    if k == K_FOR {
        return ng_scan_assigns(c, nc(c, n), out);
    }
    if k == K_LET {
        return ng_scan_node(c, nd(c, n), out);
    }
    if k == K_RETURN {
        return ng_scan_node(c, na(c, n), out);
    }
    return true;
}

fn ng_scan_assigns_vec(c: i64, v: i64, out: i64) -> bool {
    let mut i: i64 = 0;
    while i < vlen(v) {
        if !ng_scan_node(c, vget(v, i), out) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn ng_name_assigned(c: i64, name: i64) -> bool {
    let set = ng(c, NG_ASSIGNED);
    if set < 0 {
        return true;
    }
    let mut i: i64 = 0;
    while i < vlen(set) {
        if vget(set, i) == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn ng_fact(c: i64, which: i64, k: i64) -> i64 {
    let v = ng(c, which);
    if k >= 0 && k < vlen(v) {
        return vget(v, k);
    }
    return -1;
}

fn ng_fact_set(c: i64, which: i64, k: i64, val: i64) -> i64 {
    let v = ng(c, which);
    if vlen(v) <= k {
        vfill(v, k + 1 - vlen(v), -1);
    }
    return vset(v, k, val);
}

// Upper bound of `n` when it is known to lie in [0, bound], else -1.
fn ng_range(c: i64, n: i64) -> i64 {
    let k = nk(c, n);
    if k == K_INT {
        if na(c, n) >= 0 {
            return na(c, n);
        }
        return -1;
    }
    if k == K_VAR {
        let local = ni(c, na(c, n), NI_CVAR);
        if local >= 0 {
            return ng_fact(c, NG_SMAX, local);
        }
        if local <= -2 {
            let cv = vget(ng(c, NG_CBIND), -2 - local);
            if cv >= 0 {
                return cv;
            }
        }
        return -1;
    }
    if k == K_BIN && na(c, n) == OP_BAND {
        let a = ng_range(c, nb(c, n));
        let d = ng_range(c, nc(c, n));
        if a < 0 {
            return d;
        }
        if d < 0 || a < d {
            return a;
        }
        return d;
    }
    return -1;
}

// Record what `let` node `n`, bound to slot `slot`, guarantees.
fn ng_let_facts(c: i64, n: i64, slot: i64) -> i64 {
    let value = nd(c, n);
    if nk(c, value) == K_ARRAY && ng(c, NG_INLDEPTH) == 0 && !ng_name_assigned(c, na(c, n)) {
        ng_fact_set(c, NG_SLEN, slot, list_len(c, na(c, value)));
    }
    if nb(c, n) == 0 {
        let r = ng_range(c, value);
        if r >= 0 {
            ng_fact_set(c, NG_SMAX, slot, r);
        }
    }
    return 0;
}

// Slot of array local `a` when index `i` is provably in bounds, else -1.
fn ng_safe_index(c: i64, a: i64, i: i64) -> i64 {
    if nk(c, a) != K_VAR {
        return -1;
    }
    let slot = ni(c, na(c, a), NI_CVAR);
    if slot < 0 {
        return -1;
    }
    let len = ng_fact(c, NG_SLEN, slot);
    if len < 0 {
        return -1;
    }
    let r = ng_range(c, i);
    if r < 0 || r >= len {
        return -1;
    }
    return slot;
}

// rax = a[i] or [a + i*8 + 8] = rdx for a provably in-bounds index:
// operands straight from their registers when they have them.
fn ng_index_direct(c: i64, a: i64, i: i64, store: bool) -> i64 {
    let b = ncode(c);
    let ak = ng_opnd(c, a);
    let av = ng(c, NG_OPV);
    let ik = ng_opnd(c, i);
    let iv = ng(c, NG_OPV);
    let mut ra: i64 = -1;
    if ak == 2 {
        ra = ng_reg(c, av);
    }
    let mut ri: i64 = -1;
    if ik == 2 {
        ri = ng_reg(c, iv);
    }
    if ra < 0 || ri < 0 {
        if store {
            x_push_r(b, 2);
        }
        ng_gen2(c, a, i);
        if store {
            x_pop_r(b, 2);
        }
        ra = 0;
        ri = 1;
    }
    if store {
        return x_rmx(b, 0, 137, 2, ra, ri, 3, 8);
    }
    return x_rmx(b, 0, 139, 0, ra, ri, 3, 8);
}

// ------------------------------------------------------------ inlining

// Nodes in expression `n` if it is made only of inlinable expression kinds,
// else a number over any budget.
fn ng_expr_size(c: i64, n: i64) -> i64 {
    let k = nk(c, n);
    if k == K_INT || k == K_BOOL || k == K_VAR || k == K_STR {
        return 1;
    }
    if k == K_BIN {
        return 1 + ng_expr_size(c, nb(c, n)) + ng_expr_size(c, nc(c, n));
    }
    if k == K_UN {
        return 1 + ng_expr_size(c, nb(c, n));
    }
    if k == K_FIELD || k == K_TINDEX || k == K_ADDR {
        return 1 + ng_expr_size(c, na(c, n));
    }
    if k == K_INDEX {
        return 1 + ng_expr_size(c, na(c, n)) + ng_expr_size(c, nb(c, n));
    }
    if k == K_CALL {
        let args = nb(c, n);
        let mut total: i64 = 2;
        let mut i: i64 = 0;
        while i < list_len(c, args) {
            total = total + ng_expr_size(c, list_at(c, args, i));
            i = i + 1;
        }
        return total;
    }
    return 1000;
}

// Every variable in `n` is a parameter of `f` or unbound at this site, so
// the callee's names cannot be captured by the caller's locals.
fn ng_free_ok(c: i64, n: i64, f: i64) -> bool {
    let k = nk(c, n);
    if k == K_VAR {
        let name = na(c, n);
        if ni(c, name, NI_CVAR) == -1 {
            return true;
        }
        let params = nc(c, f);
        let mut i: i64 = 0;
        while i < list_len(c, params) {
            if list_at(c, params, i) == name {
                return true;
            }
            i = i + 2;
        }
        return false;
    }
    if k == K_BIN {
        return ng_free_ok(c, nb(c, n), f) && ng_free_ok(c, nc(c, n), f);
    }
    if k == K_UN {
        return ng_free_ok(c, nb(c, n), f);
    }
    if k == K_FIELD || k == K_TINDEX || k == K_ADDR {
        return ng_free_ok(c, na(c, n), f);
    }
    if k == K_INDEX {
        return ng_free_ok(c, na(c, n), f) && ng_free_ok(c, nb(c, n), f);
    }
    if k == K_CALL {
        let args = nb(c, n);
        let mut i: i64 = 0;
        while i < list_len(c, args) {
            if !ng_free_ok(c, list_at(c, args, i), f) {
                return false;
            }
            i = i + 1;
        }
    }
    return true;
}

// The returned expression of a function whose body is `return e;` with a
// small pure expression e and a value result, else -1.
fn ng_inline_body(c: i64, f: i64) -> i64 {
    if nk(c, f) != K_FN {
        return -1;
    }
    let name = na(c, f);
    let map = ng(c, NG_INL);
    if vlen(map) <= name {
        vfill(map, name + 1 - vlen(map), 0);
    }
    let known = vget(map, name);
    if known == 2 {
        return -1;
    }
    let body = ne(c, f);
    if known == 0 {
        let mut ok = list_len(c, body) == 1;
        let ret = nd(c, f);
        if ret < 0 || is_prim(c, ret, PRIM_VOID) || text_eq(name_text(c, name), "main") {
            ok = false;
        }
        if ok {
            let st = list_at(c, body, 0);
            ok = nk(c, st) == K_RETURN && na(c, st) >= 0 && ng_expr_size(c, na(c, st)) <= 24;
        }
        if ok {
            vset(map, name, 1);
        } else {
            vset(map, name, 2);
            return -1;
        }
    }
    return na(c, list_at(c, body, 0));
}

// Bind the parameters of inlinable `f` to the evaluated `args`; returns
// the scope mark, or -1 when the call is not inlined here.
fn ng_inline_begin(c: i64, f: i64, args: i64) -> i64 {
    let e = ng_inline_body(c, f);
    if e < 0 || ng(c, NG_INLDEPTH) >= 4 {
        return -1;
    }
    let params = nc(c, f);
    let count = list_len(c, args);
    if count * 2 != list_len(c, params) || !ng_free_ok(c, e, f) {
        return -1;
    }
    return ng_bind_args(c, params, args, ng(c, NG_NONE));
}


// Evaluate `args` and bind them to the parameter names; returns the scope
// mark for ng_inline_end.
fn ng_bind_args(c: i64, params: i64, args: i64, assigned: i64) -> i64 {
    let count = list_len(c, args);
    let vals = vnew();
    let kinds = vnew();
    let mut i: i64 = 0;
    while i < count {
        let a = list_at(c, args, i);
        let mut fixed = true;
        let mut q: i64 = 0;
        while q < vlen(assigned) {
            if vget(assigned, q) == list_at(c, params, i * 2) {
                fixed = false;
            }
            q = q + 1;
        }
        if !fixed {
            ng_gen(c, a);
            vpush(kinds, 2);
            vpush(vals, ng_temp(c));
        } else if ng_fold(c, a) {
            vpush(kinds, 1);
            vpush(vals, ng(c, NG_OPV));
        } else if ng_opnd(c, a) == 2 {
            vpush(kinds, 2);
            vpush(vals, ng(c, NG_OPV));
        } else {
            ng_gen(c, a);
            vpush(kinds, 2);
            vpush(vals, ng_temp(c));
        }
        i = i + 1;
    }
    let mark = ng_scope_begin(c);
    let mut j: i64 = 0;
    while j < count {
        let pname = list_at(c, params, j * 2);
        if vget(kinds, j) == 1 {
            let cb = ng(c, NG_CBIND);
            vpush(cb, vget(vals, j));
            ng_bind(c, pname, -1 - vlen(cb));
        } else {
            ng_bind(c, pname, vget(vals, j));
        }
        j = j + 1;
    }
    ng_set(c, NG_INLDEPTH, ng(c, NG_INLDEPTH) + 1);
    return mark;
}

fn ng_inline_end(c: i64, mark: i64) -> i64 {
    ng_set(c, NG_INLDEPTH, ng(c, NG_INLDEPTH) - 1);
    return ng_scope_end(c, mark);
}

// The function a call node resolves to (-1 for builtins / variants).
fn ng_call_target(c: i64, n: i64) -> i64 {
    let name = na(c, n);
    if is_qualified(c, name) && variant_disc(c, name) >= 0 {
        return -1;
    }
    let mut target = name;
    if ni(c, name, NI_FN) < 0 {
        target = last_segment(c, name);
    }
    return ni(c, target, NI_FN);
}



// Size of statement or expression `n` for whole-body inlining (over any
// budget for kinds it does not handle); names it declares go on `names`.
fn ng_node_size(c: i64, n: i64, names: i64) -> i64 {
    if n < 0 {
        return 0;
    }
    let k = nk(c, n);
    if k == K_INT || k == K_BOOL || k == K_VAR || k == K_STR {
        return 1;
    }
    if k == K_BIN || k == K_INDEX || k == K_RANGE || k == K_ASSIGN {
        if k == K_BIN || k == K_ASSIGN {
            if k == K_BIN {
                return 1 + ng_node_size(c, nb(c, n), names) + ng_node_size(c, nc(c, n), names);
            }
        }
        return 1 + ng_node_size(c, na(c, n), names) + ng_node_size(c, nb(c, n), names);
    }
    if k == K_UN {
        return 1 + ng_node_size(c, nb(c, n), names);
    }
    if k == K_FIELD || k == K_TINDEX || k == K_ADDR || k == K_RETURN {
        return 1 + ng_node_size(c, na(c, n), names);
    }
    if k == K_SLICE {
        return 1 + ng_node_size(c, na(c, n), names) + ng_node_size(c, nb(c, n), names) + ng_node_size(c, nc(c, n), names);
    }
    if k == K_ARRAY || k == K_TUPLE {
        return 1 + ng_list_size(c, na(c, n), names);
    }
    if k == K_CALL {
        return 2 + ng_list_size(c, nb(c, n), names);
    }
    if k == K_LET {
        vpush(names, na(c, n));
        return 1 + ng_node_size(c, nd(c, n), names);
    }
    if k == K_IF {
        return 1 + ng_node_size(c, na(c, n), names) + ng_list_size(c, nb(c, n), names) + ng_list_size(c, nc(c, n), names);
    }
    // loops amortize their call, and inlined loops would compete for the
    // caller's registers
    return 1000;
}

fn ng_list_size(c: i64, l: i64, names: i64) -> i64 {
    let mut total: i64 = 0;
    let mut i: i64 = 0;
    while i < list_len(c, l) {
        total = total + ng_node_size(c, list_at(c, l, i), names);
        i = i + 1;
    }
    return total;
}

// Every variable of `n` is declared by the inlined function (`names`) or
// unbound at this site.
fn ng_names_ok(c: i64, n: i64, names: i64) -> bool {
    if n < 0 {
        return true;
    }
    let k = nk(c, n);
    if k == K_VAR {
        let name = na(c, n);
        if ni(c, name, NI_CVAR) == -1 {
            return true;
        }
        let mut i: i64 = 0;
        while i < vlen(names) {
            if vget(names, i) == name {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    if k == K_BIN {
        return ng_names_ok(c, nb(c, n), names) && ng_names_ok(c, nc(c, n), names);
    }
    if k == K_INDEX || k == K_RANGE || k == K_ASSIGN {
        return ng_names_ok(c, na(c, n), names) && ng_names_ok(c, nb(c, n), names);
    }
    if k == K_UN {
        return ng_names_ok(c, nb(c, n), names);
    }
    if k == K_FIELD || k == K_TINDEX || k == K_ADDR || k == K_RETURN {
        return ng_names_ok(c, na(c, n), names);
    }
    if k == K_SLICE {
        return ng_names_ok(c, na(c, n), names) && ng_names_ok(c, nb(c, n), names) && ng_names_ok(c, nc(c, n), names);
    }
    if k == K_ARRAY || k == K_TUPLE {
        return ng_list_names_ok(c, na(c, n), names);
    }
    if k == K_CALL {
        return ng_list_names_ok(c, nb(c, n), names);
    }
    if k == K_LET {
        return ng_names_ok(c, nd(c, n), names);
    }
    if k == K_IF {
        return ng_names_ok(c, na(c, n), names) && ng_list_names_ok(c, nb(c, n), names) && ng_list_names_ok(c, nc(c, n), names);
    }
    if k == K_WHILE {
        return ng_names_ok(c, na(c, n), names) && ng_list_names_ok(c, nb(c, n), names);
    }
    if k == K_FOR {
        return ng_names_ok(c, nb(c, n), names) && ng_list_names_ok(c, nc(c, n), names);
    }
    return true;
}

fn ng_list_names_ok(c: i64, l: i64, names: i64) -> bool {
    let mut i: i64 = 0;
    while i < list_len(c, l) {
        if !ng_names_ok(c, list_at(c, l, i), names) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Names declared by `f` (parameters and locals) when its whole body is
// small enough to inline, else -1. Cached in NG_BODYOK by name id.
fn ng_body_names(c: i64, f: i64) -> i64 {
    if nk(c, f) != K_FN {
        return -1;
    }
    let name = na(c, f);
    let map = ng(c, NG_BODYOK);
    if vlen(map) <= name {
        vfill(map, name + 1 - vlen(map), 0);
    }
    let known = vget(map, name);
    if known == -1 {
        return -1;
    }
    if known != 0 {
        return known;
    }
    let names = vnew();
    let params = nc(c, f);
    let mut i: i64 = 0;
    while i < list_len(c, params) {
        vpush(names, list_at(c, params, i));
        i = i + 2;
    }
    let size = ng_list_size(c, ne(c, f), names);
    let mut ok = size <= NG_INLINE_BUDGET && !text_eq(name_text(c, name), "main");
    let mut j: i64 = 0;
    while j < vlen(names) {
        if ni(c, vget(names, j), NI_CONSTOK) == 1 {
            ok = false;
        }
        j = j + 1;
    }
    if !ok {
        vset(map, name, -1);
        return -1;
    }
    vset(map, name, names);
    return names;
}

const NG_INLINE_BUDGET = 32;

// Names of locals assigned anywhere in statement list `l`.
fn ng_assigns(c: i64, l: i64, out: i64) -> i64 {
    let mut i: i64 = 0;
    while i < list_len(c, l) {
        let n = list_at(c, l, i);
        let k = nk(c, n);
        if k == K_ASSIGN && nk(c, na(c, n)) == K_VAR {
            vpush(out, na(c, na(c, n)));
        }
        if k == K_IF {
            ng_assigns(c, nb(c, n), out);
            ng_assigns(c, nc(c, n), out);
        }
        if k == K_WHILE {
            ng_assigns(c, nb(c, n), out);
        }
        if k == K_FOR {
            ng_assigns(c, nc(c, n), out);
        }
        i = i + 1;
    }
    return 0;
}

// Inline the whole body of `f` at a call with `args`; false if not done.
fn ng_inline_full(c: i64, f: i64, args: i64) -> bool {
    let names = ng_body_names(c, f);
    if names < 0 {
        return false;
    }
    // an accumulator-recursive function inlines into itself NG_ACC_DEPTH
    // levels deep, each copy running its own accumulator loop
    let accmode = f == ng(c, NG_CURFN) && ng(c, NG_ACCFN) == f && ng(c, NG_ACC) >= 0;
    if ng(c, NG_INLDEPTH) >= 1 && !(accmode && ng(c, NG_INLDEPTH) < NG_ACC_DEPTH) {
        return false;
    }
    let params = nc(c, f);
    let count = list_len(c, args);
    if count * 2 != list_len(c, params) || !ng_list_names_ok(c, ne(c, f), names) {
        return false;
    }
    let assigned = vnew();
    ng_assigns(c, ne(c, f), assigned);
    if accmode {
        let mut q: i64 = 0;
        while q < count {
            vpush(assigned, list_at(c, params, q * 2));
            q = q + 1;
        }
    }
    let mark = ng_bind_args(c, params, args, assigned);
    let saved_ret = ng(c, NG_RETVAL);
    let ret = nd(c, f);
    let mut returns: i64 = 0;
    if ret >= 0 && !is_prim(c, ret, PRIM_VOID) {
        returns = 1;
    }
    ng_set(c, NG_RETVAL, returns);
    let exits = ng(c, NG_EXITS);
    vpush(exits, vnew());
    let saved_acc = ng(c, NG_ACC);
    let saved_top = ng(c, NG_ACCTOP);
    let saved_body = ng(c, NG_ACCBODY);
    let saved_pend = ng(c, NG_ACCRET);
    let saved_lvl = ng(c, NG_ACCLVL);
    if accmode {
        let acc = ng_slot(c);
        ng_set_imm(c, acc, 0);
        ng_set(c, NG_ACC, acc);
        ng_set(c, NG_ACCTOP, x_here(ncode(c)));
        ng_set(c, NG_ACCBODY, -1);
        ng_set(c, NG_ACCRET, -1);
        ng_set(c, NG_ACCLVL, vlen(exits));
        ng_loop_enter(c);
    }
    ng_block_v(c, ne(c, f), returns != 1);
    if returns != 1 {
        x_mov_rax_imm(ncode(c), 0);
    }
    ng_acc_flush_end(c);
    ng_patch_all(c, vpop(exits));
    if accmode {
        ng_add_acc(c);
        ng_loop_leave(c);
        ng_set(c, NG_ACC, saved_acc);
        ng_set(c, NG_ACCTOP, saved_top);
        ng_set(c, NG_ACCBODY, saved_body);
        ng_set(c, NG_ACCRET, saved_pend);
        ng_set(c, NG_ACCLVL, saved_lvl);
    }
    ng_set(c, NG_RETVAL, saved_ret);
    ng_inline_end(c, mark);
    return true;
}

const NG_ACC_DEPTH = 3;

// `if cond { return e; }` opening `f`'s body with cond and e small
// call-free expressions of its parameters: the guard, or -1.
fn ng_guard(c: i64, f: i64) -> i64 {
    let body = ne(c, f);
    if list_len(c, body) < 2 {
        return -1;
    }
    let st = list_at(c, body, 0);
    if nk(c, st) != K_IF || list_len(c, nc(c, st)) != 0 || list_len(c, nb(c, st)) != 1 {
        return -1;
    }
    let r = list_at(c, nb(c, st), 0);
    if nk(c, r) != K_RETURN || na(c, r) < 0 {
        return -1;
    }
    if !ng_param_expr(c, na(c, st), f) || !ng_param_expr(c, na(c, r), f) {
        return -1;
    }
    return st;
}

// `n` is a small expression of constants and `f`'s parameters, no calls.
fn ng_param_expr(c: i64, n: i64, f: i64) -> bool {
    let k = nk(c, n);
    if k == K_INT || k == K_BOOL {
        return true;
    }
    if k == K_VAR {
        let params = nc(c, f);
        let mut i: i64 = 0;
        while i < list_len(c, params) {
            if list_at(c, params, i) == na(c, n) {
                return true;
            }
            i = i + 2;
        }
        return false;
    }
    if k == K_BIN {
        let op = na(c, n);
        if op == OP_DIV || op == OP_MOD {
            return false;
        }
        return ng_param_expr(c, nb(c, n), f) && ng_param_expr(c, nc(c, n), f);
    }
    if k == K_UN {
        return ng_param_expr(c, nb(c, n), f);
    }
    return false;
}

// `n` uses only rax/rcx when generated: constants, locals, and arithmetic
// other than division on them.
fn ng_simple_expr(c: i64, n: i64) -> bool {
    let k = nk(c, n);
    if k == K_INT || k == K_BOOL {
        return true;
    }
    if k == K_VAR {
        return ni(c, na(c, n), NI_CVAR) >= 0 || ni(c, na(c, n), NI_CVAR) <= -2;
    }
    if k == K_BIN {
        let op = na(c, n);
        if !(op == OP_ADD || op == OP_SUB || op == OP_MUL || op == OP_BAND || op == OP_BOR) {
            return false;
        }
        return ng_simple_expr(c, nb(c, n)) && ng_simple_expr(c, nc(c, n));
    }
    return false;
}

fn ng_simple_args(c: i64, args: i64) -> bool {
    let mut i: i64 = 0;
    while i < list_len(c, args) {
        if !ng_simple_expr(c, list_at(c, args, i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// A call of `f` (at most six parameters) whose guard is tested inline:
// the guarded value without a call, else the call. False if not done.
fn ng_call_guarded(c: i64, f: i64, args: i64) -> bool {
    let g = ng_guard(c, f);
    let params = nc(c, f);
    let count = list_len(c, args);
    if g < 0 || count > 6 || count * 2 != list_len(c, params) {
        return false;
    }
    let b = ncode(c);
    let mut mark: i64 = -1;
    if count <= 4 && ng_simple_args(c, args) {
        // arguments computed straight into their argument registers (only
        // rax/rcx are scratch while they and the guard are evaluated)
        let slots = vnew();
        let mut a: i64 = 0;
        while a < count {
            let k = ng_slot(c);
            if ng(c, NG_PASS) == 1 {
                vpush(ng(c, NG_PIN), k);
                vpush(ng(c, NG_PIN), ng_arg_reg(a));
            }
            ng_gen_into(c, list_at(c, args, a), k);
            vpush(slots, k);
            a = a + 1;
        }
        mark = ng_scope_begin(c);
        let mut j: i64 = 0;
        while j < count {
            ng_bind(c, list_at(c, params, j * 2), vget(slots, j));
            j = j + 1;
        }
        ng_set(c, NG_INLDEPTH, ng(c, NG_INLDEPTH) + 1);
    } else {
        mark = ng_bind_args(c, params, args, ng(c, NG_NONE));
    }
    let to_call = vnew();
    ng_branch(c, na(c, g), false, to_call);
    ng_gen(c, na(c, list_at(c, nb(c, g), 0)));
    let done = x_jmp(b);
    ng_patch_all(c, to_call);
    let mut i: i64 = 0;
    while i < count {
        let slot = ni(c, list_at(c, params, i * 2), NI_CVAR);
        if slot >= 0 {
            ng_load_to(c, slot, ng_arg_reg(i));
        } else {
            x_mov_ri(b, ng_arg_reg(i), vget(ng(c, NG_CBIND), -2 - slot));
        }
        i = i + 1;
    }
    ng_call_regs(c, na(c, f), count);
    x_patch_here(b, done);
    ng_inline_end(c, mark);
    return true;
}

// ------------------------------------------------------------ primitives

// Generate address expression `n` as base (in rax) + constant; returns the
// constant displacement.
fn ng_addr(c: i64, n: i64) -> i64 {
    if nk(c, n) == K_BIN && na(c, n) == OP_ADD && ng_fold(c, nc(c, n)) {
        let d = ng(c, NG_OPV);
        if x_fits32(d) {
            let inner = ng_addr(c, nb(c, n));
            if x_fits32(inner + d) {
                return inner + d;
            }
            x_ri(ncode(c), 0, 0, d);
            return inner;
        }
    }
    ng_gen(c, n);
    return 0;
}

// Is address `n` slot [+ slot] [+ constant]? Sets NG_AB (base slot),
// NG_AI (index slot, -1) and NG_AD (displacement).
fn ng_pure_addr(c: i64, n: i64) -> bool {
    if nk(c, n) == K_BIN && na(c, n) == OP_ADD {
        if ng_fold(c, nc(c, n)) {
            let d = ng(c, NG_OPV);
            if !x_fits32(d) || !ng_pure_addr(c, nb(c, n)) {
                return false;
            }
            let t = ng(c, NG_AD) + d;
            ng_set(c, NG_AD, t);
            return x_fits32(t);
        }
        if ng_opnd(c, nb(c, n)) == 2 {
            let base = ng(c, NG_OPV);
            if ng_opnd(c, nc(c, n)) == 2 {
                ng_set(c, NG_AB, base);
                ng_set(c, NG_AI, ng(c, NG_OPV));
                ng_set(c, NG_AD, 0);
                return true;
            }
        }
        return false;
    }
    if ng_opnd(c, n) == 2 {
        ng_set(c, NG_AB, ng(c, NG_OPV));
        ng_set(c, NG_AI, -1);
        ng_set(c, NG_AD, 0);
        return true;
    }
    return false;
}

// Memory operation on the address ng_pure_addr found: base in its register
// or rax, index in its register or rdx.
fn ng_amode_op(c: i64, pre: i64, opc: i64, reg: i64) -> i64 {
    let b = ncode(c);
    let base = ng(c, NG_AB);
    let idx = ng(c, NG_AI);
    let d = ng(c, NG_AD);
    let mut br = ng_reg(c, base);
    if br < 0 {
        ng_load_to(c, base, 0);
        br = 0;
    }
    if idx < 0 {
        if pre != 0 {
            return x_rm2(b, opc, reg, br, d);
        }
        return x_rm(b, opc, reg, br, d);
    }
    let mut ir = ng_reg(c, idx);
    if ir < 0 {
        ng_load_to(c, idx, 2);
        ir = 2;
    }
    return x_rmx(b, pre, opc, reg, br, ir, 0, d);
}

// load64/load8/store64/store8 with folded displacements.
fn ng_mem_builtin(c: i64, text: i64, args: i64) -> bool {
    let b = ncode(c);
    let nargs = list_len(c, args);
    if nargs >= 1 && ng_pure_addr(c, list_at(c, args, 0)) {
        if nargs == 1 && text_eq(text, "load64") {
            ng_amode_op(c, 0, 139, 0);
            return true;
        }
        if nargs == 1 && text_eq(text, "load8") {
            ng_amode_op(c, 15, 182, 0);
            return true;
        }
        if nargs == 2 && (text_eq(text, "store64") || text_eq(text, "store8")) {
            let v = list_at(c, args, 1);
            let vk = ng_opnd(c, v);
            let vv = ng(c, NG_OPV);
            if vk > 0 {
                ng_opnd_to(c, vk, vv, 1);
            } else {
                ng_gen(c, v);
                x_mov_rcx_rax(b);
            }
            // the value may have clobbered the scratch; re-derive the address
            ng_pure_addr(c, list_at(c, args, 0));
            if text_eq(text, "store64") {
                ng_amode_op(c, 0, 137, 1);
            } else {
                ng_amode_op(c, 0, 136, 1);
            }
            x_mov_ri(b, 0, 0);
            return true;
        }
    }
    if text_eq(text, "load64") || text_eq(text, "load8") {
        if list_len(c, args) != 1 {
            return false;
        }
        let d = ng_addr(c, list_at(c, args, 0));
        if text_eq(text, "load64") {
            x_rm(b, 139, 0, 0, d);
        } else {
            x_rm2(b, 182, 0, 0, d);
        }
        return true;
    }
    if !(text_eq(text, "store64") || text_eq(text, "store8")) || list_len(c, args) != 2 {
        return false;
    }
    let v = list_at(c, args, 1);
    let vk = ng_opnd(c, v);
    let vv = ng(c, NG_OPV);
    let mut d: i64 = 0;
    if vk > 0 {
        d = ng_addr(c, list_at(c, args, 0));
        ng_opnd_to(c, vk, vv, 1);
    } else {
        d = ng_addr(c, list_at(c, args, 0));
        x_push_rax(b);
        ng_gen(c, v);
        x_mov_rcx_rax(b);
        x_pop_rax(b);
    }
    if text_eq(text, "store64") {
        x_rm(b, 137, 1, 0, d);
    } else {
        x_byte(b, 136);              // mov byte [rax + d], cl
        x_modrm_mem(b, 1, 0, d);
    }
    x_mov_ri(b, 0, 0);
    return true;
}

// Runtime collection / string primitives expanded at the call site.
// mov [rax + d], rcx in `size` bytes (8, 4, 2 or 1)
fn ng_store_rcx(c: i64, size: i64, d: i64) -> i64 {
    let b = ncode(c);
    if size == 8 {
        return x_rm(b, 137, 1, 0, d);
    }
    if size == 2 {
        x_byte(b, 102);
    }
    if size == 1 {
        x_byte(b, 136);
    } else {
        x_byte(b, 137);
    }
    return x_modrm_mem(b, 1, 0, d);
}

// String-builder appends with the capacity check inline; the runtime
// function runs only when the buffer must grow (or the builder is null).
fn ng_sb_prim(c: i64, text: i64, args: i64, count: i64) -> bool {
    let b = ncode(c);
    if count == 2 && text_eq(text, "track_sb_push_byte") {
        ng_gen2(c, list_at(c, args, 0), list_at(c, args, 1));
        let slow = vnew();
        x_test_rax(b);
        vpush(slow, x_jcc(b, 4));
        x_rm(b, 139, 2, 0, 8);           // rdx = len
        x_ri(b, 0, 2, 2);
        x_rm(b, 59, 2, 0, 16);           // len + 2 > cap: grow
        vpush(slow, x_jcc(b, 15));
        x_ri(b, 5, 2, 1);
        x_rm(b, 137, 2, 0, 8);           // len += 1
        x_rm(b, 139, 0, 0, 0);
        x_rr(b, 1, 0, 2);                // rax = data + new len
        ng_store_rcx(c, 1, -1);
        x_mov_ri(b, 1, 0);
        ng_store_rcx(c, 1, 0);
        x_mov_ri(b, 0, 0);
        let done = x_jmp(b);
        ng_patch_all(c, slow);
        x_push_r(b, 0);
        x_push_r(b, 1);
        ng_call_rt(c, "track_sb_push_byte", 2);
        x_patch_here(b, done);
        return true;
    }
    if count == 2 && text_eq(text, "track_sb_push") && nk(c, list_at(c, args, 1)) == K_STR {
        let lit = na(c, list_at(c, args, 1));
        let bytes = text_bytes(lit);
        let n = vlen(bytes);
        if n > 24 {
            return false;
        }
        let mut z: i64 = 0;
        while z < n {
            if vget(bytes, z) == 0 {
                return false;
            }
            z = z + 1;
        }
        vpush(bytes, 0);
        ng_gen(c, list_at(c, args, 0));
        let slow = vnew();
        x_test_rax(b);
        let null = x_jcc(b, 4);
        x_rm(b, 139, 2, 0, 8);           // rdx = len
        x_rm(b, 141, 1, 2, n + 1);       // rcx = len + n + 1
        x_rm(b, 59, 1, 0, 16);
        vpush(slow, x_jcc(b, 15));       // > cap: grow
        x_ri(b, 5, 1, 1);
        x_rm(b, 137, 1, 0, 8);           // len += n
        x_rm(b, 139, 0, 0, 0);
        x_rr(b, 1, 0, 2);                // rax = data + len
        let mut off: i64 = 0;
        while off < n + 1 {
            let mut size: i64 = 8;
            while off + size > n + 1 {
                size = size / 2;
            }
            let mut v: i64 = 0;
            let mut q: i64 = size - 1;
            while q >= 0 {
                v = (v << 8) | vget(bytes, off + q);
                q = q - 1;
            }
            x_mov_ri(b, 1, v);
            ng_store_rcx(c, size, off);
            off = off + size;
        }
        x_patch_here(b, null);
        x_mov_ri(b, 0, 0);
        let done = x_jmp(b);
        ng_patch_all(c, slow);
        x_push_r(b, 0);
        ng_string(c, lit);
        x_push_r(b, 0);
        ng_call_rt(c, "track_sb_push", 2);
        x_patch_here(b, done);
        return true;
    }
    return false;
}

fn ng_prim(c: i64, text: i64, args: i64, count: i64) -> bool {
    let b = ncode(c);
    if ng_sb_prim(c, text, args, count) {
        return true;
    }
    if count == 2 && text_eq(text, "track_i64_collection_get") {
        let h = ng_coll_hoisted(c, list_at(c, args, 0));
        if h >= 0 {
            return ng_coll_fast(c, h, list_at(c, args, 1), -1);
        }
        ng_gen2(c, list_at(c, args, 0), list_at(c, args, 1));
        let z = vnew();
        x_test_rax(b);
        vpush(z, x_jcc(b, 4));
        x_rm(b, 59, 1, 0, 8);            // cmp rcx, [rax + 8]
        vpush(z, x_jcc(b, 3));
        x_rm(b, 139, 0, 0, 0);           // mov rax, [rax]
        x_rmx(b, 0, 139, 0, 0, 1, 3, 0); // mov rax, [rax + rcx*8]
        return ng_cold_back(c, z, 0, -1, x_here(b)) >= 0;
    }
    if count == 3 && text_eq(text, "track_i64_collection_set") {
        let h = ng_coll_hoisted(c, list_at(c, args, 0));
        if h >= 0 {
            return ng_coll_fast(c, h, list_at(c, args, 1), list_at(c, args, 2));
        }
        let v = list_at(c, args, 2);
        let vk = ng_opnd(c, v);
        let vv = ng(c, NG_OPV);
        if vk > 0 {
            ng_gen2(c, list_at(c, args, 0), list_at(c, args, 1));
            ng_opnd_to(c, vk, vv, 2);
        } else {
            ng_gen(c, list_at(c, args, 0));
            x_push_rax(b);
            ng_gen(c, list_at(c, args, 1));
            x_push_rax(b);
            ng_gen(c, v);
            x_mov_rr(b, 2, 0);
            x_pop_r(b, 1);
            x_pop_r(b, 0);
        }
        let z = vnew();
        x_test_rax(b);
        vpush(z, x_jcc(b, 4));
        x_rm(b, 59, 1, 0, 8);
        vpush(z, x_jcc(b, 3));
        x_rm(b, 139, 0, 0, 0);
        x_rmx(b, 0, 137, 2, 0, 1, 3, 0); // mov [rax + rcx*8], rdx
        x_mov_ri(b, 0, 1);
        return ng_cold_back(c, z, 0, -1, x_here(b)) >= 0;
    }
    if count == 1 && text_eq(text, "track_i64_collection_len") && ng_coll_hoisted(c, list_at(c, args, 0)) >= 0 {
        let h = ng_coll_hoisted(c, list_at(c, args, 0));
        return ng_load_to(c, vget(ng(c, NG_CHOIST), h + 2), 0) >= 0;
    }
    if count == 1 && (text_eq(text, "track_i64_collection_len") || text_eq(text, "array_len")) {
        ng_gen(c, list_at(c, args, 0));
        x_test_rax(b);
        let z = x_jcc(b, 4);             // null: rax is already 0
        if text_eq(text, "array_len") {
            x_rm(b, 139, 0, 0, 0);
        } else {
            x_rm(b, 139, 0, 0, 8);
        }
        x_patch_here(b, z);
        return true;
    }
    if count == 2 && text_eq(text, "track_i64_collection_push") {
        ng_gen2(c, list_at(c, args, 0), list_at(c, args, 1));
        let slow = vnew();
        x_test_rax(b);
        vpush(slow, x_jcc(b, 4));
        x_rm(b, 139, 2, 0, 8);           // mov rdx, [rax + 8]
        x_rm(b, 59, 2, 0, 16);           // cmp rdx, [rax + 16]
        vpush(slow, x_jcc(b, 4));
        ng_set(c, NG_VOLX, 1);
        x_rm(b, 139, 6, 0, 0);           // mov rsi, [rax]
        x_rmx(b, 0, 137, 1, 6, 2, 3, 0); // mov [rsi + rdx*8], rcx
        x_mov_rr(b, 6, 2);
        x_ri(b, 0, 6, 1);
        x_rm(b, 137, 6, 0, 8);           // mov [rax + 8], rsi
        x_mov_rr(b, 0, 2);
        ng_set(c, NG_VOLX, 1);
        return ng_cold_back(c, slow, intern(c, "track_i64_collection_push"), 2, x_here(b)) >= 0;
    }
    if count == 2 && text_eq(text, "str_char_at") {
        return ng_charat(c, list_at(c, args, 0), list_at(c, args, 1));
    }
    return false;
}

// cmp reg, index operand (kind 1 imm32, kind 2 slot in register `ir` or
// frame memory)
fn ng_cmp_idx(c: i64, reg: i64, kind: i64, v: i64, ir: i64) -> i64 {
    let b = ncode(c);
    if kind == 1 {
        return x_ri(b, 7, reg, v);
    }
    if ir >= 0 {
        return x_rr(b, 57, reg, ir);
    }
    return x_rm(b, 59, reg, 5, ng_disp(c, v));
}

fn ng_sse_window(b: i64) -> i64 {
    x_byte(b, 102); x_bytes3(b, 15, 111, 0);    // movdqa xmm0, [rax]
    x_byte(b, 102); x_bytes3(b, 15, 116, 193);  // pcmpeqb xmm0, xmm1
    x_byte(b, 102); x_bytes3(b, 15, 215, 208);  // pmovmskb edx, xmm0
    return x_bytes2(b, 133, 210);               // test edx, edx
}

// rax = str_char_at(s, i) inline: 0 when s is null, i < 0 or a NUL comes
// at or before byte i; else that byte. Scans aligned 16-byte windows
// (never crossing a page) with SSE2, using only rax, rcx, rdx, xmm0 and
// xmm1, so every register home survives it.
fn ng_charat(c: i64, sn: i64, ix: i64) -> bool {
    let b = ncode(c);
    let len = ng_strlen_slot(c, sn);
    if len >= 0 {
        return ng_charat_len(c, ni(c, na(c, sn), NI_CVAR), len, ix);
    }
    let mut ik = ng_opnd(c, ix);
    let mut iv = ng(c, NG_OPV);
    let zero = vnew();
    if ik == 0 {
        // index needs code: s first (evaluation order), both to slots
        ng_gen(c, sn);
        let ks = ng_temp(c);
        ng_gen(c, ix);
        iv = ng_temp(c);
        ik = 2;
        ng_load_to(c, ks, 1);
    } else {
        ng_gen(c, sn);
        x_mov_rr(b, 1, 0);                      // rcx = s
    }
    let mut ir: i64 = -1;
    if ik == 1 {
        if iv < 0 {
            x_mov_ri(b, 0, 0);
            return true;
        }
    } else {
        ir = ng_reg(c, iv);
        if ir >= 0 {
            x_rr(b, 133, ir, ir);               // test ri, ri
        } else {
            x_rm(b, 131, 7, 5, ng_disp(c, iv)); // cmp qword [slot], 0
            x_byte(b, 0);
        }
        vpush(zero, x_jcc(b, 8));               // js zero
    }
    x_bytes3(b, 72, 133, 201);                  // test rcx, rcx
    vpush(zero, x_jcc(b, 4));
    x_mov_rr(b, 0, 1);
    x_bytes2(b, 72, 131); x_bytes2(b, 224, 240); // and rax, -16
    x_bytes3(b, 131, 225, 15);                  // and ecx, 15
    x_byte(b, 102); x_bytes3(b, 15, 239, 201);  // pxor xmm1, xmm1
    ng_sse_window(b);
    x_bytes2(b, 211, 234);                      // shr edx, cl
    x_bytes2(b, 133, 210);                      // test edx, edx
    let found_rel = x_jcc(b, 5);
    x_bytes3(b, 72, 247, 217);                  // neg rcx
    x_bytes2(b, 72, 131); x_bytes2(b, 193, 16); // add rcx, 16
    let top = x_here(b);
    ng_cmp_idx(c, 1, ik, iv, ir);
    let ok = x_jcc(b, 15);                      // jg ok: covered > i
    x_bytes2(b, 72, 131); x_bytes2(b, 192, 16); // add rax, 16
    ng_sse_window(b);
    let found_abs = x_jcc(b, 5);
    x_bytes2(b, 72, 131); x_bytes2(b, 193, 16); // add rcx, 16
    x_patch_rel(b, x_jmp(b), top);
    x_patch_here(b, found_abs);
    x_bytes3(b, 15, 188, 210);                  // bsf edx, edx
    x_bytes3(b, 72, 1, 202);                    // add rdx, rcx
    ng_cmp_idx(c, 2, ik, iv, ir);
    vpush(zero, x_jcc(b, 14));                  // jle zero: NUL at or before i
    x_bytes3(b, 72, 41, 200);                   // sub rax, rcx: s
    let to_load = x_jmp(b);
    x_patch_here(b, found_rel);
    x_bytes3(b, 15, 188, 210);                  // bsf edx, edx
    ng_cmp_idx(c, 2, ik, iv, ir);
    vpush(zero, x_jcc(b, 14));
    x_bytes3(b, 72, 1, 200);                    // add rax, rcx: s
    let to_load2 = x_jmp(b);
    x_patch_here(b, ok);
    x_bytes3(b, 72, 41, 200);                   // sub rax, rcx
    x_bytes2(b, 72, 131); x_bytes2(b, 192, 16); // add rax, 16: s
    x_patch_here(b, to_load);
    x_patch_here(b, to_load2);
    if ik == 1 {
        x_rm2(b, 182, 0, 0, iv);                // movzx rax, byte [rax + k]
    } else {
        let mut ri = ir;
        if ri < 0 {
            x_rm(b, 139, 1, 5, ng_disp(c, iv));
            ri = 1;
        }
        x_rmx(b, 15, 182, 0, 0, ri, 0, 0);      // movzx rax, byte [rax + ri]
    }
    let done = x_jmp(b);
    ng_patch_all(c, zero);
    x_mov_ri(b, 0, 0);
    x_patch_here(b, done);
    return true;
}

// Length slot of string `sn` hoisted by an enclosing loop, or -1.
fn ng_strlen_slot(c: i64, sn: i64) -> i64 {
    if nk(c, sn) != K_VAR {
        return -1;
    }
    let k = ni(c, na(c, sn), NI_CVAR);
    if k < 0 {
        return -1;
    }
    let v = ng(c, NG_STRLEN);
    let mut i: i64 = 0;
    while i < vlen(v) {
        if vget(v, i) == k {
            return vget(v, i + 1);
        }
        i = i + 2;
    }
    return -1;
}

// rax = str_char_at(s, i) with s's length in slot `len`: an unsigned
// bounds test (i < 0 fails it too) and a byte load.
fn ng_charat_len(c: i64, ks: i64, len: i64, ix: i64) -> bool {
    let b = ncode(c);
    let zero = vnew();
    let ik = ng_opnd(c, ix);
    let iv = ng(c, NG_OPV);
    let mut lr = ng_reg(c, len);
    let mut rs = ng_reg(c, ks);
    if ik == 1 {
        if iv < 0 {
            x_mov_ri(b, 0, 0);
            return true;
        }
        if lr >= 0 {
            x_ri(b, 7, lr, iv);
        } else {
            x_rm(b, 139, 2, 5, ng_disp(c, len));
            x_ri(b, 7, 2, iv);
        }
        vpush(zero, x_jcc(b, 6));               // jbe zero: len <= i
        if rs < 0 {
            x_rm(b, 139, 1, 5, ng_disp(c, ks));
            rs = 1;
        }
        x_rm2(b, 182, 0, rs, iv);               // movzx rax, byte [s + k]
    } else {
        let mut ri: i64 = -1;
        if ik == 2 {
            ri = ng_reg(c, iv);
            if ri < 0 {
                x_rm(b, 139, 0, 5, ng_disp(c, iv));
                ri = 0;
            }
        } else {
            ng_gen(c, ix);
            ri = 0;
        }
        if lr < 0 {
            x_rm(b, 139, 2, 5, ng_disp(c, len));
            lr = 2;
        }
        x_rr(b, 57, ri, lr);                    // cmp i, len
        vpush(zero, x_jcc(b, 3));               // jae zero
        if rs < 0 {
            x_rm(b, 139, 1, 5, ng_disp(c, ks));
            rs = 1;
        }
        x_rmx(b, 15, 182, 0, rs, ri, 0, 0);     // movzx rax, byte [s + i]
    }
    let done = x_jmp(b);
    ng_patch_all(c, zero);
    x_mov_ri(b, 0, 0);
    x_patch_here(b, done);
    return true;
}

// Evaluating `n` writes no memory: arithmetic on locals, local
// assignments, control flow, str_char_at / str_len, and calls of functions
// whose bodies qualify (`depth` levels deep).
fn ng_pure(c: i64, n: i64, depth: i64) -> bool {
    if n < 0 {
        return true;
    }
    let k = nk(c, n);
    if k == K_INT || k == K_BOOL {
        return true;
    }
    if k == K_VAR {
        let name = na(c, n);
        if ni(c, name, NI_CVAR) != -1 {
            return true;
        }
        return !(is_qualified(c, name) && is_payload_variant(c, name));
    }
    if k == K_BIN {
        return ng_pure(c, nb(c, n), depth) && ng_pure(c, nc(c, n), depth);
    }
    if k == K_UN {
        return ng_pure(c, nb(c, n), depth);
    }
    if k == K_ASSIGN {
        return nk(c, na(c, n)) == K_VAR && ng_pure(c, nb(c, n), depth);
    }
    if k == K_LET {
        return ng_pure(c, nd(c, n), depth);
    }
    if k == K_RETURN {
        return ng_pure(c, na(c, n), depth);
    }
    if k == K_IF {
        return ng_pure(c, na(c, n), depth) && ng_pure_list(c, nb(c, n), depth) && ng_pure_list(c, nc(c, n), depth);
    }
    if k == K_WHILE {
        return ng_pure(c, na(c, n), depth) && ng_pure_list(c, nb(c, n), depth);
    }
    if k == K_CALL {
        if !ng_pure_list(c, nb(c, n), depth) {
            return false;
        }
        let t = name_text(c, na(c, n));
        if text_eq(t, "str_char_at") || text_eq(t, "str_len") {
            return true;
        }
        if ng(c, NG_PUREC) == 1 && (text_eq(t, "track_i64_collection_get")
            || text_eq(t, "track_i64_collection_set") || text_eq(t, "track_i64_collection_len")) {
            return true;
        }
        let f = ng_call_target(c, n);
        if f < 0 || depth <= 0 || nk(c, f) != K_FN {
            return false;
        }
        return ng_pure_list(c, ne(c, f), depth - 1);
    }
    return false;
}

fn ng_pure_list(c: i64, l: i64, depth: i64) -> bool {
    let mut i: i64 = 0;
    while i < list_len(c, l) {
        if !ng_pure(c, list_at(c, l, i), depth) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Slots of local strings passed to str_char_at in `n` (into `out`, once).
fn ng_charat_strs(c: i64, n: i64, out: i64) -> i64 {
    if n < 0 {
        return 0;
    }
    let k = nk(c, n);
    if k == K_CALL {
        let args = nb(c, n);
        if text_eq(name_text(c, na(c, n)), "str_char_at") && list_len(c, args) == 2 {
            let a = list_at(c, args, 0);
            if nk(c, a) == K_VAR {
                let ks = ni(c, na(c, a), NI_CVAR);
                let mut seen = ks < 0;
                let mut i: i64 = 0;
                while i < vlen(out) {
                    if vget(out, i) == ks {
                        seen = true;
                    }
                    i = i + 1;
                }
                if !seen {
                    vpush(out, ks);
                }
            }
        }
        return ng_charat_strs_list(c, args, out);
    }
    if k == K_BIN {
        ng_charat_strs(c, nb(c, n), out);
        return ng_charat_strs(c, nc(c, n), out);
    }
    if k == K_UN {
        return ng_charat_strs(c, nb(c, n), out);
    }
    if k == K_ASSIGN {
        return ng_charat_strs(c, nb(c, n), out);
    }
    if k == K_LET {
        return ng_charat_strs(c, nd(c, n), out);
    }
    if k == K_RETURN {
        return ng_charat_strs(c, na(c, n), out);
    }
    if k == K_IF {
        ng_charat_strs(c, na(c, n), out);
        ng_charat_strs_list(c, nb(c, n), out);
        return ng_charat_strs_list(c, nc(c, n), out);
    }
    if k == K_WHILE {
        ng_charat_strs(c, na(c, n), out);
        return ng_charat_strs_list(c, nb(c, n), out);
    }
    return 0;
}

fn ng_charat_strs_list(c: i64, l: i64, out: i64) -> i64 {
    let mut i: i64 = 0;
    while i < list_len(c, l) {
        ng_charat_strs(c, list_at(c, l, i), out);
        i = i + 1;
    }
    return 0;
}

// Before a store-free while loop: the length of each local string it
// indexes with str_char_at (and never reassigns) goes in a fresh slot, so
// those calls become a bounds test and a load. Returns the number of
// NG_STRLEN entries pushed.
fn ng_hoist_strlen(c: i64, n: i64) -> i64 {
    let body = nb(c, n);
    if !ng_pure(c, na(c, n), 2) || !ng_pure_list(c, body, 2) {
        return 0;
    }
    let strs = vnew();
    ng_charat_strs(c, na(c, n), strs);
    ng_charat_strs_list(c, body, strs);
    if vlen(strs) == 0 {
        return 0;
    }
    let assigned = vnew();
    if !ng_scan_assigns(c, body, assigned) {
        return 0;
    }
    let declared = vnew();
    ng_let_names(c, body, declared);
    let b = ncode(c);
    let v = ng(c, NG_STRLEN);
    let mut pushed: i64 = 0;
    let mut i: i64 = 0;
    while i < vlen(strs) && pushed < 2 {
        let ks = vget(strs, i);
        let mut ok = true;
        let mut j: i64 = 0;
        while j < vlen(v) {
            if vget(v, j) == ks {
                ok = false;
            }
            j = j + 2;
        }
        let mut q: i64 = 0;
        while q < vlen(assigned) {
            if ni(c, vget(assigned, q), NI_CVAR) == ks {
                ok = false;
            }
            q = q + 1;
        }
        let mut d: i64 = 0;
        while d < vlen(declared) {
            if ni(c, vget(declared, d), NI_CVAR) == ks {
                ok = false; // a name the loop rebinds: not this binding
            }
            d = d + 1;
        }
        if ok {
            ng_load_to(c, ks, 0);
            ng_strlen_rax(b);
            let len = ng_temp(c);
            vpush(v, ks);
            vpush(v, len);
            pushed = pushed + 1;
        }
        i = i + 1;
    }
    return pushed;
}

// Slots of local handles passed to collection get/set/len in `n` (into `out`, once).
fn ng_coll_handles(c: i64, n: i64, out: i64) -> i64 {
    if n < 0 {
        return 0;
    }
    let k = nk(c, n);
    if k == K_CALL {
        let args = nb(c, n);
        let t = name_text(c, na(c, n));
        if list_len(c, args) >= 1 && (text_eq(t, "track_i64_collection_get")
            || text_eq(t, "track_i64_collection_set") || text_eq(t, "track_i64_collection_len")) {
            let a = list_at(c, args, 0);
            if nk(c, a) == K_VAR {
                let ks = ni(c, na(c, a), NI_CVAR);
                let mut seen = ks < 0;
                let mut i: i64 = 0;
                while i < vlen(out) {
                    if vget(out, i) == ks {
                        seen = true;
                    }
                    i = i + 1;
                }
                if !seen {
                    vpush(out, ks);
                }
            }
        }
        return ng_coll_handles_list(c, args, out);
    }
    if k == K_BIN {
        ng_coll_handles(c, nb(c, n), out);
        return ng_coll_handles(c, nc(c, n), out);
    }
    if k == K_UN || k == K_ASSIGN {
        return ng_coll_handles(c, nb(c, n), out);
    }
    if k == K_LET {
        return ng_coll_handles(c, nd(c, n), out);
    }
    if k == K_RETURN {
        return ng_coll_handles(c, na(c, n), out);
    }
    if k == K_IF {
        ng_coll_handles(c, na(c, n), out);
        ng_coll_handles_list(c, nb(c, n), out);
        return ng_coll_handles_list(c, nc(c, n), out);
    }
    if k == K_WHILE {
        ng_coll_handles(c, na(c, n), out);
        return ng_coll_handles_list(c, nb(c, n), out);
    }
    return 0;
}

fn ng_coll_handles_list(c: i64, l: i64, out: i64) -> i64 {
    let mut i: i64 = 0;
    while i < list_len(c, l) {
        ng_coll_handles(c, list_at(c, l, i), out);
        i = i + 1;
    }
    return 0;
}

// Before a while loop that cannot change any collection header (only
// ng_pure code plus collection get/set/len: no push, pop, truncate, other
// calls or raw stores), the data pointer and length of each never-reassigned
// local handle it indexes go in fresh slots (0, 0 for a null handle), so
// get/set become an unsigned bounds test and a load or store. A second name
// for the same collection cannot change the header either: every operation
// that could is rejected. Returns the number of NG_CHOIST entries pushed.
fn ng_hoist_coll(c: i64, n: i64) -> i64 {
    let body = nb(c, n);
    ng_set(c, NG_PUREC, 1);
    let pure = ng_pure(c, na(c, n), 2) && ng_pure_list(c, body, 2);
    ng_set(c, NG_PUREC, 0);
    if !pure {
        return 0;
    }
    let hs = vnew();
    ng_coll_handles(c, na(c, n), hs);
    ng_coll_handles_list(c, body, hs);
    if vlen(hs) == 0 {
        return 0;
    }
    let assigned = vnew();
    if !ng_scan_assigns(c, body, assigned) {
        return 0;
    }
    let declared = vnew();
    ng_let_names(c, body, declared);
    let b = ncode(c);
    let v = ng(c, NG_CHOIST);
    let mut pushed: i64 = 0;
    let mut i: i64 = 0;
    while i < vlen(hs) && pushed < 2 {
        let ks = vget(hs, i);
        let mut ok = true;
        let mut j: i64 = 0;
        while j < vlen(v) {
            if vget(v, j) == ks {
                ok = false;
            }
            j = j + 3;
        }
        let mut q: i64 = 0;
        while q < vlen(assigned) {
            if ni(c, vget(assigned, q), NI_CVAR) == ks {
                ok = false;
            }
            q = q + 1;
        }
        let mut d: i64 = 0;
        while d < vlen(declared) {
            if ni(c, vget(declared, d), NI_CVAR) == ks {
                ok = false;
            }
            d = d + 1;
        }
        if ok {
            ng_load_to(c, ks, 0);
            x_mov_rr(b, 1, 0);
            x_test_rax(b);
            let null = x_jcc(b, 4);              // null: data = len = 0
            x_rm(b, 139, 1, 0, 8);               // mov rcx, [rax + 8]
            x_rm(b, 139, 0, 0, 0);               // mov rax, [rax]
            x_patch_here(b, null);
            let kd = ng_slot(c);
            ng_store_from(c, kd, 0);
            let kl = ng_slot(c);
            ng_store_from(c, kl, 1);
            vpush(v, ks);
            vpush(v, kd);
            vpush(v, kl);
            pushed = pushed + 1;
        }
        i = i + 1;
    }
    return pushed;
}

// Index into NG_CHOIST of the triple for handle `hn`, or -1.
fn ng_coll_hoisted(c: i64, hn: i64) -> i64 {
    if nk(c, hn) != K_VAR {
        return -1;
    }
    let k = ni(c, na(c, hn), NI_CVAR);
    if k < 0 {
        return -1;
    }
    let v = ng(c, NG_CHOIST);
    let mut i: i64 = 0;
    while i < vlen(v) {
        if vget(v, i) == k {
            return i;
        }
        i = i + 3;
    }
    return -1;
}

// collection get/set through hoisted data/length slots. Index in a
// register (its own, or rcx), value (set) in rdx; out of range (a cold
// stub) gives 0 and stores nothing, as the runtime does.
fn ng_coll_fast(c: i64, h: i64, ix: i64, val: i64) -> bool {
    let b = ncode(c);
    let v = ng(c, NG_CHOIST);
    let kd = vget(v, h + 1);
    let kl = vget(v, h + 2);
    let ik = ng_opnd(c, ix);
    let iv = ng(c, NG_OPV);
    let mut ri: i64 = 1;
    if val >= 0 {
        let vk = ng_opnd(c, val);
        let vv = ng(c, NG_OPV);
        if vk > 0 {
            if ik == 2 && ng_reg(c, iv) >= 0 {
                ri = ng_reg(c, iv);
            } else if ik > 0 {
                ng_opnd_to(c, ik, iv, 1);
            } else {
                ng_gen(c, ix);
                x_mov_rr(b, 1, 0);
            }
            ng_opnd_to(c, vk, vv, 2);
        } else if ik > 0 {
            ng_gen(c, val);
            x_mov_rr(b, 2, 0);
            if ik == 2 && ng_reg(c, iv) >= 0 {
                ri = ng_reg(c, iv);
            } else {
                ng_opnd_to(c, ik, iv, 1);
            }
        } else {
            ng_gen(c, ix);
            x_push_rax(b);
            ng_gen(c, val);
            x_mov_rr(b, 2, 0);
            x_pop_r(b, 1);
        }
    } else if ik == 2 && ng_reg(c, iv) >= 0 {
        ri = ng_reg(c, iv);
    } else if ik > 0 {
        ng_opnd_to(c, ik, iv, 1);
    } else {
        ng_gen(c, ix);
        x_mov_rr(b, 1, 0);
    }
    let lr = ng_reg(c, kl);
    if lr >= 0 {
        x_rr(b, 57, ri, lr);                     // cmp i, len
    } else {
        x_rm(b, 59, ri, 5, ng_disp(c, kl));      // cmp i, [len]
    }
    let out = x_jcc(b, 3);                       // jae: out of range (or < 0)
    let mut dr = ng_reg(c, kd);
    if val >= 0 {
        if dr < 0 {
            x_rm(b, 139, 0, 5, ng_disp(c, kd));
            dr = 0;
        }
        x_rmx(b, 0, 137, 2, dr, ri, 3, 0);       // mov [data + i*8], rdx
        x_mov_ri(b, 0, 1);
    } else {
        if dr < 0 {
            x_rm(b, 139, 2, 5, ng_disp(c, kd));
            dr = 2;
        }
        x_rmx(b, 0, 139, 0, dr, ri, 3, 0);       // mov rax, [data + i*8]
    }
    let z = vnew();
    vpush(z, out);
    return ng_cold_back(c, z, 0, -1, x_here(b)) >= 0;
}

// Names declared by `let` anywhere in statement list `l`.
fn ng_let_names(c: i64, l: i64, out: i64) -> i64 {
    let mut i: i64 = 0;
    while i < list_len(c, l) {
        let n = list_at(c, l, i);
        let k = nk(c, n);
        if k == K_LET {
            vpush(out, na(c, n));
        } else if k == K_IF {
            ng_let_names(c, nb(c, n), out);
            ng_let_names(c, nc(c, n), out);
        } else if k == K_WHILE {
            ng_let_names(c, nb(c, n), out);
        }
        i = i + 1;
    }
    return 0;
}

// rax = strlen(rax) (0 for null), SSE2 over aligned 16-byte windows;
// uses rax, rcx, rdx, xmm0, xmm1.
fn ng_strlen_rax(b: i64) -> i64 {
    x_test_rax(b);
    let null = x_jcc(b, 4);
    x_mov_rr(b, 1, 0);
    x_bytes2(b, 72, 131); x_bytes2(b, 224, 240); // and rax, -16
    x_bytes3(b, 131, 225, 15);                  // and ecx, 15
    x_byte(b, 102); x_bytes3(b, 15, 239, 201);  // pxor xmm1, xmm1
    ng_sse_window(b);
    x_bytes2(b, 211, 234);                      // shr edx, cl
    x_bytes2(b, 133, 210);                      // test edx, edx
    let found_rel = x_jcc(b, 5);
    x_bytes3(b, 72, 247, 217);                  // neg rcx
    x_bytes2(b, 72, 131); x_bytes2(b, 193, 16); // add rcx, 16
    let top = x_here(b);
    x_bytes2(b, 72, 131); x_bytes2(b, 192, 16); // add rax, 16
    ng_sse_window(b);
    let found_abs = x_jcc(b, 5);
    x_bytes2(b, 72, 131); x_bytes2(b, 193, 16); // add rcx, 16
    x_patch_rel(b, x_jmp(b), top);
    x_patch_here(b, found_abs);
    x_bytes3(b, 15, 188, 210);                  // bsf edx, edx
    x_bytes3(b, 72, 1, 202);                    // add rdx, rcx
    x_mov_rr(b, 0, 2);
    let done = x_jmp(b);
    x_patch_here(b, found_rel);
    x_bytes3(b, 15, 188, 194);                  // bsf eax, edx
    x_patch_here(b, null);
    return x_patch_here(b, done);
}

// ------------------------------------------------------------ operands

// Classify `n` as a simple operand: 0 none, 1 imm32 (value in NG_OPV),
// 2 frame slot (slot in NG_OPV). Simple operands need no evaluation code.
fn ng_opnd(c: i64, n: i64) -> i64 {
    let k = nk(c, n);
    if k == K_INT || k == K_BOOL {
        if x_fits32(na(c, n)) {
            ng_set(c, NG_OPV, na(c, n));
            return 1;
        }
        return 0;
    }
    if k == K_UN && na(c, n) == OP_NEG && nk(c, nb(c, n)) == K_INT {
        let v = 0 - na(c, nb(c, n));
        if x_fits32(v) {
            ng_set(c, NG_OPV, v);
            return 1;
        }
        return 0;
    }
    if k != K_VAR {
        return 0;
    }
    let name = na(c, n);
    let local = ni(c, name, NI_CVAR);
    if local >= 0 {
        ng_set(c, NG_OPV, local);
        return 2;
    }
    if local <= -2 {
        let cv = vget(ng(c, NG_CBIND), -2 - local);
        if x_fits32(cv) {
            ng_set(c, NG_OPV, cv);
            return 1;
        }
        return 0;
    }
    let mut v: i64 = 0;
    if is_qualified(c, name) {
        let disc = variant_disc(c, name);
        if disc >= 0 {
            if is_payload_variant(c, name) {
                return 0;
            }
            v = disc;
        }
    } else if ni(c, name, NI_CONSTOK) == 1 {
        v = ni(c, name, NI_CONSTVAL);
    }
    if x_fits32(v) {
        ng_set(c, NG_OPV, v);
        return 1;
    }
    return 0;
}

// mov r, operand
fn ng_opnd_to(c: i64, kind: i64, v: i64, r: i64) -> i64 {
    if kind == 1 {
        return x_mov_ri(ncode(c), r, v);
    }
    return ng_load_to(c, v, r);
}

fn ng_op_rm(op: i64) -> i64 {
    // opc r64, r/m64
    if op == OP_ADD { return 3; }
    if op == OP_SUB { return 43; }
    if op == OP_BAND { return 35; }
    if op == OP_BOR { return 11; }
    return 59; // cmp
}

fn ng_op_ext(op: i64) -> i64 {
    if op == OP_ADD { return 0; }
    if op == OP_SUB { return 5; }
    if op == OP_BAND { return 4; }
    if op == OP_BOR { return 1; }
    return 7; // cmp
}

fn ng_log2(v: i64) -> i64 {
    if v <= 0 {
        return -1;
    }
    let mut k: i64 = 0;
    while (1 << k) < v && k < 62 {
        k = k + 1;
    }
    if (1 << k) == v {
        return k;
    }
    return -1;
}

// Can `dst = dst op operand` be done without rcx/rdx? (comparisons: flags)
fn ng_op_direct(op: i64, kind: i64, v: i64) -> bool {
    if op == OP_ADD || op == OP_SUB || op == OP_BAND || op == OP_BOR || op == OP_MUL || x_is_cmp(op) {
        return true;
    }
    if (op == OP_SHL || op == OP_SHR) && kind == 1 {
        return v >= 0 && v < 64;
    }
    return false;
}

// dst = dst op operand (comparisons only set the flags).
fn ng_op_apply(c: i64, op: i64, dst: i64, kind: i64, v: i64) -> i64 {
    let b = ncode(c);
    if kind == 1 {
        if op == OP_MUL {
            let sh = ng_log2(v);
            if sh == 0 { return 0; }
            if sh > 0 { return x_shift_ri(b, 4, dst, sh); }
            if v == 3 || v == 5 || v == 9 {
                // lea dst, [dst + dst * (v - 1)]
                return x_rmx(b, 0, 141, dst, dst, dst, ng_log2(v - 1), 0);
            }
            let up = ng_log2(v + 1);
            let down = ng_log2(v - 1);
            if up > 0 || down > 0 {
                x_mov_rr(b, 1, dst);
                if up > 0 {
                    x_shift_ri(b, 4, dst, up);
                    return x_rr(b, 41, dst, 1);   // (x << k) - x
                }
                x_shift_ri(b, 4, dst, down);
                return x_rr(b, 1, dst, 1);        // (x << k) + x
            }
            return x_imul_ri(b, dst, v);
        }
        if op == OP_SHL { return x_shift_ri(b, 4, dst, v); }
        if op == OP_SHR { return x_shift_ri(b, 5, dst, v); }
        if x_is_cmp(op) && v == 0 {
            return x_rr(b, 133, dst, dst); // test dst, dst
        }
        if v == 0 && (op == OP_ADD || op == OP_SUB || op == OP_BOR) {
            return 0;
        }
        return x_ri(b, ng_op_ext(op), dst, v);
    }
    let s = ng_reg(c, v);
    if s >= 0 {
        if op == OP_MUL { return x_rr2(b, 175, dst, s); }
        return x_rr(b, ng_op_rm(op) - 2, dst, s);
    }
    if op == OP_MUL { return x_rm2(b, 175, dst, 5, ng_disp(c, v)); }
    return x_rm(b, ng_op_rm(op), dst, 5, ng_disp(c, v));
}

// rax = rax op rcx for the operators ng_op_direct does not cover.
fn ng_op_rcx(c: i64, op: i64) -> i64 {
    return x_binop(ncode(c), op);
}

// Leave `x` in rax and `y` in rcx (evaluated left to right).
fn ng_gen2(c: i64, x: i64, y: i64) -> i64 {
    let b = ncode(c);
    let yk = ng_opnd(c, y);
    let yv = ng(c, NG_OPV);
    if yk > 0 {
        ng_gen(c, x);
        return ng_opnd_to(c, yk, yv, 1);
    }
    let xk = ng_opnd(c, x);
    let xv = ng(c, NG_OPV);
    if xk > 0 {
        ng_gen(c, y);
        x_mov_rcx_rax(b);
        return ng_opnd_to(c, xk, xv, 0);
    }
    ng_gen(c, x);
    if ng_index_rcx(c, y) {
        return 0;
    }
    x_push_rax(b);
    ng_gen(c, y);
    x_mov_rcx_rax(b);
    return x_pop_rax(b);
}

// rcx = y without touching rax, when y is an in-bounds index of
// register operands; false (nothing emitted) otherwise.
fn ng_index_rcx(c: i64, y: i64) -> bool {
    if nk(c, y) != K_INDEX || ng_safe_index(c, na(c, y), nb(c, y)) < 0 {
        return false;
    }
    let ak = ng_opnd(c, na(c, y));
    let av = ng(c, NG_OPV);
    let ik = ng_opnd(c, nb(c, y));
    let iv = ng(c, NG_OPV);
    if ak != 2 || ik != 2 {
        return false;
    }
    let ra = ng_reg(c, av);
    let ri = ng_reg(c, iv);
    if ng(c, NG_PASS) == 1 || ra < 0 || ri < 0 {
        // pass 1 counts the uses the same way and keeps the fallback shape
        if ng(c, NG_PASS) == 1 {
            return false;
        }
        return false;
    }
    x_rmx(ncode(c), 0, 139, 1, ra, ri, 3, 8);
    return true;
}

// Compile-time value of a constant expression (in NG_OPV); false if none.
fn ng_fold(c: i64, n: i64) -> bool {
    let k = nk(c, n);
    if k == K_BIN {
        let op = na(c, n);
        if !ng_fold(c, nb(c, n)) {
            return false;
        }
        let x = ng(c, NG_OPV);
        if !ng_fold(c, nc(c, n)) {
            return false;
        }
        let y = ng(c, NG_OPV);
        let mut r: i64 = 0;
        if op == OP_ADD { r = x + y; } else if op == OP_SUB { r = x - y; } else if op == OP_MUL { r = x * y; } else if op == OP_BAND { r = x & y; } else if op == OP_BOR { r = x | y; } else if op == OP_SHL && y >= 0 && y < 64 { r = x << y; } else if op == OP_SHR && x >= 0 && y >= 0 && y < 64 { r = x >> y; } else { return false; }
        ng_set(c, NG_OPV, r);
        return true;
    }
    if k == K_INT || k == K_BOOL {
        ng_set(c, NG_OPV, na(c, n));
        return true;
    }
    if k == K_VAR || (k == K_UN && na(c, n) == OP_NEG) {
        return ng_opnd(c, n) == 1;
    }
    return false;
}

// Set the flags for comparison `n`; returns the condition code that is
// true when the comparison holds.
fn ng_cmp(c: i64, n: i64) -> i64 {
    let b = ncode(c);
    let op = na(c, n);
    let l = nb(c, n);
    let r = nc(c, n);
    if (op == OP_EQ || op == OP_NEQ) && nk(c, r) == K_INT && na(c, r) == 0 && nk(c, l) == K_BIN && na(c, l) == OP_BAND && nk(c, nc(c, l)) == K_INT && na(c, nc(c, l)) >= 0 && x_fits32(na(c, nc(c, l))) {
        // (x & C) == 0: one test of x against C, in place when x has a register
        let m = na(c, nc(c, l));
        if ng(c, NG_PASS) == 2 && ng_opnd(c, nb(c, l)) == 2 {
            let xr = ng_reg(c, ng(c, NG_OPV));
            if xr >= 0 {
                x_test_ri(b, xr, m);
                return x_cc(op);
            }
        }
        ng_gen(c, nb(c, l));
        x_test_ri(b, 0, m);
        return x_cc(op);
    }
    let rk = ng_opnd(c, r);
    let rv = ng(c, NG_OPV);
    if rk > 0 {
        // register-resident left operand compares in place
        if ng(c, NG_PASS) == 2 && ng_opnd(c, l) == 2 {
            let lr = ng_reg(c, ng(c, NG_OPV));
            if lr >= 0 {
                ng_op_apply(c, op, lr, rk, rv);
                return x_cc(op);
            }
        }
        ng_gen(c, l);
        ng_op_apply(c, op, 0, rk, rv);
        return x_cc(op);
    }
    let lk = ng_opnd(c, l);
    let lv = ng(c, NG_OPV);
    if lk > 0 {
        ng_gen(c, r);
        ng_op_apply(c, op, 0, lk, lv);
        return x_cc(x_swap_op(op));
    }
    ng_gen(c, l);
    x_push_rax(b);
    ng_gen(c, r);
    x_mov_rcx_rax(b);
    x_pop_rax(b);
    x_bytes3(b, 72, 57, 200); // cmp rax, rcx
    return x_cc(op);
}

// Emit jumps taken when the truth of `n` equals `sense`; their rel32
// positions are appended to `list`.
fn ng_branch(c: i64, n: i64, sense: bool, list: i64) -> i64 {
    let b = ncode(c);
    let k = nk(c, n);
    if k == K_BIN {
        let op = na(c, n);
        if op == OP_AND || op == OP_OR {
            if (op == OP_AND) != sense {
                // AND false / OR true: either side decides
                ng_branch(c, nb(c, n), sense, list);
                return ng_branch(c, nc(c, n), sense, list);
            }
            let skip = vnew();
            ng_branch(c, nb(c, n), !sense, skip);
            ng_branch(c, nc(c, n), sense, list);
            return ng_patch_all(c, skip);
        }
        if x_is_cmp(op) {
            let cc = ng_cmp(c, n);
            if sense {
                return vpush(list, x_jcc(b, cc));
            }
            return vpush(list, x_jcc(b, x_inv_cc(cc)));
        }
    }
    if k == K_UN && na(c, n) == OP_NOT {
        return ng_branch(c, nb(c, n), !sense, list);
    }
    if k == K_CALL {
        let f = ng_call_target(c, n);
        if f >= 0 {
            let mark = ng_inline_begin(c, f, nb(c, n));
            if mark >= 0 {
                ng_branch(c, ng_inline_body(c, f), sense, list);
                return ng_inline_end(c, mark);
            }
        }
    }
    if k == K_BOOL || k == K_INT {
        if (na(c, n) != 0) == sense {
            return vpush(list, x_jmp(b));
        }
        return 0;
    }
    ng_gen(c, n);
    x_test_rax(b);
    if sense {
        return vpush(list, x_jnz(b));
    }
    return vpush(list, x_jz(b));
}

// rax = rax / d or rax % d (truncating, d >= 2 a 32-bit constant) without
// idiv: shifts for powers of two, else a Granlund-Montgomery multiply.
fn ng_divmod_const(c: i64, op: i64, d: i64) -> i64 {
    return ng_divmod_const_at(c, op, d, false);
}

// ... with the dividend in rcx instead of rax when `in_rcx`.
fn ng_divmod_const_at(c: i64, op: i64, d: i64, in_rcx: bool) -> i64 {
    let b = ncode(c);
    let k = ng_log2(d);
    if in_rcx && k > 0 {
        x_mov_rr(b, 0, 1);
    }
    if k > 0 {
        x_mov_rr(b, 1, 0);
        x_shift_ri(b, 7, 1, 63);        // sar rcx, 63
        x_shift_ri(b, 5, 1, 64 - k);    // shr rcx, 64 - k
        x_rr(b, 1, 1, 0);               // add rcx, rax
        if op == OP_DIV {
            x_shift_ri(b, 7, 1, k);
            return x_mov_rr(b, 0, 1);
        }
        x_ri(b, 4, 1, 0 - d);           // and rcx, -d
        return x_rr(b, 41, 0, 1);       // sub rax, rcx
    }
    let mut l: i64 = 0;
    while (1 << l) < d {
        l = l + 1;
    }
    // q = floor(2^(63+l) / d), kept modulo 2^64; the magic is q + 1 - 2^64
    let mut r: i64 = 0;
    let mut q: i64 = 0;
    let mut i: i64 = 63 + l;
    while i >= 0 {
        r = r * 2;
        if i == 63 + l {
            r = r + 1;
        }
        q = q << 1;
        if r >= d {
            r = r - d;
            q = q | 1;
        }
        i = i - 1;
    }
    if !in_rcx {
        x_mov_rr(b, 1, 0);              // rcx = n
    }
    x_mov_ri(b, 0, q + 1);
    x_bytes3(b, 72, 247, 233);          // imul rcx: rdx = high(m * n)
    x_rr(b, 1, 2, 1);                   // add rdx, rcx
    if l > 1 {
        x_shift_ri(b, 7, 2, l - 1);     // sar rdx, l - 1
    }
    x_mov_rr(b, 0, 1);
    x_shift_ri(b, 7, 0, 63);            // rax = s = n >> 63 (arithmetic)
    if op == OP_MOD {
        // n - (q0 - s) * d == (n + (s & -d)) - q0 * d: the sign fix-up
        // leaves the n -> q0 -> remainder chain
        x_ri(b, 4, 0, 0 - d);           // and rax, -d
        x_rr(b, 1, 0, 1);               // add rax, rcx
        x_imul_ri(b, 2, d);
        return x_rr(b, 41, 0, 2);       // rax = n + (s & -d) - q0 * d
    }
    x_rr(b, 41, 2, 0);                  // sub rdx, rax: q
    if op == OP_DIV {
        return x_mov_rr(b, 0, 2);
    }
    x_imul_ri(b, 2, d);
    x_mov_rr(b, 0, 1);
    return x_rr(b, 41, 0, 2);           // rax = n - q * d
}

fn x_inv_cc(cc: i64) -> i64 {
    if (cc & 1) == 1 {
        return cc - 1;
    }
    return cc + 1;
}

fn ng_binop(c: i64, n: i64) -> i64 {
    let b = ncode(c);
    let op = na(c, n);
    if op == OP_AND || op == OP_OR {
        let fails = vnew();
        ng_branch(c, n, false, fails);
        x_mov_ri(b, 0, 1);
        let end = x_jmp(b);
        ng_patch_all(c, fails);
        x_mov_ri(b, 0, 0);
        return x_patch_here(b, end);
    }
    if ng_fold(c, n) {
        return x_mov_ri(b, 0, ng(c, NG_OPV));
    }
    if x_is_cmp(op) {
        let cc = ng_cmp(c, n);
        return x_setcc_rax(b, cc);
    }
    let l = nb(c, n);
    let r = nc(c, n);
    if (op == OP_ADD || op == OP_SUB) && ng_mulc_add(c, l, r, op == OP_ADD, false) {
        return 0;
    }
    if op == OP_ADD && ng_mulc_add(c, r, l, true, false) {
        return 0;
    }
    let rk = ng_opnd(c, r);
    let rv = ng(c, NG_OPV);
    if rk > 0 && ng_op_direct(op, rk, rv) {
        ng_gen(c, l);
        return ng_op_apply(c, op, 0, rk, rv);
    }
    if (op == OP_DIV || op == OP_MOD) && rk == 1 && rv >= 2 {
        if nk(c, l) == K_BIN && na(c, l) == OP_ADD && (ng_mulc_add(c, nb(c, l), nc(c, l), true, true) || ng_mulc_add(c, nc(c, l), nb(c, l), true, true)) {
            return ng_divmod_const_at(c, op, rv, true);
        }
        ng_gen(c, l);
        return ng_divmod_const(c, op, rv);
    }
    let lk = ng_opnd(c, l);
    let lv = ng(c, NG_OPV);
    if lk > 0 && (op == OP_ADD || op == OP_MUL || op == OP_BAND || op == OP_BOR) {
        ng_gen(c, r);
        return ng_op_apply(c, op, 0, lk, lv);
    }
    if (op == OP_ADD || op == OP_SUB || op == OP_BAND || op == OP_BOR) && nk(c, r) == K_INDEX
        && ng_safe_index(c, na(c, r), nb(c, r)) >= 0 && ng_opnd(c, na(c, r)) == 2 {
        let av = ng(c, NG_OPV);
        if ng_opnd(c, nb(c, r)) == 2 {
            // rax op= a[i] from memory, array and index in registers
            let iv = ng(c, NG_OPV);
            ng_gen(c, l);
            let ra = ng_reg(c, av);
            let ri = ng_reg(c, iv);
            if ra >= 0 && ri >= 0 {
                return x_rmx(b, 0, ng_op_rm(op), 0, ra, ri, 3, 8);
            }
            x_push_rax(b);
            ng_index_direct(c, na(c, r), nb(c, r), false);
            x_mov_rcx_rax(b);
            x_pop_rax(b);
            return ng_op_rcx(c, op);
        }
    }
    ng_gen2(c, l, r);
    return ng_op_rcx(c, op);
}

// rax (rcx when `in_rcx`, adds only) = x * (2^k -+ 1) +- y for operands x (a slot) and y: (x << k) and
// (y -+ x) are independent, so the chain through x is two operations
// instead of three. False (nothing emitted) when the shape does not fit.
fn ng_mulc_add(c: i64, m: i64, y: i64, add: bool, in_rcx: bool) -> bool {
    if nk(c, m) != K_BIN || na(c, m) != OP_MUL {
        return false;
    }
    let mut xn = nb(c, m);
    let mut kn = nc(c, m);
    if ng_opnd(c, kn) != 1 {
        xn = nc(c, m);
        kn = nb(c, m);
        if ng_opnd(c, kn) != 1 {
            return false;
        }
    }
    let v = ng(c, NG_OPV);
    let mut sh = ng_log2(v + 1);
    let mut minus = true;
    if sh < 2 {
        sh = ng_log2(v - 1);
        minus = false;
        if sh < 1 {
            return false;
        }
    }
    if ng_opnd(c, xn) != 2 {
        return false;
    }
    let xv = ng(c, NG_OPV);
    let yk = ng_opnd(c, y);
    let yv = ng(c, NG_OPV);
    if yk == 0 {
        return false;
    }
    let b = ncode(c);
    // x*(2^k-1) + y = (x<<k) + (y-x)   x*(2^k-1) - y = (x<<k) - (y+x)
    // x*(2^k+1) + y = (x<<k) + (y+x)   x*(2^k+1) - y = (x<<k) - (y-x)
    ng_opnd_to(c, yk, yv, 1);
    if minus == add {
        ng_op_apply(c, OP_SUB, 1, 2, xv);
    } else {
        ng_op_apply(c, OP_ADD, 1, 2, xv);
    }
    ng_opnd_to(c, 2, xv, 0);
    x_shift_ri(b, 4, 0, sh);
    if add && in_rcx {
        x_rr(b, 1, 1, 0);       // add rcx, rax: result in rcx
    } else if add {
        x_rr(b, 1, 0, 1);       // add rax, rcx
    } else {
        x_rr(b, 41, 0, 1);      // sub rax, rcx
    }
    return true;
}

fn ng_struct_init(c: i64, n: i64) -> i64 {
    let fields = nb(c, n);
    let names = vnew();
    let slots = vnew();
    let mut i: i64 = 0;
    while i < list_len(c, fields) {
        vpush(names, list_at(c, fields, i));
        ng_gen(c, list_at(c, fields, i + 1));
        vpush(slots, ng_temp(c));
        i = i + 2;
    }
    let b = ncode(c);
    let decl = struct_def(c, na(c, n));
    if decl < 0 {
        ng_push_imm(c, struct_tag(c, na(c, n)));
        let mut j: i64 = 0;
        while j < vlen(slots) {
            ng_load(c, vget(slots, j));
            x_push_rax(b);
            j = j + 1;
        }
        return ng_site_cell(c, n, vlen(slots) + 1);
    }
    let order = nb(c, decl);
    let nf = list_len(c, order) / 2;
    // cell address register and base displacement: a heap cell in rax at
    // 0, or frame slots at [rbp + d] (every word written: frame memory is
    // not zeroed like fresh arena memory)
    let stack = ng_stack_site(c, n);
    let mut cr: i64 = 0;
    let mut d: i64 = 0;
    if stack {
        cr = 5;
        d = ng_disp(c, ng_cell_slots(c, nf + 1));
    } else {
        ng_alloc_const(c, (nf + 1) * 8);
    }
    let tag = struct_tag(c, na(c, n));
    if x_fits32(tag) {
        x_mov_mi(b, cr, d, tag);
    } else {
        x_mov_ri(b, 1, tag);
        x_rm(b, 137, 1, cr, d);
    }
    let mut f: i64 = 0;
    while f < nf {
        let mut v: i64 = -1;
        let mut k: i64 = 0;
        while k < vlen(names) {
            if vget(names, k) == list_at(c, order, f * 2) {
                v = vget(slots, k);
            }
            k = k + 1;
        }
        if v >= 0 {
            let mut r = ng_reg(c, v);
            if r < 0 {
                ng_load_to(c, v, 1);
                r = 1;
            }
            x_rm(b, 137, r, cr, d + 8 * (f + 1));
        } else if stack {
            x_mov_mi(b, cr, d + 8 * (f + 1), 0);
        }
        f = f + 1;
    }
    if stack {
        return x_rm(b, 141, 0, 5, d); // lea rax, [rbp + d]
    }
    return 0;
}

// Read (store < 0) or write (value in slot `store`) a struct field of the
// cell in slot `base`. A field shared by several structs dispatches on the
// tag. Leaves the read or stored value in rax.
fn ng_field_access(c: i64, base: i64, field: i64, store: i64) -> i64 {
    let b = ncode(c);
    let cands = field_candidates(c, field);
    if vlen(cands) == 2 {
        return ng_field_slot(c, base, vget(cands, 1) + 1, store);
    }
    ng_load(c, base);
    x_load_at(b, 0);
    let tag = ng_temp(c);
    let ends = vnew();
    let mut i: i64 = 0;
    while i < vlen(cands) {
        x_mov_rax_imm(b, vget(cands, i));
        x_mov_rcx_rax(b);
        ng_load(c, tag);
        x_binop(b, OP_EQ);
        x_test_rax(b);
        let next = x_jz(b);
        ng_field_slot(c, base, vget(cands, i + 1) + 1, store);
        vpush(ends, x_jmp(b));
        x_patch_here(b, next);
        i = i + 2;
    }
    ng_call_rt(c, "track_bad_field", 0);
    let mut j: i64 = 0;
    while j < vlen(ends) {
        x_patch_here(b, vget(ends, j));
        j = j + 1;
    }
    return 0;
}

fn ng_field_slot(c: i64, base: i64, idx: i64, store: i64) -> i64 {
    let b = ncode(c);
    ng_load(c, base);
    if store < 0 {
        return x_load_at(b, idx * 8);
    }
    x_mov_rcx_rax(b);
    ng_load(c, store);
    return x_store_at_rcx(b, idx * 8);
}

// Assign the value in slot `v` to a field / tuple element / array element.
fn ng_assign_place(c: i64, target: i64, v: i64) -> i64 {
    let b = ncode(c);
    let k = nk(c, target);
    if k == K_FIELD {
        ng_gen(c, na(c, target));
        let base = ng_temp(c);
        ng_field_access(c, base, nb(c, target), v);
    } else if k == K_TINDEX {
        ng_gen(c, na(c, target));
        x_mov_rcx_rax(b);
        ng_load(c, v);
        x_store_at_rcx(b, nb(c, target) * 8);
    } else if k == K_INDEX && ng_safe_index(c, na(c, target), nb(c, target)) >= 0 {
        ng_load_to(c, v, 2);
        ng_index_direct(c, na(c, target), nb(c, target), true);
    } else if k == K_INDEX {
        ng_gen2(c, na(c, target), nb(c, target));
        ng_load_to(c, v, 2);
        ng_array_check(c, "track_array_set", 3);
        x_rmx(b, 0, 137, 2, 0, 1, 3, 8); // mov [rax + rcx*8 + 8], rdx
    }
    return ng_load(c, v);
}

// Bounds check of array rax at index rcx; failures go to a cold call of
// the runtime function, which reports and exits.
fn ng_array_check(c: i64, rt: i64, nargs: i64) -> i64 {
    let b = ncode(c);
    let fails = vnew();
    x_test_rax(b);
    vpush(fails, x_jcc(b, 4));
    x_rm(b, 59, 1, 0, 0);          // cmp rcx, [rax]
    vpush(fails, x_jcc(b, 3));     // jae (unsigned: negative too)
    return ng_cold(c, fails, rt, nargs);
}

// rax = array rax [rcx], bounds checked
fn ng_array_get(c: i64) -> i64 {
    ng_array_check(c, "track_array_get", 2);
    return x_rmx(ncode(c), 0, 139, 0, 0, 1, 3, 8); // mov rax, [rax + rcx*8 + 8]
}

fn ng_var(c: i64, n: i64) -> i64 {
    let b = ncode(c);
    let name = na(c, n);
    let local = ni(c, name, NI_CVAR);
    if local >= 0 {
        return ng_load(c, local);
    }
    if local <= -2 {
        return x_mov_ri(b, 0, vget(ng(c, NG_CBIND), -2 - local));
    }
    let disc = variant_disc(c, name);
    if is_qualified(c, name) {
        if disc < 0 {
            return x_mov_rax_imm(b, 0);
        }
        if is_payload_variant(c, name) {
            ng_push_imm(c, disc);
            x_push_zero(b);
            return ng_cell(c, 2);
        }
        return x_mov_rax_imm(b, disc);
    }
    if ni(c, name, NI_CONSTOK) == 1 {
        return x_mov_rax_imm(b, ni(c, name, NI_CONSTVAL));
    }
    return x_mov_rax_imm(b, 0);
}

fn ng_builtin(c: i64, text: i64) -> i64 {
    if text_eq(text, "syscall6") { return 7; }
    if text_eq(text, "memset") { return 3; }
    // libc system call wrappers (elf.trk), lowered to `syscall`
    if text_eq(text, "write") { return 3; }
    if text_eq(text, "open64") { return 3; }
    if text_eq(text, "fchmod") { return 2; }
    if text_eq(text, "close") { return 1; }
    if text_eq(text, "load64") { return 1; }
    if text_eq(text, "load8") { return 1; }
    if text_eq(text, "store64") { return 2; }
    if text_eq(text, "store8") { return 2; }
    return -1;
}

fn ng_libc_syscall(text: i64) -> i64 {
    if text_eq(text, "write") { return 1; }
    if text_eq(text, "open64") { return 2; }
    if text_eq(text, "close") { return 3; }
    if text_eq(text, "fchmod") { return 91; }
    return -1;
}

// Six syscall arguments are on the stack; load them and run syscall `nr`.
fn ng_libc_call(c: i64, nr: i64) -> i64 {
    let b = ncode(c);
    x_bytes2(b, 65, 89);  // pop r9
    x_bytes2(b, 65, 88);  // pop r8
    x_bytes2(b, 65, 90);  // pop r10
    x_byte(b, 90);        // pop rdx
    x_byte(b, 94);        // pop rsi
    x_byte(b, 95);        // pop rdi
    x_mov_rax_imm(b, nr);
    return x_bytes2(b, 15, 5);
}

fn ng_call(c: i64, n: i64, args: i64) -> i64 {
    let b = ncode(c);
    let name = na(c, n);
    let count = list_len(c, args);
    let tail = ng(c, NG_TAIL) == 1;
    ng_set(c, NG_TAIL, 0);
    if is_qualified(c, name) {
        let disc = variant_disc(c, name);
        if disc >= 0 {
            if is_payload_variant(c, name) {
                ng_push_imm(c, disc);
                let mut i: i64 = 0;
                while i < count {
                    ng_gen(c, list_at(c, args, i));
                    x_push_rax(b);
                    i = i + 1;
                }
                return ng_site_cell(c, n, count + 1);
            }
            let mut j: i64 = 0;
            while j < count {
                ng_gen(c, list_at(c, args, j));
                j = j + 1;
            }
            return x_mov_rax_imm(b, disc);
        }
    }
    let mut target = name;
    if ni(c, name, NI_FN) < 0 {
        target = last_segment(c, name);
    }
    let f = ni(c, target, NI_FN);
    let mut arity: i64 = count;
    let mut callee = target;
    let mut builtin: i64 = -1;
    if f >= 0 {
        arity = list_len(c, nc(c, f)) / 2;
        callee = na(c, f);
    } else {
        let text = name_text(c, target);
        builtin = ng_builtin(c, text);
        if text_eq(text, "abort") {
            callee = intern(c, "track_abort");
            arity = 1;
            if ni(c, callee, NI_FN) < 0 {
                vpush(ng(c, NG_MISSING), callee);
            }
        } else if builtin >= 0 {
            arity = builtin;
        } else {
            vpush(ng(c, NG_MISSING), target);
        }
    }
    if f >= 0 && na(c, n) == name {
        let mark = ng_inline_begin(c, f, args);
        if mark >= 0 {
            ng_gen(c, ng_inline_body(c, f));
            return ng_inline_end(c, mark);
        }
        if ng_prim(c, name_text(c, callee), args, count) {
            return 0;
        }
        if !tail && ng_inline_full(c, f, args) {
            return 0;
        }
        if !tail && ng(c, NG_INLDEPTH) > 0 && f == ng(c, NG_CURFN) && ng_call_guarded(c, f, args) {
            return 0;
        }
    }
    if builtin >= 0 && ng_mem_builtin(c, name_text(c, target), args) {
        return 0;
    }
    let mut i: i64 = 0;
    while i < count {
        ng_gen(c, list_at(c, args, i));
        if i < arity {
            x_push_rax(b);
        }
        i = i + 1;
    }
    while i < arity {
        x_push_zero(b);
        i = i + 1;
    }
    if builtin < 0 && tail {
        // tail call: frame gone, arguments where the callee expects them, jump
        if arity <= 6 {
            let mut r: i64 = arity - 1;
            while r >= 0 {
                x_pop_r(b, ng_arg_reg(r));
                r = r - 1;
            }
            if ng(c, NG_STACKARGS) == 1 {
                ng_tail_frame(c, 0);
            } else if ng(c, NG_FRAMELESS) == 0 {
                ng_unframe(c);
            }
        } else {
            ng_set(c, NG_VOLX, 1); // needs the rbp frame
            ng_tail_frame(c, arity);
        }
        let pos = x_jmp(b);
        let fix = ng(c, NG_CALLS);
        vpush(fix, pos);
        vpush(fix, callee);
        ng_set(c, NG_TAILDONE, 1);
        return 0;
    }
    if builtin < 0 {
        return ng_call_id(c, callee, arity);
    }
    let text = name_text(c, target);
    if text_eq(text, "syscall6") {
        ng_set(c, NG_CLOB, 1);
        ng_set(c, NG_VOLX, 1);
        return x_sys_insn(b);
    }
    let nr = ng_libc_syscall(text);
    if nr >= 0 {
        // shift the pushed arguments into syscall6 shape: nr, a..f
        let mut k: i64 = 0;
        while k < 6 - arity {
            x_push_zero(b);
            k = k + 1;
        }
        ng_set(c, NG_CLOB, 1);
        ng_set(c, NG_VOLX, 1);
        return ng_libc_call(c, nr);
    }
    if text_eq(text, "memset") {
        ng_set(c, NG_VOLX, 1);
        return x_memset(b);
    }
    if text_eq(text, "load64") {
        x_pop_rax(b);
        return x_mov_load(b);
    }
    if text_eq(text, "load8") {
        x_pop_rax(b);
        return x_movzx_load(b);
    }
    x_pop_rax(b);
    x_pop_rcx(b);
    if text_eq(text, "store64") {
        x_mov_store(b);
    } else {
        x_movb_store(b);
    }
    return x_mov_rax_imm(b, 0);
}

fn ng_block(c: i64, body: i64) -> i64 {
    return ng_block_v(c, body, false);
}

// A block; with `void` its value is unused, so the last statement need not
// leave it in rax.
fn ng_block_v(c: i64, body: i64, discard: bool) -> i64 {
    let mark = ng_scope_begin(c);
    let n = list_len(c, body);
    if n == 0 && !discard {
        x_mov_rax_imm(ncode(c), 0);
    }
    let mut i: i64 = 0;
    while i < n {
        if discard || i + 1 < n {
            ng_stmt(c, list_at(c, body, i));
        } else {
            ng_gen(c, list_at(c, body, i));
        }
        i = i + 1;
    }
    return ng_scope_end(c, mark);
}

// A statement whose value is unused.
fn ng_stmt(c: i64, n: i64) -> i64 {
    let k = nk(c, n);
    if k == K_IF {
        return ng_if(c, n, true);
    }
    if k == K_ASSIGN && ng_assign_local(c, n) {
        return 0;
    }
    if k == K_LET {
        let value = nd(c, n);
        let vk = ng_opnd(c, value);
        let vv = ng(c, NG_OPV);
        if vk == 1 {
            let id = ng_new_local(c, na(c, n));
            ng_set_imm(c, id, vv);
            return ng_let_facts(c, n, id);
        }
        let k2 = ng_slot(c);
        ng_gen_into(c, value, k2);
        ng_bind(c, na(c, n), k2);
        return ng_let_facts(c, n, k2);
    }
    if k == K_ASSIGN {
        let target = na(c, n);
        if nk(c, target) == K_VAR && ni(c, na(c, target), NI_CVAR) >= 0 {
            return ng_gen_into(c, nb(c, n), ni(c, na(c, target), NI_CVAR));
        }
        if nk(c, target) == K_INDEX && ng_safe_index(c, na(c, target), nb(c, target)) >= 0 {
            // in-bounds element store whose value is unused: no temporary
            ng_gen(c, nb(c, n));
            x_mov_rr(ncode(c), 2, 0);
            return ng_index_direct(c, na(c, target), nb(c, target), true);
        }
    }
    return ng_gen(c, n);
}

fn ng_set_imm(c: i64, k: i64, v: i64) -> i64 {
    let r = ng_reg(c, k);
    if r >= 0 {
        return x_mov_ri(ncode(c), r, v);
    }
    return x_mov_mi(ncode(c), 5, ng_disp(c, k), v);
}

// `x = x op e` / `x = e` on a local, as a statement; false if not handled.
fn ng_assign_local(c: i64, n: i64) -> bool {
    let target = na(c, n);
    if nk(c, target) != K_VAR {
        return false;
    }
    let t = ni(c, na(c, target), NI_CVAR);
    if t < 0 {
        return false;
    }
    let b = ncode(c);
    let value = nb(c, n);
    let vk = ng_opnd(c, value);
    let vv = ng(c, NG_OPV);
    if vk == 1 {
        ng_set_imm(c, t, vv);
        return true;
    }
    if nk(c, value) != K_BIN {
        return false;
    }
    let op = na(c, value);
    let l = nb(c, value);
    if nk(c, l) != K_VAR || ni(c, na(c, l), NI_CVAR) != t {
        return false;
    }
    if !(op == OP_ADD || op == OP_SUB || op == OP_BAND || op == OP_BOR || op == OP_MUL || op == OP_SHL || op == OP_SHR) {
        return false;
    }
    let r = nc(c, value);
    let rk = ng_opnd(c, r);
    let rv = ng(c, NG_OPV);
    let tr = ng_reg(c, t);
    if tr >= 0 {
        if rk > 0 && ng_op_direct(op, rk, rv) {
            ng_op_apply(c, op, tr, rk, rv);
            return true;
        }
        if op == OP_SHL || op == OP_SHR {
            return false;
        }
        // t op= rax
        ng_gen(c, r);
        if op == OP_MUL {
            x_rr2(b, 175, tr, 0);
        } else {
            x_rr(b, ng_op_rm(op) - 2, tr, 0);
        }
        return true;
    }
    if op == OP_MUL || op == OP_SHL || op == OP_SHR {
        return false;
    }
    // memory destination: op [rbp+d], imm / reg
    let d = ng_disp(c, t);
    if rk == 1 {
        x_mi(b, ng_op_ext(op), 5, d, rv);
        return true;
    }
    if rk == 2 {
        let s = ng_reg(c, rv);
        if s >= 0 {
            x_rm(b, ng_op_rm(op) - 2, s, 5, d);
            return true;
        }
    }
    ng_gen(c, r);
    x_rm(b, ng_op_rm(op) - 2, 0, 5, d);
    return true;
}

fn ng_if(c: i64, n: i64, discard: bool) -> i64 {
    let b = ncode(c);
    let els = nc(c, n);
    if discard && ng(c, NG_ACC) >= 0 && ng(c, NG_ACCBODY) < 0 && vlen(ng(c, NG_EXITS)) == ng(c, NG_ACCLVL) && ng_guard(c, ng(c, NG_ACCFN)) == n {
        // the accumulator loop's guard: taken only to leave, the return it
        // guards is emitted after the back edge (ng_acc_back), which
        // re-tests the guard and jumps to the body here
        let pend = vnew();
        ng_branch(c, na(c, n), true, pend);
        ng_set(c, NG_ACCRET, pend);
        return ng_set(c, NG_ACCBODY, x_here(b));
    }
    let to_else = vnew();
    ng_branch(c, na(c, n), false, to_else);
    ng_block_v(c, nb(c, n), discard);
    if discard && list_len(c, els) == 0 {
        return ng_patch_all(c, to_else);
    }
    let to_end = x_jmp(b);
    ng_patch_all(c, to_else);
    ng_block_v(c, els, discard);
    return x_patch_here(b, to_end);
}

// Pad (never executed: the loop is entered by a jump) to a 16-byte boundary.
fn ng_align(c: i64) -> i64 {
    let b = ncode(c);
    while x_here(b) % 16 != 0 {
        x_byte(b, 144);
    }
    return 0;
}

fn ng_loop_enter(c: i64) -> i64 { return ng_set(c, NG_DEPTH, ng(c, NG_DEPTH) + 1); }
fn ng_loop_leave(c: i64) -> i64 { return ng_set(c, NG_DEPTH, ng(c, NG_DEPTH) - 1); }

// `n` mentions one of the names in `names`, or is a construct this check
// does not look into.
fn ng_mentions(c: i64, n: i64, names: i64) -> bool {
    let k = nk(c, n);
    if k == K_INT || k == K_BOOL || k == K_STR {
        return false;
    }
    if k == K_VAR {
        return ng_vhas(names, na(c, n));
    }
    if k == K_BIN || k == K_ASSIGN || k == K_INDEX {
        if k == K_BIN {
            return ng_mentions(c, nb(c, n), names) || ng_mentions(c, nc(c, n), names);
        }
        return ng_mentions(c, na(c, n), names) || ng_mentions(c, nb(c, n), names);
    }
    if k == K_UN {
        return ng_mentions(c, nb(c, n), names);
    }
    if k == K_FIELD {
        return ng_mentions(c, na(c, n), names);
    }
    if k == K_CALL {
        if ng_vhas(names, na(c, n)) {
            return true;
        }
        let args = nb(c, n);
        let mut i: i64 = 0;
        while i < list_len(c, args) {
            if ng_mentions(c, list_at(c, args, i), names) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    return true;
}

fn ng_vhas(v: i64, x: i64) -> bool {
    let mut i: i64 = 0;
    while i < vlen(v) {
        if vget(v, i) == x {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Index of the else-less `if` a loop body ends with, followed only by
// assignments and calls that use none of the body's own `let` names (the
// latch, generated a second time ahead of the body), or -1.
fn ng_latch_if(c: i64, body: i64) -> i64 {
    let n = list_len(c, body);
    let mut t: i64 = n - 1;
    while t >= 0 && (nk(c, list_at(c, body, t)) == K_ASSIGN || nk(c, list_at(c, body, t)) == K_CALL) {
        t = t - 1;
    }
    if t < 0 {
        return -1;
    }
    let st = list_at(c, body, t);
    if nk(c, st) != K_IF || list_len(c, nc(c, st)) != 0 {
        return -1;
    }
    let lets = vnew();
    let mut i: i64 = 0;
    while i < t {
        let s = list_at(c, body, i);
        if nk(c, s) == K_LETD {
            return -1;
        }
        if nk(c, s) == K_LET {
            vpush(lets, na(c, s));
        }
        i = i + 1;
    }
    let mut j: i64 = t + 1;
    while j < n {
        if ng_mentions(c, list_at(c, body, j), lets) {
            return -1;
        }
        j = j + 1;
    }
    return t;
}

// while: the test sits at the bottom, entered by a jump from the top.
// A body ending in `if c { B } T` (T: ng_latch_if) is laid out latch first,
//     latch: T; exit unless cond     top: S; to latch unless c; B; T
//     enter: back to top if cond
// so an iteration takes one taken branch whether or not B runs.
fn ng_while(c: i64, n: i64) -> i64 {
    let b = ncode(c);
    let hoisted = ng_hoist_strlen(c, n);
    let choisted = ng_hoist_coll(c, n);
    let body = nb(c, n);
    let t = ng_latch_if(c, body);
    ng_loop_enter(c);
    let enter = x_jmp(b);
    ng_align(c);
    let mut top = x_here(b);
    if t >= 0 {
        let latch = top;
        let out = vnew();
        let mark = ng_scope_begin(c);
        let mut j: i64 = t + 1;
        while j < list_len(c, body) {
            ng_stmt(c, list_at(c, body, j));
            j = j + 1;
        }
        ng_scope_end(c, mark);
        ng_branch(c, na(c, n), false, out);
        top = x_here(b);
        let mark2 = ng_scope_begin(c);
        let mut i: i64 = 0;
        while i < t {
            ng_stmt(c, list_at(c, body, i));
            i = i + 1;
        }
        let st = list_at(c, body, t);
        let skip = vnew();
        ng_branch(c, na(c, st), false, skip);
        let mut q: i64 = 0;
        while q < vlen(skip) {
            x_patch_rel(b, vget(skip, q), latch);
            q = q + 1;
        }
        ng_block_v(c, nb(c, st), true);
        j = t + 1;
        while j < list_len(c, body) {
            ng_stmt(c, list_at(c, body, j));
            j = j + 1;
        }
        ng_scope_end(c, mark2);
        x_patch_here(b, enter);
        let back = vnew();
        ng_branch(c, na(c, n), true, back);
        let mut k: i64 = 0;
        while k < vlen(back) {
            x_patch_rel(b, vget(back, k), top);
            k = k + 1;
        }
        ng_patch_all(c, out);
    } else {
        ng_block_v(c, body, true);
        x_patch_here(b, enter);
        let back = vnew();
        ng_branch(c, na(c, n), true, back);
        let mut i: i64 = 0;
        while i < vlen(back) {
            x_patch_rel(b, vget(back, i), top);
            i = i + 1;
        }
    }
    ng_loop_leave(c);
    vtrunc(ng(c, NG_STRLEN), vlen(ng(c, NG_STRLEN)) - 2 * hoisted);
    vtrunc(ng(c, NG_CHOIST), vlen(ng(c, NG_CHOIST)) - 3 * choisted);
    return x_mov_rax_imm(b, 0);
}

fn ng_for(c: i64, n: i64) -> i64 {
    let b = ncode(c);
    let iter = nb(c, n);
    let start = ng_slot(c);
    let end = ng_slot(c);
    if nk(c, iter) == K_RANGE {
        ng_gen(c, na(c, iter));
        ng_store(c, start);
        ng_gen(c, nb(c, iter));
        ng_store(c, end);
    } else {
        ng_set_imm(c, start, 0);
        ng_gen(c, iter);
        ng_store(c, end);
    }
    ng_loop_enter(c);
    let enter = x_jmp(b);
    ng_align(c);
    let top = x_here(b);
    let mark = ng_scope_begin(c);
    let var = ng_new_local(c, na(c, n));
    ng_load(c, start);
    ng_store(c, var);
    ng_block_v(c, nc(c, n), true);
    ng_scope_end(c, mark);
    let sr = ng_reg(c, start);
    if sr >= 0 {
        x_ri(b, 0, sr, 1);
    } else {
        x_mi(b, 0, 5, ng_disp(c, start), 1);
    }
    x_patch_here(b, enter);
    ng_load(c, start);
    ng_op_apply(c, OP_LT, 0, 2, end);
    x_patch_rel(b, x_jcc(b, 12), top);
    ng_loop_leave(c);
    return x_mov_rax_imm(b, 0);
}

// `return x + f(args)` in f itself: an accumulator-recursion return.
fn ng_is_acc_return(c: i64, f: i64, value: i64) -> bool {
    if value < 0 || nk(c, value) != K_BIN || na(c, value) != OP_ADD {
        return false;
    }
    let call = nc(c, value);
    if nk(c, call) != K_CALL || ng_call_target(c, call) != f {
        return false;
    }
    return list_len(c, nb(c, call)) * 2 == list_len(c, nc(c, f));
}

fn ng_find_acc(c: i64, f: i64, l: i64) -> bool {
    let mut i: i64 = 0;
    while i < list_len(c, l) {
        let n = list_at(c, l, i);
        let k = nk(c, n);
        if k == K_RETURN && ng_is_acc_return(c, f, na(c, n)) {
            return true;
        }
        if k == K_IF && (ng_find_acc(c, f, nb(c, n)) || ng_find_acc(c, f, nc(c, n))) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// rax += the accumulator of an accumulator-recursive function.
fn ng_add_acc(c: i64) -> i64 {
    let acc = ng(c, NG_ACC);
    if acc < 0 {
        return 0;
    }
    return ng_op_apply(c, OP_ADD, 0, 2, acc);
}

// Back edge of an accumulator loop. With its guard already passed once
// (NG_ACCBODY), the guard is re-tested here: the loop continues with one
// taken branch, and the guard's return is emitted inline for the exit.
fn ng_acc_back(c: i64) -> i64 {
    let b = ncode(c);
    let body = ng(c, NG_ACCBODY);
    if body < 0 {
        return x_patch_rel(b, x_jmp(b), ng(c, NG_ACCTOP));
    }
    let g = ng_guard(c, ng(c, NG_ACCFN));
    let back = vnew();
    ng_branch(c, na(c, g), false, back);
    let mut i: i64 = 0;
    while i < vlen(back) {
        x_patch_rel(b, vget(back, i), body);
        i = i + 1;
    }
    if ng(c, NG_ACCRET) < 0 {
        return ng_return(c, list_at(c, nb(c, g), 0));
    }
    return ng_acc_flush(c);
}

// Emit the accumulator loop's guarded return for jumps still waiting.
fn ng_acc_flush(c: i64) -> i64 {
    let pend = ng(c, NG_ACCRET);
    if pend < 0 {
        return 0;
    }
    ng_set(c, NG_ACCRET, -1);
    ng_patch_all(c, pend);
    return ng_return(c, list_at(c, nb(c, ng_guard(c, ng(c, NG_ACCFN))), 0));
}

fn ng_acc_flush_end(c: i64) -> i64 {
    if ng(c, NG_ACC) < 0 || ng(c, NG_ACCRET) < 0 {
        return 0;
    }
    let b = ncode(c);
    let skip = x_jmp(b);
    ng_acc_flush(c);
    return x_patch_here(b, skip);
}

fn ng_return(c: i64, n: i64) -> i64 {
    let b = ncode(c);
    let value = na(c, n);
    if ng(c, NG_ACC) >= 0 && vlen(ng(c, NG_EXITS)) == ng(c, NG_ACCLVL) && ng_is_acc_return(c, ng(c, NG_ACCFN), value) {
        // acc += x; params = args; loop: f(a) + x == x + f(a), wrapping
        ng_gen(c, nb(c, value));
        let acc = ng(c, NG_ACC);
        let ar = ng_reg(c, acc);
        if ar >= 0 {
            x_rr(b, 1, ar, 0);
        } else {
            x_rm(b, 1, 0, 5, ng_disp(c, acc));
        }
        let args = nb(c, nc(c, value));
        let tmps = vnew();
        let fparams = nc(c, ng(c, NG_ACCFN));
        if list_len(c, args) == 1 {
            ng_gen_into(c, list_at(c, args, 0), ni(c, list_at(c, fparams, 0), NI_CVAR));
            return ng_acc_back(c);
        }
        let mut i: i64 = 0;
        while i < list_len(c, args) {
            ng_gen(c, list_at(c, args, i));
            vpush(tmps, ng_temp(c));
            i = i + 1;
        }
        let mut j: i64 = 0;
        while j < vlen(tmps) {
            ng_load(c, vget(tmps, j));
            ng_store(c, ni(c, list_at(c, fparams, j * 2), NI_CVAR));
            j = j + 1;
        }
        return ng_acc_back(c);
    }
    if value >= 0 && nk(c, value) == K_CALL && ng(c, NG_RETVAL) == 1 && ng(c, NG_ACC) < 0 && vlen(ng(c, NG_EXITS)) == 0 {
        ng_set(c, NG_TAIL, 1);
        ng_set(c, NG_TAILDONE, 0);
        ng_gen(c, value);
        ng_set(c, NG_TAIL, 0);
        if ng(c, NG_TAILDONE) == 1 {
            ng_set(c, NG_TAILDONE, 0);
            return 0;
        }
        return ng_epilogue(c);
    }
    if value >= 0 {
        ng_gen(c, value);
    }
    if ng(c, NG_RETVAL) != 1 || value < 0 {
        x_mov_rax_imm(b, 0);
    }
    let exits = ng(c, NG_EXITS);
    if vlen(exits) > 0 {
        return vpush(vget(exits, vlen(exits) - 1), x_jmp(b));
    }
    ng_add_acc(c);
    return ng_epilogue(c);
}

// Tuple literal: a heap cell of its elements (docs/bootstrap.md "Value
// model"); leaves the cell in rax. `let (a, b) = (x, y)` binds the
// elements directly and makes no cell (ng_letd).
fn ng_tuple(c: i64, n: i64) -> i64 {
    let b = ncode(c);
    let elems = na(c, n);
    let count = list_len(c, elems);
    let mut i: i64 = 0;
    while i < count {
        ng_gen(c, list_at(c, elems, i));
        x_push_rax(b);
        i = i + 1;
    }
    return ng_site_cell(c, n, count);
}

// Slot holding element `i` of the cell in slot `k`.
fn ng_elem(c: i64, k: i64, i: i64) -> i64 {
    ng_load(c, k);
    x_load_at(ncode(c), i * 8);
    return ng_temp(c);
}

fn ng_bind_pattern(c: i64, p: i64, k: i64) -> i64 {
    let pk = nk(c, p);
    if pk == P_IDENT {
        let id = ng_new_local(c, na(c, p));
        ng_load(c, k);
        return ng_store(c, id);
    }
    if pk == P_TUPLE {
        let pats = na(c, p);
        let mut i: i64 = 0;
        while i < list_len(c, pats) {
            ng_bind_pattern(c, list_at(c, pats, i), ng_elem(c, k, i));
            i = i + 1;
        }
        return 0;
    }
    if pk == P_VARIANT {
        let bindings = nc(c, p);
        let payload = is_payload_union(c, na(c, p));
        let mut i: i64 = 0;
        while i < list_len(c, bindings) {
            if payload {
                ng_bind_pattern(c, list_at(c, bindings, i), ng_elem(c, k, i + 1));
            } else {
                ng_bind_pattern(c, list_at(c, bindings, i), k);
            }
            i = i + 1;
        }
        return 0;
    }
    if pk == P_STRUCT {
        let decl = struct_def(c, na(c, p));
        if decl < 0 {
            return 0;
        }
        let fields = nb(c, p);
        let mut i: i64 = 0;
        while i < list_len(c, fields) {
            let idx = struct_field_index(c, decl, list_at(c, fields, i));
            if idx >= 0 {
                ng_bind_pattern(c, list_at(c, fields, i + 1), ng_elem(c, k, idx + 1));
            }
            i = i + 2;
        }
    }
    return 0;
}

fn ng_trivial_pattern(c: i64, p: i64) -> bool {
    let pk = nk(c, p);
    return pk == P_IDENT || pk == P_WILD;
}

// rax == imm, else jump to a failure (rel32 position pushed on `fails`).
fn ng_expect_imm(c: i64, v: i64, fails: i64) -> i64 {
    let b = ncode(c);
    x_push_rax(b);
    x_mov_rax_imm(b, v);
    x_mov_rcx_rax(b);
    x_pop_rax(b);
    x_binop(b, OP_EQ);
    x_test_rax(b);
    return vpush(fails, x_jz(b));
}

// Emit a test of pattern `p` against the value in slot `k`; every failing
// path jumps to a position recorded in `fails`.
fn ng_pattern_test(c: i64, p: i64, k: i64, fails: i64) -> i64 {
    let b = ncode(c);
    let pk = nk(c, p);
    if pk == P_LIT {
        let lit = na(c, p);
        if nk(c, lit) == K_STR {
            ng_load(c, k);
            x_push_rax(b);
            ng_string(c, na(c, lit));
            x_push_rax(b);
            ng_call_rt(c, "str_eq", 2);
        } else {
            ng_gen(c, lit);
            x_mov_rcx_rax(b);
            ng_load(c, k);
            x_binop(b, OP_EQ);
        }
        x_test_rax(b);
        return vpush(fails, x_jz(b));
    }
    if pk == P_VARIANT {
        let vname = variant_name(c, na(c, p), nb(c, p));
        let mut disc = variant_disc(c, vname);
        if disc < 0 {
            disc = 0;
        }
        ng_load(c, k);
        if is_payload_union(c, na(c, p)) {
            x_load_at(b, 0);
        }
        return ng_expect_imm(c, disc, fails);
    }
    if pk == P_TUPLE {
        let pats = na(c, p);
        let mut i: i64 = 0;
        while i < list_len(c, pats) {
            let sub = list_at(c, pats, i);
            if !ng_trivial_pattern(c, sub) {
                ng_pattern_test(c, sub, ng_elem(c, k, i), fails);
            }
            i = i + 1;
        }
        return 0;
    }
    if pk == P_STRUCT {
        let decl = struct_def(c, na(c, p));
        if decl < 0 {
            return 0;
        }
        ng_load(c, k);
        x_load_at(b, 0);
        ng_expect_imm(c, struct_tag(c, na(c, p)), fails);
        let fields = nb(c, p);
        let mut i: i64 = 0;
        while i < list_len(c, fields) {
            let idx = struct_field_index(c, decl, list_at(c, fields, i));
            let sub = list_at(c, fields, i + 1);
            if idx >= 0 && !ng_trivial_pattern(c, sub) {
                ng_pattern_test(c, sub, ng_elem(c, k, idx + 1), fails);
            }
            i = i + 2;
        }
    }
    return 0;
}

fn ng_patch_all(c: i64, list: i64) -> i64 {
    let mut i: i64 = 0;
    while i < vlen(list) {
        x_patch_here(ncode(c), vget(list, i));
        i = i + 1;
    }
    return 0;
}

fn ng_match(c: i64, n: i64) -> i64 {
    let b = ncode(c);
    ng_gen(c, na(c, n));
    let m = ng_temp(c);
    let ends = vnew();
    let arms = nb(c, n);
    let mut i: i64 = 0;
    while i < list_len(c, arms) {
        let pattern = list_at(c, arms, i);
        let guard = list_at(c, arms, i + 1);
        let body = list_at(c, arms, i + 2);
        let fails = vnew();
        ng_pattern_test(c, pattern, m, fails);
        let mark = ng_scope_begin(c);
        ng_bind_pattern(c, pattern, m);
        if guard >= 0 {
            ng_gen(c, guard);
            x_test_rax(b);
            vpush(fails, x_jz(b));
        }
        ng_gen(c, body);
        vpush(ends, x_jmp(b));
        ng_scope_end(c, mark);
        ng_patch_all(c, fails);
        i = i + 3;
    }
    x_mov_rax_imm(b, 0);
    return ng_patch_all(c, ends);
}

fn ng_letd(c: i64, n: i64) -> i64 {
    let pattern = na(c, n);
    let value = nc(c, n);
    if nk(c, value) == K_TUPLE && nk(c, pattern) == P_TUPLE && list_len(c, na(c, value)) == list_len(c, na(c, pattern)) {
        let elems = na(c, value);
        let tmps = vnew();
        let mut i: i64 = 0;
        while i < list_len(c, elems) {
            ng_gen(c, list_at(c, elems, i));
            vpush(tmps, ng_temp(c));
            i = i + 1;
        }
        let pats = na(c, pattern);
        let mut j: i64 = 0;
        while j < vlen(tmps) {
            ng_bind_pattern(c, list_at(c, pats, j), vget(tmps, j));
            j = j + 1;
        }
        return x_mov_rax_imm(ncode(c), 0);
    }
    ng_gen(c, value);
    let t = ng_temp(c);
    ng_bind_pattern(c, pattern, t);
    return x_mov_rax_imm(ncode(c), 0);
}

fn ng_lens(c: i64, n: i64) -> i64 {
    let mark = ng_scope_begin(c);
    let target = ni(c, na(c, n), NI_CVAR);
    if target >= 0 {
        ng_bind(c, nb(c, n), target);
    }
    ng_block(c, nc(c, n));
    return ng_scope_end(c, mark);
}

fn ng_gen(c: i64, n: i64) -> i64 {
    let b = ncode(c);
    let k = nk(c, n);
    if k == K_INT || k == K_BOOL { return x_mov_rax_imm(b, na(c, n)); }
    if k == K_STR { return ng_string(c, na(c, n)); }
    if k == K_VAR { return ng_var(c, n); }
    if k == K_BIN { return ng_binop(c, n); }
    if k == K_UN {
        ng_gen(c, nb(c, n));
        if na(c, n) == OP_NEG { return x_neg_rax(b); }
        if na(c, n) == OP_NOT { return x_not_rax(b); }
        return 0;
    }
    if k == K_ADDR { return ng_gen(c, na(c, n)); }
    if k == K_CALL || k == K_MACROCALL { return ng_call(c, n, nb(c, n)); }
    if k == K_LET {
        ng_gen(c, nd(c, n));
        let id = ng_new_local(c, na(c, n));
        ng_store(c, id);
        return ng_let_facts(c, n, id);
    }
    if k == K_ASSIGN {
        ng_gen(c, nb(c, n));
        let target = na(c, n);
        if nk(c, target) == K_VAR && ni(c, na(c, target), NI_CVAR) >= 0 {
            let id = ni(c, na(c, target), NI_CVAR);
            return ng_store(c, id);
        }
        let v = ng_temp(c);
        return ng_assign_place(c, target, v);
    }
    if k == K_IF { return ng_if(c, n, false); }
    if k == K_WHILE { return ng_while(c, n); }
    if k == K_FOR { return ng_for(c, n); }
    if k == K_RETURN { return ng_return(c, n); }
    if k == K_LENS { return ng_lens(c, n); }
    if k == K_TUPLE { return ng_tuple(c, n); }
    if k == K_TINDEX {
        ng_gen(c, na(c, n));
        return x_load_at(b, nb(c, n) * 8);
    }
    if k == K_LETD { return ng_letd(c, n); }
    if k == K_MATCH { return ng_match(c, n); }
    if k == K_SLICE {
        ng_gen(c, na(c, n));
        x_push_rax(b);
        if nb(c, n) >= 0 {
            ng_gen(c, nb(c, n));
            x_push_rax(b);
        } else {
            x_push_zero(b);
        }
        if nc(c, n) >= 0 {
            ng_gen(c, nc(c, n));
            x_push_rax(b);
        } else {
            ng_push_imm(c, -1);
        }
        return ng_call_rt(c, "track_array_slice", 3);
    }
    if k == K_ARRAY {
        let elems = na(c, n);
        let count = list_len(c, elems);
        ng_push_imm(c, count);
        let mut i: i64 = 0;
        while i < count {
            ng_gen(c, list_at(c, elems, i));
            x_push_rax(b);
            i = i + 1;
        }
        return ng_site_cell(c, n, count + 1);
    }
    if k == K_INDEX {
        if ng_safe_index(c, na(c, n), nb(c, n)) >= 0 {
            return ng_index_direct(c, na(c, n), nb(c, n), false);
        }
        ng_gen2(c, na(c, n), nb(c, n));
        return ng_array_get(c);
    }
    if k == K_FIELD {
        let cands = field_candidates(c, nb(c, n));
        if vlen(cands) == 2 {
            ng_gen(c, na(c, n));
            return x_rm(b, 139, 0, 0, 8 * (vget(cands, 1) + 1));
        }
        ng_gen(c, na(c, n));
        let base = ng_temp(c);
        return ng_field_access(c, base, nb(c, n), -1);
    }
    if k == K_SINIT { return ng_struct_init(c, n); }
    if k == K_RANGE {
        ng_gen(c, nb(c, n));
        x_push_rax(b);
        ng_gen(c, na(c, n));
        x_mov_rcx_rax(b);
        x_pop_rax(b);
        return x_binop(b, OP_SUB);
    }
    // Declarations nested in a body produce no code.
    return x_mov_rax_imm(b, 0);
}

// ------------------------------------------------------------ functions

// Restore the callee-saved registers and return.
fn ng_epilogue(c: i64) -> i64 {
    let b = ncode(c);
    if ng(c, NG_FRAMELESS) == 1 {
        return x_ret(b);
    }
    ng_unframe(c);
    if ng(c, NG_STACKARGS) == 1 {
        x_byte(b, 194);
        x_byte(b, 8 * ng(c, NG_NPARAM));
        return x_byte(b, (8 * ng(c, NG_NPARAM)) >> 8); // ret imm16: pop the arguments
    }
    return x_ret(b);
}

// Reload the callee-saved registers (saved right below rbp) and drop the frame.
fn ng_unframe(c: i64) -> i64 {
    let b = ncode(c);
    let saved = ng(c, NG_SAVED);
    let n = vlen(saved);
    if n == 0 {
        return x_byte(b, 201); // leave
    }
    x_rm(b, 141, 4, 5, 0 - 8 * n); // lea rsp, [rbp - 8n]
    let mut i = n - 1;
    while i >= 0 {
        x_pop_r(b, vget(saved, i));
        i = i - 1;
    }
    return x_pop_r(b, 5); // pop rbp
}

// Tear down the frame for a tail call whose `nargs` (> 6, else 0) stack
// arguments are pushed at rsp: they move up to replace this function's own
// stack arguments (if any), under the return address, so the callee's
// `ret imm16` leaves rsp where this function's own return would have. The
// destination lies above the source, so the copy runs from the top down;
// the saved registers, the return address and the caller's rbp are read
// first, since the copy may overwrite them. Uses rax, rcx, rdx.
fn ng_tail_frame(c: i64, nargs: i64) -> i64 {
    let b = ncode(c);
    let saved = ng(c, NG_SAVED);
    let mut q: i64 = 0;
    while q < vlen(saved) {
        x_rm(b, 139, vget(saved, q), 5, 0 - 8 * (q + 1));
        q = q + 1;
    }
    let mut own: i64 = 0;
    if ng(c, NG_STACKARGS) == 1 {
        own = ng(c, NG_NPARAM);
    }
    let d = 16 + 8 * own - 8 * nargs;   // new home of the lowest argument
    if nargs == 0 {
        // register arguments live in rdi..rcx: only rax is free
        x_rm(b, 139, 0, 5, 8);
        x_rm(b, 137, 0, 5, d - 8);      // return address above our arguments
        x_rm(b, 141, 4, 5, d - 8);
        return x_rm(b, 139, 5, 5, 0);   // mov rbp, [rbp]
    }
    x_rm(b, 139, 1, 5, 8);              // rcx = return address
    x_rm(b, 139, 2, 5, 0);              // rdx = caller's rbp
    let mut j = nargs - 1;
    while j >= 0 {
        x_rm(b, 139, 0, 4, 8 * j);      // mov rax, [rsp + 8j]
        x_rm(b, 137, 0, 5, d + 8 * j);  // mov [rbp + d + 8j], rax
        j = j - 1;
    }
    x_rm(b, 137, 1, 5, d - 8);          // return address below them
    x_rm(b, 141, 4, 5, d - 8);          // lea rsp, [rbp + d - 8]
    return x_mov_rr(b, 5, 2);           // rbp = caller's rbp
}

// Out-of-line stub: the jumps in `jumps` land on a call of runtime
// function `name` with the `nargs` registers rax, rcx, rdx pushed (the
// callee never returns: it reports and exits).
fn ng_cold(c: i64, jumps: i64, name: i64, nargs: i64) -> i64 {
    return ng_cold_back(c, jumps, intern(c, name), nargs, -1);
}

// An out-of-line stub that resumes at code position `back`: with `nargs`
// >= 0 it calls runtime function `id` on the pushed rax (, rcx); with -1
// it sets rax to the constant `id`. The hot path falls through, so the rare
// case pays the two jumps.
fn ng_cold_back(c: i64, jumps: i64, id: i64, nargs: i64, back: i64) -> i64 {
    let cold = ng(c, NG_COLD);
    vpush(cold, jumps);
    vpush(cold, id);
    vpush(cold, nargs);
    return vpush(cold, back);
}

fn ng_emit_cold(c: i64) -> i64 {
    let b = ncode(c);
    let volx = ng(c, NG_VOLX);
    let cold = ng(c, NG_COLD);
    let mut i: i64 = 0;
    while i < vlen(cold) {
        ng_patch_all(c, vget(cold, i));
        let nargs = vget(cold, i + 2);
        let back = vget(cold, i + 3);
        if nargs < 0 {
            x_mov_ri(b, 0, vget(cold, i + 1));
        } else {
            x_push_r(b, 0);
            if nargs > 1 { x_push_r(b, 1); }
            if nargs > 2 { x_push_r(b, 2); }
            ng_call_id(c, vget(cold, i + 1), nargs);
        }
        if back >= 0 {
            x_patch_rel(b, x_jmp(b), back);
        } else {
            x_byte(b, 244); // hlt
        }
        i = i + 4;
    }
    ng_set(c, NG_VOLX, volx);
    return vtrunc(cold, 0);
}

fn ng_function_pass(c: i64, f: i64, prelude: i64) -> i64 {
    let b = ncode(c);
    ni_set(c, na(c, f), NI_EXTERN, x_here(b));
    ng_set(c, NG_NSLOT, 0);
    ng_set(c, NG_DEPTH, 0);
    let is_main = text_eq(name_text(c, na(c, f)), "main");
    let ret = nd(c, f);
    let mut returns: i64 = 0;
    if is_main || (ret >= 0 && !is_prim(c, ret, PRIM_VOID)) {
        returns = 1;
    }
    ng_set(c, NG_RETVAL, returns);
    let params = nc(c, f);
    let count = list_len(c, params) / 2;
    ng_set(c, NG_NPARAM, count);
    let stackargs = count > 6;
    if stackargs {
        ng_set(c, NG_STACKARGS, 1);
    } else {
        ng_set(c, NG_STACKARGS, 0);
    }
    let mut frame: i64 = -1;
    let saved = ng(c, NG_SAVED);
    if ng(c, NG_FRAMELESS) == 0 {
        frame = x_prologue(b, saved);
    }
    let mark = ng_scope_begin(c);
    let pass = ng(c, NG_PASS);
    let uses = ng(c, NG_USE);
    let mut i: i64 = 0;
    while i < count {
        let id = ng_new_local(c, list_at(c, params, i * 2));
        let r = ng_reg(c, id);
        if stackargs {
            if r >= 0 {
                x_rm(b, 139, r, 5, ng_disp(c, id));
            }
        } else if r < 0 && (pass == 1 || (id < vlen(uses) && vget(uses, id) > 1)) {
            // memory home: store before any argument register is reused
            x_rm(b, 137, ng_arg_reg(i), 5, ng_disp(c, id));
        }
        i = i + 1;
    }
    if !stackargs {
        let mut j: i64 = 0;
        while j < count {
            let r = ng_reg(c, j);
            if r >= 0 {
                x_mov_rr(b, r, ng_arg_reg(j));
            }
            j = j + 1;
        }
    }
    vtrunc(ng(c, NG_SLEN), 0);
    vtrunc(ng(c, NG_SMAX), 0);
    let assigned = vnew();
    if ng_scan_assigns(c, ne(c, f), assigned) && (prelude < 0 || ng_scan_assigns_vec(c, prelude, assigned)) {
        ng_set(c, NG_ASSIGNED, assigned);
    } else {
        ng_set(c, NG_ASSIGNED, -1);
    }
    ng_set(c, NG_ACC, -1);
    ng_set(c, NG_ACCLVL, 0);
    ng_set(c, NG_CURFN, f);
    ng_set(c, NG_NOSTACK, ng_stack_bars(c, ne(c, f), prelude));
    if returns == 1 && !is_main && ng_find_acc(c, f, ne(c, f)) {
        let acc = ng_slot(c);
        ng_set_imm(c, acc, 0);
        ng_set(c, NG_ACC, acc);
        ng_set(c, NG_ACCFN, f);
        ng_set(c, NG_ACCTOP, x_here(b));
        ng_set(c, NG_ACCBODY, -1);
        ng_set(c, NG_ACCRET, -1);
    }
    if prelude >= 0 {
        let mut p: i64 = 0;
        while p < vlen(prelude) {
            ng_stmt(c, vget(prelude, p));
            p = p + 1;
        }
    }
    ng_block_v(c, ne(c, f), returns != 1);
    if is_main || returns != 1 {
        x_mov_rax_imm(b, 0);
    }
    ng_acc_flush_end(c);
    ng_add_acc(c);
    ng_set(c, NG_ACC, -1);
    ng_epilogue(c);
    ng_scope_end(c, mark);
    ng_emit_cold(c);
    let mut locals = ng(c, NG_NSLOT);
    if stackargs {
        locals = locals - count;
    }
    if locals < 0 {
        locals = 0;
    }
    if frame < 0 {
        return 0;
    }
    let size = ((locals + vlen(saved)) * 8 + 15) / 16 * 16;
    return x_patch32(b, frame, size - 8 * vlen(saved));
}

const NG_CALLEE_SAVED = 7;

// Registers preserved across calls, in allocation order: rbx, r12..r15,
// r8, r9 (no other code uses r8/r9 except syscall argument set-up, and a
// function doing that saves them).
fn ng_saved_reg(i: i64) -> i64 {
    if i == 0 { return 3; }
    if i <= 4 { return 11 + i; }
    return i + 3;
}

// Two passes: the first counts slot uses (weighted by loop depth), then the
// code is discarded and regenerated with the busiest slots in callee-saved
// registers.
fn ng_function(c: i64, f: i64, prelude: i64) -> i64 {
    let b = ncode(c);
    let start = vlen(b);
    let calls = vlen(ng(c, NG_CALLS));
    let strs = vlen(ng(c, NG_STRS));
    ng_set(c, NG_PASS, 1);
    ng_set(c, NG_CLOB, 0);
    ng_set(c, NG_VOLX, 0);
    ng_set(c, NG_FRAMELESS, 0);
    ng_set(c, NG_CELLFRAME, 0);
    ng_set(c, NG_NSAVE, 0);
    vtrunc(ng(c, NG_SAVED), 0);
    vtrunc(ng(c, NG_USE), 0);
    vtrunc(ng(c, NG_REG), 0);
    vtrunc(ng(c, NG_PIN), 0);
    ng_function_pass(c, f, prelude);
    let uses = ng(c, NG_USE);
    let nslot = ng(c, NG_NSLOT);
    let np = ng(c, NG_NPARAM);
    vtrunc(b, start);
    vtrunc(ng(c, NG_CALLS), calls);
    vtrunc(ng(c, NG_STRS), strs);
    let regs = ng(c, NG_REG);
    vfill(regs, nslot, -1);
    let pins = ng(c, NG_PIN);
    let mut pi: i64 = 0;
    while pi < vlen(pins) {
        vset(regs, vget(pins, pi), vget(pins, pi + 1));
        pi = pi + 2;
    }
    let saved = ng(c, NG_SAVED);
    let leaf = ng(c, NG_VOLX) == 0 && np <= 6;
    if leaf {
        // no calls: the argument registers rdi, rsi, r10, r11 are free
        // homes; parameters keep theirs, other hot slots take the rest
        let taken = vfill(vnew(), 4, 0);
        let mut p: i64 = 0;
        while p < np && p < 4 {
            if vget(uses, p) > 1 {
                vset(regs, p, ng_arg_reg(p));
                vset(taken, p, 1);
            }
            p = p + 1;
        }
        let mut v: i64 = 0;
        while v < 4 {
            if vget(taken, v) == 0 {
                let mut best: i64 = -1;
                let mut bw: i64 = 0;
                let mut k: i64 = 0;
                while k < vlen(uses) {
                    let mut w = vget(uses, k);
                    if k < np {
                        w = w - 1;
                    }
                    if vget(regs, k) < 0 && w > 0 && w > bw {
                        best = k;
                        bw = w;
                    }
                    k = k + 1;
                }
                if best >= 0 {
                    vset(regs, best, ng_arg_reg(v));
                }
            }
            v = v + 1;
        }
    }
    let mut r: i64 = 0;
    while r < NG_CALLEE_SAVED {
        let mut best: i64 = -1;
        let mut bw: i64 = 0;
        let mut k: i64 = 0;
        while k < vlen(uses) {
            let mut w = vget(uses, k);
            if k < np {
                w = w - 1;
            }
            if vget(regs, k) < 0 && w > 2 && w > bw {
                best = k;
                bw = w;
            }
            k = k + 1;
        }
        if best >= 0 {
            vset(regs, best, ng_saved_reg(r));
            vpush(saved, ng_saved_reg(r));
        }
        r = r + 1;
    }
    if ng(c, NG_CLOB) == 1 {
        // r8/r9 clobbered by syscall set-up: keep them out of the slots
        // and save them for the caller
        let mut q: i64 = 0;
        while q < vlen(regs) {
            let rq = vget(regs, q);
            if rq == 8 || rq == 9 {
                vset(regs, q, -1);
            }
            q = q + 1;
        }
        let keep = vnew();
        let mut w: i64 = 0;
        while w < vlen(saved) {
            if vget(saved, w) != 8 && vget(saved, w) != 9 {
                vpush(keep, vget(saved, w));
            }
            w = w + 1;
        }
        vtrunc(saved, 0);
        let mut e: i64 = 0;
        while e < vlen(keep) {
            vpush(saved, vget(keep, e));
            e = e + 1;
        }
        vpush(saved, 8);
        vpush(saved, 9);
    }
    ng_set(c, NG_NSAVE, vlen(saved));
    if leaf && vlen(saved) == 0 && ng(c, NG_CELLFRAME) == 0 {
        // every used slot in a register and no stack cell: no frame at all
        let mut fl = true;
        let mut k: i64 = 0;
        while k < vlen(uses) {
            let mut w = vget(uses, k);
            if k < np {
                w = w - 1;
            }
            if w > 0 && vget(regs, k) < 0 {
                fl = false;
            }
            k = k + 1;
        }
        if fl {
            ng_set(c, NG_FRAMELESS, 1);
        }
    }
    ng_set(c, NG_PASS, 2);
    if env_exists("TRACKC_NATIVE_MAP") == 1 {
        err(text_cat3(int_to_str(vlen(b) + 176), " ", text_cat(name_text(c, na(c, f)), "\n")));
    }
    return ng_function_pass(c, f, prelude);
}

fn ng_is_declaration(c: i64, n: i64) -> bool {
    let k = nk(c, n);
    return k == K_FN || k == K_MACRODEF;
}

// _start: rt_start(argc, argv); sys_exit(main()); then a raw exit.
fn ng_entry(c: i64) -> i64 {
    let b = ncode(c);
    x_bytes2(b, 72, 139);
    x_bytes2(b, 4, 36);        // mov rax, [rsp]
    x_bytes3(b, 72, 141, 76);
    x_bytes2(b, 36, 8);        // lea rcx, [rsp + 8]
    x_push_rax(b);
    x_byte(b, 81);             // push rcx
    ng_call_rt(c, "rt_start", 2);
    ng_call_rt(c, "main", 0);
    x_push_rax(b);
    x_push_rax(b);
    ng_call_rt(c, "sys_exit", 1);
    x_byte(b, 95);             // pop rdi
    x_byte(b, 184);
    x_u32(b, 60);              // mov eax, 60
    return x_bytes2(b, 15, 5); // syscall
}

// Generate the ELF image (byte vector) for the loaded, checked program, or
// report undefined functions and return 0.
fn generate_native(c: i64) -> i64 {
    let state = vfill(vnew_cap(NG_SLOTS), NG_SLOTS, 0);
    vset(c, CX_GEN, state);
    ng_set(c, NG_CODE, vnew_cap(1048576));
    ng_set(c, NG_DATA, vnew_cap(65536));
    ng_set(c, NG_BOUND, vnew());
    ng_set(c, NG_CALLS, vnew());
    ng_set(c, NG_STRS, vnew());
    ng_set(c, NG_STRMAP, vnew());
    ng_set(c, NG_MISSING, vnew());
    ng_set(c, NG_REG, vnew());
    ng_set(c, NG_USE, vnew());
    ng_set(c, NG_SAVED, vnew());
    ng_set(c, NG_INL, vnew());
    ng_set(c, NG_COLD, vnew());
    ng_set(c, NG_CBIND, vnew());
    ng_set(c, NG_BODYOK, vnew());
    ng_set(c, NG_EXITS, vnew());
    ng_set(c, NG_NONE, vnew());
    ng_set(c, NG_SLEN, vnew());
    ng_set(c, NG_SMAX, vnew());
    ng_set(c, NG_PIN, vnew());
    ng_set(c, NG_ACCBODY, -1);
    ng_set(c, NG_ACCRET, -1);
    ng_set(c, NG_STRLEN, vnew());
    ng_set(c, NG_CHOIST, vnew());
    ng_set(c, NG_ASSIGNED, -1);
    ng_set(c, NG_ACC, -1);
    ng_set(c, NG_PASS, 2);
    ng_entry(c);
    let items = cx(c, CX_ITEMS);
    let files = cx(c, CX_ITEMFILE);
    let root = cx(c, CX_MAINFILE);
    let prelude = vnew();
    let mut main_fn: i64 = -1;
    let mut i: i64 = 0;
    while i < vlen(items) {
        let n = vget(items, i);
        if vget(files, i) == root && !ng_is_declaration(c, n) {
            vpush(prelude, n);
        }
        if nk(c, n) == K_FN && text_eq(name_text(c, na(c, n)), "main") {
            main_fn = n;
        }
        i = i + 1;
    }
    // No `main`: an empty one runs the top-level statements, as in the C
    // backend. Registered first so calls to it (rt_start) resolve.
    let mut synthetic: i64 = -1;
    if main_fn < 0 {
        synthetic = node_new(c, K_FN, intern(c, "main"), 0, 0, -1, 0, -1);
        ni_set(c, intern(c, "main"), NI_FN, synthetic);
    }
    let mut j: i64 = 0;
    while j < vlen(items) {
        let n = vget(items, j);
        if ng_is_declaration(c, n) {
            if n == main_fn {
                ng_function(c, n, prelude);
            } else {
                ng_function(c, n, -1);
            }
        }
        j = j + 1;
    }
    if synthetic >= 0 {
        ng_function(c, synthetic, prelude);
    }
    let b = ncode(c);
    // resolve calls
    let calls = ng(c, NG_CALLS);
    let mut k: i64 = 0;
    while k < vlen(calls) {
        let target = ni(c, vget(calls, k + 1), NI_EXTERN);
        if target < 0 {
            vpush(ng(c, NG_MISSING), vget(calls, k + 1));
        } else {
            x_patch_rel(b, vget(calls, k), target);
        }
        k = k + 2;
    }
    let missing = ng(c, NG_MISSING);
    if vlen(missing) > 0 {
        let mut m: i64 = 0;
        while m < vlen(missing) {
            let name = vget(missing, m);
            if ni(c, name, NI_MARK) != 77 {
                ni_set(c, name, NI_MARK, 77);
                err(text_cat3("trackc: native: undefined function '", name_text(c, name), "'\n"));
            }
            m = m + 1;
        }
        return 0;
    }
    // data after the code, 8-aligned
    while vlen(b) % 8 != 0 {
        x_byte(b, 204);
    }
    let base = vlen(b);
    let strs = ng(c, NG_STRS);
    let mut s: i64 = 0;
    while s < vlen(strs) {
        x_patch_rel(b, vget(strs, s), base + vget(strs, s + 1));
        s = s + 2;
    }
    let data = ng(c, NG_DATA);
    let mut d: i64 = 0;
    while d < vlen(data) {
        vpush(b, vget(data, d));
        d = d + 1;
    }
    return elf_image(b, 0);
}
