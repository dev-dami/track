// E-LC03: a reference outlives the block its target dies in.
struct Point { x: i64, y: i64 }
fn main() -> void {
    let a = Point { x: 1, y: 2 };
    let mut r = &a;
    let flag: i64 = 1;
    if flag > 0 {
        let b = Point { x: 3, y: 4 };
        r = &b;
    } else {
        let b = Point { x: 5, y: 6 };
        r = &b;
    }
    print(r.x);
}
