// String building: string builder appends, int_to_str, str_concat, str_len.
fn main() -> void {
    let mut round: i64 = 0;
    let mut total: i64 = 0;
    while round < 40 {
        let b: i64 = track_sb_new();
        let mut i: i64 = 0;
        while i < 100000 {
            track_sb_push(b, "item");
            track_sb_push_int(b, i * round);
            track_sb_push_byte(b, 44);
            if (i & 1023) == 0 {
                let s: i64 = str_concat(int_to_str(i), "-x");
                total = total + str_len(s);
            }
            i = i + 1;
        }
        let text: i64 = track_sb_str(b);
        total = total + str_len(text);
        round = round + 1;
    }
    print(total);
}
