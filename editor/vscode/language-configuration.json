{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "/*", "close": " */", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["/*", "*/"]
  ],
  "wordPattern": "(-?[a-zA-Z_][a-zA-Z0-9_]*|@?[a-zA-Z_][a-zA-Z0-9_]*)",
  "indentationRules": {
    "increaseIndentPattern": "^.*\\{[^}\"]*\\s*$",
    "decreaseIndentPattern": "^\\s*\\}"
  },
  "folding": {
    "markers": {
      "start": "^\\s*//\\s*#region\\b.*",
      "end": "^\\s*//\\s*#endregion\\b.*"
    }
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*//.*",
      "action": { "indentAction": "None", "appendText": "// " }
    },
    {
      "beforeText": "^\\s*\\{\\s*$",
      "afterText": "^\\s*\\}\\s*$",
      "action": { "indentAction": "IndentOutdent" }
    }
  ]
}
