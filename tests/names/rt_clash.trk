// K3a: a program may define any name the runtimes use internally. Each
// call here resolves to the user's definition; the runtime's own calls
// (print -> write, file io -> O_RDONLY ...) still reach the runtime's.
const O_RDONLY = 7;

fn sum(a: i64, b: i64) -> i64 { return a * 100 + b; }
fn add(a: i64, b: i64) -> i64 { return a * 10 + b; }
fn sub(a: i64, b: i64) -> i64 { return b - a; }
fn write(x: i64) -> i64 { return x + 1000; }
fn close(x: i64) -> i64 { return x + 2000; }
fn rt_xor(a: i64, b: i64) -> i64 { return a + b; }
fn w(x: i64) -> i64 { return x + 1; }
fn shl(a: i64, b: i64) -> i64 { return a + b; }
fn shr(a: i64, b: i64) -> i64 { return a - b; }
fn div(a: i64, b: i64) -> i64 { return a * b; }
fn dup(a: i64) -> i64 { return a + a + a; }

fn main() -> i64 {
    print(sum(1, 2));
    print(add(1, 2));
    print(sub(1, 2));
    print(write(1));
    print(close(1));
    print(rt_xor(5, 6));
    print(w(1));
    print(shl(1, 2));
    print(shr(9, 2));
    print(div(3, 4));
    print(dup(5));
    print(O_RDONLY);
    print(1 << 3);
    print(17 / 5);
    print(str_len("hello"));
    print("done");
    return 0;
}
