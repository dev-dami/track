// L13b: nested temporaries: each fresh argument is freed once, innermost
// first, right after the call it was passed to returns.
fn main() -> void {
    let a: Str = str_concat("a", "-");
    let b: Str = str_concat("b", "!");
    let mut total: i64 = 0;
    let mut i: i64 = 0;
    while i < 3000 {
        let s: Str = str_concat(&int_to_str(i), &str_concat(&a, &b));
        total = total + str_len(&s);
        if i % 1000 == 0 {
            print(&s);
            print(&str_concat(&str_concat(&int_to_str(i), "/"), &int_to_str(i + 1)));
        }
        i = i + 1;
    }
    print(total);
    print(str_len(&a) + str_len(&b));
    print(sys_get_memory_used());
}
