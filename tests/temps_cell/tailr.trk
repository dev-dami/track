// L13d: a cell temporary passed to a self tail call. The native backend
// must not turn the call into a jump while a temporary still waits to be
// freed after it, nor lose the temporary of the first call.
struct Rect { w: i64, h: i64 }

fn tailr(r: Rect, n: i64) -> i64 {
    if n == 0 {
        return r.w;
    }
    return tailr(Rect { w: r.w + 1, h: n }, n - 1);
}

fn main() -> void {
    print(tailr(Rect { w: 0, h: 0 }, 1000));
    print(sys_get_memory_used());
}
