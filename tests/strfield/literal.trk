// L13e: a Str field holding a literal is static; it is never freed.
struct Named { name: Str, n: i64 }

fn weight(x: &Named) -> i64 {
    return str_len(x.name) + x.n;
}

fn main() -> void {
    let mut total: i64 = 0;
    let mut i: i64 = 0;
    while i < 1000 {
        total = total + weight(&Named { name: "lit", n: i });
        let x = Named { name: "local", n: 1 };
        total = total + weight(&x);
        i = i + 1;
    }
    print(total);
}
