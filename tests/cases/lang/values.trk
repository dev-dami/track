fn sign(x: i64) -> i64 {
    let s = if x < 0 { -1 } else if x == 0 { 0 } else { 1 };
    return s;
}
fn name(x: i64) -> i64 {
    let v = match x { 1 => 100, 2 => 200, _ => 300, };
    return v;
}
fn main() -> void {
    print(sign(-4)); print(sign(0)); print(sign(9));
    print(name(2)); print(name(7));
}
