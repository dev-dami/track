// 4-variable rotation: p reaches `a` after 3 iterations, so the
// loop needs 3 passes plus one to confirm the fixpoint. p must end by
// `ret` and the result must be derived(p) fresh (card L3b).
struct Point { x: i64, y: i64 }
fn rot4_while(p: Point, n: i64) -> Point {
    let mut a = Point { x: 0, y: 0 };
    let mut b = Point { x: 0, y: 0 };
    let mut c = Point { x: 0, y: 0 };
    let mut d = p;
    let mut i = 0;
    while i < n {
        let t = a;
        a = b;
        b = c;
        c = d;
        d = t;
        i = i + 1;
    }
    return a;
}
fn rot4_for(p: Point, n: i64) -> Point {
    let mut a = Point { x: 0, y: 0 };
    let mut b = Point { x: 0, y: 0 };
    let mut c = Point { x: 0, y: 0 };
    let mut d = p;
    for i in 0..n {
        let t = a;
        a = b;
        b = c;
        c = d;
        d = t;
    }
    return a;
}
fn main() -> void {
    print(rot4_while(Point { x: 1, y: 2 }, 3).x);
    print(rot4_for(Point { x: 1, y: 2 }, 3).x);
}
