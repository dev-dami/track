// L12a: frees in latch-first loops. The body declares a heap-autofree
// cell, then ends in an else-less `if` and an assignment (the latch-first
// layout): the cell is freed whether or not the `if` runs, and the early
// `return` inside it frees the cell before leaving, along with the
// function's own cell declared before the loop.
struct Cell { v: i64, w: i64 }

fn mk(i: i64) -> Cell {
    return Cell { v: i, w: i * 5 };
}

fn find(n: i64, m: i64) -> i64 {
    let guard = mk(m);
    let mut i: i64 = 1;
    let mut seen: i64 = 0;
    while i < n {
        let c = mk(i);
        seen = (seen + c.w) % 1000003;
        if c.v % guard.v == 0 {
            return c.v * 1000 + seen % 1000;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn main() -> i64 {
    sys_set_memory_limit(1000000);
    let base = sys_get_memory_used();
    print(find(1000000, 999983));
    print(sys_get_memory_used() - base);
    let mut t: i64 = 0;
    let mut k: i64 = 0;
    while k < 2000 {
        t = (t + find(500, 7 + k % 300)) % 1000003;
        k = k + 1;
    }
    print(t);
    print(sys_get_memory_used() - base);
    return 0;
}
