// Collection data pointer and length hoisted out of loops only when
// nothing in the loop can change the header: out-of-range get/set still
// give 0 and store nothing, a loop that grows the collection (directly or
// through another name) keeps reloading, and the final array index past
// the end inside a hoisted loop still aborts.
fn bump(h: i64, i: i64) -> i64 {
    return track_i64_collection_push(h, i);
}

fn main() -> void {
    let v: i64 = track_i64_collection_new(4);
    let mut i: i64 = 0;
    while i < 10 {
        track_i64_collection_push(v, i * 3);
        i = i + 1;
    }
    // hoisted: indexes run past both ends
    let mut acc: i64 = 0;
    let mut k: i64 = -3;
    while k < 14 {
        acc = acc + track_i64_collection_get(v, k);
        print(track_i64_collection_set(v, k, k + 100));
        k = k + 1;
    }
    print(acc);
    print(track_i64_collection_get(v, 9));
    // grown inside the loop: length and data pointer change (realloc)
    let mut n: i64 = 0;
    let mut sum: i64 = 0;
    while n < 40 {
        track_i64_collection_push(v, n);
        sum = sum + track_i64_collection_get(v, n + 10) + track_i64_collection_len(v);
        n = n + 1;
    }
    print(sum);
    // grown through an alias and through a call
    let w: i64 = v;
    let mut m: i64 = 0;
    let mut s2: i64 = 0;
    while m < 100 {
        track_i64_collection_push(w, m);
        s2 = s2 + track_i64_collection_get(v, 49 + m);
        bump(w, m);
        s2 = s2 + track_i64_collection_get(v, track_i64_collection_len(v) - 1);
        m = m + 1;
    }
    print(s2);
    print(track_i64_collection_len(v));
    // popped through an alias: the length shrinks
    let mut p: i64 = 0;
    let mut s3: i64 = 0;
    while p < 300 {
        s3 = s3 + track_i64_collection_get(v, 249);
        track_i64_collection_pop(w);
        p = p + 1;
    }
    print(s3);
    // null handle in a hoisted loop
    let z: i64 = 0;
    let mut q: i64 = 0;
    while q < 3 {
        print(track_i64_collection_get(z, q) + track_i64_collection_set(z, q, 1));
        q = q + 1;
    }
    // array index past the end inside a hoisted loop: aborts
    let xs = [1, 2, 3];
    let mut r: i64 = 0;
    while r < 5 {
        print(xs[r] + track_i64_collection_get(v, r));
        r = r + 1;
    }
}
