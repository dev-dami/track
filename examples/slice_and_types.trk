// Test: v0.1.6 Slice syntax ([]u8), sub-slicing (a[0..5]), and u8/i8 types

fn main() -> void {
    let buf: ptr<u8> = alloc(16);

    let val1: u8 = 42;
    let val2: i8 = -10;

    print(val1);
    print(val2);

    let arr: [i64; 5] = [10, 20, 30, 40, 50];
    let slice: []i64 = arr[1..4];

    print(slice);
}
